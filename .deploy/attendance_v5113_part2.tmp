<div id="recordDateRangeDialog"
     class="hidden fixed inset-0 z-[10080] items-center justify-center bg-slate-950/55 p-4"
     onclick="if(event.target===this)closeRecordDateRangeDialog()"
     role="dialog"
     aria-modal="true"
     aria-labelledby="recordDateRangeDialogTitle">
  <div class="w-full max-w-md rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xl p-5">
    <div class="flex items-start justify-between gap-3 mb-4">
      <div>
        <h3 id="recordDateRangeDialogTitle" class="font-black text-slate-800 dark:text-slate-100">📅 選擇考勤日期</h3>
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">起訖同一天＝查單日；不同日期＝查這幾天。</p>
      </div>
      <button type="button" onclick="closeRecordDateRangeDialog()" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 font-black">✕</button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <label class="block">
        <span class="block mb-1 text-xs font-bold text-slate-600 dark:text-slate-300">開始日期</span>
        <input id="recordDateDraftStart" type="date"
               class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-bold">
      </label>
      <label class="block">
        <span class="block mb-1 text-xs font-bold text-slate-600 dark:text-slate-300">結束日期</span>
        <input id="recordDateDraftEnd" type="date"
               class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-bold">
      </label>
    </div>

    <div class="mt-3 flex flex-wrap gap-2">
      <button type="button" onclick="setRecordDateDraftToday()" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-700 text-xs font-bold">今天／單日</button>
      <button type="button" onclick="setRecordDateDraftWholeMonth()" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-700 text-xs font-bold">目前月份整月</button>
    </div>

    <div class="mt-5 flex justify-end gap-2">
      <button type="button" onclick="closeRecordDateRangeDialog()" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold">取消</button>
      <button type="button" onclick="applyRecordDateRangeDialog()" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-black shadow">確定</button>
    </div>
  </div>
</div>



<style id="p79-v51038-audit-fit-layout">
#attendanceImportAuditModal{
  padding:18px!important;
  display:flex;
  align-items:flex-start;
  justify-content:center;
}
#attendanceImportAuditModal.hidden{display:none!important}
#attendanceImportAuditModal .p79-audit-panel{
  width:min(94vw,1320px)!important;
  max-width:1320px!important;
  margin:18px auto!important;
}
#attendanceImportAuditModal .p79-audit-head{padding:10px 12px!important;gap:8px!important}
#attendanceImportAuditModal .p79-audit-scroll{max-height:72vh!important;overflow:auto!important}
#attendanceImportAuditTable{
  width:100%!important;
  min-width:1160px!important;
  table-layout:auto!important;
  font-size:11px!important;
  line-height:1.25!important;
}
#attendanceImportAuditTable th,
#attendanceImportAuditTable td{
  padding:6px 6px!important;
  white-space:nowrap!important;
  vertical-align:middle!important;
}
#attendanceImportAuditTable th:nth-child(1),
#attendanceImportAuditTable td:nth-child(1){width:30px!important;text-align:center}
#attendanceImportAuditTable th:nth-child(2),
#attendanceImportAuditTable td:nth-child(2){width:56px!important}
#attendanceImportAuditTable th:nth-child(3),
#attendanceImportAuditTable td:nth-child(3){width:88px!important}
#attendanceImportAuditTable th:nth-child(4),
#attendanceImportAuditTable td:nth-child(4){width:62px!important}
#attendanceImportAuditTable th:nth-child(5),
#attendanceImportAuditTable td:nth-child(5),
#attendanceImportAuditTable th:nth-child(6),
#attendanceImportAuditTable td:nth-child(6),
#attendanceImportAuditTable th:nth-child(7),
#attendanceImportAuditTable td:nth-child(7),
#attendanceImportAuditTable th:nth-child(8),
#attendanceImportAuditTable td:nth-child(8){width:112px!important}
#attendanceImportAuditTable th:nth-child(9),
#attendanceImportAuditTable td:nth-child(9){width:78px!important}
#attendanceImportAuditTable th:nth-child(10),
#attendanceImportAuditTable td:nth-child(10){width:44px!important;text-align:center}
#attendanceImportAuditTable th:nth-child(11),
#attendanceImportAuditTable td:nth-child(11){
  width:240px!important;
  min-width:220px!important;
  max-width:280px!important;
  white-space:normal!important;
  line-height:1.35!important;
}
#attendanceImportAuditTable th:nth-child(12),
#attendanceImportAuditTable td:nth-child(12){width:145px!important;min-width:145px!important}
#attendanceImportAuditTable td:nth-child(4){font-weight:800}
#attendanceImportAuditTable .p79-audit-actions{
  display:flex!important;
  flex-wrap:wrap!important;
  justify-content:center!important;
  gap:4px!important;
}
#attendanceImportAuditTable .p79-audit-actions button{
  padding:5px 7px!important;
  font-size:10px!important;
  line-height:1.1!important;
  white-space:nowrap!important;
  border-radius:8px!important;
}
#attendanceImportAuditModal .p79-audit-footer{padding:8px 10px!important}
@media (max-width:900px){
  #attendanceImportAuditModal{padding:6px!important;display:block}
  #attendanceImportAuditModal .p79-audit-panel{
    width:calc(100vw - 12px)!important;
    max-width:none!important;
    margin:6px auto!important;
  }
  #attendanceImportAuditTable{min-width:1120px!important;font-size:10px!important}
  #attendanceImportAuditTable th,#attendanceImportAuditTable td{padding:5px!important}
}
</style>

<div id="attendanceImportAuditModal" class="hidden fixed inset-0 z-[10120] bg-slate-950/60 overflow-y-auto" onclick="if(event.target===this)closeAttendanceImportAuditModal()">
  <button type="button"
          onclick="closeAttendanceImportAuditModal()"
          class="fixed top-2 right-2 z-[10150] px-3 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-black shadow-2xl"
          title="關閉匯入比對明細"
          aria-label="關閉匯入比對明細">✕ 關閉</button>
  <div class="p79-audit-panel mx-auto rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200 dark:border-slate-700">
    <div class="p79-audit-head sticky top-0 z-10 flex flex-wrap items-center justify-between border-b border-slate-200 dark:border-slate-700 bg-white/95 dark:bg-slate-900/95 backdrop-blur rounded-t-2xl">
      <div>
        <h3 class="font-black text-slate-800 dark:text-white">🔎 Excel ↔ 系統考勤逐班比對明細</h3>
        <div class="mt-1 flex flex-wrap gap-2 text-[10px] font-bold">
          <span class="px-2 py-1 rounded-lg bg-sky-100 text-sky-800 dark:bg-sky-950/60 dark:text-sky-200">藍色＝Excel 原始資料</span>
          <span class="px-2 py-1 rounded-lg bg-violet-100 text-violet-800 dark:bg-violet-950/60 dark:text-violet-200">紫色＝目前系統資料</span>
        </div>
        <div id="attendanceImportAuditSummary" class="mt-1 text-xs text-slate-500 dark:text-slate-400"></div>
      </div>
      <div class="flex flex-wrap gap-1.5 pr-24">
        <button type="button" onclick="rebuildAttendanceImportAuditFromCurrentSystem()" class="px-3 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold">🔄 重新比對</button>
        <button type="button" onclick="exportAttendanceImportAuditExcel()" class="px-3 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold">📊 匯出 Excel</button>
        <button type="button" onclick="p79FinalizeConfirmedExcelAttendance()" class="px-3 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-black">✅ 完成核對，只保留系統考勤</button>
        <button type="button" onclick="closeAttendanceImportAuditModal()" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-700 text-xs font-bold">✕ 關閉</button>
      </div>
    </div>
    <div class="p79-audit-scroll overflow-auto">
      <table id="attendanceImportAuditTable" class="w-full">
        <thead class="sticky top-0 bg-slate-100 dark:bg-slate-800 z-[1]">
          <tr>
            <th class="px-2 py-2">#</th>
            <th class="px-2 py-2">考勤號</th>
            <th class="px-2 py-2">工號</th>
            <th class="px-2 py-2">姓名</th>
            <th class="px-2 py-2 bg-sky-100 text-sky-800 dark:bg-sky-950/60 dark:text-sky-200">Excel 上班</th>
            <th class="px-2 py-2 bg-sky-100 text-sky-800 dark:bg-sky-950/60 dark:text-sky-200">Excel 下班</th>
            <th class="px-2 py-2 bg-violet-100 text-violet-800 dark:bg-violet-950/60 dark:text-violet-200">系統上班</th>
            <th class="px-2 py-2 bg-violet-100 text-violet-800 dark:bg-violet-950/60 dark:text-violet-200">系統下班</th>
            <th class="px-2 py-2">系統狀態</th>
            <th class="px-2 py-2">跨日</th>
            <th class="px-2 py-2">比對結果 / 動作</th>
            <th class="px-2 py-2 sticky right-0 bg-slate-100 dark:bg-slate-800 z-[2]">操作</th>
          </tr>
        </thead>
        <tbody id="attendanceImportAuditBody"></tbody>
      </table>
    </div>
    <div class="p79-audit-footer sticky bottom-0 z-10 flex items-center justify-between gap-3 border-t border-slate-200 dark:border-slate-700 bg-white/95 dark:bg-slate-900/95 backdrop-blur rounded-b-2xl">
      <div class="text-[11px] text-slate-500 dark:text-slate-400">修改／補卡後會自動重算；也可以手動按「重新比對」。</div>
      <div class="flex gap-2 shrink-0">
        <button type="button" onclick="rebuildAttendanceImportAuditFromCurrentSystem()" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-black">🔄 重新比對</button>
        <button type="button" onclick="p79FinalizeConfirmedExcelAttendance()" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-black">✅ 完成核對，只保留系統考勤</button>
        <button type="button" onclick="closeAttendanceImportAuditModal()" class="px-5 py-2 rounded-xl bg-slate-700 hover:bg-slate-800 text-white text-xs font-black">✕ 關閉</button>
      </div>
    </div>
  </div>
</div>

<script src="../assets/port79-calendar-range.js"></script>
<script>
document.addEventListener("DOMContentLoaded",()=>{

const C=window.Port79CalendarRange;if(!C)return;
// V5.10.20：考勤日期改用本頁單格確認/取消視窗，不再交給外部 range widget 重建。
C.mountRange({startId:'leaveStartFilter',endId:'leaveEndFilter',label:'日期範圍',allowClear:true});
C.mountRange({startId:'manualLeaveStart',endId:'manualLeaveEnd',label:'請假日期',allowClear:false});
['empModalStartDate','empModalBirthday','modalDateInput','addModalDateInput'].forEach(id=>C.mountSingle({inputId:id}));

});
</script>
</body>
</html>
            return String(value || '').replaceAll('-', '/');
        }

        function setRecordDateRangeToMonth(monthValue, render=false){
            const rawMonth=String(monthValue||'').trim();
            const start=document.getElementById('recordDateFilter');
            const end=document.getElementById('recordDateEndFilter');

            // ALL = 不限制日期；特定月份 = 預設整月。
            if(rawMonth==='ALL' || !/^\d{4}-\d{2}$/.test(rawMonth)){
                if(start){start.value='';start.dataset.p79DateInitialized='1';}
                if(end){end.value='';end.dataset.p79DateInitialized='1';}
            }else{
                const range=getAttendanceMonthDateRange(rawMonth);
                if(start){start.value=range.first;start.dataset.p79DateInitialized='1';}
                if(end){end.value=range.last;end.dataset.p79DateInitialized='1';}
            }

            updateRecordDateRangeSummary();
            if(render){
                recordsCurrentPage=1;
                renderAdminRecordsTable();
            }
            return {
                first:start?.value||'',
                last:end?.value||''
            };
        }

        function ensureRecordDateDefaultsToday(){
            // 保留舊函式名稱，但規則改為：
            // 選定月份 -> 整月；全部月份 -> 不限制日期。
            const start=document.getElementById('recordDateFilter');
            const end=document.getElementById('recordDateEndFilter');
            if(!start||!end)return;

            if(start.dataset.p79DateInitialized==='1' && end.dataset.p79DateInitialized==='1') return;

            const month=document.getElementById('filterMonthSelect')?.value||'ALL';
            setRecordDateRangeToMonth(month,false);
        }

        function updateRecordDateRangeSummary(){
            const start=document.getElementById('recordDateFilter');
            const end=document.getElementById('recordDateEndFilter');
            const a=String(start?.value||'').trim();
            const b=String(end?.value||'').trim();

            const label = !a && !b
                ? '全部日期'
                : (a && b && a===b
                    ? p79DateToSlash(a)
                    : `${p79DateToSlash(a||b)} ～ ${p79DateToSlash(b||a)}`);

            const summary=document.getElementById('recordDateRangeSummary');
            const buttonText=document.getElementById('recordDateRangeButtonText');
            if(summary) summary.textContent=label;
            if(buttonText) buttonText.textContent=label;
            return label;
        }

        function p79RecordDateDialogElements(){
            return {
                modal:document.getElementById('recordDateRangeDialog'),
                draftStart:document.getElementById('recordDateDraftStart'),
                draftEnd:document.getElementById('recordDateDraftEnd')
            };
        }

        function openRecordDateRangeDialog(){
            ensureRecordDateDefaultsToday();

            const {modal,draftStart,draftEnd}=p79RecordDateDialogElements();
            if(!modal||!draftStart||!draftEnd)return;

            const currentStart=String(document.getElementById('recordDateFilter')?.value||'').trim();
            const currentEnd=String(document.getElementById('recordDateEndFilter')?.value||'').trim();
            const month=String(document.getElementById('filterMonthSelect')?.value||'ALL').trim();

            draftStart.value=currentStart;
            draftEnd.value=currentEnd;

            // 已選月份時，日期只允許在該月內，避免「10 月」標籤卻篩到別月。
            if(/^\d{4}-\d{2}$/.test(month)){
                const range=getAttendanceMonthDateRange(month);
                draftStart.min=range.first; draftStart.max=range.last;
                draftEnd.min=range.first; draftEnd.max=range.last;
                if(!draftStart.value) draftStart.value=range.first;
                if(!draftEnd.value) draftEnd.value=range.last;
            }else{
                draftStart.removeAttribute('min'); draftStart.removeAttribute('max');
                draftEnd.removeAttribute('min'); draftEnd.removeAttribute('max');
            }

            modal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
            setTimeout(()=>draftStart.focus(),0);
        }

        function closeRecordDateRangeDialog(){
            const modal=document.getElementById('recordDateRangeDialog');
            if(modal)modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        function setRecordDateDraftToday(){
            const {draftStart,draftEnd}=p79RecordDateDialogElements();
            if(!draftStart||!draftEnd)return;
            let today=getTodayAttendanceIso();

            // 若目前鎖定的是其他月份，今天不在範圍內時取該月第一天。
            if(draftStart.min && (today<draftStart.min || today>draftStart.max)) today=draftStart.min;

            draftStart.value=today;
            draftEnd.value=today;
        }

        function setRecordDateDraftWholeMonth(){
            const {draftStart,draftEnd}=p79RecordDateDialogElements();
            if(!draftStart||!draftEnd)return;

            const month=String(document.getElementById('filterMonthSelect')?.value||'ALL').trim();
            if(/^\d{4}-\d{2}$/.test(month)){
                const range=getAttendanceMonthDateRange(month);
                draftStart.value=range.first;
                draftEnd.value=range.last;
            }else{
                draftStart.value='';
                draftEnd.value='';
            }
        }

        function applyRecordDateRangeDialog(){
            const {draftStart,draftEnd}=p79RecordDateDialogElements();
            const start=document.getElementById('recordDateFilter');
            const end=document.getElementById('recordDateEndFilter');
            if(!draftStart||!draftEnd||!start||!end)return;

            let a=String(draftStart.value||'').trim();
            let b=String(draftEnd.value||'').trim();

            if(a && !b)b=a;
            if(b && !a)a=b;
            if(a && b && a>b)[a,b]=[b,a];

            const month=String(document.getElementById('filterMonthSelect')?.value||'ALL').trim();
            if(/^\d{4}-\d{2}$/.test(month)){
                const range=getAttendanceMonthDateRange(month);
                a=a||range.first;
                b=b||range.last;
                a=a<range.first?range.first:(a>range.last?range.last:a);
                b=b<range.first?range.first:(b>range.last?range.last:b);
                if(a>b)[a,b]=[b,a];
            }

            start.value=a;
            end.value=b;
            start.dataset.p79DateInitialized='1';
            end.dataset.p79DateInitialized='1';

            // 重要：日期確認不再把月份選單改成 ALL。
            updateRecordDateRangeSummary();
            closeRecordDateRangeDialog();

            recordsCurrentPage=1;
            renderAdminRecordsTable();
        }

        function onRecordDateChange(){
            // 舊相容入口：不再改變月份。
            updateRecordDateRangeSummary();
            recordsCurrentPage=1;
            renderAdminRecordsTable();
        }

        function setRecordDateRangeToday(){
            const start=document.getElementById('recordDateFilter');
            const end=document.getElementById('recordDateEndFilter');
            if(!start||!end)return;

            let today=getTodayAttendanceIso();
            const month=String(document.getElementById('filterMonthSelect')?.value||'ALL').trim();
            if(/^\d{4}-\d{2}$/.test(month)){
                const range=getAttendanceMonthDateRange(month);
                if(today<range.first || today>range.last) today=range.first;
            }
            start.value=today;
            end.value=today;
            start.dataset.p79DateInitialized='1';
            end.dataset.p79DateInitialized='1';
            updateRecordDateRangeSummary();
            recordsCurrentPage=1;
            renderAdminRecordsTable();
        }

        function clearRecordDateFilter(){
            const month=document.getElementById('filterMonthSelect')?.value||'ALL';
            setRecordDateRangeToMonth(month,true);
        }

        function getAttendanceRecordFilterRows() {
            const monthFilter = document.getElementById('filterMonthSelect')?.value || 'ALL';
            ensureRecordDateDefaultsToday();
            const dateFrom = normalizeRecordFilterDate(
                document.getElementById('recordDateFilter')?.value || ''
            );
            const dateTo = normalizeRecordFilterDate(
                document.getElementById('recordDateEndFilter')?.value || ''
            );
            const statusFilter = document.getElementById('recordStatusFilter')?.value || 'ALL';

            let rows = buildDailyAttendanceRows(records.filter(canCurrentAdminViewDataRow));

            if (dateFrom || dateTo) {
                rows = rows.filter(row =>
                    attendanceRowMatchesDateRange(row, dateFrom, dateTo)
                );
            } else if (monthFilter !== 'ALL') {
                rows = rows.filter(row => attendanceRowVisibleForMonth(row, monthFilter));
            }

            if (statusFilter === 'NORMAL') rows = rows.filter(row => row.attendanceStatus === '正常');
            if (statusFilter === 'ABNORMAL') rows = rows.filter(row => row.attendanceStatus !== '正常');
            return sortAttendanceRowsActiveFirst(rows);
        }

        function initDropdowns() {
            const attendanceNameAudit = repairAttendanceNamesInMemory();
            if (attendanceNameAudit.changed || attendanceNameAudit.unresolved) {
                console.info('[V5.10.8 考勤姓名檢視]', attendanceNameAudit);
            }
            const visibleEmployees = getAdminVisibleEmployees();
            const attendanceEmployees = getAdminAttendanceEmployees();
            const recordDepts = [...new Set(
                attendanceEmployees
                    .filter(e => String(e?.empId || '').trim().toUpperCase() !== 'ADMIN')
                    .map(e => String(e?.dept || '一般').trim() || '一般')
                    .filter(Boolean)
            )].sort((a, b) => a.localeCompare(b, 'zh-Hant', { numeric: true }));

            const recordDeptFilter = document.getElementById('recordDeptFilter');
            if (recordDeptFilter) {
                const currentVal = recordDeptFilter.value || 'ALL';
                recordDeptFilter.innerHTML = '<option value="ALL">全部部門</option>' + recordDepts.map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
                recordDeptFilter.value = recordDepts.includes(currentVal) ? currentVal : 'ALL';
            }

            const liveDeptFilter = document.getElementById('liveDeptFilter');
            if (liveDeptFilter) {
                const currentVal = liveDeptFilter.value || 'ALL';
                const liveDepts = [...new Set(visibleEmployees.map(e => String(e.dept || '一般')).filter(Boolean))]
                    .sort((a, b) => a.localeCompare(b, 'zh-Hant', { numeric: true }));
                liveDeptFilter.innerHTML = '<option value="ALL">全部部門</option>' + liveDepts.map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
                liveDeptFilter.value = liveDepts.includes(currentVal) ? currentVal : 'ALL';
            }

            const addModalDeptSelect = document.getElementById('addModalDeptSelect');
            if (addModalDeptSelect) {
                const modalDepts = [...new Set(attendanceEmployees.map(e => e.dept || '一般'))];
                addModalDeptSelect.innerHTML = modalDepts.map(d => `<option value="${d}">${d}</option>`).join('');
                onAddModalDeptChange();
            }

            const today = new Date();
            const currentYearMonth = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;
            const recordMonths = [...new Set(records.map(r => {
                if (!r.timeStr) return '';
                const parts = r.timeStr.split(/[\/\-\s]/);
                return parts.length >= 2 ? `${parts[0]}-${parts[1].padStart(2,'0')}` : '';
            }).filter(m => m.length > 0))];
            const months = ['ALL', ...new Set([currentYearMonth, ...recordMonths].sort().reverse())];

            const monthSelect = document.getElementById('filterMonthSelect');
            if (monthSelect) {
                const initialized = monthSelect.dataset.p79MonthInitialized === '1';
                const curMonth = initialized ? (monthSelect.value || currentYearMonth) : currentYearMonth;
                monthSelect.innerHTML = months.map(m => `<option value="${m}">${m === 'ALL' ? '全部月份（較慢）' : m}</option>`).join('');
                monthSelect.value = months.includes(curMonth) ? curMonth : currentYearMonth;
                monthSelect.dataset.p79MonthInitialized = '1';
                renderAttendanceMonthTabs(months, monthSelect.value);
            }

            updateRecordEmployeeFilterOptions();
            updateLiveEmpOptions();
        }

        function renderAttendanceMonthTabs(months, selectedMonth) {
            const box = document.getElementById('attendanceMonthTabs');
            if (!box) return;
            box.innerHTML = months.map(month => {
                const active = month === selectedMonth;
                const label = month === 'ALL' ? '全部' : month.replace('-', ' / ');
                return `<button type="button" onclick="selectAttendanceMonth('${month}')" class="shrink-0 px-3 py-2 rounded-xl text-xs font-bold border transition ${active ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-indigo-400'}">${label}</button>`;
            }).join('');
        }

        async function onAttendanceMonthFilterChange() {
            const monthSelect = document.getElementById('filterMonthSelect');
            if (!monthSelect) return;
            setRecordDateRangeToMonth(monthSelect.value, false);
            resetFilterControls(['recordDeptFilter','recordJobTitleFilter','recordNameFilter','recordStatusFilter']);
            renderAttendanceMonthTabs([...monthSelect.options].map(option=>option.value), monthSelect.value || 'ALL');
            recordsCurrentPage = 1;
            if (monthSelect.value === 'ALL') {
                setCloudSyncStatus('正在讀取全部月份考勤資料', 'loading', 'read');
                await loadCloudData(false, true);
            } else {
                await Promise.all([preloadAttendanceEmployeeMaster(false, false), loadAttendanceMonthFromCloud(monthSelect.value, false)]);
            }
            initDropdowns();
            renderAdminRecordsTable();
        }

        async function selectAttendanceMonth(month) {
            const monthSelect = document.getElementById('filterMonthSelect');
            if (!monthSelect) return;
            monthSelect.value = month;
            setRecordDateRangeToMonth(month, false);
            resetFilterControls(['recordDeptFilter','recordJobTitleFilter','recordNameFilter','recordStatusFilter']);
            renderAttendanceMonthTabs([...monthSelect.options].map(option=>option.value), month);
            recordsCurrentPage = 1;
            if (month === 'ALL') await loadCloudData(false, true);
            else await Promise.all([preloadAttendanceEmployeeMaster(false, false), loadAttendanceMonthFromCloud(month, false)]);
            initDropdowns();
            renderAdminRecordsTable();
        }

        function updateRecordEmployeeFilterOptions() {
            // V5.10.8：考勤篩選人員 = 人資員工主檔 + 所有已存在考勤身份聯集。
            // 主檔暫時漏掉的人（例如考勤已有姓名/考勤號）仍必須出現在姓名選單。
            repairAttendanceNamesInMemory();
            const visibleEmployees = getAdminAttendanceEmployees();

            const deptSelect = document.getElementById('recordDeptFilter');
            const jobTitleSelect = document.getElementById('recordJobTitleFilter');
            const nameSelect = document.getElementById('recordNameFilter');
            if (!deptSelect || !jobTitleSelect || !nameSelect) return;

            const currentDept = deptSelect.value || 'ALL';
            const currentJob = jobTitleSelect.value || 'ALL';
            const currentName = nameSelect.value || 'ALL';

            const depts = [...new Set(
                visibleEmployees
                    .map(e => String(e?.dept || '一般').trim() || '一般')
                    .filter(Boolean)
            )].sort((a,b)=>a.localeCompare(b,'zh-Hant',{numeric:true}));

            deptSelect.innerHTML =
                '<option value="ALL">全部部門</option>' +
                depts.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');
            deptSelect.value = depts.includes(currentDept) ? currentDept : 'ALL';

            const selectedDept = deptSelect.value || 'ALL';
            let candidates = visibleEmployees.filter(e =>
                selectedDept === 'ALL' || String(e?.dept || '一般') === selectedDept
            );

            const jobs = [...new Set(
                candidates
                    .map(e => String(e?.jobTitle || e?.deptDetail || '').trim())
                    .filter(Boolean)
            )].sort((a,b)=>a.localeCompare(b,'zh-Hant',{numeric:true}));

            jobTitleSelect.innerHTML =
                '<option value="ALL">全部職務</option>' +
                jobs.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');
            jobTitleSelect.value = jobs.includes(currentJob) ? currentJob : 'ALL';

            const selectedJob = jobTitleSelect.value || 'ALL';
            candidates = candidates.filter(e =>
                selectedJob === 'ALL' ||
                String(e?.jobTitle || e?.deptDetail || '') === selectedJob
            );

            // 姓名使用 empId 作為 value，顯示「姓名（工號）」；
            // 只要員工主檔有此人，就一定會在這裡。
            const unique = new Map();
            candidates.forEach(e => {
                const empId = String(e?.empId || '').trim();
                const name = String(e?.name || '').trim();
                if (!empId && !name) return;
                const key = empId || `NAME:${name}`;
                if (!unique.has(key)) unique.set(key, e);
            });

            const people = [...unique.values()].sort((a,b) => {
                const an = String(a?.name || '');
                const bn = String(b?.name || '');
                const byName = an.localeCompare(bn,'zh-Hant',{numeric:true});
                if (byName) return byName;
                return String(a?.empId || '').localeCompare(String(b?.empId || ''),'zh-Hant',{numeric:true});
            });

            nameSelect.innerHTML =
                '<option value="ALL">全部姓名</option>' +
                people.map(e => {
                    const value = attendanceEmployeeOptionValue(e);
                    const label = attendanceEmployeeDisplayLabel(e);
                    return value ? `<option value="${escapeHtml(value)}">${escapeHtml(label)}</option>` : '';
                }).join('');

            const validValues = new Set(people.map(e => attendanceEmployeeOptionValue(e)).filter(Boolean));
            nameSelect.value = validValues.has(currentName) ? currentName : 'ALL';
        }

        function onRecordDeptChange() {
            resetFilterControls(['recordJobTitleFilter', 'recordNameFilter', 'recordStatusFilter']);
            updateRecordEmployeeFilterOptions();
            renderAdminRecordsTable();
        }

        function onRecordJobTitleChange() {
            resetFilterControls(['recordNameFilter', 'recordStatusFilter']);
            updateRecordEmployeeFilterOptions();
            renderAdminRecordsTable();
        }

        function onRecordNameChange() {
            resetFilterControls(['recordStatusFilter']);
            renderAdminRecordsTable();
        }

        function onRecordDataScopeChange() {
            initDropdowns();
            renderAdminRecordsTable();
        }

        function updateLiveEmpOptions() {
            const deptFilter = document.getElementById('liveDeptFilter').value;
            const jobTitleSelect = document.getElementById('liveJobTitleFilter');
            const empFilterSelect = document.getElementById('liveEmpFilter');
            if (!jobTitleSelect || !empFilterSelect) return;

            const currentJobTitle = jobTitleSelect.value || 'ALL';
            const currentVal = empFilterSelect.value || 'ALL';
            let filteredEmps = getAdminVisibleEmployees();
            if (deptFilter !== 'ALL') {
                filteredEmps = filteredEmps.filter(e => (e.dept || '一般') === deptFilter);
            }
            const jobTitles = [...new Set(filteredEmps.map(e => String(e.jobTitle || e.deptDetail || '未設定')).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'zh-Hant'));
            jobTitleSelect.innerHTML = '<option value="ALL">全部職務</option>' + jobTitles.map(value => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('');
            jobTitleSelect.value = jobTitles.includes(currentJobTitle) ? currentJobTitle : 'ALL';
            const jobTitleFilter = jobTitleSelect.value || 'ALL';
            if (jobTitleFilter !== 'ALL') {
                filteredEmps = filteredEmps.filter(e => String(e.jobTitle || e.deptDetail || '未設定') === jobTitleFilter);
            }
            filteredEmps = sortEmployeesById(filteredEmps);

            empFilterSelect.innerHTML = `<option value="ALL">全體員工</option>` +
                filteredEmps.map(e => `<option value="${e.empId}">${e.name} (${e.empId})</option>`).join('');
            empFilterSelect.value = filteredEmps.some(e => String(e.empId) === currentVal) ? currentVal : 'ALL';
        }

        function onLiveDeptChange() {
            resetFilterControls(['liveJobTitleFilter', 'liveEmpFilter', 'liveStatusFilter', 'liveLocationFilter']);
            updateLiveEmpOptions();
            renderAdminLiveTable();
        }

        function onLiveJobTitleChange() {
            resetFilterControls(['liveEmpFilter', 'liveStatusFilter', 'liveLocationFilter']);
            updateLiveEmpOptions();
            renderAdminLiveTable();
        }

        function onLiveEmployeeChange() {
            resetFilterControls(['liveStatusFilter', 'liveLocationFilter']);
            renderAdminLiveTable();
        }

        function onLiveStatusChange() {
            resetFilterControls(['liveLocationFilter']);
            renderAdminLiveTable();
        }

        function resetRecordFilters() {
            document.getElementById('recordDeptFilter').value = 'ALL';
            document.getElementById('recordJobTitleFilter').value = 'ALL';
            document.getElementById('recordNameFilter').value = 'ALL';
            document.getElementById('recordStatusFilter').value = 'ALL';
            const dateInput = document.getElementById('recordDateFilter');
            const dateEndInput = document.getElementById('recordDateEndFilter');
            if (dateInput) {dateInput.value='';dateInput.dataset.p79DateInitialized='1';}
            if (dateEndInput) {dateEndInput.value='';dateEndInput.dataset.p79DateInitialized='1';}
            updateRecordEmployeeFilterOptions();
            document.getElementById('filterMonthSelect').value = 'ALL';
            updateRecordDateRangeSummary();
            renderAttendanceMonthTabs(
                [...document.getElementById('filterMonthSelect').options].map(option => option.value),
                'ALL'
            );
            renderAdminRecordsTable();
        }

        function resetLiveFilters() {
            document.getElementById('liveDeptFilter').value = 'ALL';
            document.getElementById('liveJobTitleFilter').value = 'ALL';
            updateLiveEmpOptions();
            document.getElementById('liveEmpFilter').value = 'ALL';
            document.getElementById('liveStatusFilter').value = 'ALL';
            document.getElementById('liveLocationFilter').value = 'ALL';
            renderAdminLiveTable();
        }

        function getAttendanceDateKey(timeStr) {
            const s = String(timeStr || '').trim();
            if (!s) return '';
            const normalized = s.replace(/-/g, '/').replace('T', ' ');
            const m = normalized.match(/^(\d{3,4})\/(\d{1,2})\/(\d{1,2})/);
            if (!m) return normalized.split(' ')[0];
            let year = Number(m[1]);
            if (year < 1911) year += 1911;
            return `${year}/${String(m[2]).padStart(2,'0')}/${String(m[3]).padStart(2,'0')}`;
        }

        function getAttendanceTimestamp(record) {
            // PORT79 V3.5：同時支援西元年與民國年。
            // 例：115/10/04 07:31 必須視為 2026/10/04 07:31，
            // 否則人工補的 2026/10/04 下班會永遠配不到這筆上班。
            const raw = String(record && record.timeStr || '').trim();
            if (!raw) return 0;

            const normalized = normalizeImportedAttendanceTime(raw);
            const s = String(normalized || raw).replace('T', ' ').replace(/-/g, '/');
            const m = s.match(/^(\d{4})\/(\d{1,2})\/(\d{1,2})(?:\s+(\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/);

            if (m) {
                const year = Number(m[1]);
                const month = Number(m[2]) - 1;
                const day = Number(m[3]);
                const hour = Number(m[4] || 0);
                const minute = Number(m[5] || 0);
                const second = Number(m[6] || 0);
                const ts = new Date(year, month, day, hour, minute, second).getTime();
                return Number.isFinite(ts) ? ts : 0;
            }

            const fallback = Date.parse(s);
            return Number.isFinite(fallback) ? fallback : 0;
        }



        const p79AttendanceEmployeeLookupCache = new WeakMap();
        function getAttendanceEmployeeLookupIndex(sourceEmployees) {
            const list = Array.isArray(sourceEmployees) ? sourceEmployees : [];
            const now = Date.now();
            const cached = p79AttendanceEmployeeLookupCache.get(list);
            if (cached && cached.length === list.length && now - cached.at < 1000) return cached;

            const byAtt = new Map();
            const byName = new Map();
            const byId = new Map();
            const normName = value =>
                String(value || '').trim().replace(/\s+/g,'').replace(/\((AQC|ARMG|F\/L)\)\s*$/i,'');
            const normAtt = value => {
                const raw = String(value ?? '').trim();
                const cleaned = raw.replace(/^0+/,'');
                return cleaned || raw;
            };

            list.forEach(emp => {
                const att = normAtt(emp?.attNo);
                const name = normName(emp?.name);
                const id = String(emp?.empId || '').trim().toUpperCase();
                if (att) {
                    if (!byAtt.has(att)) byAtt.set(att, []);
                    byAtt.get(att).push(emp);
                }
                if (name) {
                    if (!byName.has(name)) byName.set(name, []);
                    byName.get(name).push(emp);
                }
                if (id && !byId.has(id)) byId.set(id, emp);
            });

            const result = { at: now, length: list.length, byAtt, byName, byId, normName, normAtt };
            p79AttendanceEmployeeLookupCache.set(list, result);
            return result;
        }

        function findEmployeeForAttendanceDisplay(item, sourceEmployees = employees) {
            const list = Array.isArray(sourceEmployees) ? sourceEmployees : [];
            const idx = getAttendanceEmployeeLookupIndex(list);
            const wantedEmpId = String(item?.empId || '').trim().toUpperCase();
            const wantedAttNo = idx.normAtt(item?.attNo);
            const wantedName = idx.normName(item?.name);

            // V5.11.2：員工主檔工號為第一身份鍵。
            if (wantedEmpId) {
                const byId = idx.byId.get(wantedEmpId) || null;
                if (byId) return byId;
            }

            if (wantedAttNo) {
                const byAtt = idx.byAtt.get(wantedAttNo) || [];
                if (byAtt.length === 1) return byAtt[0];
                if (byAtt.length > 1 && wantedName) {
                    const exact = byAtt.find(emp => idx.normName(emp?.name) === wantedName);
                    if (exact) return exact;
                }
            }

            if (wantedName) {
                const byName = idx.byName.get(wantedName) || [];
                if (byName.length === 1) return byName[0];
                if (byName.length > 1 && wantedAttNo) {
                    const exact = byName.find(emp => idx.normAtt(emp?.attNo) === wantedAttNo);
                    if (exact) return exact;
                }
            }
            return null;
        }

        let p79AttendanceMasterRefreshRequested = false;
        function ensureAttendanceDisplayMasterFresh() {
            if (p79AttendanceMasterRefreshRequested) return;
            p79AttendanceMasterRefreshRequested = true;

            // 管理員考勤表開啟後，背景強制抓一次完整員工主檔。
            // fresh=1 由 V5.10.2 GAS 支援，會跳過員工主檔 cache。
            setTimeout(async () => {
                try {
                    await preloadAttendanceEmployeeMaster(false, true);
                    try { initDropdowns(); } catch (e) {}
                    try { renderAdminRecordsTable(); } catch (e) {}
                    try { renderAdminLiveTable(); } catch (e) {}
                } catch (e) {
                    // 失敗時保留目前畫面，不阻塞考勤操作。
                }
            }, 0);
        }


        // V5.10.8：考勤姓名完整補全。
        // 人資員工主檔仍是第一優先；若歷史/當月考勤有此人但主檔暫時沒帶到，
        // 會用考勤號 → 工號 → 姓名建立「考勤備援人員」，供姓名篩選與管理員補卡使用。
        function normalizeAttendanceIdentityName(value) {
            const s = String(value || '').trim();
            if (!s || s === '--' || s === '-' || s === '未命名' || s === '無姓名') return '';
            return s.replace(/\s+/g, '').replace(/\((AQC|ARMG|F\/L)\)\s*$/i, '');
        }

        function normalizeAttendanceIdentityAttNo(value) {
            const raw = String(value ?? '').trim().replace(/\s+/g, '');
            if (!raw) return '';
            const cleaned = raw.replace(/^0+/, '');
            return cleaned || raw;
        }

        function attendanceEmployeeOptionValue(emp) {
            const empId = String(emp?.empId || '').trim();
            const attNo = normalizeAttendanceIdentityAttNo(emp?.attNo);
            // V5.10.10：考勤備援人員一律以考勤號當選項鍵，
            // 避免歷史資料中的舊/錯 empId 導致補卡補到別人。
            if (emp?._attendanceDerived && attNo) return `ATTNO:${attNo}`;
            if (empId) return empId;
            if (attNo) return `ATTNO:${attNo}`;
            const name = String(emp?.name || '').trim();
            return name ? `NAME:${name}` : '';
        }

        function attendanceEmployeeDisplayName(emp) {
            const name = String(emp?.name || '').trim();
            if (name) return name;
            const attNo = String(emp?.attNo ?? '').trim();
            const empId = String(emp?.empId || '').trim();
            return attNo ? `未命名（考勤號 ${attNo}）` : (empId ? `未命名（${empId}）` : '未命名');
        }

        function attendanceEmployeeDisplayLabel(emp) {
            const name = attendanceEmployeeDisplayName(emp);
            const empId = String(emp?.empId || '').trim();
            const attNo = String(emp?.attNo ?? '').trim();
            if (empId) return `${name} (${empId})`;
            if (attNo) return `${name}`;
            return name;
        }

        function mergeAttendanceIdentityFields(target, source) {
            if (!target || !source) return target;
            const fields = ['attNo','empId','name','dept','unit','deptUnit','orgUnit','jobTitle','deptDetail'];
            fields.forEach(field => {
                const current = String(target?.[field] ?? '').trim();
                const incoming = String(source?.[field] ?? '').trim();
                if (!current && incoming) target[field] = source[field];
            });
            if (!target.adminRole) target.adminRole = 'employee';
            return target;
        }

        let p79AttendanceIdentityPoolCache = null;
        function getAttendanceIdentityEmployeePool() {
            const now = Date.now();
            const recordList = Array.isArray(records) ? records : [];
            const employeeList = Array.isArray(employees) ? employees : [];
            if (p79AttendanceIdentityPoolCache &&
                p79AttendanceIdentityPoolCache.recordsRef === recordList &&
                p79AttendanceIdentityPoolCache.employeesRef === employeeList &&
                p79AttendanceIdentityPoolCache.recordLen === recordList.length &&
                p79AttendanceIdentityPoolCache.employeeLen === employeeList.length &&
                now - p79AttendanceIdentityPoolCache.at < 1000) {
                return p79AttendanceIdentityPoolCache.pool;
            }

            const master = (Array.isArray(employees) ? employees : []).map(emp => ({ ...emp, _attendanceDerived: false }));
            const pool = [...master];
            const byEmpId = new Map();
            const byAttNo = new Map();
            const derivedByKey = new Map();

            pool.forEach(emp => {
                const empId = String(emp?.empId || '').trim().toUpperCase();
                const attNo = normalizeAttendanceIdentityAttNo(emp?.attNo);
                if (empId && !byEmpId.has(empId)) byEmpId.set(empId, emp);
                if (attNo && !byAttNo.has(attNo)) byAttNo.set(attNo, emp);
            });

            (Array.isArray(records) ? records : []).forEach(record => {
                const attNo = normalizeAttendanceIdentityAttNo(record?.attNo);
                const empId = String(record?.empId || '').trim().toUpperCase();
                const name = String(record?.name || '').trim();

                // 考勤號是最可信的身份鍵；其次才是工號。
                let target = (attNo && byAttNo.get(attNo)) || (empId && byEmpId.get(empId)) || null;
                if (target) {
                    mergeAttendanceIdentityFields(target, record);
                    return;
                }

                const key = attNo ? `ATT:${attNo}` : (empId ? `EMP:${empId}` : (name ? `NAME:${normalizeAttendanceIdentityName(name)}` : ''));
                if (!key) return;

                target = derivedByKey.get(key);
                if (!target) {
                    target = {
                        attNo: record?.attNo ?? '',
                        empId: String(record?.empId || '').trim().toUpperCase(),
                        name: String(record?.name || '').trim(),
                        dept: String(record?.dept || '一般').trim() || '一般',
                        unit: String(record?.unit || record?.deptUnit || record?.orgUnit || '').trim(),
                        deptUnit: String(record?.unit || record?.deptUnit || record?.orgUnit || '').trim(),
                        orgUnit: String(record?.unit || record?.deptUnit || record?.orgUnit || '').trim(),
                        jobTitle: String(record?.jobTitle || record?.deptDetail || '').trim(),
                        deptDetail: String(record?.jobTitle || record?.deptDetail || '').trim(),
                        adminRole: 'employee',
                        _attendanceDerived: true
                    };
                    derivedByKey.set(key, target);
                    pool.push(target);
                    if (empId && !byEmpId.has(empId)) byEmpId.set(empId, target);
                    if (attNo && !byAttNo.has(attNo)) byAttNo.set(attNo, target);
                } else {
                    mergeAttendanceIdentityFields(target, record);
                }
            });

            // 第二輪：同考勤號 / 同工號的其他考勤若有姓名，補到先前建立的空白備援人員。
            (Array.isArray(records) ? records : []).forEach(record => {
                const attNo = normalizeAttendanceIdentityAttNo(record?.attNo);
                const empId = String(record?.empId || '').trim().toUpperCase();
                const target = (attNo && byAttNo.get(attNo)) || (empId && byEmpId.get(empId)) || null;
                if (target) mergeAttendanceIdentityFields(target, record);
            });

            p79AttendanceIdentityPoolCache = {
                at: now,
                recordsRef: recordList,
                employeesRef: employeeList,
                recordLen: recordList.length,
                employeeLen: employeeList.length,
                pool
            };
            return pool;
        }

        function getAdminAttendanceEmployees() {
            const pool = getAttendanceIdentityEmployeePool().filter(emp =>
                String(emp?.empId || '').trim().toUpperCase() !== 'ADMIN'
            );
            if (!isAdminLoggedIn || isCurrentViewerSuperAdmin()) return pool;
            return pool.filter(emp => emp?._attendanceDerived || canCurrentAdminViewEmployee(emp));
        }

        function findAttendanceEmployeeByOptionValue(value, source = null) {
            const key = String(value || '').trim();
            const list = Array.isArray(source) ? source : getAdminAttendanceEmployees();
            if (!key) return null;
            const exact = list.find(emp => attendanceEmployeeOptionValue(emp) === key);
            if (exact) return exact;
            const upper = key.toUpperCase();
            return list.find(emp => String(emp?.empId || '').trim().toUpperCase() === upper) || null;
        }

        function repairAttendanceNamesInMemory() {
            const list = Array.isArray(records) ? records : [];
            if (!list.length) return { changed: 0, named: 0, unresolved: 0 };
            const now = Date.now();
            const last = repairAttendanceNamesInMemory._cache;
            if (last &&
                last.recordsRef === list &&
                last.employeesRef === employees &&
                last.recordLen === list.length &&
                last.employeeLen === (Array.isArray(employees) ? employees.length : 0) &&
                now - last.at < 1000) {
                return last.result;
            }
            const pool = getAttendanceIdentityEmployeePool();
            const byAttNo = new Map();
            const byEmpId = new Map();
            const nameBuckets = new Map();

            pool.forEach(emp => {
                const attNo = normalizeAttendanceIdentityAttNo(emp?.attNo);
                const empId = String(emp?.empId || '').trim().toUpperCase();
                const name = normalizeAttendanceIdentityName(emp?.name);
                if (attNo && !byAttNo.has(attNo)) byAttNo.set(attNo, emp);
                if (empId && !byEmpId.has(empId)) byEmpId.set(empId, emp);
                if (name) {
                    if (!nameBuckets.has(name)) nameBuckets.set(name, []);
                    nameBuckets.get(name).push(emp);
                }
            });

            let changed = 0;
            let named = 0;
            let unresolved = 0;
            records = list.map(record => {
                const attNo = normalizeAttendanceIdentityAttNo(record?.attNo);
                const empId = String(record?.empId || '').trim().toUpperCase();
                const recordName = normalizeAttendanceIdentityName(record?.name);
                let match = (attNo && byAttNo.get(attNo)) || (empId && byEmpId.get(empId)) || null;
                if (!match && recordName) {
                    const candidates = nameBuckets.get(recordName) || [];
                    if (candidates.length === 1) match = candidates[0];
                }

                if (!match) {
                    if (!recordName) unresolved++;
                    return record;
                }

                const patch = {};
                const resolvedName = String(match?.name || '').trim();
                if (!recordName && resolvedName) patch.name = resolvedName;
                if (!String(record?.dept || '').trim() && String(match?.dept || '').trim()) patch.dept = match.dept;
                if (!String(record?.unit || record?.deptUnit || record?.orgUnit || '').trim()) {
                    const unit = String(match?.unit || match?.deptUnit || match?.orgUnit || '').trim();
                    if (unit) Object.assign(patch, { unit, deptUnit: unit, orgUnit: unit });
                }
                if (!String(record?.jobTitle || record?.deptDetail || '').trim()) {
                    const jobTitle = String(match?.jobTitle || match?.deptDetail || '').trim();
                    if (jobTitle) Object.assign(patch, { jobTitle, deptDetail: jobTitle });
                }
                if (!String(record?.empId || '').trim() && String(match?.empId || '').trim()) patch.empId = match.empId;
                if (!String(record?.attNo ?? '').trim() && String(match?.attNo ?? '').trim()) patch.attNo = match.attNo;

                if (Object.keys(patch).length) {
                    changed++;
                    if (patch.name) named++;
                    return { ...record, ...patch };
                }
                if (!recordName) unresolved++;
                return record;
            });

            if (changed) {
                try { localStorage.setItem('sp_records_v5', JSON.stringify(records)); } catch (e) {}
                p79AttendanceIdentityPoolCache = null;
            }
            const result = { changed, named, unresolved };
            repairAttendanceNamesInMemory._cache = {
                at: Date.now(),
                recordsRef: records,
                employeesRef: employees,
                recordLen: Array.isArray(records) ? records.length : 0,
                employeeLen: Array.isArray(employees) ? employees.length : 0,
                result
            };
            return result;
        }

        function findEmployeeForAttendanceIdentity(item, sourceEmployees = employees) {
            const list = Array.isArray(sourceEmployees) ? sourceEmployees : [];
            const idx = getAttendanceEmployeeLookupIndex(list);
            const wantedEmpId = String(item?.empId || '').trim().toUpperCase();
            const wantedAttNo = idx.normAtt(item?.attNo);
            const wantedName = idx.normName(item?.name);

            // V5.11.2：工號精確命中時直接使用主檔身份，不再被舊 attNo 衝突阻擋。
            if (wantedEmpId) {
                const byId = idx.byId.get(wantedEmpId) || null;
                if (byId) return byId;
            }

            if (wantedAttNo) {
                const byAtt = idx.byAtt.get(wantedAttNo) || [];
                if (byAtt.length === 1) return byAtt[0];
                if (byAtt.length > 1 && wantedName) {
                    const exact = byAtt.find(emp => idx.normName(emp?.name) === wantedName);
                    if (exact) return exact;
                }
            }

            if (wantedName) {
                const byName = idx.byName.get(wantedName) || [];
                if (byName.length === 1) return byName[0];
                if (byName.length > 1 && wantedAttNo) {
                    const exact = byName.find(emp => idx.normAtt(emp?.attNo) === wantedAttNo);
                    if (exact) return exact;
                }
            }

            return null;
        }

        function isManualAdminAttendanceRecord(record) {
            const source = String(record?.source || '').toLowerCase();
            const location = String(record?.location || '');
            const note = String(record?.note || '');
            return isManuallyEditedAttendanceRecord(record) ||
                source.includes('manual') ||
                location.includes('管理員手動') ||
                note.includes('管理員手動');
        }

        
        function getManualPairGroupKey(record) {
            const explicit = getManualPairGroupFromRecord(record);
            if (explicit) return explicit;
            const type = getAttendanceRecordType(record);
            const targetType = type === 'OUT' ? 'IN' : (type === 'IN' ? 'OUT' : '');
            if (!targetType) return '';
            const targetKey = type === 'OUT' ? getManualPairClockInKey(record) : getManualPairClockOutKey(record);
            const targetTime = type === 'OUT' ? getManualPairClockInTimeStr(record) : getManualPairClockOutTimeStr(record);
            const identity = getAttendanceImportIdentityKey(record);
            const nt = normalizeImportedAttendanceTime(targetTime);
            return targetKey ? `PAIRGRP:${targetType}:${targetKey}` :
                (identity && nt ? `PAIRGRP:${identity}:${targetType}:${nt}` : '');
        }

function getManualPairRecordAnchor(record) {
            const type = getAttendanceRecordType(record);
            if (type === 'OUT') return getManualPairTargetAnchor(record, 'OUT_TO_IN');
            if (type === 'IN') return getManualPairTargetAnchor(record, 'IN_TO_OUT');
            return '';
        }

        function preferCanonicalAttendanceRecord(candidate, current) {
            if (!current) return true;
            const candidateManual = isManualAdminAttendanceRecord(candidate);
            const currentManual = isManualAdminAttendanceRecord(current);
            if (candidateManual !== currentManual) return candidateManual;
            const aEdit = Date.parse(String(candidate?.manuallyEditedAt || '')) || 0;
            const bEdit = Date.parse(String(current?.manuallyEditedAt || '')) || 0;
            if (aEdit !== bEdit) return aEdit > bEdit;
            const aLink = Date.parse(String(candidate?.manualPairLinkedAt || '')) || 0;
            const bLink = Date.parse(String(current?.manualPairLinkedAt || '')) || 0;
            if (aLink !== bLink) return aLink > bLink;
            return getAttendanceTimestamp(candidate) > getAttendanceTimestamp(current);
        }

        function prepareAttendanceRecordsForPairing(sourceRecords) {
            let list = (Array.isArray(sourceRecords) ? sourceRecords : []).map(record => ({ ...record }));

            const dedupeByKey = keyFn => {
                const kept = new Map();
                list.forEach(record => {
                    const key = keyFn(record);
                    if (!key) return;
                    const current = kept.get(key);
                    if (!current || preferCanonicalAttendanceRecord(record, current)) kept.set(key, record);
                });
                if (!kept.size) return;
                const selected = new Set(kept.values());
                const keyedRecords = new Set(list.filter(record => !!keyFn(record)));
                list = list.filter(record => !keyedRecords.has(record) || selected.has(record));
            };

            // 同 ID / 同 sourceEventKey+類型 / 同人工配對目標，只在顯示層純去重，不寫回 records。
            // V5.10.35：雲端舊資料可能出現 IN / OUT 共用同一 record.id。
            // ID 只能在「同一打卡類型」內視為同筆更新；不同類型必須同時保留，
            // 否則下班簽退會在顯示配對前被上班紀錄吃掉。
            dedupeByKey(record => {
                const id = String(record?.id ?? '').trim();
                if (!id) return '';
                const type = getAttendanceRecordType(record);
                return `${id}|TYPE:${type}`;
            });
            dedupeByKey(record => {
                const key = stripManualPairSuffixFromEventKey(record?.sourceEventKey);
                const type = getAttendanceRecordType(record);
                return key && type !== 'OTHER' ? `${key}|TYPE:${type}` : '';
            });
            dedupeByKey(record => {
                const anchor = getManualPairRecordAnchor(record);
                const type = getAttendanceRecordType(record);
                return anchor ? `${anchor}|EVENT:${type}` : '';
            });
            dedupeByKey(record => {
                const type = getAttendanceRecordType(record);
                if (type === 'OTHER') return '';
                return `${getManualPairRepairIdentity(record)}|${type}|${normalizeImportedAttendanceTime(record?.timeStr)}`;
            });

            // V4.0：先依原始事件 lineage 收斂。人工修改時間後，舊原始版本不得再顯示成第二列。
            dedupeByKey(record => p79AttendanceLineageKey(record));

            // V3.2：清掉舊 IndexedDB/localStorage 已留下的跨來源完全相同事件。
            dedupeByKey(record => p79ExactAttendanceLogicalEventKey(record));

            // PORT79 2026-10-04 LOSSLESS-MANUAL：
            // 不再用「30 分鐘內」猜測人工補卡為重複事件。
            // 上方已處理同 ID / 同 sourceEventKey / 完全相同時間事件；其餘一律保留。

            // 若人工補卡保存了明確 target time，但 target 已被舊版誤刪，僅在顯示層補一個 deterministic target。
            const additions = [];
            list.slice().forEach(record => {
                const type = getAttendanceRecordType(record);
                const direction = type === 'OUT' ? 'OUT_TO_IN' : (type === 'IN' ? 'IN_TO_OUT' : '');
                if (!direction || !getManualPairRecordAnchor(record)) return;
                const targetId = direction === 'OUT_TO_IN' ? getManualPairClockInId(record) : getManualPairClockOutId(record);
                const targetKey = direction === 'OUT_TO_IN' ? getManualPairClockInKey(record) : getManualPairClockOutKey(record);
                const targetTime = direction === 'OUT_TO_IN' ? getManualPairClockInTimeStr(record) : getManualPairClockOutTimeStr(record);
                if (!normalizeImportedAttendanceTime(targetTime)) return;
                const targetType = direction === 'OUT_TO_IN' ? 'IN' : 'OUT';
                const exists = list.some(candidate => getAttendanceRecordType(candidate) === targetType && attendancePairRecordMatches(candidate,targetId,targetKey,targetTime));
                if (exists) return;
                const recovered = makeRecoveredManualPairRecord(record,targetType);
                if (recovered && !list.some(r => String(r?.id ?? '') === String(recovered.id)) && !additions.some(r => String(r?.id ?? '') === String(recovered.id))) {
                    recovered.viewRecoveredPair = true;
                    additions.push(recovered);
                }
            });
            return additions.length ? [...additions, ...list] : list;
        }

        function sanitizeImpossibleManualPairAnchorsForDisplay(sourceRecords) {
            const list = (Array.isArray(sourceRecords) ? sourceRecords : []).map(r => ({ ...r }));
            const byId = new Map(list.map(r => [String(r?.id ?? '').trim(), r]));
            const byStableKey = new Map();
            list.forEach(r => {
                const k = getAttendanceStablePairKey(r);
                if (k) byStableKey.set(k, r);
            });

            const clearOutTarget = r => {
                r.manualPairClockOutId = '';
                r.manualPairClockOutKey = '';
                r.manualPairClockOutTimeStr = '';
            };
            const clearInTarget = r => {
                r.manualPairClockInId = '';
                r.manualPairClockInKey = '';
                r.manualPairClockInTimeStr = '';
            };

            const resolveTarget = (id, key, timeStr, expectedType) => {
                let target = id ? byId.get(String(id).trim()) : null;
                if (!target && key) target = byStableKey.get(String(key).trim()) || null;
                if (!target && timeStr) {
                    const normalized = normalizeImportedAttendanceTime(timeStr);
                    target = list.find(x =>
                        getAttendanceRecordType(x) === expectedType &&
                        normalizeImportedAttendanceTime(x?.timeStr) === normalized
                    ) || null;
                }
                return target;
            };

            list.forEach(r => {
                const type = getAttendanceRecordType(r);
                const ownTs = getAttendanceTimestamp(r);
                if (!Number.isFinite(ownTs)) return;

                if (type === 'IN') {
                    const pairId = getManualPairClockOutId(r);
                    const pairKey = getManualPairClockOutKey(r);
                    const pairTime = getManualPairClockOutTimeStr(r);
                    if (!pairId && !pairKey && !pairTime) return;

                    const target = resolveTarget(pairId, pairKey, pairTime, 'OUT');
                    const targetTs = target
                        ? getAttendanceTimestamp(target)
                        : getAttendanceTimestamp({ timeStr: pairTime });

                    // 舊資料曾出現「早上的 OUT 指定給晚上的 IN」。
                    // OUT 早於 IN 是不可能班次，顯示層直接解除這個 reservation。
                    if (Number.isFinite(targetTs) && targetTs < ownTs) {
                        clearOutTarget(r);
                    }
                } else if (type === 'OUT') {
                    const pairId = getManualPairClockInId(r);
                    const pairKey = getManualPairClockInKey(r);
                    const pairTime = getManualPairClockInTimeStr(r);
                    if (!pairId && !pairKey && !pairTime) return;

                    const target = resolveTarget(pairId, pairKey, pairTime, 'IN');
                    const targetTs = target
                        ? getAttendanceTimestamp(target)
                        : getAttendanceTimestamp({ timeStr: pairTime });

                    // IN 晚於 OUT 也是不可能班次，讓一般 FIFO 重新配對。
                    if (Number.isFinite(targetTs) && targetTs > ownTs) {
                        clearInTarget(r);
                    }
                }
            });

            return list;
        }

        // V5.10.18：禁止把「先下班、後上班」硬湊成同一班。
        // 舊 10 分鐘反向配對會把真正 07:38 上班吃去配前一筆 07:xx 下班，
        // 造成後面的 11:44 下班變成「缺少簽到」。
        const REVERSED_NEAR_PAIR_WINDOW_MS = 0;

        function buildDailyAttendanceRows(sourceRecords) {
            // V5.1：先處理 V5 明確雙向 pair ID。
            // 這一層優先於舊 manualPair / dedupe / FIFO，確保「＋補卡」按下後立即顯示在同一列。
            const rawSourceRecords = Array.isArray(sourceRecords) ? sourceRecords : [];
            const v5ById = new Map(
                rawSourceRecords
                    .filter(r => r && r.id !== null && r.id !== undefined && String(r.id).trim() !== '')
                    .map(r => [String(r.id).trim(), r])
            );
            const v5ForcedPairSessions = [];
            const v5ForcedUsedIds = new Set();

            rawSourceRecords.forEach(record => {
                const id = String(record?.id ?? '').trim();
                const targetId = String(record?.v5PairTargetId ?? '').trim();
                if (!id || !targetId || v5ForcedUsedIds.has(id)) return;

                const target = v5ById.get(targetId);
                if (!target || v5ForcedUsedIds.has(targetId)) return;

                const type = getAttendanceRecordType(record);
                const targetType = getAttendanceRecordType(target);
                if (!((type === 'IN' && targetType === 'OUT') || (type === 'OUT' && targetType === 'IN'))) return;

                const clockIn = type === 'IN' ? record : target;
                const clockOut = type === 'OUT' ? record : target;
                const inTs = getAttendanceTimestamp(clockIn);
                const outTs = getAttendanceTimestamp(clockOut);

                if (!Number.isFinite(inTs) || !Number.isFinite(outTs)) return;
                if (outTs < inTs || outTs - inTs > 24 * 60 * 60 * 1000) return;

                v5ForcedUsedIds.add(String(clockIn.id ?? '').trim());
                v5ForcedUsedIds.add(String(clockOut.id ?? '').trim());
                v5ForcedPairSessions.push({
                    attNo: clockIn.attNo || clockOut.attNo,
                    empId: clockIn.empId || clockOut.empId,
                    name: clockIn.name || clockOut.name,
                    dept: clockIn.dept || clockOut.dept || '一般',
                    clockIn,
                    clockOut,
                    records: [clockIn, clockOut],
                    v5ForcedPair: true
                });
            });

            // 舊配對引擎只處理尚未被 V5 明確配對吃掉的紀錄。
            sourceRecords = rawSourceRecords.filter(
                r => !v5ForcedUsedIds.has(String(r?.id ?? '').trim())
            );

            // V5.10.16：配對前先用「考勤號」對目前員工主檔補正身份。
            // 舊考勤可能帶到過期 / 錯誤 empId；畫面雖然靠考勤號能顯示正確姓名，
            // 但舊配對引擎若再用錯誤 empId 分組，就會出現「雲端已有下班、畫面仍缺少簽退」。
            // 這裡只改顯示用 clone，不回寫原始 records。
            {
                const identityPool = getAttendanceIdentityEmployeePool();
                sourceRecords = sourceRecords.map(r => {
                    const master =
                        findEmployeeForAttendanceDisplay(r, identityPool) ||
                        findEmployeeForAttendanceIdentity(r, identityPool);
                    if (!master) return r;
                    return {
                        ...r,
                        attNo: master.attNo ?? r.attNo,
                        empId: master.empId || r.empId,
                        name: master.name || r.name,
                        dept: master.dept || r.dept || '一般'
                    };
                });
            }

            // 純顯示 canonicalization：不得在 render / getData 階段新增、刪除或寫回 records。
            sourceRecords = sanitizeImpossibleManualPairAnchorsForDisplay(sourceRecords);
            sourceRecords = prepareAttendanceRecordsForPairing(sourceRecords);

            // PORT79 2026-10-04 MANUAL-PAIR-IDENTITY-FIRST
            // 指定人工補卡必須先依 target ID / stable key / 原時間找到目標，
            // 再做員工分組。否則新舊工號/考勤號格式不同時，即使指定了配對也會被拆成兩組。
            // 此處只修改顯示用 clone，不改寫 records。
            {
                const list = Array.isArray(sourceRecords) ? sourceRecords : [];
                const byId = new Map();
                const byStable = new Map();
                list.forEach(r => {
                    const id = String(r?.id ?? '').trim();
                    const key = getAttendanceStablePairKey(r);
                    if (id) byId.set(id, r);
                    if (key) byStable.set(key, r);
                });

                const resolveTarget = (record, expectedType) => {
                    const isOut = getAttendanceRecordType(record) === 'OUT';
                    const id = isOut ? getManualPairClockInId(record) : getManualPairClockOutId(record);
                    const key = isOut ? getManualPairClockInKey(record) : getManualPairClockOutKey(record);
                    const time = isOut ? getManualPairClockInTimeStr(record) : getManualPairClockOutTimeStr(record);

                    let target = id ? byId.get(String(id).trim()) : null;
                    if (!target && key) target = byStable.get(String(key).trim()) || null;
                    if (!target && time) {
                        const nt = normalizeImportedAttendanceTime(time);
                        target = list.find(x =>
                            getAttendanceRecordType(x) === expectedType &&
                            normalizeImportedAttendanceTime(x?.timeStr) === nt
                        ) || null;
                    }
                    return target && getAttendanceRecordType(target) === expectedType ? target : null;
                };

                sourceRecords = list.map(r => {
                    const type = getAttendanceRecordType(r);
                    if (type !== 'IN' && type !== 'OUT') return r;
                    if (!isTargetedManualPairRecord(r)) return r;

                    const target = resolveTarget(r, type === 'OUT' ? 'IN' : 'OUT');
                    if (!target) return r;

                    // 指定補卡的身份一律沿用被指定的原紀錄，確保進入同一 employee bucket。
                    return {
                        ...r,
                        attNo: target.attNo ?? r.attNo,
                        empId: target.empId || r.empId,
                        name: target.name || r.name,
                        dept: target.dept || r.dept
                    };
                });
            }
            /*
             * 考勤班次配對最終規則
             * ------------------------------------------------
             * 一般資料：
             *   最早尚未結束的上班 -> 下一筆可用下班（FIFO）
             *
             * 管理員由異常列「＋」補卡：
             *   manualPairClockInId  = 這筆下班指定給哪一筆上班
             *   manualPairClockOutId = 這筆上班指定給哪一筆下班
             *
             * 指定配對是最高優先，不受：
             *   - 同時間重複事件去重
             *   - 60 分鐘重複刷卡整合
             *   - FIFO 自動配對
             * 影響。
             */

            // PORT79 2026-10-05 V3.6 FORCED-MANUAL-PAIR-FIRST
            // 從異常列「＋」新增的人工補卡，既然已經有明確 target ID / key / time，
            // 就先在全域直接組成同一班次，不再先按 empId/attNo 分組。
            // 這可避免舊資料工號格式、考勤號格式、民國/西元日期來源差異把同一人拆成兩列。
            const forcedPairSessions = [];
            const forcedUsedRecords = new Set();

            const resolveForcedPairTarget = (record, expectedType) => {
                if (!record) return null;
                const type = getAttendanceRecordType(record);
                const targetId = type === 'OUT'
                    ? getManualPairClockInId(record)
                    : getManualPairClockOutId(record);
                const targetKey = type === 'OUT'
                    ? getManualPairClockInKey(record)
                    : getManualPairClockOutKey(record);
                const targetTime = type === 'OUT'
                    ? getManualPairClockInTimeStr(record)
                    : getManualPairClockOutTimeStr(record);

                if (!targetId && !targetKey && !targetTime) return null;

                return (sourceRecords || []).find(candidate => {
                    if (candidate === record) return false;
                    if (getAttendanceRecordType(candidate) !== expectedType) return false;
                    return attendancePairRecordMatches(candidate, targetId, targetKey, targetTime);
                }) || null;
            };

            (sourceRecords || []).forEach(record => {
                if (forcedUsedRecords.has(record)) return;
                const type = getAttendanceRecordType(record);
                if (type !== 'IN' && type !== 'OUT') return;
                if (!isTargetedManualPairRecord(record)) return;

                const target = resolveForcedPairTarget(record, type === 'OUT' ? 'IN' : 'OUT');
                if (!target || forcedUsedRecords.has(target)) return;

                const clockIn = type === 'OUT' ? target : record;
                const clockOut = type === 'OUT' ? record : target;
                const inTs = getAttendanceTimestamp(clockIn);
                const outTs = getAttendanceTimestamp(clockOut);

                // 明確人工配對仍需符合基本時間合理性：下班不得早於上班、最長 24 小時。
                if (!Number.isFinite(inTs) || !Number.isFinite(outTs)) return;
                if (outTs < inTs || outTs - inTs > 24 * 60 * 60 * 1000) return;

                forcedUsedRecords.add(clockIn);
                forcedUsedRecords.add(clockOut);

                forcedPairSessions.push({
                    attNo: clockIn.attNo || clockOut.attNo,
                    empId: clockIn.empId || clockOut.empId,
                    name: clockIn.name || clockOut.name,
                    dept: clockIn.dept || clockOut.dept || '一般',
                    clockIn,
                    clockOut,
                    records: [clockIn, clockOut],
                    forcedManualPair: true
                });
            });

            const byEmployee = new Map();

            (sourceRecords || []).forEach(r => {
                if (forcedUsedRecords.has(r)) return;
                const rawAtt = String(r.attNo == null ? '' : r.attNo).trim();
                const attNum = Number(rawAtt);
                const attKey = rawAtt !== '' && Number.isFinite(attNum)
                    ? String(Math.trunc(attNum))
                    : rawAtt.replace(/\s+/g, '').toUpperCase();

                const empIdKey = String(r.empId == null ? '' : r.empId)
                    .replace(/\s+/g, '')
                    .toUpperCase();

                const nameKey = String(r.name == null ? '' : r.name)
                    .replace(/\s+/g, '');

                // V5.10.16：考勤配對以「考勤號」為第一識別。
                // 你的舊資料曾出現 empId 與員工主檔不同，但考勤號 / 姓名仍正確；
                // 若工號優先，像 287 黃明安的 15:36 與 23:53 會被拆成兩個 bucket。
                const employeeKey = attKey
                    ? `ATT:${attKey}`
                    : (nameKey ? `NAME:${nameKey}` : `EMP:${empIdKey}`);

                if (!byEmployee.has(employeeKey)) byEmployee.set(employeeKey, []);
                byEmployee.get(employeeKey).push(r);
            });

            const sessions = [...v5ForcedPairSessions, ...forcedPairSessions];
            const MAX_SHIFT_MS = 24 * 60 * 60 * 1000;
            // PORT79 2026-10-04 LOSSLESS-CLOUD-ATTENDANCE：
            // 不再用 60 分鐘猜測「重複刷卡」。
            // 雲端有一筆就保留一筆；真正完全相同事件已由 eventKey / ID 去重。
            const DUPLICATE_PUNCH_WINDOW_MS = 0;

            byEmployee.forEach(empRecords => {
                // 同時間時，先處理一般紀錄，再處理帶指定配對的人工紀錄。
                // 這樣 07:36 一般上班 + 07:36 指定補上班可以同時存在。
                empRecords.sort((a, b) => {
                    const timeDiff = getAttendanceTimestamp(a) - getAttendanceTimestamp(b);
                    if (timeDiff) return timeDiff;
                    return Number(isTargetedManualPairRecord(a)) - Number(isTargetedManualPairRecord(b));
                });

                const openSessions = [];
                const orphanOutSessions = [];
                let lastCompletedSession = null;

                const flushExpiredOpenSessions = (outTs) => {
                    const keep = [];
                    openSessions.forEach(session => {
                        const inTs = getAttendanceTimestamp(session.clockIn);
                        if (outTs - inTs > MAX_SHIFT_MS) {
                            sessions.push(session);
                        } else {
                            keep.push(session);
                        }
                    });
                    openSessions.splice(0, openSessions.length, ...keep);
                };

                const completeSession = (openIndex, outRecord) => {
                    const target = openSessions.splice(openIndex, 1)[0];
                    target.clockOut = outRecord;
                    target.records.push(outRecord);
                    sessions.push(target);
                    lastCompletedSession = target;
                    return target;
                };

                empRecords.forEach(r => {
                    const type = getAttendanceRecordType(r);

                    if (type === 'IN') {
                        const targetOutId = getManualPairClockOutId(r);
                        const targetOutKey = getManualPairClockOutKey(r);
                        const targetOutTimeStr = getManualPairClockOutTimeStr(r);

                        // 人工指定配對不能只靠 ID。
                        // 修改/去重後原紀錄 ID 可能改變，因此再用 sourceEventKey / 原時間作穩定錨點。
                        if (targetOutId || targetOutKey || targetOutTimeStr) {
                            const orphanIndex = orphanOutSessions.findIndex(s =>
                                attendancePairRecordMatches(
                                    s.clockOut,
                                    targetOutId,
                                    targetOutKey,
                                    targetOutTimeStr
                                )
                            );
                            if (orphanIndex >= 0) {
                                const target = orphanOutSessions.splice(orphanIndex, 1)[0];
                                target.clockIn = r;
                                target.records.unshift(r);
                                sessions.push(target);
                                lastCompletedSession = target;
                                return;
                            }
                        }

                        // V5.10.18：不再允許 OUT 早於 IN 的反向配對。
                        // 先出現的孤立下班會保留為孤立下班；後來真正的上班必須留給之後的下班。
                        const lastOpen = openSessions.length
                            ? openSessions[openSessions.length - 1]
                            : null;

                        // 只有「兩邊都不是指定補卡」才允許 60 分鐘內視為重複上班。
                        if (!targetOutId &&
                            lastOpen?.clockIn &&
                            !getManualPairClockOutId(lastOpen.clockIn) &&
                            !getManualPairClockInId(lastOpen.clockIn)) {

                            const gap = getAttendanceTimestamp(r) - getAttendanceTimestamp(lastOpen.clockIn);
                            const sameDate =
                                getAttendanceDateKey(lastOpen.clockIn.timeStr) ===
                                getAttendanceDateKey(r.timeStr);

                            if (sameDate && gap === 0 &&
                                getAttendanceImportEventKey(r) === getAttendanceImportEventKey(lastOpen.clockIn)) {
                                if (shouldPreferAttendanceRecord(r, lastOpen.clockIn, 'IN')) {
                                    lastOpen.clockIn = r;
                                }
                                lastOpen.records.push(r);
                                return;
                            }
                        }

                        openSessions.push({
                            attNo: r.attNo,
                            empId: r.empId,
                            name: r.name,
                            dept: r.dept || '一般',
                            clockIn: r,
                            clockOut: null,
                            records: [r]
                        });
                        return;
                    }

                    if (type === 'OUT') {
                        const outTs = getAttendanceTimestamp(r);
                        const targetInId = getManualPairClockInId(r);
                        const targetInKey = getManualPairClockInKey(r);
                        const targetInTimeStr = getManualPairClockInTimeStr(r);
                        const outId = String(r.id ?? '').trim();
                        const outStableKey = getAttendanceStablePairKey(r);

                        flushExpiredOpenSessions(outTs);

                        let targetIndex = -1;

                        // 優先 1：指定下班先依 ID 配對，再依 stable key / 原始時間配對。
                        // 這可以修復「補卡成功但原上班紀錄後續被去重換 ID」造成的 --。
                        if (targetInId || targetInKey || targetInTimeStr) {
                            targetIndex = openSessions.findIndex(s =>
                                attendancePairRecordMatches(
                                    s.clockIn,
                                    targetInId,
                                    targetInKey,
                                    targetInTimeStr
                                )
                            );
                        }

                        // 優先 2：上班那一側指定這筆下班；同樣支援 ID / stable key。
                        if (targetIndex < 0 && (outId || outStableKey)) {
                            targetIndex = openSessions.findIndex(s => {
                                const pairOutId = getManualPairClockOutId(s.clockIn);
                                const pairOutKey = getManualPairClockOutKey(s.clockIn);
                                const pairOutTime = getManualPairClockOutTimeStr(s.clockIn);
                                return attendancePairRecordMatches(r, pairOutId, pairOutKey, pairOutTime);
                            });
                        }

                        // 優先 3：舊版人工補卡只有 target ID，且該 ID 已被人工修改/去重換掉。
                        // 只對「明確曾指定配對」的人工紀錄啟用安全補救：
                        // 在同一天、同員工、下班時間之前年份最近的未結束上班班次中配對。
                        if (targetIndex < 0 &&
                            (targetInId || targetInKey || targetInTimeStr) &&
                            (String(r.source || '').toLowerCase().includes('manual') || isManuallyEditedAttendanceRecord(r))) {

                            let bestIndex = -1;
                            let bestInTs = -1;

                            openSessions.forEach((session, index) => {
                                if (!session.clockIn) return;
                                if (getManualPairClockOutId(session.clockIn) &&
                                    !attendancePairRecordMatches(
                                        r,
                                        getManualPairClockOutId(session.clockIn),
                                        getManualPairClockOutKey(session.clockIn),
                                        getManualPairClockOutTimeStr(session.clockIn)
                                    )) return;

                                const inTs = getAttendanceTimestamp(session.clockIn);
                                const diff = outTs - inTs;
                                if (diff < 0 || diff > MAX_SHIFT_MS) return;

                                const sameDate =
                                    getAttendanceDateKey(session.clockIn.timeStr) ===
                                    getAttendanceDateKey(r.timeStr);

                                // 同日優先；若跨午夜才允許 24 小時內 fallback。
                                const score = sameDate ? inTs + 1000000000000000 : inTs;
                                if (score > bestInTs) {
                                    bestInTs = score;
                                    bestIndex = index;
                                }
                            });

                            targetIndex = bestIndex;
                        }

                        if (targetIndex >= 0) {
                            completeSession(targetIndex, r);
                            return;
                        }

                        // 非指定下班才做重複簽退判定。
                        if (!targetInId && lastCompletedSession?.clockOut) {
                            const previousOutTs = getAttendanceTimestamp(lastCompletedSession.clockOut);
                            const outGap = outTs - previousOutTs;
                            const sameOutDate =
                                getAttendanceDateKey(lastCompletedSession.clockOut.timeStr) ===
                                getAttendanceDateKey(r.timeStr);

                            if (sameOutDate && outGap === 0 &&
                                getAttendanceImportEventKey(r) === getAttendanceImportEventKey(lastCompletedSession.clockOut)) {
                                // 仍有可配的一般未結束班次時，不把這筆吃成重複簽退。
                                const eligibleOpen = openSessions.find(s => {
                                    // 有指定未來下班的 reserved session 不可被一般 OUT 搶走。
                                    if (getManualPairClockOutId(s.clockIn)) return false;
                                    const inTs = getAttendanceTimestamp(s.clockIn);
                                    const diff = outTs - inTs;
                                    return diff >= 0 && diff <= MAX_SHIFT_MS;
                                });

                                if (!eligibleOpen) {
                                    if (shouldPreferAttendanceRecord(r, lastCompletedSession.clockOut, 'OUT')) {
                                        lastCompletedSession.clockOut = r;
                                    }
                                    lastCompletedSession.records.push(r);
                                    return;
                                }
                            }
                        }

                        // V5.10.18：一般下班不再用 FIFO 抓「最舊未結束上班」。
                        // 改抓「時間上最近、且確實早於這筆下班」的上班；同一天優先。
                        {
                            let bestIndex = -1;
                            let bestTs = -1;
                            let bestSameDate = false;
                            const outDate = getAttendanceDateKey(r.timeStr);

                            openSessions.forEach((session, index) => {
                                const inRec = session?.clockIn;
                                if (!inRec) return;

                                if (getManualPairClockOutId(inRec) ||
                                    getManualPairClockOutKey(inRec) ||
                                    getManualPairClockOutTimeStr(inRec)) return;

                                const inTs = getAttendanceTimestamp(inRec);
                                const diff = outTs - inTs;
                                if (!Number.isFinite(inTs) || diff < 0 || diff > MAX_SHIFT_MS) return;

                                const sameDate = getAttendanceDateKey(inRec.timeStr) === outDate;

                                if (bestIndex < 0 ||
                                    (sameDate && !bestSameDate) ||
                                    (sameDate === bestSameDate && inTs > bestTs)) {
                                    bestIndex = index;
                                    bestTs = inTs;
                                    bestSameDate = sameDate;
                                }
                            });

                            targetIndex = bestIndex;
                        }

                        if (targetIndex >= 0) {
                            completeSession(targetIndex, r);
                            return;
                        }

                        // 無法配對：保留成孤立下班，不直接丟掉。
                        const lastOrphan = orphanOutSessions.length
                            ? orphanOutSessions[orphanOutSessions.length - 1]
                            : null;

                        const canMergeOrphan =
                            !targetInId &&
                            lastOrphan?.clockOut &&
                            !isTargetedManualPairRecord(lastOrphan.clockOut) &&
                            getAttendanceDateKey(lastOrphan.clockOut.timeStr) === getAttendanceDateKey(r.timeStr) &&
                            outTs === getAttendanceTimestamp(lastOrphan.clockOut) &&
                            getAttendanceImportEventKey(r) === getAttendanceImportEventKey(lastOrphan.clockOut);

                        if (canMergeOrphan) {
                            if (shouldPreferAttendanceRecord(r, lastOrphan.clockOut, 'OUT')) {
                                lastOrphan.clockOut = r;
                            }
                            lastOrphan.records.push(r);
                        } else {
                            orphanOutSessions.push({
                                attNo: r.attNo,
                                empId: r.empId,
                                name: r.name,
                                dept: r.dept || '一般',
                                clockIn: null,
                                clockOut: r,
                                records: [r]
                            });
                        }
                        return;
                    }

                    // 舊資料 / 無法辨識狀態也保留。
                    sessions.push({
                        attNo: r.attNo,
                        empId: r.empId,
                        name: r.name,
                        dept: r.dept || '一般',
                        clockIn: null,
                        clockOut: null,
                        records: [r]
                    });
                });

                openSessions.forEach(s => sessions.push(s));
                orphanOutSessions.forEach(s => sessions.push(s));
            });

            // V5.10.18 最後安全網：同身份若仍有孤立 IN + OUT，
            // 只允許 IN < OUT，並優先同日、最近的一筆 IN。
            {
                const identity = s => String(s?.attNo || s?.empId || s?.name || '')
                    .replace(/\s+/g,'').toUpperCase();
                const consumed = new Set();

                const orphanIns = sessions
                    .map((s,i)=>({s,i}))
                    .filter(x=>x.s?.clockIn && !x.s?.clockOut);
                const orphanOuts = sessions
                    .map((s,i)=>({s,i}))
                    .filter(x=>!x.s?.clockIn && x.s?.clockOut);

                orphanOuts.forEach(outItem => {
                    if (consumed.has(outItem.i)) return;
                    const outRec = outItem.s.clockOut;
                    const outTs = getAttendanceTimestamp(outRec);
                    const outDate = getAttendanceDateKey(outRec?.timeStr);
                    const outIdentity = identity(outItem.s);
                    if (!Number.isFinite(outTs) || !outIdentity) return;

                    let best = null;
                    orphanIns.forEach(inItem => {
                        if (consumed.has(inItem.i)) return;
                        if (identity(inItem.s) !== outIdentity) return;

                        const inRec = inItem.s.clockIn;
                        const inTs = getAttendanceTimestamp(inRec);
                        if (!Number.isFinite(inTs)) return;

                        const diff = outTs - inTs;
                        if (diff < 0 || diff > MAX_SHIFT_MS) return;

                        const sameDate = getAttendanceDateKey(inRec?.timeStr) === outDate;
                        if (!best ||
                            (sameDate && !best.sameDate) ||
                            (sameDate === best.sameDate && inTs > best.inTs)) {
                            best = { inItem, inTs, sameDate };
                        }
                    });

                    if (!best) return;

                    best.inItem.s.clockOut = outRec;
                    best.inItem.s.records = [
                        ...(best.inItem.s.records || []),
                        ...(outItem.s.records || [outRec])
                    ];
                    consumed.add(best.inItem.i);
                    consumed.add(outItem.i);
                });

                if (consumed.size) {
                    const rebuilt = [];
                    sessions.forEach((session, index) => {
                        if (!consumed.has(index)) {
                            rebuilt.push(session);
                            return;
                        }
                        if (session?.clockIn && session?.clockOut) rebuilt.push(session);
                    });
                    sessions.splice(0, sessions.length, ...rebuilt);
                }
            }

            const mappedSessions = sessions.map((g, index) => {
                let attendanceStatus = '未打卡';
                if (g.clockIn && g.clockOut) attendanceStatus = '正常';
                else if (!g.clockIn && g.clockOut) attendanceStatus = '缺少簽到';
                else if (g.clockIn && !g.clockOut) attendanceStatus = '缺少簽退';

                const notes = [...new Set(
                    g.records.map(r => String(r.note || '').trim()).filter(Boolean)
                )];

                const latestLocationRecord = g.records
                    .filter(r => String(r.location || '').trim())
                    .reduce((latest, r) =>
                        !latest || getAttendanceTimestamp(r) >= getAttendanceTimestamp(latest) ? r : latest
                    , null);

                const baseTime =
                    g.clockIn?.timeStr ||
                    g.clockOut?.timeStr ||
                    g.records[0]?.timeStr ||
                    '';

                const currentEmployee = findEmployeeForAttendanceIdentity(g, getAttendanceIdentityEmployeePool());

                return {
                    ...g,
                    attNo: currentEmployee?.attNo ?? g.attNo,
                    empId: currentEmployee?.empId || g.empId,
                    name: stripAttendanceNameTrailingMeta(currentEmployee?.name || g.name),
                    dept: currentEmployee?.dept || g.dept || '一般',
                    unit:
                        currentEmployee?.unit ||
                        currentEmployee?.deptUnit ||
                        currentEmployee?.orgUnit ||
                        g.unit ||
                        g.deptUnit ||
                        g.orgUnit ||
                        g.records?.find(r => String(r?.unit || r?.deptUnit || r?.orgUnit || '').trim())?.unit ||
                        g.records?.find(r => String(r?.deptUnit || '').trim())?.deptUnit ||
                        g.records?.find(r => String(r?.orgUnit || '').trim())?.orgUnit ||
                        '',
                    jobTitle:
                        currentEmployee?.jobTitle ||
                        currentEmployee?.deptDetail ||
                        g.jobTitle ||
                        g.deptDetail ||
                        g.records?.find(r => String(r?.jobTitle || r?.deptDetail || '').trim())?.jobTitle ||
                        g.records?.find(r => String(r?.deptDetail || '').trim())?.deptDetail ||
                        '',
                    key: `${String(g.attNo || g.empId || g.name)}__${baseTime}__${index}`,
                    dateKey: getAttendanceDateKey(baseTime),
                    // v2026.10.03.16.60：完整跨日班次以上班簽到日歸屬。
                    accountingDateKey: getAttendanceDateKey(
                        g.clockIn?.timeStr || baseTime || g.clockOut?.timeStr
                    ),
                    accountingMonthKey: (() => {
                        const source = g.clockIn?.timeStr || baseTime || g.clockOut?.timeStr;
                        const m = String(source || '').match(/^(\d{4})[\/-](\d{1,2})/);
                        return m ? `${m[1]}-${String(m[2]).padStart(2,'0')}` : '';
                    })(),
                    attendanceStatus,
                    noteText: notes.join(' / '),
                    locationText: latestLocationRecord
                        ? formatAttendanceLocationDisplay(latestLocationRecord.location)
                        : '',
                    sortTime: g.clockIn
                        ? getAttendanceTimestamp(g.clockIn)
                        : (g.clockOut
                            ? getAttendanceTimestamp(g.clockOut)
                            : Math.max(...g.records.map(getAttendanceTimestamp), 0))
                };
            });

            // V4.1 顯示層最後收斂舊人工修正版。
            const clusterWindow = 10 * 60 * 1000;
            const canonical = [];
            const identityOf = row => String(row?.attNo || row?.empId || row?.name || '').replace(/\s+/g,'').toUpperCase();
            const manualLike = row => (row?.records || []).some(r => isManualAdminAttendanceRecord(r) || r?.viewRecoveredPair);
            const rowTs = (row, side) => getAttendanceTimestamp(side === 'IN' ? row?.clockIn : row?.clockOut);
            const rowDate = row => getAttendanceDateKey(row?.clockIn?.timeStr || row?.clockOut?.timeStr || '');
            const rowScore = row => {
                const complete = row?.clockIn && row?.clockOut ? 1 : 0;
                const latestEdit = Math.max(...(row?.records || []).map(r =>
                    Date.parse(String(r?.manuallyEditedAt || r?.manualPairLinkedAt || '')) || Number(r?.id || 0) || 0
                ), 0);
                return complete * 1e16 + latestEdit;
            };

            mappedSessions.forEach(row => {
                if (!manualLike(row)) { canonical.push(row); return; }
                let hit = -1;
                for (let i=canonical.length-1;i>=0;i--) {
                    const other=canonical[i];
                    if (identityOf(other)!==identityOf(row)) continue;
                    if (rowDate(other)!==rowDate(row)) continue;
                    if (!manualLike(other)) continue;
                    const inA=rowTs(row,'IN'), inB=rowTs(other,'IN');
                    const outA=rowTs(row,'OUT'), outB=rowTs(other,'OUT');
                    const nearIn=inA&&inB&&Math.abs(inA-inB)<=clusterWindow;
                    const nearOut=outA&&outB&&Math.abs(outA-outB)<=clusterWindow;
                    if (nearIn||nearOut){hit=i;break;}
                }
                if(hit<0) canonical.push(row);
                else if(rowScore(row)>=rowScore(canonical[hit])) canonical[hit]=row;
            });

            // V5.11.1：完整班次已存在時，移除同一人同一精確時間的單邊孤立重複列。
            // 典型案例：同一個 16:00 OUT 同時存在於「07:35→16:00 完整班次」與「--→16:00 孤立下班」。
            // 只影響畫面 rows，不修改 records / 雲端資料。
            const identityKey = row => String(row?.empId || row?.attNo || row?.name || '')
                .replace(/\s+/g,'').toUpperCase();
            const sideTs = (row, side) => {
                const rec = side === 'IN' ? row?.clockIn : row?.clockOut;
                const ts = rec ? getAttendanceTimestamp(rec) : 0;
                return Number.isFinite(ts) ? ts : 0;
            };
            const rowCompleteness = row => (row?.clockIn ? 1 : 0) + (row?.clockOut ? 1 : 0);

            const finalRows = canonical.filter((row, index, all) => {
                const id = identityKey(row);
                if (!id) return true;

                const inTs = sideTs(row,'IN');
                const outTs = sideTs(row,'OUT');
                const completeness = rowCompleteness(row);

                // 完整班次永遠保留；相同完整班次只保留分數較高/較早出現的一列。
                if (completeness === 2) {
                    const duplicateComplete = all.findIndex((other, j) => {
                        if (j >= index || identityKey(other) !== id || rowCompleteness(other) !== 2) return false;
                        return sideTs(other,'IN') === inTs && sideTs(other,'OUT') === outTs;
                    });
                    return duplicateComplete < 0;
                }

                // 單邊列如果已被任何完整班次包含，就不再額外顯示。
                if (completeness === 1) {
                    const containedByComplete = all.some((other, j) => {
                        if (j === index || identityKey(other) !== id || rowCompleteness(other) !== 2) return false;
                        if (inTs) return sideTs(other,'IN') === inTs;
                        if (outTs) return sideTs(other,'OUT') === outTs;
                        return false;
                    });
                    if (containedByComplete) return false;

                    // 同一單邊事件重複多次，只保留第一列。
                    const duplicateSingle = all.findIndex((other, j) => {
                        if (j >= index || identityKey(other) !== id || rowCompleteness(other) !== 1) return false;
                        if (inTs) return sideTs(other,'IN') === inTs;
                        if (outTs) return sideTs(other,'OUT') === outTs;
                        return false;
                    });
                    return duplicateSingle < 0;
                }

                return true;
            });

            return finalRows;
        }

        function getAttendanceRecordType(record) {
            const status = String(record?.status || '').trim();
            const isClockIn = status.includes('上班簽到') || status === '簽到' || (status.includes('上班') && !status.includes('未'));
            const isClockOut = status.includes('下班簽退') || status === '簽退' || (status.includes('下班') && !status.includes('未'));
            if (isClockIn && !isClockOut) return 'IN';
            if (isClockOut && !isClockIn) return 'OUT';
            return 'OTHER';
        }

        function isManuallyEditedAttendanceRecord(record) {
            return record?.manuallyEdited === true || String(record?.manuallyEdited || '').toLowerCase() === 'true';
        }

        function shouldPreferAttendanceRecord(candidate, current, type = '') {
            if (!candidate) return false;
            if (!current) return true;
            // 人工修改會保留原始事件鍵。若其中一筆明確取代另一筆原始事件，
            // 永遠採用人工修正值，不再按簽到早／簽退晚的規則選回 Excel 舊時間。
            const candidateSourceKey = String(candidate.sourceEventKey || '').trim();
            const currentSourceKey = String(current.sourceEventKey || '').trim();
            const candidateEventKey = getAttendanceImportEventKey(candidate);
            const currentEventKey = getAttendanceImportEventKey(current);
            const candidateOverridesCurrent = !!candidateSourceKey && candidateSourceKey !== candidateEventKey && candidateSourceKey === currentEventKey;
            const currentOverridesCandidate = !!currentSourceKey && currentSourceKey !== currentEventKey && currentSourceKey === candidateEventKey;
            if (candidateOverridesCurrent !== currentOverridesCandidate) return candidateOverridesCurrent;
            const candidateManual = isManuallyEditedAttendanceRecord(candidate);
            const currentManual = isManuallyEditedAttendanceRecord(current);
            if (candidateManual !== currentManual) return candidateManual;
            if (candidateManual && currentManual) {
                const candidateEditedAt = Date.parse(candidate.manuallyEditedAt || '') || 0;
                const currentEditedAt = Date.parse(current.manuallyEditedAt || '') || 0;
                if (candidateEditedAt !== currentEditedAt) return candidateEditedAt > currentEditedAt;
            }
            const candidateTime = getAttendanceTimestamp(candidate);
            const currentTime = getAttendanceTimestamp(current);
            if (type === 'IN') return candidateTime < currentTime;
            if (type === 'OUT') return candidateTime > currentTime;
            return false;
        }

        function getAttendanceMinute(record) {
            const raw = String(record?.timeStr || '').replace('T', ' ').trim();
            const match = raw.match(/\s(\d{1,2}):(\d{2})(?::\d{2})?$/);
            return match ? Number(match[2]) : null;
        }

        function formatAttendanceTimeCell(record, type) {
            if (!record) return '--';
            const text = escapeHtml(formatDateTime(record.timeStr));
            // 管理員已手動修正的時間視為完成確認，不再顯示黃／紫色異常提醒。
            if (isManuallyEditedAttendanceRecord(record)) {
                return `<span class="text-slate-700 dark:text-white font-semibold">${text}</span>`;
            }
            const minute = getAttendanceMinute(record);
            if (type === 'IN' && minute !== null && minute >= 1 && minute <= 30) {
                return `<span class="inline-flex px-2 py-1 rounded-lg bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 font-bold" title="上班簽到分鐘介於 01–30">${text}</span>`;
            }
            // 分鐘 45–59，以及下一小時的 00 分，均視為 45–60 的正常範圍。
            if (type === 'OUT' && minute !== null && minute !== 0 && minute < 45) {
                return `<span class="inline-flex px-2 py-1 rounded-lg bg-violet-100 text-violet-800 dark:bg-violet-950 dark:text-violet-300 font-bold" title="下班簽退分鐘未介於 45–60">${text}</span>`;
            }
            return text;
        }

        function formatEditableAttendanceTimeCell(record, type, canEdit) {
            const display = formatAttendanceTimeCell(record, type);
            if (!record || record.id === null || record.id === undefined || String(record.id) === '') return display;

            const id = String(record.id);
            const queueInfo = typeof window.p79V5QueueInfoForId === 'function'
                ? window.p79V5QueueInfoForId(id)
                : null;
            const pending = !!queueInfo || hasPendingAttendanceWriteForId(id);
            const recentState = getRecentAttendanceMutationState(id);
            const recent = !!recentState;
            const cloudConfirmed = !!Number(recentState?.cloudConfirmedAt || 0);
            const edited = isManuallyEditedAttendanceRecord(record) || isManualAdminAttendanceRecord(record);

            const queueProgress = queueInfo
                ? `${Math.max(1, Number(queueInfo.index||1))}/${Math.max(1, Number(queueInfo.total||1))}`
                : '';
            const queueTitle = queueInfo
                ? `${queueInfo.description || '考勤資料'}${queueInfo.lastError ? `｜最近錯誤：${queueInfo.lastError}` : ''}`
                : '已套用到畫面，等待雲端完成';

            const syncBadge = pending
                ? (queueInfo?.state === 'syncing'
                    ? `<span class="ml-1 inline-flex items-center rounded-full bg-indigo-100 px-1.5 py-0.5 text-[9px] font-black text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300" title="${escapeHtml(queueTitle)}">⏳ 同步中 ${queueProgress}</span>`
                    : `<span class="ml-1 inline-flex items-center rounded-full bg-amber-100 px-1.5 py-0.5 text-[9px] font-black text-amber-700 dark:bg-amber-950 dark:text-amber-300" title="${escapeHtml(queueTitle)}">🟡 待同步${queueProgress ? ` ${queueProgress}` : ''}</span>`)
                : (cloudConfirmed
                    ? `<span class="ml-1 inline-flex items-center rounded-full bg-emerald-100 px-1.5 py-0.5 text-[9px] font-black text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" title="雲端已確認寫入">🟢 已同步</span>`
                    : (recent
                        ? `<span class="ml-1 inline-flex items-center rounded-full bg-sky-100 px-1.5 py-0.5 text-[9px] font-black text-sky-700 dark:bg-sky-950 dark:text-sky-300" title="本機已修改，正在等待雲端確認">🔵 已修改</span>`
                        : (edited
                            ? `<span class="ml-1 inline-flex items-center rounded-full bg-emerald-100 px-1.5 py-0.5 text-[9px] font-black text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" title="人工修改已在目前資料中">🟢 已同步</span>`
                            : '')));

            if (!canEdit) return `<span class="inline-flex items-center">${display}${syncBadge}</span>`;

            const encodedId = encodeURIComponent(id);
            const encodedTime = encodeURIComponent(String(record.timeStr || ''));
            const label = type === 'IN' ? '上班簽到' : '下班簽退';
            return `<span class="inline-flex items-center">
                <button type="button" onclick="openAttendanceTimeEditor('${encodedId}', '${type}', '${encodedTime}')" class="group inline-flex items-center gap-1.5 rounded-lg hover:ring-2 hover:ring-indigo-400/50 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" title="點選修改${label}時間" aria-label="點選修改${label}時間">
                    ${display}<span class="text-[10px] text-indigo-500 dark:text-indigo-300 opacity-70 group-hover:opacity-100">✎</span>
                </button>${syncBadge}
            </span>`;
        }


        function getManualPairRepairIdentity(record) {
            const empId = String(record?.empId || '').trim().toUpperCase();
            const attNo = normalizeAttendanceNumber(record?.attNo, empId);
            const name = String(record?.name || '').replace(/\s+/g, '').trim();
            return String(attNo || '').trim()
                ? `ATT:${attNo}`
                : (empId ? `EMP:${empId}` : `NAME:${name}`);
        }

        function getManualPairTargetAnchor(record, direction) {
            const isOutToIn = direction === 'OUT_TO_IN';
            const targetId = isOutToIn ? getManualPairClockInId(record) : getManualPairClockOutId(record);
            const targetKey = isOutToIn ? getManualPairClockInKey(record) : getManualPairClockOutKey(record);
            const targetTime = isOutToIn ? getManualPairClockInTimeStr(record) : getManualPairClockOutTimeStr(record);
            const normalizedTime = normalizeImportedAttendanceTime(targetTime);
            // targetKey 在舊版可能已被 PAIR suffix 污染；原始 target time 才是最穩定的配對錨點。
            const cleanTargetKey = stripManualPairSuffixFromEventKey(targetKey);
            const anchor = normalizedTime || cleanTargetKey || String(targetId || '').trim();
            if (!anchor) return '';
            return `${getManualPairRepairIdentity(record)}|${direction}|${anchor}`;
        }

        function compareManualPairRepairRecords(a, b) {
            const aEdit = Date.parse(String(a?.manuallyEditedAt || '')) || 0;
            const bEdit = Date.parse(String(b?.manuallyEditedAt || '')) || 0;
            if (aEdit !== bEdit) return aEdit - bEdit;
            const aLinked = Date.parse(String(a?.manualPairLinkedAt || '')) || 0;
            const bLinked = Date.parse(String(b?.manualPairLinkedAt || '')) || 0;
            if (aLinked !== bLinked) return aLinked - bLinked;
            const aTime = getAttendanceTimestamp(a);
            const bTime = getAttendanceTimestamp(b);
            if (aTime !== bTime) return aTime - bTime;
            return Number(String(a?.id || '').replace(/\D/g, '') || 0) - Number(String(b?.id || '').replace(/\D/g, '') || 0);
        }

        function makeRecoveredManualPairRecord(sourceRecord, targetType) {
            const isRecoverIn = targetType === 'IN';
            const targetTime = isRecoverIn
                ? getManualPairClockInTimeStr(sourceRecord)
                : getManualPairClockOutTimeStr(sourceRecord);
            const normalizedTime = normalizeImportedAttendanceTime(targetTime);
            if (!normalizedTime) return null;

            const targetKey = isRecoverIn
                ? getManualPairClockInKey(sourceRecord)
                : getManualPairClockOutKey(sourceRecord);
            const empId = String(sourceRecord?.empId || '').trim().toUpperCase();
            const idBase = [
                'PAIRREC',
                isRecoverIn ? 'IN' : 'OUT',
                empId || normalizeAttendanceNumber(sourceRecord?.attNo, empId) || 'EMP',
                normalizedTime.replace(/\D/g, '')
            ].join('_');

            const recovered = {
                id: idBase,
                attNo: sourceRecord?.attNo,
                empId,
                name: sourceRecord?.name || '',
                dept: sourceRecord?.dept || '一般',
                unit: sourceRecord?.unit || '',
                jobTitle: sourceRecord?.jobTitle || sourceRecord?.deptDetail || '',
                timeStr: normalizedTime,
                status: isRecoverIn ? '上班簽到' : '下班簽退',
                location: '系統自動修復',
                note: '由人工補卡配對資料自動還原',
                source: 'manual-pair-recovery',
                sourceEventKey: String(targetKey || '').trim(),
                manuallyEdited: true,
                manuallyEditedAt: String(sourceRecord?.manuallyEditedAt || new Date().toISOString()),
                manualPairLinkedAt: new Date().toISOString()
            };

            if (isRecoverIn) {
                recovered.manualPairClockOutId = String(sourceRecord?.id ?? '').trim();
                recovered.manualPairClockOutKey = getAttendanceStablePairKey(sourceRecord);
                recovered.manualPairClockOutTimeStr = String(sourceRecord?.timeStr || '').trim();
            } else {
                recovered.manualPairClockInId = String(sourceRecord?.id ?? '').trim();
                recovered.manualPairClockInKey = getAttendanceStablePairKey(sourceRecord);
                recovered.manualPairClockInTimeStr = String(sourceRecord?.timeStr || '').trim();
            }
            return normalizeAttendanceRecordIdentifiers(recovered);
        }

        function repairBrokenManualPairGroups(deleteFromCloud = false, notify = false) {
            if (!Array.isArray(records) || !records.length) return 0;

            const removeRecords = new Set();
            const addRecords = [];
            let changed = 0;

            const processDirection = (direction, targetType) => {
                const groups = new Map();
                records.forEach(record => {
                    const type = getAttendanceRecordType(record);
                    if (direction === 'OUT_TO_IN' && type !== 'OUT') return;
                    if (direction === 'IN_TO_OUT' && type !== 'IN') return;
                    const anchor = getManualPairTargetAnchor(record, direction);
                    if (!anchor) return;
                    if (!groups.has(anchor)) groups.set(anchor, []);
                    groups.get(anchor).push(record);
                });

                groups.forEach(group => {
                    if (!group.length) return;
                    const ordered = group.slice().sort(compareManualPairRepairRecords);
                    const keeper = ordered[ordered.length - 1];

                    // 同一個配對目標只能保留最後一次人工補卡。
                    ordered.slice(0, -1).forEach(record => {
                        if (!removeRecords.has(record)) {
                            removeRecords.add(record);
                            changed++;
                        }
                    });

                    const targetId = direction === 'OUT_TO_IN'
                        ? getManualPairClockInId(keeper)
                        : getManualPairClockOutId(keeper);
                    const targetKey = direction === 'OUT_TO_IN'
                        ? getManualPairClockInKey(keeper)
                        : getManualPairClockOutKey(keeper);
                    const targetTime = direction === 'OUT_TO_IN'
                        ? getManualPairClockInTimeStr(keeper)
                        : getManualPairClockOutTimeStr(keeper);

                    let target = records.find(record => {
                        if (removeRecords.has(record) || group.includes(record)) return false;
                        if (getAttendanceRecordType(record) !== targetType) return false;
                        if (getManualPairRepairIdentity(record) !== getManualPairRepairIdentity(keeper)) return false;
                        return attendancePairRecordMatches(record, targetId, targetKey, targetTime);
                    }) || null;

                    // 原始上/下班已被舊版誤刪時，從人工補卡內保存的原始時間/事件鍵自動重建。
                    if (!target && normalizeImportedAttendanceTime(targetTime)) {
                        target = makeRecoveredManualPairRecord(keeper, targetType);
                        if (target) {
                            const sameIdExists = records.some(r => String(r?.id ?? '') === String(target.id));
                            if (!sameIdExists) {
                                addRecords.push(target);
                                changed++;
                            }
                        }
                    }

                    if (!target) return;

                    if (direction === 'OUT_TO_IN') {
                        keeper.manualPairClockInId = String(target.id ?? '').trim();
                        keeper.manualPairClockInKey = getAttendanceStablePairKey(target);
                        keeper.manualPairClockInTimeStr = String(target.timeStr || '').trim();
                        target.manualPairClockOutId = String(keeper.id ?? '').trim();
                        target.manualPairClockOutKey = getAttendanceStablePairKey(keeper);
                        target.manualPairClockOutTimeStr = String(keeper.timeStr || '').trim();
                    } else {
                        keeper.manualPairClockOutId = String(target.id ?? '').trim();
                        keeper.manualPairClockOutKey = getAttendanceStablePairKey(target);
                        keeper.manualPairClockOutTimeStr = String(target.timeStr || '').trim();
                        target.manualPairClockInId = String(keeper.id ?? '').trim();
                        target.manualPairClockInKey = getAttendanceStablePairKey(keeper);
                        target.manualPairClockInTimeStr = String(keeper.timeStr || '').trim();
                    }
                    keeper.manualPairLinkedAt = new Date().toISOString();
                    target.manualPairLinkedAt = new Date().toISOString();
                    rememberRecentAttendanceMutation(keeper, 'pairRepair');
                    rememberRecentAttendanceMutation(target, 'pairRepair');
                });
            };

            processDirection('OUT_TO_IN', 'IN');
            processDirection('IN_TO_OUT', 'OUT');

            if (removeRecords.size) {
                records = records.filter(record => !removeRecords.has(record));
            }
            if (addRecords.length) {
                records = [...addRecords, ...records];
            }

            if (!changed) return 0;

            saveRecords();
            archiveAttendanceRecords(addRecords);

            if (deleteFromCloud) {
                [...removeRecords].forEach(record => {
                    forgetRecentAttendanceMutation(record?.id);
                    postToCloud({ action: 'deleteRecord', id: record?.id }, '', null, () => {});
                });
            }

            if (notify) {
                showToast(`已自動修復 ${changed} 筆人工補卡配對資料`, 'success');
            }
            return changed;
        }

        function deduplicateAttendanceRecords(deleteFromCloud = false, notify = false) {
            if (!Array.isArray(records) || records.length < 2) {
                saveRecords();
                return 0;
            }

            const removeRecords = new Set();

            // v2026.10.01：先用 sourceEventKey 處理「人工修改版取代舊原始版」。
            // 人工修改時間後，getAttendanceImportEventKey 會因新時間改變；
            // 但 sourceEventKey 仍指向原始事件。若只按目前時間去重，舊 09:22 與修改後時間會同時存在。
            const keptBySourceEventKey = new Map();
            records.forEach(record => {
                const sourceKey = String(record?.sourceEventKey || '').trim();
                if (!sourceKey) return;
                const sourceTypeKey = `${sourceKey}|TYPE:${getAttendanceRecordType(record)}`;
                if (!keptBySourceEventKey.has(sourceTypeKey)) {
                    keptBySourceEventKey.set(sourceTypeKey, record);
                    return;
                }
                const current = keptBySourceEventKey.get(sourceTypeKey);
                const candidateManual = isManuallyEditedAttendanceRecord(record);
                const currentManual = isManuallyEditedAttendanceRecord(current);
                let preferCandidate = false;
                if (candidateManual !== currentManual) {
                    preferCandidate = candidateManual;
                } else if (candidateManual && currentManual) {
                    const candidateTs = Date.parse(record.manuallyEditedAt || '') || 0;
                    const currentTs = Date.parse(current.manuallyEditedAt || '') || 0;
                    preferCandidate = candidateTs > currentTs;
                }
                const primary = preferCandidate ? record : current;
                const duplicate = preferCandidate ? current : record;
                keptBySourceEventKey.set(sourceTypeKey, primary);
                removeRecords.add(duplicate);
            });

            const keptByEventKey = new Map();
            records.forEach(record => {
                if (removeRecords.has(record)) return;
                const key = getAttendanceImportEventKey(record);
                if (!key) return;
                if (!keptByEventKey.has(key)) {
                    keptByEventKey.set(key, record);
                    return;
                }
                const kept = keptByEventKey.get(key);

                // 指定補某一異常班次的紀錄，不可因為時間相同而刪除。
                if (isTargetedManualPairRecord(record) || isTargetedManualPairRecord(kept)) {
                    // pairing suffix 理論上已讓 key 不同；這裡再做最後一道防護。
                    keptByEventKey.set(`${key}|ID:${String(record.id ?? '')}`, record);
                    return;
                }

                // 完全相同事件若包含人工修改版本，必須保留人工版本，避免重新匯入後被原始 Excel 覆蓋。
                const type = getAttendanceRecordType(record);
                const preferCurrent = shouldPreferAttendanceRecord(record, kept, type);
                const primary = preferCurrent ? record : kept;
                const duplicate = preferCurrent ? kept : record;
                if (!String(primary.location || '').trim() && String(duplicate.location || '').trim()) primary.location = duplicate.location;
                if (!String(primary.note || '').trim() && String(duplicate.note || '').trim()) primary.note = duplicate.note;
                if (!String(primary.sourceEventKey || '').trim() && String(duplicate.sourceEventKey || '').trim()) primary.sourceEventKey = duplicate.sourceEventKey;
                keptByEventKey.set(key, primary);
                removeRecords.add(duplicate);
            });

            // 完全相同事件先去重，再將同一班次多刷的資料實際整合：
            // 上班只留最早一筆，下班只留最晚一筆。
            const exactFilteredRecords = records.filter(record => !removeRecords.has(record));
            buildDailyAttendanceRows(exactFilteredRecords).forEach(session => {
                session.records.forEach(record => {
                    const type = getAttendanceRecordType(record);
                    const keptRecord = type === 'IN' ? session.clockIn : (type === 'OUT' ? session.clockOut : null);
                    if (!keptRecord || record === keptRecord) return;

                    // 指定補卡屬於明確人工修正，絕不由自動整合程序刪除。
                    if (isTargetedManualPairRecord(record) || isTargetedManualPairRecord(keptRecord)) return;

                    // 保留被整合紀錄中較完整的地點與備註。
                    if (!String(keptRecord.location || '').trim() && String(record.location || '').trim()) keptRecord.location = record.location;
                    if (!String(keptRecord.note || '').trim() && String(record.note || '').trim()) keptRecord.note = record.note;
                    removeRecords.add(record);
                });
            });

            if (!removeRecords.size) {
                saveRecords();
                return 0;
            }

            records = records.filter(record => !removeRecords.has(record));
            saveRecords();

            if (deleteFromCloud) {
                const remainingIds = new Set(records.map(record => String(record.id ?? '')).filter(Boolean));
                const deleteIdMap = new Map();
                [...removeRecords].forEach(record => {
                    const originalId = record.id;
                    const idKey = String(originalId ?? '');
                    if (idKey && !remainingIds.has(idKey) && !deleteIdMap.has(idKey)) {
                        // 保留雲端回傳的原始型別；試算表中的數字 ID 不可轉成字串後再比對。
                        deleteIdMap.set(idKey, originalId);
                    }
                });
                // 同步移除本機保護備份中的舊重複紀錄，避免重新拉取時舊時間再次出現。
                if (deleteIdMap.size) removeAttendanceRecordsFromArchive([...deleteIdMap.values()]);
                [...deleteIdMap.values()].forEach(id => postToCloud({ action: 'deleteRecord', id }));
            }

            if (notify) {
                showToast(`已整合 ${removeRecords.size} 筆重複打卡；上班保留最早、下班保留最晚`, 'success');
            }
            return removeRecords.size;
        }

        function getAttendanceStatusBadge(status) {
            if (status === '正常') {
                return `<span class="px-2.5 py-1 rounded-lg text-[10px] bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold">正常</span>`;
            }
            if (status === '上班未簽到' || status === '缺少簽到') {
                return `<span class="px-2.5 py-1 rounded-lg text-[10px] bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300 font-bold">缺少簽到</span>`;
            }
            if (status === '下班未簽退' || status === '缺少簽退') {
                return `<span class="px-2.5 py-1 rounded-lg text-[10px] bg-orange-100 text-orange-800 dark:bg-orange-950 dark:text-orange-300 font-bold">缺少簽退</span>`;
            }
            if (String(status).includes('重複')) {
                return `<span class="px-2.5 py-1 rounded-lg text-[10px] bg-cyan-100 text-cyan-800 dark:bg-cyan-950 dark:text-cyan-300 font-bold">${escapeHtml(status)}</span>`;
            }
            return `<span class="px-2.5 py-1 rounded-lg text-[10px] bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300 font-bold">未打卡</span>`;
        }

        const RECORDS_PAGE_SIZE = 50;
        let recordsCurrentPage = 1;
        let recordsPaginationSignature = '';

        function goToRecordsPage(page) {
            recordsCurrentPage = Math.max(1, Number(page) || 1);
            renderAdminRecordsTable();
            document.getElementById('adminRecordsTableContainer')?.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderRecordsPagination(totalRows, totalPages, rawPunchCount = null) {
            const box = document.getElementById('recordsPagination');
            if (!box) return;
            if (!totalRows) {
                box.classList.add('hidden');
                box.innerHTML = '';
                return;
            }
            box.classList.remove('hidden');
            const start = (recordsCurrentPage - 1) * RECORDS_PAGE_SIZE + 1;
            const end = Math.min(recordsCurrentPage * RECORDS_PAGE_SIZE, totalRows);
            const previousDisabled = recordsCurrentPage <= 1;
            const nextDisabled = recordsCurrentPage >= totalPages;
            box.innerHTML = `
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-300">顯示班次第 ${start}–${end} 列，共 ${totalRows} 班次${rawPunchCount == null ? '' : `｜原始打卡 ${rawPunchCount} 筆`}｜每頁 50 列</span>
                <div class="flex items-center gap-1.5">
                    <button type="button" onclick="goToRecordsPage(1)" ${previousDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 text-xs font-bold disabled:opacity-40 disabled:cursor-not-allowed">« 第一頁</button>
                    <button type="button" onclick="goToRecordsPage(${recordsCurrentPage - 1})" ${previousDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 text-xs font-bold disabled:opacity-40 disabled:cursor-not-allowed">‹ 上一頁</button>
                    <span class="min-w-[76px] text-center text-xs font-black text-indigo-600 dark:text-indigo-300">${recordsCurrentPage} / ${totalPages}</span>
                    <button type="button" onclick="goToRecordsPage(${recordsCurrentPage + 1})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 text-xs font-bold disabled:opacity-40 disabled:cursor-not-allowed">下一頁 ›</button>
                    <button type="button" onclick="goToRecordsPage(${totalPages})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 text-xs font-bold disabled:opacity-40 disabled:cursor-not-allowed">末頁 »</button>
                </div>`;
        }

        function attendanceRowAttentionRank(row) {
            // 0：目前已上班、尚未下班 → 最優先放最上方，現場最好辨識。
            if (row?.clockIn && !row?.clockOut) return 0;
            // 1：只有下班、缺簽到 → 異常仍需處理，放在已完成班次之前。
            if (!row?.clockIn && row?.clockOut) return 1;
            // 2：上下班皆完成 → 已確認完成，往下面推。
            if (row?.clockIn && row?.clockOut) return 2;
            return 3;
        }

        function sortAttendanceRowsActiveFirst(rows) {
            return (Array.isArray(rows) ? rows : []).sort((a, b) => {
                // V5.11：日期永遠是第一排序條件，最新日期必須在最上方。
                // 舊版先排「異常/缺卡」會讓 10/03 缺卡跑到 10/06 前面，看起來像日期亂跳。
                const dateA = String(a?.accountingDateKey || a?.dateKey || '').replace(/\D/g,'');
                const dateB = String(b?.accountingDateKey || b?.dateKey || '').replace(/\D/g,'');
                if (dateA !== dateB) return dateB.localeCompare(dateA);
                const rankDiff = attendanceRowAttentionRank(a) - attendanceRowAttentionRank(b);
                if (rankDiff) return rankDiff;
                return Number(b?.sortTime || 0) - Number(a?.sortTime || 0);
            });
        }

        function attendanceRowOvertimeMinutes(row) {
            if (!row?.clockIn || !row?.clockOut) return 0;
            const start = getAttendanceTimestamp(row.clockIn);
            const end = getAttendanceTimestamp(row.clockOut);
            const totalMinutes = Math.floor((end - start) / 60000);
            if (!Number.isFinite(totalMinutes) || totalMinutes <= 480 + MIN_OVERTIME_MINUTES) return 0;
            return Math.max(0, totalMinutes - 480);
        }

        function attendanceRowOvertimeText(row) {
            return formatDurationMinutes(attendanceRowOvertimeMinutes(row));
        }

        function renderAdminRecordsTable() {
            const tbody = document.getElementById('adminRecordsTableBody');
            if (!tbody) return;
            repairAttendanceNamesInMemory();

            const deptFilter = document.getElementById('recordDeptFilter')?.value || 'ALL';
            const jobTitleFilter = document.getElementById('recordJobTitleFilter')?.value || 'ALL';
            const nameFilter = document.getElementById('recordNameFilter')?.value || 'ALL';
            const statusFilter = document.getElementById('recordStatusFilter')?.value || 'ALL';
            const monthFilter = document.getElementById('filterMonthSelect')?.value || 'ALL';
            ensureRecordDateDefaultsToday();
            const dateFrom = normalizeRecordFilterDate(
                document.getElementById('recordDateFilter')?.value || ''
            );
            const dateTo = normalizeRecordFilterDate(
                document.getElementById('recordDateEndFilter')?.value || ''
            );
            const visibleEmployees = getAdminAttendanceEmployees();
            ensureAttendanceDisplayMasterFresh();

            let filtered = records.filter(r => {
                if (!canCurrentAdminViewDataRow(r)) return false;
                const emp = findEmployeeForAttendanceDisplay(r, visibleEmployees)
                    || findEmployeeForAttendanceIdentity(r, visibleEmployees);
                const currentDept = emp?.dept || r.dept || '一般';
                if (deptFilter !== 'ALL' && currentDept !== deptFilter) return false;
                if (jobTitleFilter !== 'ALL' && String(emp?.jobTitle || emp?.deptDetail || '') !== jobTitleFilter) return false;
                if (nameFilter !== 'ALL') {
                    const currentEmpId = String(emp?.empId || r.empId || '').trim();
                    const currentName = String(emp?.name || r.name || '').trim();
                    if (nameFilter.startsWith('NAME:')) {
                        if (`NAME:${currentName}` !== nameFilter) return false;
                    } else if (nameFilter.startsWith('ATTNO:')) {
                        const currentAttNo = normalizeAttendanceIdentityAttNo(emp?.attNo ?? r.attNo);
                        if (`ATTNO:${currentAttNo}` !== nameFilter) return false;
                    } else if (currentEmpId !== nameFilter) {
                        return false;
                    }
                }
                return true;
            });

            // 同一員工、同一天的上班與下班紀錄合併為一列。
            let dailyRows = buildDailyAttendanceRows(filtered);
            // 先完成跨日／跨月班次配對。
            // 指定日期與月份都以「上班簽到日」歸屬；跨月下班仍留在原上班日。
            if (dateFrom || dateTo) {
                dailyRows = dailyRows.filter(row =>
                    attendanceRowMatchesDateRange(row, dateFrom, dateTo)
                );
            } else if (monthFilter !== 'ALL') {
                dailyRows = dailyRows.filter(row => attendanceRowVisibleForMonth(row, monthFilter));
            }
            if (statusFilter === 'NORMAL') dailyRows = dailyRows.filter(row => row.attendanceStatus === '正常');
            if (statusFilter === 'ABNORMAL') dailyRows = dailyRows.filter(row => row.attendanceStatus !== '正常');
            sortAttendanceRowsActiveFirst(dailyRows);

            const paginationSignature = [deptFilter, jobTitleFilter, nameFilter, statusFilter, monthFilter, dateFrom, dateTo, currentEmp?.empId || ''].join('|');
            if (paginationSignature !== recordsPaginationSignature) {
                recordsPaginationSignature = paginationSignature;
                recordsCurrentPage = 1;
            }
            const totalPages = Math.max(1, Math.ceil(dailyRows.length / RECORDS_PAGE_SIZE));
            recordsCurrentPage = Math.min(Math.max(1, recordsCurrentPage), totalPages);
            const pageStart = (recordsCurrentPage - 1) * RECORDS_PAGE_SIZE;
            const pageRows = dailyRows.slice(pageStart, pageStart + RECORDS_PAGE_SIZE);

            const rawEventKeys = new Set();
            dailyRows.forEach(row => {
                (Array.isArray(row?.records) ? row.records : []).forEach(record => {
                    const id = String(record?.id ?? '').trim();
                    const eventKey = getAttendanceImportEventKey(record);
                    const fallback = [
                        normalizeAttendanceIdentityAttNo(record?.attNo),
                        String(record?.empId || '').trim().toUpperCase(),
                        String(record?.timeStr || '').trim(),
                        String(record?.status || '').trim()
                    ].join('|');
                    rawEventKeys.add(id ? `ID:${id}` : (eventKey ? `EV:${eventKey}` : `RAW:${fallback}`));
                });
            });
            const rawPunchCount = rawEventKeys.size;

            const countEl = document.getElementById('recordFilterResultCount');
            if (countEl) {
                countEl.textContent = `(班次 ${dailyRows.length} 列｜原始打卡 ${rawPunchCount} 筆｜第 ${recordsCurrentPage} 頁，共 ${totalPages} 頁)`;
                countEl.title = '班次＝畫面合併後的一列；原始打卡＝上班/下班各自一筆，可用來和 Google Sheet 筆數比對';
            }
            renderRecordsPagination(dailyRows.length, totalPages, rawPunchCount);

            if (dailyRows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="11" class="p-6 text-center text-slate-400">🔍 找不到符合條件的考勤紀錄</td></tr>`;
                return;
            }

            const allowAttendanceEdit = canPerformAdminAction(currentEmp, 'attendanceEdit');
            const allowAttendanceCreate = canPerformAdminAction(currentEmp, 'attendanceCreate');
            const allowAttendanceDelete = canPerformAdminAction(currentEmp, 'attendanceDelete');

            tbody.innerHTML = pageRows.map(row => {
                // V5.10.3：顯示單位／職務時每列直接用考勤號查員工主檔。
                // 不相信舊考勤 record 的 empId，避免 empId 污染造成 -- 或套到別人。
                const displayEmp = findEmployeeForAttendanceDisplay(row, visibleEmployees)
                    || findEmployeeForAttendanceIdentity(row, visibleEmployees);

                const displayDept = String(displayEmp?.dept || row.dept || '一般').trim() || '一般';
                const displayUnit = String(
                    displayEmp?.unit ||
                    displayEmp?.deptUnit ||
                    displayEmp?.orgUnit ||
                    row.unit ||
                    ''
                ).trim();
                const displayJobTitle = String(
                    displayEmp?.jobTitle ||
                    displayEmp?.deptDetail ||
                    row.jobTitle ||
                    ''
                ).trim();

                const statusBadge = getAttendanceStatusBadge(row.attendanceStatus);
                const crossMonthBadge = attendanceRowCrossMonthLabel(row, monthFilter)
                    ? `<span class="ml-1 inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-[10px] font-black text-sky-700 dark:bg-sky-950 dark:text-sky-300" title="前一月份班次跨入目前月份">↔ 跨月</span>`
                    : '';
                const recordIds = row.records.map(r => r.id).filter(id => id !== null && id !== undefined && String(id) !== '');
                const manualIdentity = encodeURIComponent(String(row.attNo || row.name || row.empId || ''));
                const manualAttNo = encodeURIComponent(String(row.attNo ?? ''));
                const manualName = encodeURIComponent(String(row.name || ''));
                const manualDate = encodeURIComponent(String(row.dateKey || ''));
                const manualClockInId = encodeURIComponent(String(row.clockIn?.id ?? ''));
                const manualClockOutId = encodeURIComponent(String(row.clockOut?.id ?? ''));
                const inTime = row.clockIn
                    ? formatEditableAttendanceTimeCell(row.clockIn, 'IN', allowAttendanceEdit)
                    : `<span class="inline-flex items-center gap-1.5">--${allowAttendanceCreate ? `<button type="button" onclick="openRowManualAdd('${manualIdentity}', '${manualDate}', '上班簽到', '${manualClockOutId}', '${manualAttNo}', '${manualName}')" class="inline-flex w-6 h-6 items-center justify-center rounded-full bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300 font-black hover:ring-2 hover:ring-amber-400" title="手動補刷上班簽到" aria-label="手動補刷上班簽到">＋</button>` : ''}</span>`;
                const outTime = row.clockOut
                    ? formatEditableAttendanceTimeCell(row.clockOut, 'OUT', allowAttendanceEdit)
                    : `<span class="inline-flex items-center gap-1.5">--${allowAttendanceCreate ? `<button type="button" onclick="openRowManualAdd('${manualIdentity}', '${manualDate}', '下班簽退', '${manualClockInId}', '${manualAttNo}', '${manualName}')" class="inline-flex w-6 h-6 items-center justify-center rounded-full bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300 font-black hover:ring-2 hover:ring-amber-400" title="手動補刷下班簽退" aria-label="手動補刷下班簽退">＋</button>` : ''}</span>`;

                return `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                        <td class="px-2 py-3 text-center font-mono font-bold whitespace-nowrap">${row.attNo ?? ''}</td>
                        <td class="px-2 py-3 text-center font-semibold whitespace-nowrap">${row.name || ''}</td>
                        <td class="px-2 py-3 text-center whitespace-nowrap">${displayDept}</td>
                        <td class="px-2 py-3 text-center whitespace-nowrap">${displayUnit || '--'}</td>
                        <td class="px-2 py-3 text-center whitespace-nowrap">${displayJobTitle || '--'}</td>
                        <td class="px-2 py-3 text-center font-mono text-[11px] whitespace-nowrap">${inTime}</td>
                        <td class="px-2 py-3 text-center font-mono text-[11px] whitespace-nowrap">${outTime}</td>
                        <td class="px-2 py-3 text-center font-black text-indigo-700 dark:text-indigo-300 whitespace-nowrap">${attendanceRowOvertimeText(row)}</td>
                        <td class="px-2 py-3 text-center whitespace-nowrap">${statusBadge}${crossMonthBadge}</td>
                        <td class="px-2 py-3 text-center text-slate-500 text-[11px] leading-5">
                            ${row.noteText ? `備註: ${row.noteText}<br>` : ''}
                            ${row.locationText || '--'}
                        </td>
                        <td class="px-2 py-3 text-center">
                            <div class="flex justify-center min-w-[42px]">
                            ${allowAttendanceDelete ? `<button onclick='deleteDailyAttendance(${JSON.stringify(recordIds)})' class="inline-flex w-7 h-7 items-center justify-center rounded-full bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 hover:ring-2 hover:ring-rose-300" title="刪除整筆考勤" aria-label="刪除整筆考勤">🗑</button>` : '<span class="text-[10px] text-slate-400">—</span>'}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function editDailyAttendance(clockInId, clockOutId) {
            if (!requireAdminAction('attendanceEdit', '編輯打卡紀錄')) return;
            clockInId = clockInId ? decodeURIComponent(clockInId) : null;
            clockOutId = clockOutId ? decodeURIComponent(clockOutId) : null;
            if (clockInId != null && clockOutId != null) {
                const choice = confirm('此列包含上班與下班兩筆紀錄。\n按「確定」編輯上班簽到；按「取消」編輯下班簽退。');
                openEditRecordModal(choice ? clockInId : clockOutId);
                return;
            }
            const id = clockInId != null ? clockInId : clockOutId;
            if (id != null) openEditRecordModal(id);
        }

        function openAttendanceTimeEditor(encodedId, expectedType = '', encodedTime = '') {
            if (!requireAdminAction('attendanceEdit', '編輯打卡時間')) return;
            const id = decodeURIComponent(encodedId || '');
            const expectedTime = decodeURIComponent(encodedTime || '');
            if (id) openEditRecordModal(id, expectedType, expectedTime);
        }

        function deleteDailyAttendance(ids) {
            if (!requireAdminAction('attendanceDelete', '刪除打卡紀錄')) return;
            const validIds = Array.isArray(ids) ? ids.filter(id => id !== null && id !== undefined && String(id) !== '') : [];
            if (!validIds.length) return;

            if (!confirm(`確定要刪除這一天的考勤紀錄嗎？\n將刪除 ${validIds.length} 筆原始打卡資料。`)) return;

            const idSet = new Set(validIds.map(String));
            records = records.filter(r => !idSet.has(String(r.id)));
            saveRecords();
            removeAttendanceRecordsFromArchive(validIds);
            validIds.forEach(id => forgetRecentAttendanceMutation(id));

            validIds.forEach(id => {
                postToCloud({ action: 'deleteRecord', id: id });
            });

            showToast('已刪除該日考勤紀錄', 'success');
            renderAdminRecordsTable();
            renderAdminLiveTable();
        }

        function deleteRecord(id) {
            if (!requireAdminAction('attendanceDelete', '刪除打卡紀錄')) return;
            if (confirm("確定要刪除這筆打卡紀錄嗎？")) {
                records = records.filter(r => r.id !== id);
                saveRecords();
                removeAttendanceRecordsFromArchive(id);
                forgetRecentAttendanceMutation(id);
                postToCloud({ action: 'deleteRecord', id: id }, "已刪除打卡紀錄");
                renderAdminRecordsTable();
            }
        }

        function ensure24HourTimePicker(prefix) {
            const hourSelect = document.getElementById(`${prefix}TimeHour`);
            const minuteSelect = document.getElementById(`${prefix}TimeMinute`);
            if (!hourSelect || !minuteSelect) return;

            if (!hourSelect.options.length) {
                hourSelect.innerHTML = Array.from({ length: 24 }, (_, i) => {
                    const value = String(i).padStart(2, '0');
                    return `<option value="${value}">${value} 時</option>`;
                }).join('');
            }
            if (!minuteSelect.options.length) {
                minuteSelect.innerHTML = Array.from({ length: 60 }, (_, i) => {
                    const value = String(i).padStart(2, '0');
                    return `<option value="${value}">${value} 分</option>`;
                }).join('');
            }

            [hourSelect, minuteSelect].forEach(select => {
                if (select.dataset.wheelReady === '1') return;
                select.dataset.wheelReady = '1';
                select.addEventListener('wheel', event => {
                    event.preventDefault();
                    const direction = event.deltaY > 0 ? 1 : -1;
                    const count = select.options.length;
                    select.selectedIndex = (select.selectedIndex + direction + count) % count;
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                }, { passive: false });
            });
        }

        function set24HourTime(prefix, timeValue) {
            ensure24HourTimePicker(prefix);
            const match = String(timeValue || '').match(/^(\d{1,2}):(\d{1,2})/);
            const hour = match ? Math.min(23, Number(match[1])) : 0;
            const minute = match ? Math.min(59, Number(match[2])) : 0;
            document.getElementById(`${prefix}TimeHour`).value = String(hour).padStart(2, '0');
            document.getElementById(`${prefix}TimeMinute`).value = String(minute).padStart(2, '0');
            document.getElementById(`${prefix}TimeInput`).value = `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
        }

        function get24HourTime(prefix) {
            ensure24HourTimePicker(prefix);
            const hour = document.getElementById(`${prefix}TimeHour`).value;
            const minute = document.getElementById(`${prefix}TimeMinute`).value;
            const value = hour !== '' && minute !== '' ? `${hour}:${minute}` : '';
            document.getElementById(`${prefix}TimeInput`).value = value;
            return value;
        }

        let activeEditingAttendanceRecord = null;
        let activeEditingAttendanceRecordSnapshot = null;

        // V5.10.15：單筆考勤異動不要每次都同步做全量序列化＋多次整表重繪。
        let p79AttendanceMutationRenderQueued = false;
        function p79ScheduleAttendanceMutationRender() {
            if (p79AttendanceMutationRenderQueued) return;
            p79AttendanceMutationRenderQueued = true;
            const run = () => {
                p79AttendanceMutationRenderQueued = false;

                // V5.10.16：修改 / 補卡後，只要目前就在「考勤管理」頁，
                // 就直接重建這一張表，不再依賴 isAdminLoggedIn 狀態剛好已完成同步。
                // 這可避免本機 records 已經加入補卡，但畫面仍停在「--」。
                const recordsPanel = document.getElementById('adminContentRecords');
                const recordsTable = document.getElementById('adminRecordsTableBody');
                const recordsVisible = !!recordsTable && (
                    !recordsPanel ||
                    (!recordsPanel.classList.contains('hidden') && getComputedStyle(recordsPanel).display !== 'none')
                );

                if (recordsVisible) {
                    try { initDropdowns(); } catch (e) {}
                    try { renderAdminRecordsTable(); } catch (e) {
                        console.warn('補卡後立即刷新考勤表失敗：', e);
                    }
                } else {
                    try {
                        p79RenderOnlyVisibleAttendanceView();
                    } catch (e) {
                        try { renderAdminRecordsTable(); } catch (_) {}
                    }
                }

                if (currentEmp && !isAdminLoggedIn) {
                    try { renderEmpHistoryTable(); } catch (e) {}
                }

                // V5.10.31：只要剛修改/補卡/刪除考勤，就用目前 records 自動重算匯入比對。
                // 工具列「待處理 N / 總數」會立刻下降，不需重新匯入 Excel。
                try {
                    if (typeof rebuildAttendanceImportAuditFromCurrentSystem === 'function' &&
                        getStoredAttendanceImportAudit().length) {
                        rebuildAttendanceImportAuditFromCurrentSystem({silent:true});
                    }
                } catch (e) {
                    console.warn('考勤異動後自動重新比對失敗：', e);
                }
            };
            if (typeof requestAnimationFrame === 'function') requestAnimationFrame(run);
            else setTimeout(run, 0);
        }

        function p79ScheduleAttendanceMutationPersist(archiveItems = [], removeArchiveIds = []) {
            // 主考勤快取：交給共用 idle scheduler，一批連續異動只會保留最後一次。
            try {
                if (typeof window.p79ScheduleAttendancePersist === 'function') {
                    window.p79ScheduleAttendancePersist();
                } else {
                    setTimeout(() => { try { saveRecords(); } catch (e) {} }, 0);
                }
            } catch (e) {}

            // 匯入保護檔較大，延後到瀏覽器空閒時才維護，不阻塞「儲存變更」按鈕。
            const archiveCopy = (Array.isArray(archiveItems) ? archiveItems : [])
                .filter(Boolean)
                .map(item => ({ ...item }));
            const removeIds = (Array.isArray(removeArchiveIds) ? removeArchiveIds : [])
                .map(id => String(id ?? '').trim())
                .filter(Boolean);

            if (!archiveCopy.length && !removeIds.length) return;

            const runArchive = () => {
                try {
                    if (removeIds.length) removeAttendanceRecordsFromArchive(removeIds);
                    if (archiveCopy.length) archiveAttendanceRecords(archiveCopy);
                } catch (e) {
                    console.warn('考勤保護備份延後處理失敗：', e);
                }
            };

            if (typeof requestIdleCallback === 'function') {
                requestIdleCallback(runArchive, { timeout: 2500 });
            } else {
                setTimeout(runArchive, 250);
            }
        }

        function repairDuplicateAttendanceRecordIds() {
            const usedIds = new Set();
            let repairedCount = 0;
            let nextId = Date.now() * 1000;
            records.forEach(record => {
                const idKey = String(record?.id ?? '').trim();
                if (!idKey || !usedIds.has(idKey)) {
                    if (idKey) usedIds.add(idKey);
                    return;
                }
                while (usedIds.has(String(nextId))) nextId++;
                record.id = nextId++;
                usedIds.add(String(record.id));
                repairedCount++;
            });
            return repairedCount;
        }

        function p79SetDateInputValue(inputId, value) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const next = String(value || '').trim();
            input.value = next;
            try { input.dispatchEvent(new Event('input', {bubbles:true})); } catch (e) {}
            try { input.dispatchEvent(new Event('change', {bubbles:true})); } catch (e) {}
        }

        function openEditRecordModal(id, expectedType = '', expectedTime = '', expectedIdentity = null) {
            if (!requireAdminAction('attendanceEdit', '編輯打卡紀錄')) return;
            const candidates = records.filter(item =>
                String(item.id) === String(id) &&
                (!expectedIdentity || p79AuditRecordIdentityMatches(expectedIdentity, item))
            );
            const r = candidates.find(item =>
                (!expectedType || getAttendanceRecordType(item) === expectedType) &&
                (!expectedTime || String(item.timeStr || '') === String(expectedTime))
            ) || candidates.find(item => !expectedType || getAttendanceRecordType(item) === expectedType)
              || candidates[0];

            if (!r) {
                showToast(
                    expectedIdentity
                        ? `找不到「${expectedIdentity.name || expectedIdentity.attNo || expectedIdentity.empId || ''}」對應的系統打卡紀錄，已停止開啟，避免修改到其他人`
                        : '找不到這筆考勤紀錄',
                    'warning'
                );
                return;
            }
            activeEditingAttendanceRecord = r;
            activeEditingAttendanceRecordSnapshot = { ...r };

            document.getElementById('modalRecordId').value = r.id;
            const title = document.getElementById('editRecordModalTitle');
            if (title) title.textContent = `📝 修改${r.status || '考勤'}時間（24 小時制）`;
            document.getElementById('modalEmpInfo').textContent = `${r.name} (${r.empId}) - ${r.dept || '一般'} (考勤號: ${r.attNo})`;
            document.getElementById('modalNoteInput').value = r.note || '';

            if (r.timeStr) {
                const parts = r.timeStr.replace(/-/g, '/').split(' ');
                const dateParts = parts[0].split('/');
                if (dateParts.length === 3) {
                    p79SetDateInputValue('modalDateInput', `${dateParts[0]}-${dateParts[1].padStart(2,'0')}-${dateParts[2].padStart(2,'0')}`);
                }
                if (parts[1]) {
                    set24HourTime('modal', parts[1].slice(0, 5));
                }
            }

            if (!r.timeStr || !r.timeStr.includes(' ')) {
                const now = new Date();
                set24HourTime('modal', `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`);
            }

            selectModalStatus(r.status || '上班簽到');
            updateEditModalDeleteButton(r);
            setupMobileDateInputs();
            document.getElementById('editRecordModal').classList.remove('hidden');
        }


        function getAttendanceDeleteLabel(record) {
            const type = getAttendanceRecordType(record);
            const status = String(record?.status || '').trim();
            if (type === 'IN') {
                return status.includes('加班') ? '加班上班' : '上班打卡';
            }
            if (type === 'OUT') {
                return status.includes('加班') ? '加班下班' : '下班打卡';
            }
            return status || '這筆打卡';
        }

        function updateEditModalDeleteButton(record) {
            const btn = document.getElementById('deleteModalRecordBtn');
            if (!btn) return;
            const label = getAttendanceDeleteLabel(record);
            btn.textContent = `🗑️ 刪除${label}`;
            btn.title = `只刪除目前這一筆${label}，另一筆上下班紀錄會保留`;
        }

        function deleteCurrentModalAttendanceRecord() {
            if (!requireAdminAction('attendanceDelete', '刪除打卡紀錄')) return;

            const id = String(document.getElementById('modalRecordId')?.value || '').trim();
            const snapshot = activeEditingAttendanceRecordSnapshot || activeEditingAttendanceRecord || null;

            let record = activeEditingAttendanceRecord && records.includes(activeEditingAttendanceRecord)
                ? activeEditingAttendanceRecord
                : records.find(item => String(item?.id ?? '').trim() === id);

            if (!record && snapshot) {
                const snapshotEventKey = getAttendanceImportEventKey(snapshot);
                if (snapshotEventKey) {
                    record = records.find(item => getAttendanceImportEventKey(item) === snapshotEventKey);
                }
            }
            if (!record && snapshot) record = snapshot;

            if (!record) {
                showToast('找不到要刪除的打卡紀錄，請重新開啟該筆資料', 'warning');
                return;
            }

            const recordId = String(record?.id ?? id).trim();
            if (!recordId) {
                showToast('這筆打卡缺少紀錄 ID，無法安全刪除', 'warning');
                return;
            }

            const label = getAttendanceDeleteLabel(record);
            const who = String(record?.name || '').trim();
            const when = String(record?.timeStr || '').trim();

            if (!confirm(`確定只刪除${who ? '「' + who + '」的' : ''}${label}嗎？\n\n${when || ''}\n\n另一筆上下班紀錄不會一起刪除。`)) {
                return;
            }

            const btn = document.getElementById('deleteModalRecordBtn');
            if (btn?.disabled) return;
            if (btn) {
                btn.disabled = true;
                btn.textContent = '⏳ 刪除中…';
            }

            try {
                purgeDeletedAttendanceRecordFromAllLocalCaches(record);
                records = records.filter(item => String(item?.id ?? '').trim() !== recordId);
                p79ScheduleAttendanceMutationPersist([], [recordId]);
                forgetRecentAttendanceMutation(recordId);

                closeEditModal();

                p79ScheduleAttendanceMutationRender();
                try { updateHomeClockInButtonState(); } catch (ignore) {}

                showToast(`已刪除${label}，正在同步雲端…`, 'success');

                postToCloud(
                    { action: 'deleteRecord', id: recordId },
                    `已刪除${label}`,
                    () => {
                        // 本機刪除時畫面已更新；雲端成功只更新按鈕狀態，不再整表重繪兩次。
                        try { updateHomeClockInButtonState(); } catch (ignore) {}
                    },
                    errorText => {
                        console.warn(`刪除${label}雲端同步失敗：`, errorText);
                        showToast(`本機已刪除${label}，雲端將自動重試同步`, 'warning');
                    }
                );
            } catch (error) {
                console.error('刪除目前考勤紀錄失敗：', error);
                showToast('刪除失敗：' + String(error?.message || error || '未知錯誤'), 'warning');
                if (btn) {
                    btn.disabled = false;
                    updateEditModalDeleteButton(record);
                }
            }
        }

        function closeEditModal() {
            document.getElementById('editRecordModal').classList.add('hidden');
            activeEditingAttendanceRecord = null;
            activeEditingAttendanceRecordSnapshot = null;
        }

        function selectModalStatus(status) {
            document.getElementById('modalStatusInput').value = status;
            ['上班簽到', '下班簽退', '加班上班', '加班下班'].forEach(s => {
                const btn = document.getElementById(`btnStatus-${s}`);
                if (!btn) return;
                if (s === status) {
                    btn.className = "status-btn px-3 py-2 rounded-xl text-xs font-bold border border-indigo-500 bg-indigo-600 text-white shadow-md";
                } else {
                    btn.className = "status-btn px-3 py-2 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100";
                }
            });
        }

        function saveModalEdit() {
            const saveBtn = document.getElementById('saveModalEditBtn');
            if (saveBtn?.disabled) return;
            if (!requireAdminAction('attendanceEdit', '編輯打卡紀錄')) return;

            const originalButtonText = saveBtn?.innerHTML || '💾 儲存變更';
            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '⏳ 儲存中…';
            }

            try {
                const id = document.getElementById('modalRecordId').value;
                const snapshot = activeEditingAttendanceRecordSnapshot || activeEditingAttendanceRecord || null;
                const snapshotSourceKey = String(snapshot?.sourceEventKey || '').trim();
                const snapshotEventKey = snapshot ? getAttendanceImportEventKey(snapshot) : '';
                const snapshotType = snapshot ? getAttendanceRecordType(snapshot) : '';
                const snapshotTime = String(snapshot?.timeStr || '').trim();
                const snapshotEmpId = String(snapshot?.empId || '').trim().toUpperCase();
                const snapshotAttNo = String(snapshot?.attNo ?? '').trim();

                let r = activeEditingAttendanceRecord && records.includes(activeEditingAttendanceRecord)
                    ? activeEditingAttendanceRecord
                    : records.find(item => String(item.id) === String(id));

                // 編輯視窗開著時，背景雲端刷新可能把 records 陣列整批換掉。
                // 不可因此讓「儲存變更」按鈕無聲失效；改用原始事件鍵/身分/時間重新找到同一筆。
                if (!r && snapshotSourceKey) {
                    r = records.find(item => String(item?.sourceEventKey || '').trim() === snapshotSourceKey);
                }
                if (!r && snapshotEventKey) {
                    r = records.find(item => getAttendanceImportEventKey(item) === snapshotEventKey);
                }
                if (!r && snapshot) {
                    r = records.find(item => {
                        const sameEmp = snapshotEmpId
                            ? String(item?.empId || '').trim().toUpperCase() === snapshotEmpId
                            : String(item?.attNo ?? '').trim() === snapshotAttNo;
                        return sameEmp &&
                            String(item?.timeStr || '').trim() === snapshotTime &&
                            getAttendanceRecordType(item) === snapshotType;
                    });
                }
                if (!r && snapshot) {
                    // 最後保底：後台 editRecord_ 本身支援「原紀錄不存在則補建」，
                    // 因此保留原 snapshot 繼續送雲端，而不是按鈕直接 return 沒反應。
                    r = { ...snapshot };
                    records.unshift(r);
                    activeEditingAttendanceRecord = r;
                }
                if (!r) {
                    showToast('找不到正在編輯的考勤紀錄，請重新開啟該筆資料', 'warning');
                    return;
                }

                const dateVal = document.getElementById('modalDateInput').value;
                const timeVal = get24HourTime('modal');
                const statusVal = document.getElementById('modalStatusInput').value;
                const noteVal = document.getElementById('modalNoteInput').value.trim();

                if (!dateVal || !timeVal) {
                    showToast('請完整填寫日期與時間！', 'warning');
                    return;
                }
                if (!statusVal) {
                    showToast('請選擇出勤狀態！', 'warning');
                    return;
                }

                const originalTimeStr = String(r.timeStr || '');
                const originalPunchType = getAttendanceRecordType(r);
                const previousSnapshot = { ...r };

                // 保存匯入時的原始事件識別。再次匯入同一事件時，人工修改版優先。
                // sourceEventKey 只能保存事件本體，不得把 manualPair suffix 寫進去；
                // 否則每次補卡/雙向連結都會讓 key 改變，舊副本永遠清不乾淨。
                r.sourceEventKey = stripManualPairSuffixFromEventKey(r.sourceEventKey) || getAttendanceStablePairKey(r);
                r.manuallyEdited = true;
                r.manuallyEditedAt = new Date().toISOString();
                r.timeStr = `${dateVal.replace(/-/g, '/')} ${timeVal}`;
                r.status = statusVal;
                r.note = noteVal;

                document.getElementById('modalRecordId').value = r.id;

                // 編輯人工補卡後，同一配對目標的其他舊副本立即從本機移除；
                // 後台 updateRecord 也會做同一套 canonical cleanup。
                collapseLocalManualPairSiblings(r);

                // V5.10.15：修改一筆考勤時，不再在按鈕事件內同步 JSON.stringify 全部 records
                // + 安全備份 + 匯入備份。先改記憶體／最近異動，完整持久化延後到 idle。
                p79ScheduleAttendanceMutationPersist([r]);
                rememberRecentAttendanceMutation(r, 'updateRecord');

                // 畫面只排一次 RAF render；不等待雲端，也不在成功 callback 再重繪一次。
                closeEditModal();
                p79ScheduleAttendanceMutationRender();
                p79ReturnToAttendanceAuditAfterMutation();

                showToast('考勤修改已套用，正在同步雲端…', 'success');

                postToCloud({
                    action: 'updateRecord',
                    record: r,
                    originalTimeStr,
                    originalPunchType
                }, '考勤紀錄已成功更新並同步雲端！',
                () => {
                    markRecentAttendanceMutationCloudConfirmed(r.id);
                    // 本機已經先套用修改，雲端成功不需再次重建整張考勤表。
                    try { window.p79UpdateAttendanceLiveProgress?.(); } catch (e) {}
                },
                errorText => {
                    console.warn('考勤修改已保留於待同步清單：', errorText);
                });
            } catch (error) {
                console.error('儲存考勤修改時發生錯誤：', error);
                showToast('儲存考勤修改失敗：' + String(error?.message || error || '未知錯誤'), 'warning');
            } finally {
                if (saveBtn && document.body.contains(saveBtn)) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = originalButtonText;
                }
            }
        }

        // 手機日期選擇修正：iPhone / Android / 桌面皆可使用。
        // 優先使用 showPicker；不支援時改用 focus + click。
        function openSystemDatePicker(inputId) {
            const input = document.getElementById(inputId);
            if (!input || input.disabled) return;

            try {
                input.focus({ preventScroll: true });
            } catch (e) {
                try { input.focus(); } catch (ignore) {}
            }

            try {
                if (typeof input.showPicker === 'function') {
                    input.showPicker();
                    return;
                }
            } catch (e) {
                // Safari 某些版本會禁止 showPicker，下面改走 click。
            }

            try { input.click(); } catch (ignore) {}
        }

        function setupMobileDateInputs() {
            ['addModalDateInput', 'modalDateInput'].forEach(id => {
                const input = document.getElementById(id);
                if (!input || input.dataset.mobileDateReady === '1') return;
                input.dataset.mobileDateReady = '1';
                input.addEventListener('touchend', function() {
                    try { this.focus(); } catch (e) {}
                }, { passive: true });
            });
        }

        let pendingManualPairTargetRecordRef = null;
        let pendingManualPairTargetRecordSnapshot = null;
        let pendingManualPairClockInId = '';
        let pendingManualPairClockOutId = '';
        let pendingManualPairClockInKey = '';
        let pendingManualPairClockOutKey = '';
        let pendingManualPairClockInTimeStr = '';
        let pendingManualPairClockOutTimeStr = '';

        function openManualAddModal() {
            if (!requireAdminAction('attendanceCreate', '新增上下班打卡')) return;
            pendingManualPairClockInId = '';
            pendingManualPairClockOutId = '';
            pendingManualPairClockInKey = '';
            pendingManualPairClockOutKey = '';
            pendingManualPairClockInTimeStr = '';
            pendingManualPairClockOutTimeStr = '';
            const pairHint = document.getElementById('addModalPairHint');
            if (pairHint) {
                pairHint.textContent = '';
                pairHint.classList.add('hidden');
            }
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const hh = String(now.getHours()).padStart(2, '0');
            const min = String(now.getMinutes()).padStart(2, '0');

            document.getElementById('addModalDateInput').value = `${yyyy}-${mm}-${dd}`;
            set24HourTime('addModal', `${hh}:${min}`);
            document.getElementById('addModalNoteInput').value = "管理員手動補卡";

            repairAttendanceNamesInMemory();
            initDropdowns();
            initAddModalDropdownsFast();
            selectAddModalStatus('上班簽到');
            setupMobileDateInputs();
            document.getElementById('addRecordModal').classList.remove('hidden');
        }


        function initAddModalDropdownsFast(preferredEmployee = null) {
            const deptSelect = document.getElementById('addModalDeptSelect');
            const empSelect = document.getElementById('addModalEmpSelect');
            if (!deptSelect || !empSelect) return;

            repairAttendanceNamesInMemory();
            const visible = sortEmployeesById(getAdminAttendanceEmployees());
            const depts = Array.from(new Set(
                visible.map(e => String(e?.dept || '一般').trim() || '一般')
            )).sort((a,b)=>a.localeCompare(b,'zh-Hant'));

            const preferredDept = String(preferredEmployee?.dept || deptSelect.value || depts[0] || '一般');
            deptSelect.innerHTML = depts.map(d =>
                `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`
            ).join('');
            if (depts.includes(preferredDept)) deptSelect.value = preferredDept;

            const selectedDept = deptSelect.value || preferredDept;
            const filtered = visible.filter(e => String(e?.dept || '一般') === selectedDept);
            empSelect.innerHTML = filtered.map(e => {
                const value = attendanceEmployeeOptionValue(e);
                return value ? `<option value="${escapeHtml(value)}">${escapeHtml(attendanceEmployeeDisplayLabel(e))}</option>` : '';
            }).join('');

            const preferredId = attendanceEmployeeOptionValue(preferredEmployee);
            if (preferredId && filtered.some(e => attendanceEmployeeOptionValue(e) === preferredId)) {
                empSelect.value = preferredId;
            }
        }

        async function openRowManualAdd(encodedEmpId, encodedDate, suggestedStatus, encodedTargetRecordId = '', encodedRowAttNo = '', encodedRowName = '') {
            if (!requireAdminAction('attendanceCreate', '新增上下班打卡')) return;
            const empId = decodeURIComponent(encodedEmpId || '');
            const dateKey = decodeURIComponent(encodedDate || '');
            const targetRecordId = decodeURIComponent(encodedTargetRecordId || '');
            const rowAttNo = decodeURIComponent(encodedRowAttNo || '');
            const rowName = decodeURIComponent(encodedRowName || '');

            const targetRecord = targetRecordId
                ? records.find(record => String(record?.id ?? '').trim() === String(targetRecordId).trim())
                : null;

            // V5.2：按「＋」當下直接鎖定這一列的原始 target。
            // 後續 Modal 操作期間即使 records 被 Delta/render/去重替換，也不再重新猜目標。
            pendingManualPairTargetRecordRef = targetRecord || null;
            pendingManualPairTargetRecordSnapshot = targetRecord ? { ...targetRecord } : null;

            const targetStableKey = getAttendanceStablePairKey(targetRecord);
            const targetTimeStr = String(targetRecord?.timeStr || '').trim();

            pendingManualPairClockInId = suggestedStatus === '下班簽退' ? targetRecordId : '';
            pendingManualPairClockOutId = suggestedStatus === '上班簽到' ? targetRecordId : '';
            pendingManualPairClockInKey = suggestedStatus === '下班簽退' ? targetStableKey : '';
            pendingManualPairClockOutKey = suggestedStatus === '上班簽到' ? targetStableKey : '';
            pendingManualPairClockInTimeStr = suggestedStatus === '下班簽退' ? targetTimeStr : '';
            pendingManualPairClockOutTimeStr = suggestedStatus === '上班簽到' ? targetTimeStr : '';

            const pairHint = document.getElementById('addModalPairHint');
            if (pairHint) {
                pairHint.textContent = targetRecordId
                    ? `此筆補卡會固定配對到目前這一列，不會被其他班次搶走。`
                    : '';
                pairHint.classList.toggle('hidden', !targetRecordId);
            }

            const resolveManualEmployee = () => {
                repairAttendanceNamesInMemory();
                const visible = getAdminAttendanceEmployees();

                const normalizeName = value =>
                    String(value || '').trim().replace(/\s+/g,'').replace(/\([^)]*\)$/,'');
                const normalizeAtt = value =>
                    String(value ?? '').trim().replace(/^0+/,'') || String(value ?? '').trim();

                // 畫面這一列的考勤號 / 姓名是最高可信來源。
                const wantedAtt = normalizeAtt(
                    rowAttNo || targetRecord?.attNo || ''
                );
                const wantedName = normalizeName(
                    rowName || targetRecord?.name || ''
                );

                // 1. 考勤號唯一命中：直接使用。
                if (wantedAtt) {
                    const byAtt = visible.filter(e =>
                        normalizeAtt(e?.attNo) === wantedAtt
                    );
                    if (byAtt.length === 1) return byAtt[0];

                    // 多筆同考勤號時，以姓名交叉確認。
                    if (wantedName && byAtt.length > 1) {
                        const exact = byAtt.find(e =>
                            normalizeName(e?.name) === wantedName
                        );
                        if (exact) return exact;
                    }
                }

                // 2. 姓名唯一命中。
                if (wantedName) {
                    const byName = visible.filter(e =>
                        normalizeName(e?.name) === wantedName
                    );
                    if (byName.length === 1) return byName[0];

                    // 同名時再用考勤號確認。
                    if (wantedAtt && byName.length > 1) {
                        const exact = byName.find(e =>
                            normalizeAtt(e?.attNo) === wantedAtt
                        );
                        if (exact) return exact;
                    }
                }

                // 3. target 的 empId 只有在不和考勤號/姓名衝突時才可採用。
                const targetEmpId = String(targetRecord?.empId || '').trim().toUpperCase();
                if (targetEmpId) {
                    const byId = visible.find(e =>
                        String(e?.empId || '').trim().toUpperCase() === targetEmpId
                    );
                    if (byId) {
                        const attConflict = wantedAtt && normalizeAtt(byId?.attNo) !== wantedAtt;
                        const nameConflict = wantedName && normalizeName(byId?.name) !== wantedName;
                        if (!attConflict && !nameConflict) return byId;
                    }
                }

                // 4. 最後才使用傳入 identity；同樣不可覆蓋畫面考勤號/姓名。
                const key = String(empId || '').trim().toUpperCase();
                if (key) {
                    const candidate = visible.find(e => {
                        const eId = String(e?.empId || '').trim().toUpperCase();
                        const eAtt = normalizeAtt(e?.attNo);
                        const eName = normalizeName(e?.name);
                        return eId === key || eAtt === normalizeAtt(empId) || eName === normalizeName(empId);
                    });
                    if (candidate) {
                        const attConflict = wantedAtt && normalizeAtt(candidate?.attNo) !== wantedAtt;
                        const nameConflict = wantedName && normalizeName(candidate?.name) !== wantedName;
                        if (!attConflict && !nameConflict) return candidate;
                    }
                }

                return null;
            };

            let emp = resolveManualEmployee();
            if (!emp) {
                // 月份考勤可以比員工主檔先到；補卡前強制補讀一次人資員工主檔再找。
                await preloadAttendanceEmployeeMaster(false, true);
                emp = resolveManualEmployee();
            }
            if (!emp) {
                showToast('找不到可補刷的員工資料｜已重新讀取員工主檔仍無此人', 'warning');
                return;
            }

            // 補卡視窗只更新自己需要的兩個下拉，不再重跑整頁 initDropdowns()。
            initAddModalDropdownsFast(emp);
            const deptSelect = document.getElementById('addModalDeptSelect');
            const empSelect = document.getElementById('addModalEmpSelect');
            if (deptSelect) deptSelect.value = emp.dept || deptSelect.value || '一般';
            onAddModalDeptChange();
            if (empSelect) {
                empSelect.value = attendanceEmployeeOptionValue(emp);
                empSelect.disabled = !!targetRecordId;
            }

            // V5.6：鎖定後再次驗證 Modal 選到的人必須和畫面列一致。
            const resolvedAttNo = String(emp?.attNo ?? '').trim().replace(/^0+/,'');
            const expectedAttNo = String(rowAttNo || targetRecord?.attNo || '').trim().replace(/^0+/,'');
            const resolvedName = String(emp?.name || '').trim().replace(/\s+/g,'');
            const expectedName = String(rowName || targetRecord?.name || '').trim().replace(/\s+/g,'');

            if ((expectedAttNo && resolvedAttNo !== expectedAttNo) ||
                (expectedName && resolvedName !== expectedName)) {
                showToast(`補卡身份不一致，已停止開啟：畫面 ${rowName || targetRecord?.name || ''} / ${rowAttNo || targetRecord?.attNo || ''}，解析成 ${emp?.name || ''} / ${emp?.attNo || ''}`, 'warning');
                return;
            }

            const normalizedPairDate = normalizeImportedAttendanceTime(`${dateKey} 00:00`);
            const normalizedDateMatch = String(normalizedPairDate || '').match(/^(\d{4})\/(\d{2})\/(\d{2})/);
            if (normalizedDateMatch) {
                document.getElementById('addModalDateInput').value =
                    `${normalizedDateMatch[1]}-${normalizedDateMatch[2]}-${normalizedDateMatch[3]}`;
            } else {
                const dateParts = dateKey.split('/');
                if (dateParts.length === 3) {
                    let year = Number(dateParts[0]);
                    if (Number.isFinite(year) && year < 1911) year += 1911;
                    document.getElementById('addModalDateInput').value =
                        `${String(year).padStart(4,'0')}-${String(dateParts[1]).padStart(2,'0')}-${String(dateParts[2]).padStart(2,'0')}`;
                }
            }

            const now = new Date();
            set24HourTime('addModal', `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`);
            document.getElementById('addModalNoteInput').value = '管理員手動補刷';
            selectAddModalStatus(suggestedStatus || '上班簽到');
            const modal = document.getElementById('addRecordModal');
            if (modal) {
                modal.dataset.p79LockedEmpId = String(emp.empId || '');
                modal.dataset.p79LockedEmployeeKey = attendanceEmployeeOptionValue(emp);
                modal.dataset.p79LockedAttNo = String(emp.attNo ?? '');
                modal.dataset.p79LockedName = String(emp.name || '');
                modal.classList.remove('hidden');
            }
        }

        function closeAddModal() {
            const modal = document.getElementById('addRecordModal');
            if (modal) {
                modal.classList.add('hidden');
                delete modal.dataset.p79LockedEmpId;
                delete modal.dataset.p79LockedEmployeeKey;
                delete modal.dataset.p79LockedAttNo;
                delete modal.dataset.p79LockedName;
            }
            const empSelect = document.getElementById('addModalEmpSelect');
            if (empSelect) empSelect.disabled = false;
            pendingManualPairTargetRecordRef = null;
            pendingManualPairTargetRecordSnapshot = null;
            pendingManualPairClockInId = '';
            pendingManualPairClockOutId = '';
            pendingManualPairClockInKey = '';
            pendingManualPairClockOutKey = '';
            pendingManualPairClockInTimeStr = '';
            pendingManualPairClockOutTimeStr = '';
        }

        function onAddModalDeptChange() {
            const deptSelect = document.getElementById('addModalDeptSelect');
            const empSelect = document.getElementById('addModalEmpSelect');
            if (!deptSelect || !empSelect) return;
            const previous = empSelect.value;
            const dept = deptSelect.value;

            const filtered = sortEmployeesById(
                getAdminAttendanceEmployees().filter(e => (e.dept || '一般') === dept)
            );
            empSelect.innerHTML = filtered.map(e => {
                const value = attendanceEmployeeOptionValue(e);
                return value ? `<option value="${escapeHtml(value)}">${escapeHtml(attendanceEmployeeDisplayLabel(e))}</option>` : '';
            }).join('');
            if (previous && filtered.some(e => attendanceEmployeeOptionValue(e) === previous)) {
                empSelect.value = previous;
            }
        }

        function selectAddModalStatus(status) {
            document.getElementById('addModalStatusInput').value = status;
            ['上班簽到', '下班簽退', '加班上班', '加班下班'].forEach(s => {
                const btn = document.getElementById(`btnAddStatus-${s}`);
                if (!btn) return;
                if (s === status) {
                    btn.className = "add-status-btn px-3 py-2 rounded-xl text-xs font-bold border border-indigo-500 bg-indigo-600 text-white shadow-md";
                } else {
                    btn.className = "add-status-btn px-3 py-2 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100";
                }
            });
        }

        function findManualPairTargetRecord(targetId, targetKey, targetTimeStr, expectedType = '') {
            const id = String(targetId || '').trim();
            const key = String(targetKey || '').trim();
            const time = String(targetTimeStr || '').trim();
            return (records || []).find(record => {
                if (expectedType && getAttendanceRecordType(record) !== expectedType) return false;
                return attendancePairRecordMatches(record, id, key, time);
            }) || null;
        }

        function linkManualPairLocally(newRecord) {
            if (!newRecord) return null;
            const type = getAttendanceRecordType(newRecord);
            let target = null;

            if (type === 'OUT') {
                target = findManualPairTargetRecord(
                    getManualPairClockInId(newRecord),
                    getManualPairClockInKey(newRecord),
                    getManualPairClockInTimeStr(newRecord),
                    'IN'
                );
                if (target) {
                    target.manualPairClockOutId = String(newRecord.id ?? '');
                    target.manualPairClockOutKey = getAttendanceStablePairKey(newRecord);
                    target.manualPairClockOutTimeStr = String(newRecord.timeStr || '');
                    target.manualPairLinkedAt = new Date().toISOString();
                }
            } else if (type === 'IN') {
                target = findManualPairTargetRecord(
                    getManualPairClockOutId(newRecord),
                    getManualPairClockOutKey(newRecord),
                    getManualPairClockOutTimeStr(newRecord),
                    'OUT'
                );
                if (target) {
                    target.manualPairClockInId = String(newRecord.id ?? '');
                    target.manualPairClockInKey = getAttendanceStablePairKey(newRecord);
                    target.manualPairClockInTimeStr = String(newRecord.timeStr || '');
                    target.manualPairLinkedAt = new Date().toISOString();
                }
            }

            return target;
        }

        function findExistingManualPairSiblings(record) {
            const anchor = getManualPairRecordAnchor(record);
            const type = getAttendanceRecordType(record);
            if (!anchor || (type !== 'IN' && type !== 'OUT')) return [];
            return (records || []).filter(candidate =>
                getAttendanceRecordType(candidate) === type &&
                getManualPairRecordAnchor(candidate) === anchor
            );
        }

        function getReplaceableManualPairSiblings(record) {
            const type = getAttendanceRecordType(record);
            if (type !== 'IN' && type !== 'OUT') return [];
            const anchor = getManualPairRecordAnchor(record);
            const groupKey = getManualPairGroupKey(record);
            if (!anchor && !groupKey) return [];
            return (records || []).filter(candidate => {
                if (!candidate || candidate === record) return false;
                if (getAttendanceRecordType(candidate) !== type) return false;
                const sameGroup = groupKey && getManualPairGroupKey(candidate) === groupKey;
                const sameAnchor = anchor && getManualPairRecordAnchor(candidate) === anchor;
                if (!sameGroup && !sameAnchor) return false;
                return isManualAdminAttendanceRecord(candidate);
            });
        }

        function deleteOldManualPairVersionsFromCloud(items) {
            const list = (Array.isArray(items) ? items : [])
                .filter(item =>
                    item &&
                    isManualAdminAttendanceRecord(item) &&
                    item.id !== null &&
                    item.id !== undefined &&
                    String(item.id).trim() !== ''
                );

            if (!list.length) return;

            // 延後送出，不阻塞 Modal。每筆使用原本 deleteRecord API，
            // 讓 GAS 同步 tombstone / Delta delete，避免 RAW 下次又把舊人工版本拉回。
            setTimeout(() => {
                list.forEach(item => {
                    try {
                        postToCloud(
                            {
                                action: 'deleteRecord',
                                id: item.id,
                                record: item,
                                reason: 'manual-pair-replaced'
                            },
                            '',
                            () => {
                                try { forgetRecentAttendanceMutation(item.id); } catch (e) {}
                            }
                        );
                    } catch (error) {
                        console.warn('刪除舊人工補卡版本失敗，待下次同步重試：', item?.id, error);
                    }
                });
            }, 40);
        }

        function collapseLocalManualPairSiblings(record) {
            const siblings = findExistingManualPairSiblings(record);
            if (!siblings.length) return { record, removed: [] };
            let keeper = record;
            const removed = [];
            siblings.forEach(candidate => {
                if (String(candidate?.id ?? '') === String(record?.id ?? '')) return;
                removed.push(candidate);
            });
            const removeSet = new Set(removed);
            if (removeSet.size) records = records.filter(item => !removeSet.has(item));
            removed.forEach(item => forgetRecentAttendanceMutation(item?.id));
            return { record: keeper, removed };
        }

        function saveAddModalRecord() {
            if (!requireAdminAction('attendanceCreate', '新增上下班打卡')) return;

            const confirmBtn = document.getElementById('btnConfirmAddRecord');
            if (confirmBtn?.disabled) return;

            const modal = document.getElementById('addRecordModal');
            repairAttendanceNamesInMemory();
            const lockedEmployeeKey = String(modal?.dataset?.p79LockedEmployeeKey || '').trim();
            const lockedEmpId = String(modal?.dataset?.p79LockedEmpId || '').trim();
            const selectedEmployeeKey = document.getElementById('addModalEmpSelect')?.value || '';
            const employeeKey = lockedEmployeeKey || lockedEmpId || selectedEmployeeKey;
            const emp = findAttendanceEmployeeByOptionValue(employeeKey);
            if (!emp) {
                showToast('請選擇有效的員工！', 'warning');
                return;
            }

            const dateVal = document.getElementById('addModalDateInput')?.value || '';
            const timeVal = get24HourTime('addModal');
            const statusVal = document.getElementById('addModalStatusInput')?.value || '';
            const noteVal = document.getElementById('addModalNoteInput')?.value.trim() || '';

            if (!dateVal || !timeVal) {
                showToast('請完整填寫日期與時間！', 'warning');
                return;
            }
            if (!statusVal) {
                showToast('請選擇補卡狀態！', 'warning');
                return;
            }

            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.dataset.originalText = confirmBtn.textContent || '➕ 確認補卡';
                confirmBtn.textContent = '⏳ 處理中…';
            }

            try {
                let pairIdentityTarget = pendingManualPairTargetRecordRef;

                // 若原物件已被 Delta / merge 換掉，先依鎖定 ID 找目前 records 裡的新物件；
                // 還是找不到才使用 snapshot。這樣補卡目標不會在 Modal 開啟後漂移。
                if (pairIdentityTarget) {
                    const lockedId = String(pairIdentityTarget?.id ?? '').trim();
                    if (lockedId) {
                        pairIdentityTarget = (records || []).find(
                            r => String(r?.id ?? '').trim() === lockedId
                        ) || pairIdentityTarget;
                    }
                }

                if (!pairIdentityTarget) {
                    pairIdentityTarget = statusVal === '上班簽到'
                        ? findManualPairTargetRecord(
                            pendingManualPairClockOutId,
                            pendingManualPairClockOutKey,
                            pendingManualPairClockOutTimeStr,
                            'OUT'
                        )
                        : (statusVal === '下班簽退'
                            ? findManualPairTargetRecord(
                                pendingManualPairClockInId,
                                pendingManualPairClockInKey,
                                pendingManualPairClockInTimeStr,
                                'IN'
                            )
                            : null);
                }

                if (!pairIdentityTarget && pendingManualPairTargetRecordSnapshot) {
                    pairIdentityTarget = { ...pendingManualPairTargetRecordSnapshot };
                }

                // V5.11.3：管理員補卡日期必須以實際選擇為準。
                // 舊版只要是從異常列「＋」進入，就會把日期強制改回原始 target 日期，
                // 造成 10/04 23:32 上班、補 10/05 下班時，下班又被寫回 10/04。
                // 現在只有輸入日期空白/無效時，才使用原始 target 日期作為備援。
                let effectiveDateVal = String(dateVal || '').trim();
                if (!/^\d{4}-\d{2}-\d{2}$/.test(effectiveDateVal) && pairIdentityTarget?.timeStr) {
                    const normalizedTargetTime = normalizeImportedAttendanceTime(pairIdentityTarget.timeStr);
                    const targetDateMatch = String(normalizedTargetTime || '')
                        .match(/^(\d{4})\/(\d{2})\/(\d{2})/);
                    if (targetDateMatch) {
                        effectiveDateVal =
                            `${targetDateMatch[1]}-${targetDateMatch[2]}-${targetDateMatch[3]}`;
                    }
                }

                const targetStableForGroup = pairIdentityTarget ? getAttendanceStablePairKey(pairIdentityTarget) : '';
                const targetTimeForGroup = pairIdentityTarget ? normalizeImportedAttendanceTime(pairIdentityTarget.timeStr) : '';
                const pairGroupKey = pairIdentityTarget
                    ? `PAIRGRP:${getAttendanceRecordType(pairIdentityTarget)}:${targetStableForGroup || targetTimeForGroup}`
                    : '';

                const newRecord = {
                    id: Date.now(),
                    attNo: pairIdentityTarget?.attNo ?? emp.attNo,
                    empId: pairIdentityTarget?.empId || emp.empId,
                    name: pairIdentityTarget?.name || emp.name,
                    dept: pairIdentityTarget?.dept || emp.dept || '一般',
                    timeStr: `${effectiveDateVal.replace(/-/g, '/')} ${timeVal}`,
                    status: statusVal,
                    location: '管理員手動補卡',
                    note: noteVal,
                    source: 'manual-admin',
                    manualPairGroupKey: pairGroupKey,
                    sourceEventKey: pairGroupKey
                        ? `${pairGroupKey}|TYPE:${statusVal === '上班簽到' ? 'IN' : 'OUT'}`
                        : '',
                    manuallyEdited: true,
                    manuallyEditedAt: new Date().toISOString(),
                    manualPairClockInId: statusVal === '下班簽退' ? pendingManualPairClockInId : '',
                    manualPairClockOutId: statusVal === '上班簽到' ? pendingManualPairClockOutId : '',
                    manualPairClockInKey: statusVal === '下班簽退' ? pendingManualPairClockInKey : '',
                    manualPairClockOutKey: statusVal === '上班簽到' ? pendingManualPairClockOutKey : '',
                    manualPairClockInTimeStr: statusVal === '下班簽退' ? pendingManualPairClockInTimeStr : '',
                    manualPairClockOutTimeStr: statusVal === '上班簽到' ? pendingManualPairClockOutTimeStr : ''
                };

                // V3.8：同一原始缺卡目標再次補卡 = 取代舊人工版本，不是再新增一個永久版本。
                // 只處理同 target anchor 且確定為管理員人工資料；原始打卡永遠保留。
                const existingSiblings = getReplaceableManualPairSiblings(newRecord);
                if (existingSiblings.length) {
                    const siblingSet = new Set(existingSiblings);
                    records = records.filter(item => !siblingSet.has(item));
                    existingSiblings.forEach(item => forgetRecentAttendanceMutation(item?.id));
                }

                try {
                    const newEventKey = getAttendanceImportEventKey(newRecord);
                    if (newEventKey) {
                        const kept = readLocalAttendanceDeleteTombstones().filter(item =>
                            String(item?.eventKey || '').trim() !== newEventKey
                        );
                        localStorage.setItem(
                            ATTENDANCE_LOCAL_DELETE_TOMBSTONES_KEY,
                            JSON.stringify(kept.slice(-500))
                        );
                    }
                } catch (e) {}

                // 若 target snapshot 不在目前 records，先補回同一 ID 的現行 target，
                // 讓本機立即配對一定有實體對象。
                if (pairIdentityTarget) {
                    const targetId = String(pairIdentityTarget?.id ?? '').trim();
                    const currentTarget = targetId
                        ? (records || []).find(r => String(r?.id ?? '').trim() === targetId)
                        : null;
                    if (!currentTarget && targetId) {
                        records.unshift(pairIdentityTarget);
                    }
                }

                const pairedTarget = linkManualPairLocally(newRecord) || pairIdentityTarget || null;

                // V5.2：若舊 link helper 因 metadata 差異沒找到 target，直接依鎖定 target 建立 reciprocal。
                if (pairedTarget) {
                    const newType = getAttendanceRecordType(newRecord);
                    if (newType === 'IN') {
                        pairedTarget.manualPairClockInId = String(newRecord.id ?? '');
                        pairedTarget.manualPairClockInKey = getAttendanceStablePairKey(newRecord);
                        pairedTarget.manualPairClockInTimeStr = String(newRecord.timeStr || '');
                    } else if (newType === 'OUT') {
                        pairedTarget.manualPairClockOutId = String(newRecord.id ?? '');
                        pairedTarget.manualPairClockOutKey = getAttendanceStablePairKey(newRecord);
                        pairedTarget.manualPairClockOutTimeStr = String(newRecord.timeStr || '');
                    }
                    pairedTarget.manualPairLinkedAt = new Date().toISOString();
                }

                // V5.1：補卡的「指定同列」建立獨立雙向 pair ID。
                // 不再只依賴舊 manualPairClockIn/Out metadata。
                if (pairedTarget) {
                    newRecord.v5PairTargetId = String(pairedTarget.id ?? '');
                    pairedTarget.v5PairTargetId = String(newRecord.id ?? '');
                    newRecord.v5PairLinkedAt = new Date().toISOString();
                    pairedTarget.v5PairLinkedAt = newRecord.v5PairLinkedAt;
                }

                records.unshift(newRecord);
                collapseLocalManualPairSiblings(newRecord);

                rememberRecentAttendanceMutation(newRecord, 'addRecord');
                if (pairedTarget) rememberRecentAttendanceMutation(pairedTarget, 'pairLink');

                // V5.10.15：補卡不再立即序列化整份 records。
                // 先排入 idle 持久化；最近異動／outbox 仍可保護尚未同步的這一筆。
                p79ScheduleAttendanceMutationPersist(
                    pairedTarget ? [newRecord, pairedTarget] : [newRecord]
                );

                // 先關閉 Modal + 只排一次畫面更新，不等待任何雲端回應。
                closeAddModal();
                p79ScheduleAttendanceMutationRender();
                p79ReturnToAttendanceAuditAfterMutation();
                showToast('補卡已加入，正在同步雲端…', 'success');

                // 雲端同樣非阻塞送出。
                setTimeout(() => {
                    postToCloud(
                        {
                            action: 'addRecord',
                            record: newRecord,
                            // V3.9：舊人工版本 ID 跟新補卡同一次送後端，後端在同一把考勤鎖內原子取代。
                            replaceIds: existingSiblings
                                .map(item => item?.id)
                                .filter(id => id !== null && id !== undefined && String(id).trim() !== '')
                        },
                        '已成功儲存補打卡紀錄！',
                        () => {
                            // 本機補卡已先呈現；雲端成功不再整表重繪。
                            try { window.p79UpdateAttendanceLiveProgress?.(); } catch (e) {}
                        }
                    );
                }, 20);

            } catch (error) {
                console.error('補卡失敗：', error);
                showToast('補卡失敗：' + (error?.message || error), 'warning');
            } finally {
                // Modal 若因錯誤仍開著，恢復按鈕；成功關閉後也不影響下次開啟。
                setTimeout(() => {
                    const btn = document.getElementById('btnConfirmAddRecord');
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = btn.dataset.originalText || '➕ 確認補卡';
                    }
                }, 100);
            }
        }

        function renderAdminLiveTable() {
            const tbody = document.getElementById('adminLiveTableBody');
            if (!tbody) return;

            const deptFilter = document.getElementById('liveDeptFilter').value;
            const jobTitleFilter = document.getElementById('liveJobTitleFilter').value;
            const empFilter = document.getElementById('liveEmpFilter').value;
            const statusFilter = document.getElementById('liveStatusFilter').value;
            const locationFilter = document.getElementById('liveLocationFilter').value;

            let filteredEmps = getAdminVisibleEmployees().filter(e => e.empId !== 'ADMIN');
            if (deptFilter !== 'ALL') filteredEmps = filteredEmps.filter(e => (e.dept || '一般') === deptFilter);
            if (jobTitleFilter !== 'ALL') filteredEmps = filteredEmps.filter(e => String(e.jobTitle || e.deptDetail || '未設定') === jobTitleFilter);
            if (empFilter !== 'ALL') filteredEmps = filteredEmps.filter(e => e.empId === empFilter);
            filteredEmps = sortEmployeesById(filteredEmps);

            const todayStr = new Date().toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '/');

            let liveRows = filteredEmps.map(emp => {
                const empRecs = records.filter(r => r.empId === emp.empId && r.timeStr.includes(todayStr.slice(0, 10)));
                empRecs.sort((a, b) => new Date(b.timeStr.replace(/-/g,'/')) - new Date(a.timeStr.replace(/-/g,'/')));
                const latest = empRecs.length > 0 ? empRecs[0] : null;
                const session = getEmployeeSessionSummary(emp);

                return {
                    emp: emp,
                    latestStatus: latest ? latest.status : 'NONE',
                    latestLocation: latest ? (formatAttendanceLocationDisplay(latest.location) || '--') : '尚未打卡',
                    latestTime: latest ? latest.timeStr : '',
                    session
                };
            });

            if (statusFilter !== 'ALL') {
                liveRows = liveRows.filter(r => r.latestStatus === statusFilter);
            }
            if (locationFilter !== 'ALL') {
                liveRows = liveRows.filter(r => r.latestLocation.includes(locationFilter));
            }

            const countEl = document.getElementById('liveFilterResultCount');
            if (countEl) countEl.textContent = `(符合條件共 ${liveRows.length} 位)`;

            let inCount = 0, outCount = 0;
            employees.forEach(emp => {
                if (emp.empId === 'ADMIN') return;
                const empRecs = records.filter(r => r.empId === emp.empId && r.timeStr.includes(todayStr.slice(0, 10)));
                if (empRecs.some(r => r.status.includes('簽到'))) inCount++;
                if (empRecs.some(r => r.status.includes('簽退'))) outCount++;
            });

            document.getElementById('statInCount').textContent = inCount;
            document.getElementById('statOutCount').textContent = outCount;
            document.getElementById('statTotalEmp').textContent = getAdminVisibleEmployees().filter(e => e.empId !== 'ADMIN').length;

            if (liveRows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-slate-400">🔍 目前尚無符合條件的即時動態</td></tr>`;
                return;
            }

            tbody.innerHTML = liveRows.map(row => {
                let badge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-semibold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">尚未打卡</span>`;
                if (row.latestStatus === '上班簽到') badge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">🟢 上班簽到 (${formatDateTime(row.latestTime)})</span>`;
                if (row.latestStatus === '下班簽退') badge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300">🔴 下班簽退 (${formatDateTime(row.latestTime)})</span>`;
                if (row.latestStatus === '加班上班') badge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">🟡 加班上班 (${formatDateTime(row.latestTime)})</span>`;
                if (row.latestStatus === '加班下班') badge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-semibold bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300">🟣 加班下班 (${formatDateTime(row.latestTime)})</span>`;

                return `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                        <td class="px-4 py-3 font-mono font-bold">${row.emp.attNo}</td>
                        <td class="px-4 py-3 font-semibold">${row.emp.name} <span class="text-[10px] text-slate-400 font-mono">(${row.emp.empId})</span></td>
                        <td class="px-4 py-3">${row.emp.dept || '一般'}</td>
                        <td class="px-4 py-3">${row.emp.jobTitle || row.emp.deptDetail || '--'}</td>
                        <td class="px-4 py-3">${badge}</td>
                        <td class="px-4 py-3 text-slate-500 text-[11px]">${row.latestLocation}</td>
                        <td class="px-4 py-3"><span class="px-2 py-1 rounded-lg text-[10px] font-bold ${row.session.online ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-300'}">${row.session.online ? '已登入' : '已登出'}</span></td>
                        <td class="px-4 py-3 font-mono text-[11px] whitespace-nowrap">${row.session.loginTime ? escapeHtml(formatDateTime(row.session.loginTime)) : '--'}</td>
                        <td class="px-4 py-3 font-mono text-[11px] whitespace-nowrap">${row.session.logoutTime ? escapeHtml(formatDateTime(row.session.logoutTime)) : '--'}</td>
                    </tr>
                `;
            }).join('');
        }

        let overtimeCurrentPage = 1;
        const OVERTIME_PAGE_SIZE = 50;
        const MIN_OVERTIME_MINUTES = 30;

        function formatDurationMinutes(totalMinutes) {
            const minutes = Math.max(0, Math.floor(Number(totalMinutes) || 0));
            const hours = Math.floor(minutes / 60);
            const remainder = minutes % 60;
            return `${hours} 小時${remainder ? ` ${remainder} 分` : ''}`;
        }

        function buildOvertimeStatisticsRows() {
            const visibleEmployees = getAdminVisibleEmployees().filter(emp => String(emp.empId || '').toUpperCase() !== 'ADMIN');
            const visibleEmployeeIds = new Set(visibleEmployees.map(emp => String(emp.empId || '').trim().toUpperCase()).filter(Boolean));
            const visibleAttendanceNumbers = new Set(visibleEmployees.map(emp => normalizeAttendanceStatsAttNo(emp.attNo)).filter(Boolean));
            const sourceRecords = records.filter(record => {
                if (!canCurrentAdminViewDataRow(record)) return false;
                const empId = String(record.empId || '').trim().toUpperCase();
                const attNo = normalizeAttendanceStatsAttNo(record.attNo);
                return (empId && visibleEmployeeIds.has(empId)) || (attNo && visibleAttendanceNumbers.has(attNo));
            });

            const rows = buildDailyAttendanceRows(sourceRecords)
                .filter(session => session.clockIn && session.clockOut)
                .map(session => {
                    const start = getAttendanceTimestamp(session.clockIn);
                    const end = getAttendanceTimestamp(session.clockOut);
                    const totalMinutes = Math.floor((end - start) / 60000);
                    // 每日延長時間 30 分鐘以內不列入加班；須超過 30 分鐘才計入。
                    if (!Number.isFinite(totalMinutes) || totalMinutes <= 480 + MIN_OVERTIME_MINUTES) return null;
                    const employee = findEmployeeForAttendanceIdentity(session, visibleEmployees);
                    if (!employee) return null;
                    const overtimeMinutes = totalMinutes - 480;
                    const monthKey = String(session.dateKey || '').slice(0, 7);
                    return {
                        ...session,
                        empId: employee.empId,
                        name: employee.name || session.name || '未命名',
                        dept: employee.dept || session.dept || '一般',
                        jobTitle: employee.jobTitle || employee.deptDetail || session.jobTitle || '未設定',
                        monthKey,
                        totalMinutes,
                        overtimeMinutes,
                        overDailyLimit: totalMinutes > 720
                    };
                })
                .filter(Boolean);

            return rows.sort((a, b) => b.sortTime - a.sortTime);
        }

        function replaceOvertimeOptions(element, allLabel, values, labelMap = null) {
            if (!element) return;
            const previous = element.value || 'ALL';
            const uniqueValues = [...new Set(values.map(value => String(value || '').trim()).filter(Boolean))];
            element.innerHTML = `<option value="ALL">${allLabel}</option>` + uniqueValues.map(value => `<option value="${escapeHtml(value)}">${escapeHtml(labelMap?.get(value) || value)}</option>`).join('');
            element.value = uniqueValues.includes(previous) ? previous : 'ALL';
        }

        function initOvertimeFilters() {
            const monthEl = document.getElementById('overtimeMonthFilter');
            const deptEl = document.getElementById('overtimeDeptFilter');
            const jobEl = document.getElementById('overtimeJobTitleFilter');
            const employeeEl = document.getElementById('overtimeEmployeeFilter');
            if (!monthEl || !deptEl || !jobEl || !employeeEl) return;
            const rows = buildOvertimeStatisticsRows();
            const months = [...new Set(rows.map(row => row.monthKey).filter(Boolean))].sort().reverse();
            replaceOvertimeOptions(monthEl, '全部月份', months);
            let scopedRows = monthEl.value === 'ALL' ? rows : rows.filter(row => row.monthKey === monthEl.value);
            replaceOvertimeOptions(deptEl, '全部部門', scopedRows.map(row => row.dept).sort((a, b) => a.localeCompare(b, 'zh-Hant')));
            if (deptEl.value !== 'ALL') scopedRows = scopedRows.filter(row => row.dept === deptEl.value);
            replaceOvertimeOptions(jobEl, '全部職務', scopedRows.map(row => row.jobTitle).sort((a, b) => a.localeCompare(b, 'zh-Hant')));
            if (jobEl.value !== 'ALL') scopedRows = scopedRows.filter(row => row.jobTitle === jobEl.value);
            const nameMap = new Map();
            scopedRows.forEach(row => nameMap.set(String(row.empId), row.name));
            replaceOvertimeOptions(employeeEl, '全部姓名', [...nameMap.keys()], nameMap);
        }

        function onOvertimeMonthChange() {
            ['overtimeDeptFilter','overtimeJobTitleFilter','overtimeEmployeeFilter'].forEach(id => { const el = document.getElementById(id); if (el) el.value = 'ALL'; });
            overtimeCurrentPage = 1;
            initOvertimeFilters();
            renderOvertimeStats();
        }

        function onOvertimeDeptChange() {
            ['overtimeJobTitleFilter','overtimeEmployeeFilter'].forEach(id => { const el = document.getElementById(id); if (el) el.value = 'ALL'; });
            overtimeCurrentPage = 1;
            initOvertimeFilters();
            renderOvertimeStats();
        }

        function onOvertimeJobTitleChange() {
            const employeeEl = document.getElementById('overtimeEmployeeFilter');
            if (employeeEl) employeeEl.value = 'ALL';
            overtimeCurrentPage = 1;
            initOvertimeFilters();
            renderOvertimeStats();
        }

        function onOvertimeEmployeeChange() {
            overtimeCurrentPage = 1;
            renderOvertimeStats();
        }

        function resetOvertimeFilters() {
            ['overtimeMonthFilter','overtimeDeptFilter','overtimeJobTitleFilter','overtimeEmployeeFilter'].forEach(id => { const el = document.getElementById(id); if (el) el.value = 'ALL'; });
            overtimeCurrentPage = 1;
            initOvertimeFilters();
            renderOvertimeStats();
        }

        function goToOvertimePage(page) {
            overtimeCurrentPage = Math.max(1, Number(page) || 1);
            renderOvertimeStats();
        }

        function renderOvertimeStats() {
            const tbody = document.getElementById('overtimeTableBody');
            if (!tbody) return;
            initOvertimeFilters();
            const month = document.getElementById('overtimeMonthFilter')?.value || 'ALL';
            const dept = document.getElementById('overtimeDeptFilter')?.value || 'ALL';
            const jobTitle = document.getElementById('overtimeJobTitleFilter')?.value || 'ALL';
            const employeeId = document.getElementById('overtimeEmployeeFilter')?.value || 'ALL';
            let rows = buildOvertimeStatisticsRows().filter(row =>
                (month === 'ALL' || row.monthKey === month) &&
                (dept === 'ALL' || row.dept === dept) &&
                (jobTitle === 'ALL' || row.jobTitle === jobTitle) &&
                (employeeId === 'ALL' || String(row.empId) === employeeId)
            );
            const uniqueEmployees = new Set(rows.map(row => String(row.empId || row.attNo || row.name))).size;
            const totalOvertimeMinutes = rows.reduce((total, row) => total + row.overtimeMinutes, 0);
            const over12Count = rows.filter(row => row.overDailyLimit).length;
            document.getElementById('overtimeEmployeeCount').textContent = uniqueEmployees;
            document.getElementById('overtimeShiftCount').textContent = rows.length;
            document.getElementById('overtimeTotalHours').textContent = formatDurationMinutes(totalOvertimeMinutes);
            document.getElementById('overtimeOver12Count').textContent = over12Count;
            document.getElementById('overtimeFilterResultCount').textContent = `(符合條件共 ${rows.length} 個班次)`;

            const totalPages = Math.max(1, Math.ceil(rows.length / OVERTIME_PAGE_SIZE));
            overtimeCurrentPage = Math.min(Math.max(1, overtimeCurrentPage), totalPages);
            const startIndex = (overtimeCurrentPage - 1) * OVERTIME_PAGE_SIZE;
            const pageRows = rows.slice(startIndex, startIndex + OVERTIME_PAGE_SIZE);
            const allowAttendanceEdit = canPerformAdminAction(currentEmp, 'attendanceEdit');
            tbody.innerHTML = pageRows.length ? pageRows.map(row => {
                const clockInCell = formatEditableAttendanceTimeCell(row.clockIn, 'IN', allowAttendanceEdit);
                const clockOutCell = formatEditableAttendanceTimeCell(row.clockOut, 'OUT', allowAttendanceEdit);
                return `<tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition ${row.overDailyLimit ? 'bg-rose-50/60 dark:bg-rose-950/10' : ''}">
                    <td class="px-3 py-3 font-mono whitespace-nowrap">${escapeHtml(String(row.dateKey || '').replace(/-/g, '/'))}</td>
                    <td class="px-3 py-3 font-bold whitespace-nowrap">${escapeHtml(row.name)}</td>
                    <td class="px-3 py-3">${escapeHtml(row.dept)}</td>
                    <td class="px-3 py-3">${escapeHtml(row.jobTitle)}</td>
                    <td class="px-3 py-3 font-mono whitespace-nowrap">${clockInCell}</td>
                    <td class="px-3 py-3 font-mono whitespace-nowrap">${clockOutCell}</td>
                    <td class="px-3 py-3 font-bold whitespace-nowrap">${formatDurationMinutes(row.totalMinutes)}</td>
                    <td class="px-3 py-3 font-black text-indigo-700 dark:text-indigo-300 whitespace-nowrap">${formatDurationMinutes(row.overtimeMinutes)}</td>
                </tr>`;
            }).join('') : '<tr><td colspan="8" class="p-8 text-center text-slate-400">目前沒有符合條件、且已完整簽到簽退的加班班次</td></tr>';

            const pagination = document.getElementById('overtimePagination');
            if (pagination) pagination.innerHTML = `<span class="text-[11px] text-slate-500 dark:text-slate-400">共 ${rows.length} 筆｜第 ${overtimeCurrentPage} / ${totalPages} 頁｜每頁 50 筆</span><div class="flex gap-2"><button type="button" onclick="goToOvertimePage(${overtimeCurrentPage - 1})" ${overtimeCurrentPage <= 1 ? 'disabled' : ''} class="px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-200 dark:border-slate-700 disabled:opacity-40">上一頁</button><button type="button" onclick="goToOvertimePage(${overtimeCurrentPage + 1})" ${overtimeCurrentPage >= totalPages ? 'disabled' : ''} class="px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-200 dark:border-slate-700 disabled:opacity-40">下一頁</button></div>`;
        }

        function openOvertimePolicyModal() {
            const modal = document.getElementById('overtimePolicyModal');
            if (!modal) return;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeOvertimePolicyModal() {
            const modal = document.getElementById('overtimePolicyModal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function getCurrentYearMonthValue() {
            const now = new Date();
            return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
        }

        function initAttendanceStatsFilters() {
            const monthEl = document.getElementById('attendanceStatsMonth');
            const deptEl = document.getElementById('attendanceStatsDept');
            const jobEl = document.getElementById('attendanceStatsJobTitle');
            const employeeEl = document.getElementById('attendanceStatsEmployee');
            if (!monthEl || !deptEl || !jobEl || !employeeEl) return;
            if (!monthEl.value) monthEl.value = getCurrentYearMonthValue();

            const visibleEmployees = sortEmployeesById(
                getAdminVisibleEmployees().filter(emp => String(emp.empId || '').toUpperCase() !== 'ADMIN')
            );
            const fillOptions = (element, allLabel, items, valueGetter, labelGetter) => {
                const current = element.value || 'ALL';
                const unique = [];
                const seen = new Set();
                items.forEach(item => {
                    const value = String(valueGetter(item) || '').trim();
                    if (!value || seen.has(value)) return;
                    seen.add(value);
                    unique.push({ value, label: String(labelGetter(item) || value) });
                });
                element.innerHTML = `<option value="ALL">${allLabel}</option>` + unique.map(item => `<option value="${escapeHtml(item.value)}">${escapeHtml(item.label)}</option>`).join('');
                element.value = unique.some(item => item.value === current) ? current : 'ALL';
            };

            fillOptions(
                deptEl,
                '全部部門',
                [...visibleEmployees].sort((a, b) => String(a.dept || '一般').localeCompare(String(b.dept || '一般'), 'zh-Hant')),
                emp => emp.dept || '一般',
                emp => emp.dept || '一般'
            );

            const dept = deptEl.value || 'ALL';
            const departmentEmployees = visibleEmployees.filter(emp => dept === 'ALL' || String(emp.dept || '一般') === dept);
            fillOptions(
                jobEl,
                '全部職務',
                [...departmentEmployees].sort((a, b) => String(a.jobTitle || a.deptDetail || '').localeCompare(String(b.jobTitle || b.deptDetail || ''), 'zh-Hant')),
                emp => emp.jobTitle || emp.deptDetail || '未設定',
                emp => emp.jobTitle || emp.deptDetail || '未設定'
            );

            const jobTitle = jobEl.value || 'ALL';
            const jobEmployees = departmentEmployees.filter(emp => jobTitle === 'ALL' || String(emp.jobTitle || emp.deptDetail || '未設定') === jobTitle);
            fillOptions(
                employeeEl,
                '全部姓名',
                jobEmployees,
                emp => emp.empId,
                emp => `${emp.name || '未命名'}（${emp.empId || '--'}）`
            );
        }

        function onAttendanceStatsMonthChange() {
            resetFilterControls(['attendanceStatsDept', 'attendanceStatsJobTitle', 'attendanceStatsEmployee']);
            initAttendanceStatsFilters();
            renderAttendanceStatsTable();
        }

        function onAttendanceStatsDeptChange() {
            const jobEl = document.getElementById('attendanceStatsJobTitle');
            const employeeEl = document.getElementById('attendanceStatsEmployee');
            if (jobEl) jobEl.value = 'ALL';
            if (employeeEl) employeeEl.value = 'ALL';
            initAttendanceStatsFilters();
            renderAttendanceStatsTable();
        }

        function onAttendanceStatsJobTitleChange() {
            const employeeEl = document.getElementById('attendanceStatsEmployee');
            if (employeeEl) employeeEl.value = 'ALL';
            initAttendanceStatsFilters();
            renderAttendanceStatsTable();
        }

        function resetAttendanceStatsFilters() {
            const monthEl = document.getElementById('attendanceStatsMonth');
            if (monthEl) monthEl.value = getCurrentYearMonthValue();
            ['attendanceStatsDept', 'attendanceStatsJobTitle', 'attendanceStatsEmployee'].forEach(id => {
                const element = document.getElementById(id);
                if (element) element.value = 'ALL';
            });
            initAttendanceStatsFilters();
            renderAttendanceStatsTable();
        }

        function normalizeAttendanceStatsAttNo(value) {
            const raw = String(value == null ? '' : value).trim();
            if (!raw) return '';
            const numeric = Number(raw);
            return Number.isFinite(numeric) ? String(Math.trunc(numeric)) : raw.toUpperCase();
        }

        function buildAttendanceDayMapByShift(visibleEmployees, year, month) {
            const attendanceDays = new Map(visibleEmployees.map(emp => [String(emp.empId || ''), new Set()]));
            const visibleRecords = records.filter(canCurrentAdminViewDataRow);

            // 以完整班次統計，而不是逐筆原始刷卡統計。
            // 班次所屬月份以「上班簽到日」為準，因此 9/30 23:35 至 10/1 07:48 只計入 9 月 30 日。
            buildDailyAttendanceRows(visibleRecords).forEach(session => {
                const dateMatch = String(session.dateKey || '').match(/^(\d{4})\/(\d{2})\/(\d{2})$/);
                if (!dateMatch || Number(dateMatch[1]) !== year || Number(dateMatch[2]) !== month) return;
                const emp = findEmployeeForAttendanceIdentity(session, visibleEmployees);
                if (!emp) return;
                attendanceDays.get(String(emp.empId || ''))?.add(Number(dateMatch[3]));
            });
            return attendanceDays;
        }

        function renderAttendanceStatsTable() {
            const head = document.getElementById('attendanceStatsTableHead');
            const body = document.getElementById('attendanceStatsTableBody');
            const summary = document.getElementById('attendanceStatsSummary');
            const monthEl = document.getElementById('attendanceStatsMonth');
            if (!head || !body || !summary || !monthEl) return;

            initAttendanceStatsFilters();
            const monthValue = monthEl.value || getCurrentYearMonthValue();
            const match = monthValue.match(/^(\d{4})-(\d{2})$/);
            if (!match) return;
            const year = Number(match[1]);
            const month = Number(match[2]);
            const daysInMonth = new Date(year, month, 0).getDate();
            const selectedDept = document.getElementById('attendanceStatsDept')?.value || 'ALL';
            const selectedJob = document.getElementById('attendanceStatsJobTitle')?.value || 'ALL';
            const selectedEmployee = document.getElementById('attendanceStatsEmployee')?.value || 'ALL';

            let visibleEmployees = getAdminVisibleEmployees().filter(emp => String(emp.empId || '').toUpperCase() !== 'ADMIN');
            visibleEmployees = sortEmployeesById(visibleEmployees.filter(emp =>
                (selectedDept === 'ALL' || String(emp.dept || '一般') === selectedDept) &&
                (selectedJob === 'ALL' || String(emp.jobTitle || emp.deptDetail || '未設定') === selectedJob) &&
                (selectedEmployee === 'ALL' || String(emp.empId || '') === selectedEmployee)
            ));

            const attendanceDays = buildAttendanceDayMapByShift(visibleEmployees, year, month);

            const dayHeaders = Array.from({ length: 31 }, (_, index) => {
                const day = index + 1;
                const unavailable = day > daysInMonth;
                return `<th class="p79-stats-day-head border-l border-slate-200 dark:border-slate-700 ${unavailable ? 'bg-slate-200/70 dark:bg-slate-950 text-slate-400' : ''}">${day}</th>`;
            }).join('');
            head.innerHTML = `<tr>
                <th class="p79-stats-dept-head sticky z-20 bg-slate-100 dark:bg-slate-900">部門</th>
                <th class="p79-stats-job-head sticky z-20 bg-slate-100 dark:bg-slate-900">職務</th>
                <th class="p79-stats-person-head sticky z-20 bg-slate-100 dark:bg-slate-900">姓名／工號</th>
                ${dayHeaders}
                <th class="p79-stats-total-head sticky right-0 z-20 border-l-2 border-indigo-200 dark:border-indigo-800 bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300">結算天數</th>
            </tr>`;

            if (!visibleEmployees.length) {
                body.innerHTML = `<tr><td colspan="35" class="p-8 text-center text-slate-400">🔍 沒有符合篩選條件的員工</td></tr>`;
                summary.textContent = `${year} 年 ${month} 月｜沒有符合篩選條件的員工`;
                return;
            }

            let totalAttendanceDays = 0;
            body.innerHTML = visibleEmployees.map(emp => {
                const days = attendanceDays.get(String(emp.empId || '')) || new Set();
                totalAttendanceDays += days.size;
                const dayCells = Array.from({ length: 31 }, (_, index) => {
                    const day = index + 1;
                    if (day > daysInMonth) return `<td class="p79-stats-day-cell border-l border-slate-100 dark:border-slate-700 bg-slate-100/70 dark:bg-slate-950/60 text-slate-300 dark:text-slate-600">×</td>`;
                    if (days.has(day)) return `<td class="p79-stats-day-cell border-l border-slate-100 dark:border-slate-700 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-black">V</td>`;
                    return `<td class="p79-stats-day-cell border-l border-slate-100 dark:border-slate-700 text-slate-300 dark:text-slate-600">—</td>`;
                }).join('');
                return `<tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40">
                    <td class="p79-stats-dept-cell sticky z-10 font-semibold bg-white dark:bg-slate-800">${escapeHtml(emp.dept || '一般')}</td>
                    <td class="p79-stats-job-cell sticky z-10 bg-white dark:bg-slate-800">${escapeHtml(emp.jobTitle || emp.deptDetail || '未設定')}</td>
                    <td class="p79-stats-person-cell sticky z-10 bg-white dark:bg-slate-800"><span class="p79-stats-person-name font-bold">${escapeHtml(emp.name || '未命名')}</span><span class="p79-stats-person-id font-mono text-slate-400">${escapeHtml(emp.empId || '--')}</span></td>
                    ${dayCells}
                    <td class="p79-stats-total-cell sticky right-0 z-10 border-l-2 border-indigo-100 dark:border-indigo-900 bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 font-black">${days.size}</td>
                </tr>`;
            }).join('');

            summary.textContent = `${year} 年 ${month} 月｜顯示 ${visibleEmployees.length} 人｜合計 ${totalAttendanceDays} 人次出勤日`;
        }

        function exportAttendanceStatsExcel() {
            if (!requireAdminAction('attendanceExport', '匯出出勤天數統計')) return;
            if (!ensureExcelLibrary()) return;
            initAttendanceStatsFilters();

            const monthValue = document.getElementById('attendanceStatsMonth')?.value || getCurrentYearMonthValue();
            const monthMatch = monthValue.match(/^(\d{4})-(\d{2})$/);
            if (!monthMatch) {
                showToast('請先選擇統計年月', 'warning');
                return;
            }
            const year = Number(monthMatch[1]);
            const month = Number(monthMatch[2]);
            const daysInMonth = new Date(year, month, 0).getDate();
            const selectedDept = document.getElementById('attendanceStatsDept')?.value || 'ALL';
            const selectedJob = document.getElementById('attendanceStatsJobTitle')?.value || 'ALL';
            const selectedEmployee = document.getElementById('attendanceStatsEmployee')?.value || 'ALL';

            let visibleEmployees = getAdminVisibleEmployees().filter(emp => String(emp.empId || '').toUpperCase() !== 'ADMIN');
            visibleEmployees = sortEmployeesById(visibleEmployees.filter(emp =>
                (selectedDept === 'ALL' || String(emp.dept || '一般') === selectedDept) &&
                (selectedJob === 'ALL' || String(emp.jobTitle || emp.deptDetail || '未設定') === selectedJob) &&
                (selectedEmployee === 'ALL' || String(emp.empId || '') === selectedEmployee)
            ));
            if (!visibleEmployees.length) {
                showToast('沒有符合目前篩選條件的員工資料', 'warning');
                return;
            }

            const attendanceDays = buildAttendanceDayMapByShift(visibleEmployees, year, month);

            const dayHeaders = Array.from({ length: 31 }, (_, index) => `${index + 1}日`);
            const sheetRows = [['公司', '完整工號', '姓名', '部門', '職務', ...dayHeaders, '結算天數']];
            visibleEmployees.forEach(emp => {
                const empId = String(emp.empId || '');
                const company = empId.match(/^([A-Za-z]+)/)?.[1]?.toUpperCase() || '';
                const days = attendanceDays.get(empId) || new Set();
                const dailyValues = Array.from({ length: 31 }, (_, index) => {
                    const day = index + 1;
                    if (day > daysInMonth) return '';
                    return days.has(day) ? 'V' : '';
                });
                sheetRows.push([
                    company, empId, emp.name || '', emp.dept || '一般', emp.jobTitle || emp.deptDetail || '未設定',
                    ...dailyValues, days.size
                ]);
            });

            const worksheet = XLSX.utils.aoa_to_sheet(sheetRows);
            worksheet['!cols'] = [8, 16, 14, 16, 14, ...Array.from({ length: 31 }, () => 5), 10].map(wch => ({ wch }));
            worksheet['!autofilter'] = { ref: `A1:AK${sheetRows.length}` };
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, `${year}-${String(month).padStart(2, '0')}出勤統計`);
            XLSX.writeFile(workbook, `出勤天數統計_${monthValue}.xlsx`);
            showToast('出勤天數統計 Excel 匯出成功！', 'success');
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function initEmployeeFilters() {
            const visibleEmployees = getAdminVisibleEmployees();
            const deptEl = document.getElementById('employeeDeptFilter');
            const jobTitleEl = document.getElementById('employeeJobTitleFilter');
            const nameEl = document.getElementById('employeeNameFilter');
            if (!deptEl || !jobTitleEl || !nameEl) return;

            const setOptions = (el, allText, values) => {
                const current = el.value || 'ALL';
                const uniqueValues = [...new Set(values.filter(Boolean))]
                    .sort((a,b) => a.localeCompare(b, 'zh-Hant', { numeric: true }));
                el.innerHTML = `<option value="ALL">${allText}</option>` + uniqueValues.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');
                el.value = uniqueValues.includes(current) ? current : 'ALL';
            };

            setOptions(deptEl, '全部部門', visibleEmployees.map(e => String(e.dept || '一般')));
            const selectedDept = deptEl.value || 'ALL';
            const departmentEmployees = visibleEmployees.filter(e => selectedDept === 'ALL' || String(e.dept || '一般') === selectedDept);
            setOptions(jobTitleEl, '全部職務', departmentEmployees.map(e => String(e.jobTitle || e.deptDetail || '')).filter(Boolean));
            const selectedJobTitle = jobTitleEl.value || 'ALL';
            const jobEmployees = departmentEmployees.filter(e => selectedJobTitle === 'ALL' || String(e.jobTitle || e.deptDetail || '') === selectedJobTitle);
            setOptions(nameEl, '全部姓名', jobEmployees.map(e => String(e.name || '')).filter(Boolean));
        }

        function onEmployeeDeptFilterChange() {
            resetFilterControls(['employeeJobTitleFilter', 'employeeNameFilter', 'employeeAdminRoleFilter']);
            renderAdminEmployeeTable();
        }

        function onEmployeeJobTitleFilterChange() {
            resetFilterControls(['employeeNameFilter', 'employeeAdminRoleFilter']);
            renderAdminEmployeeTable();
        }

        function onEmployeeNameFilterChange() {
            resetFilterControls(['employeeAdminRoleFilter']);
            renderAdminEmployeeTable();
        }

        function resetEmployeeFilters() {
            ['employeeDeptFilter','employeeJobTitleFilter','employeeNameFilter','employeeAdminRoleFilter'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = 'ALL';
            });
            renderAdminEmployeeTable();
        }

        function renderAdminEmployeeTable() {
            const tbody = document.getElementById('adminEmpTableBody');
            if (!tbody) return;
            initEmployeeFilters();
            const allowManage = !isAdminLoggedIn || !currentEmp || canManageEmployeeList(currentEmp);
            const dept = document.getElementById('employeeDeptFilter')?.value || 'ALL';
            const jobTitle = document.getElementById('employeeJobTitleFilter')?.value || 'ALL';
            const name = document.getElementById('employeeNameFilter')?.value || 'ALL';
            const adminRole = document.getElementById('employeeAdminRoleFilter')?.value || 'ALL';
            const visibleEmployees = getAdminVisibleEmployees();
            const filteredEmployees = sortEmployeesById(visibleEmployees.filter(emp =>
                (dept === 'ALL' || String(emp.dept || '一般') === dept) &&
                (jobTitle === 'ALL' || String(emp.jobTitle || emp.deptDetail || '') === jobTitle) &&
                (name === 'ALL' || String(emp.name ?? '') === name) &&
                (adminRole === 'ALL' || normalizeAdminRole(emp.adminRole, emp) === adminRole)
            ));
            const countEl = document.getElementById('employeeFilterResultCount');
            if (countEl) countEl.textContent = `顯示 ${filteredEmployees.length} / ${visibleEmployees.length} 人`;

            if (!filteredEmployees.length) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-slate-400">🔍 沒有符合篩選條件的員工</td></tr>`;
                return;
            }

            tbody.innerHTML = filteredEmployees.map(emp => {
                const empRole = normalizeAdminRole(emp.adminRole, emp);
                const isSuper = empRole === 'superadmin';
                const isManager = empRole === 'admin';
                const roleMark = isSuper
                    ? `<span class="inline-flex items-center mr-1.5 px-1.5 py-0.5 rounded-md bg-amber-100 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 text-[10px] font-extrabold" title="超級管理員">👑 超級管理員</span>`
                    : (isManager ? `<span class="inline-flex items-center mr-1.5 px-1.5 py-0.5 rounded-md bg-indigo-100 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 text-[10px] font-extrabold" title="管理員">🛡️ 管理員</span>` : '');
                let deviceBadge = emp.deviceId ? `<span class="text-[10px] font-mono text-emerald-600 bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 rounded">已綁定</span> ${allowManage ? `<button onclick="resetEmpDevice('${emp.empId}')" class="text-[10px] text-rose-600 hover:underline ml-1">解除／更換手機</button>` : ''}` : `<span class="text-[10px] text-slate-400">尚未綁定（下次打卡自動綁定）</span>`;
                if (isSuper) deviceBadge = `<span class="text-[10px] text-amber-600 font-bold">超級管理員免綁定</span>`;

                return `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                        <td class="px-4 py-3 font-mono font-bold">${emp.attNo}</td>
                        <td class="px-4 py-3 font-mono font-semibold">${emp.empId}</td>
                        <td class="px-4 py-3 font-bold text-indigo-600 dark:text-indigo-400">${roleMark}${emp.name}</td>
                        <td class="px-4 py-3">${emp.dept || '一般'}</td>
                        <td class="px-4 py-3 font-semibold">${emp.jobTitle || emp.deptDetail || '--'}</td>
                        <td class="px-4 py-3 font-mono text-xs">${normalizePhoneNumber(emp.phone) || '--'}</td>
                        <td class="px-4 py-3 text-[11px] text-slate-500">到職: ${emp.startDate ? formatDateOnly(emp.startDate) : '--'}<br>生日: ${emp.birthday ? formatDateOnly(emp.birthday) : '--'}</td>
                        <td class="px-4 py-3">${deviceBadge}</td>
                        <td class="px-4 py-3 space-x-2">
                            ${allowManage ? `<button onclick="openEmployeeEditModal('${emp.empId}', 'edit')" class="px-2.5 py-1 bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-300 rounded text-[10px] font-bold">編輯／調動</button>` : '<span class="text-[10px] text-slate-400 font-semibold">僅供觀看</span>'}
                            ${allowManage && emp.empId !== 'ADMIN' ? `<button onclick="deleteEmployee('${emp.empId}')" class="px-2.5 py-1 bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 rounded text-[10px] font-bold">刪除</button>` : ''}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function resetEmpDevice(empId) {
            if (isAdminLoggedIn && currentEmp && !canManageEmployeeList(currentEmp)) { showToast('此帳號的員工清單權限為「只能觀看」，不可解除裝置綁定', 'warning'); return; }
            const emp = employees.find(e => e.empId === empId);
            if (emp) {
                if (!confirm(`確定要解除「${emp.name}」目前的手機綁定嗎？\n解除後，下一次成功打卡的手機會自動成為新綁定手機。`)) return;
                try {
                    if (sysConfig.gasUrl) {
                        const payload = { action: 'unbindEmployeeDevice', empId: emp.empId };
                        const result = await performCloudRequest(payload);
                        if (!result?.ok) throw new Error(result?.error || '雲端拒絕解除綁定');
                    }
                    emp.deviceId = '';
                    saveEmployees();
                    renderAdminEmployeeTable();
                    showToast(`已解除 ${emp.name} 的裝置綁定；下一次打卡會綁定新手機`, 'success');
                    if (sysConfig.gasUrl) await loadCloudData(false, true);
                } catch (error) {
                    showToast(`解除手機失敗：${error?.message || error}。雲端資料未變更，請重新整理後再試。`, 'warning');
                }
            }
        }

        function updateEmployeeDeptDetailOptions(selectedValue = '') {
            const deptEl = document.getElementById('empModalDept');
            const detailEl = document.getElementById('empModalDeptDetail');
            const labelEl = document.getElementById('empModalDeptDetailLabel');
            const hintEl = document.getElementById('empModalDeptDetailHint');
            if (!deptEl || !detailEl) return;
            const dept = deptEl.value;
            const options = normalizeJobTitles(sysConfig.jobTitles);
            if (labelEl) labelEl.innerHTML = '職務 <span class="text-rose-500">*</span>';
            if (hintEl) hintEl.textContent = `${dept || '目前部門'}：可直接調整職務，例如 AQC 轉為 ARMG`;
            detailEl.innerHTML = options.map(v => `<option value="${v}">${v}</option>`).join('');
            if (selectedValue && !options.includes(selectedValue)) {
                const option = document.createElement('option');
                option.value = selectedValue;
                option.textContent = selectedValue;
                detailEl.appendChild(option);
            }
            if (selectedValue) detailEl.value = selectedValue;
        }

        function openEmployeeEditModal(empId, mode) {
            if (isAdminLoggedIn && currentEmp && !canManageEmployeeList(currentEmp)) {
                showToast('此帳號的員工清單權限為「只能觀看」，不可新增或修改員工資料', 'warning');
                return;
            }
            if (isAdminLoggedIn && !isCurrentViewerSuperAdmin()) {
                if (mode === 'admin') { showToast('一般管理員不能新增超級管理員', 'warning'); return; }
                const target = empId ? employees.find(e => e.empId === empId) : null;
                if (target && !canCurrentAdminViewEmployee(target)) { showToast('無權查看或修改管理員資料', 'warning'); return; }
            }
            const modal = document.getElementById('employeeModal');
            refreshDepartmentControls();
            if (mode === 'admin') {
                document.getElementById('empModalTitle').textContent = '👑 新增超級管理員';
                document.getElementById('empEditOriginalId').value = '';
                document.getElementById('empModalAttNo').value = employees.length + 1;
                document.getElementById('empModalEmpId').value = 'BOSS' + Math.floor(Math.random() * 900 + 100);
                document.getElementById('empModalName').value = '';
                document.getElementById('empModalDept').value = sysConfig.departments.includes('第二事業部') ? '第二事業部' : sysConfig.departments[0];
                updateEmployeeDeptDetailOptions('經理');
                document.getElementById('empModalPhone').value = '';
                document.getElementById('empModalStartDate').value = '';
                document.getElementById('empModalBirthday').value = '';
                document.getElementById('empModalPassword').value = 'password';
                setEmployeePermissionFields({ adminRole: 'superadmin', monitorPermissions: [...ADMIN_MONITOR_OPTIONS], employeeListAccess: 'manage' });
            } else if (empId) {
                const emp = employees.find(e => e.empId === empId);
                if (!emp) return;
                document.getElementById('empModalTitle').textContent = '✏️ 編輯員工資料';
                document.getElementById('empEditOriginalId').value = emp.empId;
                document.getElementById('empModalAttNo').value = emp.attNo || '';
                document.getElementById('empModalEmpId').value = emp.empId || '';
                document.getElementById('empModalName').value = emp.name || '';
                if (emp.dept && !sysConfig.departments.includes(emp.dept)) {
                    sysConfig.departments = normalizeDepartments([...sysConfig.departments, emp.dept]);
                    saveConfig();
                    refreshDepartmentControls(emp.dept);
                }
                document.getElementById('empModalDept').value = emp.dept || sysConfig.departments[0];
                updateEmployeeDeptDetailOptions(emp.jobTitle || emp.deptDetail || '');
                document.getElementById('empModalPhone').value = emp.phone || '';
                document.getElementById('empModalStartDate').value = emp.startDate || '';
                document.getElementById('empModalBirthday').value = emp.birthday || '';
                document.getElementById('empModalPassword').value = emp.password || '';
                setEmployeePermissionFields(emp);
            } else {
                document.getElementById('empModalTitle').textContent = '👤 新增員工資料';
                document.getElementById('empEditOriginalId').value = '';
                document.getElementById('empModalAttNo').value = employees.length + 1;
                document.getElementById('empModalEmpId').value = 'EMP' + Math.floor(Math.random() * 9000 + 1000);
                document.getElementById('empModalName').value = '';
                document.getElementById('empModalDept').value = sysConfig.departments.includes('79W作業課') ? '79W作業課' : sysConfig.departments[0];
                updateEmployeeDeptDetailOptions('AQC');
                document.getElementById('empModalPhone').value = '';
                document.getElementById('empModalStartDate').value = '';
                document.getElementById('empModalBirthday').value = '';
                document.getElementById('empModalPassword').value = '';
            setEmployeePermissionFields({ adminRole: 'employee', monitorPermissions: [] });
            }
            const roleSelect = document.getElementById('empModalAdminRole');
            if (roleSelect) roleSelect.disabled = isAdminLoggedIn && !isCurrentViewerSuperAdmin();
            modal.classList.remove('hidden');
        }

        function closeEmployeeModal() {
            document.getElementById('employeeModal').classList.add('hidden');
        }

        function saveEmployeeModal() {
            if (isAdminLoggedIn && currentEmp && !canManageEmployeeList(currentEmp)) { showToast('此帳號的員工清單權限為「只能觀看」，不可修改員工資料', 'warning'); return; }
            const permissionFields = collectEmployeePermissionFields();
            const originalId = document.getElementById('empEditOriginalId').value;
            const empId = document.getElementById('empModalEmpId').value.trim().toUpperCase();
            const attNo = normalizeAttendanceNumber(
                document.getElementById('empModalAttNo').value || String(employees.length + 1),
                empId
            );
            const name = document.getElementById('empModalName').value.trim();
            const dept = document.getElementById('empModalDept').value;
            const jobTitle = document.getElementById('empModalDeptDetail').value;
            const phone = normalizePhoneNumber(document.getElementById('empModalPhone').value);
            const startDate = document.getElementById('empModalStartDate').value;
            const birthday = document.getElementById('empModalBirthday').value;
            const password = document.getElementById('empModalPassword').value.trim();

            if (!empId || !name) {
                showToast("工號與姓名為必填欄位！", "warning");
                return;
            }

            if (originalId) {
                const emp = employees.find(e => e.empId === originalId);
                if (emp) {
                    const oldDept = emp.dept || '';
                    const oldJobTitle = emp.jobTitle || emp.deptDetail || '';
                    if (oldDept !== dept || oldJobTitle !== jobTitle) {
                        if (!Array.isArray(emp.transferHistory)) emp.transferHistory = [];
                        emp.transferHistory.push({
                            changedAt: new Date().toISOString(),
                            fromDept: oldDept, toDept: dept,
                            fromJobTitle: oldJobTitle, toJobTitle: jobTitle,
                            changedBy: currentAdminId || 'SYSTEM'
                        });
                    }
                    emp.attNo = attNo;
                    emp.empId = empId;
                    emp.name = name;
                    emp.dept = dept;
                    emp.jobTitle = jobTitle;
                    emp.deptDetail = jobTitle;
                    emp.phone = phone;
                    emp.startDate = startDate;
                    emp.birthday = birthday;
                    if (password) emp.password = password;
                    emp.adminRole = permissionFields.adminRole;
                    emp.monitorPermissions = permissionFields.monitorPermissions;
                    emp.actionPermissions = permissionFields.actionPermissions;
                    emp.employeeListAccess = permissionFields.employeeListAccess;
                    emp.systemPermissions = permissionFields.systemPermissions;
                    if (isAdminLoggedIn && String(currentAdminId).toUpperCase() === String(originalId).toUpperCase()) {
                        currentEmp = emp;
                        updateAdminCurrentName(emp);
                    }
                }
            } else {
                if (employees.some(e => e.empId === empId)) {
                    showToast("此工號已存在，請使用其他工號！", "warning");
                    return;
                }
                employees.push({
                    attNo: attNo,
                    empId: empId,
                    name: name,
                    dept: dept,
                    jobTitle: jobTitle,
                    deptDetail: jobTitle,
                    phone: phone,
                    startDate: startDate,
                    birthday: birthday,
                    password: password || '',
                adminRole: permissionFields.adminRole,
                monitorPermissions: permissionFields.monitorPermissions,
                actionPermissions: permissionFields.actionPermissions,
                employeeListAccess: permissionFields.employeeListAccess,
                systemPermissions: permissionFields.systemPermissions,
                });
            }

            // 工號或角色變更時同步維護超級管理員清單，避免舊工號殘留造成權限判斷錯誤。
            if (originalId && String(originalId).toUpperCase() !== empId) {
                sysConfig.adminIds = (sysConfig.adminIds || []).filter(id => String(id).toUpperCase() !== String(originalId).toUpperCase());
            }
            if (permissionFields.adminRole === 'superadmin') {
                if (!sysConfig.adminIds.includes(empId)) sysConfig.adminIds.push(empId);
            } else if (!defaultConfig.adminIds.includes(empId)) {
                sysConfig.adminIds = (sysConfig.adminIds || []).filter(id => String(id).toUpperCase() !== empId);
            }
            saveConfig();

            saveEmployees();
            const savedEmployee = employees.find(emp => String(emp.empId || '').trim().toUpperCase() === empId);
            postToCloud({
                action: 'upsertEmployee',
                employee: savedEmployee,
                originalEmpId: originalId || empId
            }, "員工資料已成功儲存並同步雲端！");
            closeEmployeeModal();
            renderAdminEmployeeTable();
        }

        function deleteEmployee(empId) {
            if (isAdminLoggedIn && currentEmp && !canManageEmployeeList(currentEmp)) { showToast('此帳號的員工清單權限為「只能觀看」，不可刪除員工資料', 'warning'); return; }
            const target = employees.find(e => e.empId === empId);
            if (isAdminLoggedIn && !isCurrentViewerSuperAdmin() && target && !canCurrentAdminViewEmployee(target)) { showToast('一般管理員不能刪除管理員資料', 'warning'); return; }
            if (confirm(`確定要刪除工號 ${empId} 的員工嗎？`)) {
                employees = employees.filter(e => e.empId !== empId);
                saveEmployees();
                postToCloud({ action: 'deleteEmployee', empId }, "已從雲端刪除員工");
                renderAdminEmployeeTable();
            }
        }

        function downloadCleanExcelWorkbook(workbook, fileName) {
            // SheetJS 瀏覽器版在部分 Excel 版本會把殘留樣式寫入 styles.xml，
            // 因此匯出前明確移除儲存格樣式與自訂格式，只保留資料、欄寬和工作表結構。
            Object.values(workbook.Sheets || {}).forEach(sheet => {
                Object.keys(sheet || {}).forEach(address => {
                    if (address.startsWith('!')) return;
                    const cell = sheet[address];
                    if (!cell || typeof cell !== 'object') return;
                    delete cell.s;
                    delete cell.z;
                    delete cell.w;
                    if (cell.t === 'd') {
                        cell.t = 's';
                        cell.v = cell.v instanceof Date
                            ? `${cell.v.getFullYear()}/${String(cell.v.getMonth() + 1).padStart(2, '0')}/${String(cell.v.getDate()).padStart(2, '0')}`
                            : String(cell.v || '');
                    }
                });
            });

            const bytes = XLSX.write(workbook, {
                bookType: 'xlsx',
                type: 'array',
                compression: true,
                cellStyles: false,
                bookSST: false
            });
            const blob = new Blob([bytes], {
                type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
            });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            link.remove();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        }

        function exportEmployeesExcel() {
            const visibleEmployees = sortEmployeesById(getAdminVisibleEmployees());
            if (visibleEmployees.length === 0) {
                showToast("無員工資料可供匯出", "warning");
                return;
            }
            if (!ensureExcelLibrary()) return;
            const headers = ['考勤號', '工號', '姓名', '部門', '電話', '到職日', '生日', '密碼', '後台角色', '監看權限', '員工清單權限', '公司', '職務', '操作權限'];
            const rows = visibleEmployees.map(e => {
                const permissions = Array.isArray(e.monitorPermissions) ? e.monitorPermissions.join('|') : '';
                const actionPermissions = getActionPermissions(e).join('|');
                const company = String(e.empId || '').match(/^([A-Za-z]+)/)?.[1]?.toUpperCase() || '';
                return [
                    String(e.attNo ?? ''), String(e.empId || ''), String(e.name || ''), String(e.dept || ''),
                    String(normalizePhoneNumber(e.phone)), String(e.startDate || ''), String(e.birthday || ''), String(e.password || ''),
                    String(normalizeAdminRole(e.adminRole, e)), String(permissions), String(e.employeeListAccess || ''),
                    String(company), String(e.jobTitle || e.deptDetail || ''), String(actionPermissions)
                ];
            });
            const worksheet = XLSX.utils.aoa_to_sheet([headers, ...rows], { cellDates: false });
            worksheet['!cols'] = [10, 15, 14, 16, 16, 12, 12, 14, 12, 30, 16, 8, 16, 36].map(wch => ({ wch }));
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, '員工清單');
            downloadCleanExcelWorkbook(workbook, `員工清單_${new Date().toISOString().slice(0,10)}.xlsx`);
            showToast("員工清單 Excel 匯出成功！", "success");
        }

        async function importEmployeesExcel(event) {
            if (isAdminLoggedIn && currentEmp && !canManageEmployeeList(currentEmp)) { showToast('此帳號的員工清單權限為「只能觀看」，不可匯入員工資料', 'warning'); return; }
            if (isAdminLoggedIn && !isCurrentViewerSuperAdmin()) { showToast('只有超級管理員可以匯入員工資料', 'warning'); event.target.value = ''; return; }
            const file = event.target.files[0];
            if (!file) return;
            if (!ensureExcelLibrary()) { event.target.value = ''; return; }
            try {
                const workbook = XLSX.read(await file.arrayBuffer(), { type: 'array' });
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                const dataRows = XLSX.utils.sheet_to_json(firstSheet, { header: 1, defval: '', raw: false });
                let count = 0;
                for (const sourceRow of dataRows.slice(1)) {
                    const cols = sourceRow.map(value => String(value ?? '').trim());
                    if (cols.length >= 3 && cols[1] && cols[2]) {
                        const empId = cols[1].toUpperCase();
                        const attNo = normalizeAttendanceNumber(cols[0] || String(employees.length + 1), empId);
                        const name = cols[2];
                        const dept = cols[3] || '物流部';
                        const phone = normalizePhoneNumber(cols[4]);
                        const startDate = cols[5] || '';
                        const birthday = cols[6] || '';
                        const password = cols[7] || '';
                        const adminRole = ['employee', 'admin', 'superadmin'].includes(String(cols[8] || '').toLowerCase()) ? String(cols[8]).toLowerCase() : 'employee';
                        const rawPermissions = String(cols[9] || '').split('|').filter(Boolean);
                        const monitorPermissions = [...new Set(rawPermissions.flatMap(v => {
                            if (ADMIN_MONITOR_OPTIONS.includes(v)) return [v];
                            if (v === 'attendance') return ['attendanceRecords','liveAttendance','overtimeStats','attendanceStats'];
                            if (v === 'leave') return ['leaveRequests','leaveBalances'];
                            if (v === 'employees') return ['employeeList'];
                            if (v === 'settings') return ['departments','settings'];
                            return [];
                        }))];
                        const employeeListAccess = ['none', 'view', 'manage'].includes(cols[10]) ? cols[10] : (adminRole === 'superadmin' ? 'manage' : 'none');
                        const jobTitle = cols[12] || '';
                        const actionPermissions = String(cols[13] || '').split('|').filter(value => ADMIN_ACTION_OPTIONS.includes(value));

                        const existing = employees.find(item => item.empId === empId);
                        if (existing) {
                            existing.attNo = attNo;
                            existing.name = name;
                            existing.dept = dept;
                            existing.phone = phone;
                            existing.startDate = startDate;
                            existing.birthday = birthday;
                            if (jobTitle) { existing.jobTitle = jobTitle; existing.deptDetail = jobTitle; }
                            if (password) existing.password = password;
                            if (cols.length >= 9) {
                                existing.adminRole = adminRole;
                                existing.monitorPermissions = adminRole === 'superadmin' ? [...ADMIN_MONITOR_OPTIONS] : monitorPermissions;
                                existing.actionPermissions = adminRole === 'superadmin' ? [...ADMIN_ACTION_OPTIONS] : actionPermissions;
                                existing.employeeListAccess = adminRole === 'superadmin' ? 'manage' : employeeListAccess;
                            }
                        } else {
                            employees.push({ attNo, empId, name, dept, jobTitle, deptDetail: jobTitle, phone, startDate, birthday, password, adminRole, monitorPermissions, actionPermissions: adminRole === 'superadmin' ? [...ADMIN_ACTION_OPTIONS] : actionPermissions, employeeListAccess });
                        }
                        count++;
                    }
                }
                syncAdminIdsFromEmployeeRoles();
                syncDepartmentsFromEmployees();
                syncJobTitlesFromEmployees();
                saveConfig();
                saveEmployees();
                postToCloud({ action: 'syncEmployees', employees: employees }, `成功匯入 ${count} 筆員工資料！`);
                renderAdminEmployeeTable();
            } catch (error) {
                console.error('員工 Excel 匯入失敗：', error);
                showToast('員工 Excel 匯入失敗：' + (error?.message || error), 'warning');
            } finally {
                event.target.value = '';
            }
        }

        function decodeLegacyAttendanceExcelText(value) {
            if (value instanceof Date) return value;
            const text = String(value ?? '').trim();
            if (!text || /[\u4e00-\u9fff]/u.test(text) || !/[^\x00-\x7F]/.test(text)) return text;
            try {
                const bytes = Uint8Array.from([...text].map(char => char.charCodeAt(0) & 0xff));
                const decoded = new TextDecoder('big5').decode(bytes).trim();
                return /[\u4e00-\u9fff]/u.test(decoded) ? decoded : text;
            } catch (error) {
                return text;
            }
        }

        function normalizeAttendanceImportHeader(value) {
            return String(decodeLegacyAttendanceExcelText(value) || '')
                .replace(/[\s　_／/()-]/g, '')
                .trim();
        }

        function normalizeImportedAttendanceTime(value) {
            if (value instanceof Date && !Number.isNaN(value.getTime())) {
                return `${value.getFullYear()}/${String(value.getMonth() + 1).padStart(2, '0')}/${String(value.getDate()).padStart(2, '0')} ${String(value.getHours()).padStart(2, '0')}:${String(value.getMinutes()).padStart(2, '0')}`;
            }
            const raw = String(decodeLegacyAttendanceExcelText(value) || '').trim();
            if (!raw) return '';
            if (/^\d+(?:\.\d+)?$/.test(raw) && typeof XLSX !== 'undefined' && XLSX.SSF?.parse_date_code) {
                const parsed = XLSX.SSF.parse_date_code(Number(raw));
                if (parsed) return `${parsed.y}/${String(parsed.m).padStart(2, '0')}/${String(parsed.d).padStart(2, '0')} ${String(parsed.H || 0).padStart(2, '0')}:${String(parsed.M || 0).padStart(2, '0')}`;
            }
            const cleaned = raw.replace(/[年.-]/g, '/').replace(/月/g, '/').replace(/日/g, ' ').replace('T', ' ').replace(/\s+/g, ' ').trim();
            const match = cleaned.match(/^(\d{3,4})\/(\d{1,2})\/(\d{1,2})(?:\s+(\d{1,2}):(\d{1,2}))?/);
            if (!match) return '';
            let year = Number(match[1]);
            if (year < 1911) year += 1911;
            const month = Number(match[2]);
            const day = Number(match[3]);
            const hour = Number(match[4] || 0);
            const minute = Number(match[5] || 0);
            const test = new Date(year, month - 1, day, hour, minute);
            if (test.getFullYear() !== year || test.getMonth() !== month - 1 || test.getDate() !== day || hour > 23 || minute > 59) return '';
            return `${year}/${String(month).padStart(2, '0')}/${String(day).padStart(2, '0')} ${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
        }

        function normalizeImportedAttendanceStatus(value) {
            const text = String(decodeLegacyAttendanceExcelText(value) || '').replace(/\s+/g, '').trim();
            if (!text) return '';
            if (text.includes('加班') && (text.includes('上班') || text.includes('簽到'))) return '加班上班';
            if (text.includes('加班') && (text.includes('下班') || text.includes('簽退'))) return '加班下班';
            if (text.includes('上班') || text === '簽到') return '上班簽到';
            if (text.includes('下班') || text === '簽退') return '下班簽退';
            return '';
        }

        function getAttendanceImportIdentityKey(record) {
            // V5.10.18：考勤資料以考勤號為第一身份鍵，工號只做備援。
            return normalizeAttendanceStatsAttNo(record?.attNo)
                || String(record?.empId || '').trim().toUpperCase()
                || normalizeEmployeeLookupName(record?.name);
        }

        function getAttendanceImportEventKey(record) {
            const identity = getAttendanceImportIdentityKey(record);
            const time = normalizeImportedAttendanceTime(record?.timeStr);
            const status = normalizeImportedAttendanceStatus(record?.status);
            if (!identity || !time || !status) return '';

            const pairClockInId = getManualPairClockInId(record);
            const pairClockOutId = getManualPairClockOutId(record);
            const pairClockInKey = getManualPairClockInKey(record);
            const pairClockOutKey = getManualPairClockOutKey(record);
            const pairClockInTime = getManualPairClockInTimeStr(record);
            const pairClockOutTime = getManualPairClockOutTimeStr(record);
            const hasPair = Boolean(
                pairClockInId || pairClockOutId ||
                pairClockInKey || pairClockOutKey ||
                pairClockInTime || pairClockOutTime
            );
            const pairSuffix = !hasPair ? '' : [
                `PAIR_IN_ID:${encodeURIComponent(pairClockInId)}`,
                `PAIR_OUT_ID:${encodeURIComponent(pairClockOutId)}`,
                `PAIR_IN_KEY:${encodeURIComponent(pairClockInKey)}`,
                `PAIR_OUT_KEY:${encodeURIComponent(pairClockOutKey)}`,
                `PAIR_IN_TIME:${encodeURIComponent(pairClockInTime)}`,
                `PAIR_OUT_TIME:${encodeURIComponent(pairClockOutTime)}`
            ].join('|');

            return `${identity}|${time}|${status}${pairSuffix ? `|${pairSuffix}` : ''}`;
        }

        function isExistingAttendanceProtectedFromImport(candidate, sourceEventKey) {
            const candidateKey = String(sourceEventKey || getAttendanceImportEventKey(candidate) || '').trim();
            if (!candidateKey) return false;

            return (Array.isArray(records) ? records : []).some(existing => {
                if (!existing || isLocallyDeletedAttendanceRecord(existing)) return false;
                const existingSourceKey = stripManualPairSuffixFromEventKey(existing?.sourceEventKey);
                const candidateSourceKey = stripManualPairSuffixFromEventKey(candidateKey);
                return !!(
                    existingSourceKey &&
                    candidateSourceKey &&
                    existingSourceKey === candidateSourceKey &&
                    isManuallyEditedAttendanceRecord(existing)
                );
            });
        }

        async function backupAttendanceRecordsBeforeImport(fileName) {
            const payload = {
                createdAt: new Date().toISOString(),
                fileName: String(fileName || ''),
                records: Array.isArray(records) ? records : []
            };

            // 第一層：localStorage。資料量小時最快。
            try {
                localStorage.setItem('sp_records_backup_before_excel_import_v1', JSON.stringify(payload));
                return true;
            } catch (error) {
                console.warn('localStorage 容量不足，改用 IndexedDB 保存考勤匯入前備份：', error);
            }

            // 第二層：IndexedDB。容量遠大於 localStorage，專門處理大量考勤紀錄。
            try {
                const db = await new Promise((resolve, reject) => {
                    const request = indexedDB.open('PORT79_ATTENDANCE_IMPORT_BACKUP_V1', 1);
                    request.onupgradeneeded = () => {
                        const idb = request.result;
                        if (!idb.objectStoreNames.contains('backups')) {
                            idb.createObjectStore('backups', { keyPath: 'key' });
                        }
                    };
                    request.onsuccess = () => resolve(request.result);
                    request.onerror = () => reject(request.error || new Error('IndexedDB 開啟失敗'));
                });

                await new Promise((resolve, reject) => {
                    const tx = db.transaction('backups', 'readwrite');
                    const store = tx.objectStore('backups');
                    store.put({
                        key: 'latest-before-excel-import',
                        ...payload
                    });
                    tx.oncomplete = () => resolve(true);
                    tx.onerror = () => reject(tx.error || new Error('IndexedDB 寫入失敗'));
                    tx.onabort = () => reject(tx.error || new Error('IndexedDB 寫入中止'));
                });

                try { db.close(); } catch (e) {}
                return true;
            } catch (error) {
                console.error('IndexedDB 考勤匯入前備份失敗：', error);
                return false;
            }
        }


        async function getAttendanceImportBackupInfo() {
            try {
                const raw = localStorage.getItem('sp_records_backup_before_excel_import_v1');
                if (raw) {
                    const data = JSON.parse(raw);
                    return {
                        storage: 'localStorage',
                        createdAt: data?.createdAt || '',
                        fileName: data?.fileName || '',
                        count: Array.isArray(data?.records) ? data.records.length : 0
                    };
                }
            } catch (e) {}

            try {
                const db = await new Promise((resolve, reject) => {
                    const request = indexedDB.open('PORT79_ATTENDANCE_IMPORT_BACKUP_V1', 1);
                    request.onsuccess = () => resolve(request.result);
                    request.onerror = () => reject(request.error);
                });
                const data = await new Promise((resolve, reject) => {
                    const tx = db.transaction('backups', 'readonly');
                    const req = tx.objectStore('backups').get('latest-before-excel-import');
                    req.onsuccess = () => resolve(req.result || null);
                    req.onerror = () => reject(req.error);
                });
                try { db.close(); } catch (e) {}
                return data ? {
                    storage: 'IndexedDB',
                    createdAt: data.createdAt || '',
                    fileName: data.fileName || '',
                    count: Array.isArray(data.records) ? data.records.length : 0
                } : null;
            } catch (e) {
                return null;
            }
        }
        window.p79AttendanceImportBackupInfo = getAttendanceImportBackupInfo;

        // V5.10.12：匯入考勤姓名正規化。
        // 只處理「姓名尾端」括號內容，不動姓名中間文字。
        // 半形/全形括號都支援，而且連續多組尾端括號會全部移除：
        // 陳信仲(AQC) -> 陳信仲、王小明（夜班） -> 王小明、林大華(AQC)(支援) -> 林大華。
        function normalizeImportedAttendanceName(value) {
            return stripAttendanceNameTrailingMeta(value);
        }
        window.normalizeImportedAttendanceName = normalizeImportedAttendanceName;


        const P79_IMPORT_MAX_SHIFT_MS = 24 * 60 * 60 * 1000;
        const P79_IMPORT_SIDE_MATCH_MS = 90 * 60 * 1000;

        function p79ImportShiftIdentity(recordOrRow) {
            return getAttendanceImportIdentityKey(recordOrRow);
        }

        function p79BuildImportShifts(sourceRecords) {
            const byIdentity = new Map();

            (Array.isArray(sourceRecords) ? sourceRecords : []).forEach(record => {
                const identity = p79ImportShiftIdentity(record);
                const type = getAttendanceRecordType(record);
                const ts = getAttendanceTimestamp(record);
                if (!identity || !['IN','OUT'].includes(type) || !Number.isFinite(ts)) return;
                if (!byIdentity.has(identity)) byIdentity.set(identity, []);
                byIdentity.get(identity).push(record);
            });

            const shifts = [];

            byIdentity.forEach((list, identity) => {
                const sorted = [...list].sort((a,b) => getAttendanceTimestamp(a) - getAttendanceTimestamp(b));
                const openIns = [];

                sorted.forEach(record => {
                    const type = getAttendanceRecordType(record);
                    const ts = getAttendanceTimestamp(record);

                    if (type === 'IN') {
                        openIns.push(record);
                        return;
                    }

                    // OUT：只找真正早於它、且 24 小時內的最近 IN。
                    let bestIndex = -1;
                    let bestTs = -1;
                    openIns.forEach((clockIn, index) => {
                        const inTs = getAttendanceTimestamp(clockIn);
                        const diff = ts - inTs;
                        if (diff < 0 || diff > P79_IMPORT_MAX_SHIFT_MS) return;
                        if (inTs > bestTs) {
                            bestTs = inTs;
                            bestIndex = index;
                        }
                    });

                    if (bestIndex >= 0) {
                        const clockIn = openIns.splice(bestIndex, 1)[0];
                        shifts.push({
                            identity,
                            attNo: clockIn?.attNo || record?.attNo,
                            empId: clockIn?.empId || record?.empId,
                            name: clockIn?.name || record?.name,
                            clockIn,
                            clockOut: record
                        });
                    } else {
                        shifts.push({
                            identity,
                            attNo: record?.attNo,
                            empId: record?.empId,
                            name: record?.name,
                            clockIn: null,
                            clockOut: record
                        });
                    }
                });

                openIns.forEach(clockIn => {
                    shifts.push({
                        identity,
                        attNo: clockIn?.attNo,
                        empId: clockIn?.empId,
                        name: clockIn?.name,
                        clockIn,
                        clockOut: null
                    });
                });
            });

            return shifts.sort((a,b) => {
                const ta = getAttendanceTimestamp(a.clockIn || a.clockOut);
                const tb = getAttendanceTimestamp(b.clockIn || b.clockOut);
                return ta - tb;
            });
        }

        function p79ImportSourceLineageKey(record) {
            const direct = stripManualPairSuffixFromEventKey(record?.sourceEventKey);
            if (direct) return direct;
            return stripManualPairSuffixFromEventKey(getAttendanceImportEventKey(record));
        }

        function p79ImportSideMatch(sourceRecord, systemRecord) {
            if (!sourceRecord || !systemRecord) return { matched:false, exact:false, diffMinutes:null };

            const sourceType = getAttendanceRecordType(sourceRecord);
            const systemType = getAttendanceRecordType(systemRecord);
            if (sourceType !== systemType || !['IN','OUT'].includes(sourceType)) {
                return { matched:false, exact:false, diffMinutes:null };
            }

            const sourceLineage = p79ImportSourceLineageKey(sourceRecord);
            const systemLineage = stripManualPairSuffixFromEventKey(systemRecord?.sourceEventKey);
            if (sourceLineage && systemLineage && sourceLineage === systemLineage) {
                return { matched:true, exact:true, lineage:true, diffMinutes:0 };
            }

            const sourceTs = getAttendanceTimestamp(sourceRecord);
            const systemTs = getAttendanceTimestamp(systemRecord);
            if (!Number.isFinite(sourceTs) || !Number.isFinite(systemTs)) {
                return { matched:false, exact:false, diffMinutes:null };
            }

            const diff = Math.abs(sourceTs - systemTs);
            return {
                matched: diff <= P79_IMPORT_SIDE_MATCH_MS,
                exact: diff === 0,
                lineage:false,
                diffMinutes: Math.round(diff / 60000)
            };
        }

        function p79ImportSystemRawSideExists(sourceRecord) {
            if (!sourceRecord) return null;
            const identity = p79ImportShiftIdentity(sourceRecord);
            const type = getAttendanceRecordType(sourceRecord);
            const lineage = p79ImportSourceLineageKey(sourceRecord);
            const sourceTime = normalizeImportedAttendanceTime(sourceRecord?.timeStr);

            return (Array.isArray(records) ? records : []).find(existing => {
                if (!existing || isLocallyDeletedAttendanceRecord(existing)) return false;
                if (p79ImportShiftIdentity(existing) !== identity) return false;
                if (getAttendanceRecordType(existing) !== type) return false;

                const existingLineage = stripManualPairSuffixFromEventKey(existing?.sourceEventKey);
                if (lineage && existingLineage && lineage === existingLineage) return true;

                // 原始資料完全同時間同類型，視為已存在。
                return normalizeImportedAttendanceTime(existing?.timeStr) === sourceTime;
            }) || null;
        }

        const P79_IMPORT_AUDIT_WARN_DIFF_MIN = 30;
        const P79_IMPORT_AUDIT_ERROR_DIFF_MIN = 90;

        function p79AuditTimeDiffMinutes(a, b) {
            if (!a || !b) return null;
            const ta = getAttendanceTimestamp({timeStr:a});
            const tb = getAttendanceTimestamp({timeStr:b});
            if (!Number.isFinite(ta) || !Number.isFinite(tb)) return null;
            return Math.round(Math.abs(ta - tb) / 60000);
        }

        function p79ClassifyImportAuditRow(row) {
            const hasExcelIn = !!row?.excelIn;
            const hasExcelOut = !!row?.excelOut;
            const hasSystemIn = !!row?.systemIn;
            const hasSystemOut = !!row?.systemOut;

            const excelComplete = hasExcelIn && hasExcelOut;
            const systemComplete = hasSystemIn && hasSystemOut;
            const inDiff = p79AuditTimeDiffMinutes(row?.excelIn, row?.systemIn);
            const outDiff = p79AuditTimeDiffMinutes(row?.excelOut, row?.systemOut);

            const legacyPairingIssue = /原始資料已有；顯示\/配對需檢查/.test(String(row?.action || ''));
            const pairingIssue = row?.pairingIssue === true ||
                legacyPairingIssue ||
                (systemComplete && /缺少簽到|缺少簽退/.test(String(row?.systemStatus || '')));

            let severity = 'ok';
            let action = '';
            let needsAttention = false;
            let sourceIssue = false;
            let isComplete = false;

            // 最高優先：原始 IN/OUT 都找得到，但班次引擎沒有正常配成一班。
            if (pairingIssue) {
                severity = 'error';
                needsAttention = true;
                action = '系統原始上下班都有，但班次配對異常｜需重新配對';
            }
            // 真正完整班次：Excel 上下班 + 系統上下班四個欄位都必須存在。
            else if (excelComplete && systemComplete) {
                isComplete = true;

                if (
                    (inDiff != null && inDiff > P79_IMPORT_AUDIT_ERROR_DIFF_MIN) ||
                    (outDiff != null && outDiff > P79_IMPORT_AUDIT_ERROR_DIFF_MIN)
                ) {
                    severity = 'error';
                    needsAttention = true;
                    const parts = [];
                    if (inDiff != null && inDiff > P79_IMPORT_AUDIT_ERROR_DIFF_MIN) parts.push(`上班差 ${inDiff} 分`);
                    if (outDiff != null && outDiff > P79_IMPORT_AUDIT_ERROR_DIFF_MIN) parts.push(`下班差 ${outDiff} 分`);
                    action = `四欄都有，但時間差異過大｜需確認／修改（${parts.join('、')}）`;
                } else if (
                    (inDiff != null && inDiff > P79_IMPORT_AUDIT_WARN_DIFF_MIN) ||
                    (outDiff != null && outDiff > P79_IMPORT_AUDIT_WARN_DIFF_MIN)
                ) {
                    severity = 'warning';
                    needsAttention = true;
                    const parts = [];
                    if (inDiff != null && inDiff > P79_IMPORT_AUDIT_WARN_DIFF_MIN) parts.push(`上班差 ${inDiff} 分`);
                    if (outDiff != null && outDiff > P79_IMPORT_AUDIT_WARN_DIFF_MIN) parts.push(`下班差 ${outDiff} 分`);
                    action = `四欄都有，但時間有差異｜建議確認（${parts.join('、')}）`;
                } else {
                    action = 'Excel／系統皆有完整上下班｜比對正常';
                }
            }
            // Excel 完整，但系統缺資料：可依 Excel 補空白側。
            else if (excelComplete && !systemComplete) {
                severity = 'missing';
                needsAttention = true;

                if (!hasSystemIn && !hasSystemOut) action = '系統缺上班＋下班｜可依 Excel 補兩側';
                else if (!hasSystemIn) action = '系統缺上班｜只補上班';
                else action = '系統缺下班｜只補下班';
            }
            // 系統完整，但 Excel 來源本身不完整：不能稱完整比對，但系統不需補。
            else if (!excelComplete && systemComplete) {
                severity = 'source';
                sourceIssue = true;
                needsAttention = false;

                if (!hasExcelIn && hasExcelOut) action = 'Excel 缺上班｜系統班次完整，不補系統';
                else if (hasExcelIn && !hasExcelOut) action = 'Excel 缺下班｜系統班次完整，不補系統';
                else action = 'Excel 來源班次不完整｜系統班次完整';
            }
            // Excel、系統都缺同一側：沒有來源可以自動補，必須人工查核。
            else if (!hasExcelIn && !hasSystemIn) {
                severity = 'error';
                sourceIssue = true;
                needsAttention = true;

                if (hasExcelOut && !hasSystemOut) {
                    action = 'Excel／系統皆缺上班；系統另缺下班｜可補下班，但上班需人工查核';
                } else {
                    action = 'Excel／系統皆缺上班｜Excel 無上班來源，需人工查核／補卡';
                }
            }
            else if (!hasExcelOut && !hasSystemOut) {
                severity = 'error';
                sourceIssue = true;
                needsAttention = true;

                if (hasExcelIn && !hasSystemIn) {
                    action = 'Excel／系統皆缺下班；系統另缺上班｜可補上班，但下班需人工查核';
                } else {
                    action = 'Excel／系統皆缺下班｜Excel 無下班來源，需人工查核／補卡';
                }
            }
            // Excel 只有一側，而系統剛好缺 Excel 有的那一側。
            else {
                severity = 'missing';
                needsAttention = true;
                sourceIssue = !excelComplete;

                if (hasExcelIn && !hasSystemIn) action = '系統缺上班｜可依 Excel 補上班';
                else if (hasExcelOut && !hasSystemOut) action = '系統缺下班｜可依 Excel 補下班';
                else action = '班次資料不完整｜需人工確認';
            }

            return {
                severity,
                action,
                needsAttention,
                sourceIssue,
                isComplete,
                pairingIssue,
                excelComplete,
                systemComplete,
                inDiff,
                outDiff
            };
        }

        function p79ImportShiftMatchScore(sourceShift, systemShift) {
            if (!sourceShift || !systemShift) return -1;
            if (sourceShift.identity !== p79ImportShiftIdentity(systemShift)) return -1;

            let score = 0;
            let evidence = 0;

            const inMatch = p79ImportSideMatch(sourceShift.clockIn, systemShift.clockIn);
            const outMatch = p79ImportSideMatch(sourceShift.clockOut, systemShift.clockOut);

            if (inMatch.matched) {
                evidence++;
                score += inMatch.lineage ? 1200 : (600 - Math.min(500, Number(inMatch.diffMinutes || 0)));
            }
            if (outMatch.matched) {
                evidence++;
                score += outMatch.lineage ? 1200 : (600 - Math.min(500, Number(outMatch.diffMinutes || 0)));
            }

            // 一側缺失時，用另一側定位同一班次：
            // 例如 Excel 10/03 23:33 -> 10/04 07:50，
            // 系統只有 10/04 07:55 OUT，仍是同一班，應補 23:33 IN。
            if (sourceShift.clockIn && sourceShift.clockOut) {
                if (!systemShift.clockIn && systemShift.clockOut && outMatch.matched) score += 700;
                if (systemShift.clockIn && !systemShift.clockOut && inMatch.matched) score += 700;
            }

            if (!evidence) return -1;
            return score;
        }

        function p79BuildSystemShiftRowsForImport() {
            try {
                return buildDailyAttendanceRows(
                    (Array.isArray(records) ? records : [])
                        .filter(record => record && !isLocallyDeletedAttendanceRecord(record))
                );
            } catch (e) {
                console.warn('建立系統班次供匯入比對失敗：', e);
                return [];
            }
        }

        function p79ReconcileImportByShift(sourceRecords) {
            // 先對 Excel 本身完全重複去重，姓名/工號/考勤號仍保留。
            const uniqueSource = [];
            const seenSource = new Set();
            let sourceDuplicateCount = 0;

            (Array.isArray(sourceRecords) ? sourceRecords : []).forEach(record => {
                const key = p79ImportExactEventKey(record);
                if (!key) return;
                if (seenSource.has(key)) {
                    sourceDuplicateCount++;
                    return;
                }
                seenSource.add(key);
                uniqueSource.push(record);
            });

            const sourceShifts = p79BuildImportShifts(uniqueSource);
            const systemShifts = p79BuildSystemShiftRowsForImport();
            const usedSystemIndexes = new Set();
            const selected = [];
            const audit = [];

            sourceShifts.forEach((sourceShift, sourceIndex) => {
                let bestIndex = -1;
                let bestScore = -1;

                systemShifts.forEach((systemShift, systemIndex) => {
                    if (usedSystemIndexes.has(systemIndex)) return;
                    const score = p79ImportShiftMatchScore(sourceShift, systemShift);
                    if (score > bestScore) {
                        bestScore = score;
                        bestIndex = systemIndex;
                    }
                });

                const systemShift = bestIndex >= 0 ? systemShifts[bestIndex] : null;
                if (bestIndex >= 0) usedSystemIndexes.add(bestIndex);

                let systemIn = systemShift?.clockIn || null;
                let systemOut = systemShift?.clockOut || null;

                // 顯示配對可能漏掉，但 raw records 本身其實已經有事件時不可重複新增。
                const rawIn = !systemIn && sourceShift.clockIn
                    ? p79ImportSystemRawSideExists(sourceShift.clockIn)
                    : null;
                const rawOut = !systemOut && sourceShift.clockOut
                    ? p79ImportSystemRawSideExists(sourceShift.clockOut)
                    : null;

                if (rawIn) systemIn = rawIn;
                if (rawOut) systemOut = rawOut;

                const addIn = !!sourceShift.clockIn && !systemIn;
                const addOut = !!sourceShift.clockOut && !systemOut;

                if (addIn) selected.push(sourceShift.clockIn);
                if (addOut) selected.push(sourceShift.clockOut);

                const pairingIssue = !!(
                    (rawIn && !systemShift?.clockIn) ||
                    (rawOut && !systemShift?.clockOut)
                );

                const inMatch = p79ImportSideMatch(sourceShift.clockIn, systemIn);
                const outMatch = p79ImportSideMatch(sourceShift.clockOut, systemOut);

                const draftRow = {
                    index: sourceIndex + 1,
                    attNo: sourceShift.attNo || systemShift?.attNo || '',
                    empId: sourceShift.empId || systemShift?.empId || '',
                    name: stripAttendanceNameTrailingMeta(sourceShift.name || systemShift?.name || ''),
                    excelIn: sourceShift.clockIn?.timeStr || '',
                    excelOut: sourceShift.clockOut?.timeStr || '',
                    systemIn: systemIn?.timeStr || '',
                    systemOut: systemOut?.timeStr || '',
                    systemInId: String(systemIn?.id ?? ''),
                    systemOutId: String(systemOut?.id ?? ''),
                    systemInStatus: String(systemIn?.status || ''),
                    systemOutStatus: String(systemOut?.status || ''),
                    systemStatus: systemShift?.attendanceStatus || (systemIn || systemOut ? '原始事件已有' : '系統無班次'),
                    pairingIssue,
                    addIn,
                    addOut,
                    crossDay: !!(
                        sourceShift.clockIn &&
                        sourceShift.clockOut &&
                        getAttendanceDateKey(sourceShift.clockIn.timeStr) !== getAttendanceDateKey(sourceShift.clockOut.timeStr)
                    )
                };

                const classified = p79ClassifyImportAuditRow(draftRow);
                draftRow.action = classified.action;
                draftRow.auditSeverity = classified.severity;
                draftRow.needsAttention = classified.needsAttention;
                draftRow.sourceIssue = classified.sourceIssue;
                draftRow.isComplete = classified.isComplete;
                draftRow.excelComplete = classified.excelComplete;
                draftRow.systemComplete = classified.systemComplete;
                draftRow.pairingIssue = classified.pairingIssue;
                draftRow.inDiffMin = classified.inDiff;
                draftRow.outDiffMin = classified.outDiff;

                audit.push(draftRow);
            });

            return {
                selected,
                audit,
                sourceShifts,
                systemShifts,
                sourceDuplicateCount
            };
        }

        function p79ImportExactEventKey(record) {
            if (!record) return '';
            const identity = getAttendanceImportIdentityKey(record);
            const type = getAttendanceRecordType(record);
            const time = normalizeImportedAttendanceTime(record?.timeStr);
            if (!identity || !time || !type || type === 'OTHER') return '';
            return `${identity}|${type}|${time}`;
        }

        function p79ImportExistingExactEventKeys() {
            const keys = new Set();
            (Array.isArray(records) ? records : []).forEach(record => {
                if (!record || isLocallyDeletedAttendanceRecord(record)) return;
                const key = p79ImportExactEventKey(record);
                if (key) keys.add(key);
            });
            return keys;
        }

        function p79ImportMissingSideSummary(importRows) {
            let inCount = 0;
            let outCount = 0;
            (Array.isArray(importRows) ? importRows : []).forEach(record => {
                const type = getAttendanceRecordType(record);
                if (type === 'IN') inCount++;
                if (type === 'OUT') outCount++;
            });
            return { inCount, outCount };
        }


        let p79ManualAttendanceCloudSyncBusy = false;

        function p79ManualCloudSyncTargetMonths() {
            const selected = String(document.getElementById('filterMonthSelect')?.value || 'ALL').trim();
            if (/^\d{4}-\d{2}$/.test(selected)) return [selected];

            return Array.from(new Set(
                (Array.isArray(records) ? records : [])
                    .filter(record =>
                        record &&
                        !isLocallyDeletedAttendanceRecord(record) &&
                        String(record?.source || '').toLowerCase() === 'excel-import'
                    )
                    .map(attendanceRecordMonthKey)
                    .filter(month => /^\d{4}-\d{2}$/.test(String(month || '')))
            )).sort();
        }

        function p79ManualCloudSyncLocalImportRows(months) {
            const monthSet = new Set(Array.isArray(months) ? months : []);
            return (Array.isArray(records) ? records : [])
                .filter(record => {
                    if (!record || isLocallyDeletedAttendanceRecord(record)) return false;
                    if (String(record?.source || '').toLowerCase() !== 'excel-import') return false;
                    const month = attendanceRecordMonthKey(record);
                    return monthSet.size === 0 || monthSet.has(month);
                })
                .map(record => normalizeAttendanceRecordIdentifiers({ ...record }));
        }

        function p79AttendanceManualSyncPendingCount() {
            let count = 0;
            try {
                count += Number(window.p79V5GetStatus?.()?.pending || 0);
            } catch (e) {}
            return Math.max(0, count);
        }

        function updateAttendanceCloudSyncButton() {
            const button = document.getElementById('btnAttendanceCloudSync');
            const countEl = document.getElementById('btnAttendanceCloudSyncCount');
            if (!button || !countEl) return;

            const pending = p79AttendanceManualSyncPendingCount();
            countEl.textContent = pending > 0 ? `(${pending})` : '';
            button.title = pending > 0
                ? `目前有 ${pending} 筆考勤等待寫入雲端。點擊後會立即補傳並讀回確認。`
                : '把本機匯入考勤寫入雲端，並重新讀回確認。';
        }

        async function syncAttendanceCloudNow() {
            if (p79ManualAttendanceCloudSyncBusy) {
                showToast('同步雲端正在進行中，請稍候', 'warning');
                return false;
            }
            if (!requireAdminAction('cloudSync', '同步雲端考勤')) return false;
            if (typeof navigator !== 'undefined' && navigator.onLine === false) {
                showToast('目前沒有網路，無法同步雲端', 'warning');
                return false;
            }

            const button = document.getElementById('btnAttendanceCloudSync');
            const originalHtml = button?.innerHTML || '☁️ 同步雲端';
            p79ManualAttendanceCloudSyncBusy = true;

            if (button) {
                button.disabled = true;
                button.innerHTML = '⏳ 同步中…';
            }

            try {
                // ① 先補傳所有 V5 待同步工作（補卡、修改、刪除等）。
                setCloudSyncStatus('正在補傳待同步考勤', 'loading', 'write');
                if (typeof window.p79V5Drain === 'function') {
                    await window.p79V5Drain(true);
                }

                const pendingAfterDrain = p79AttendanceManualSyncPendingCount();

                // ② 再把本機 Excel 匯入資料重新送一次。
                // syncRecords 後端採合併/ID 邏輯，因此可重送；目的在補齊曾因中斷未上雲端的匯入資料。
                const months = p79ManualCloudSyncTargetMonths();
                const importRows = p79ManualCloudSyncLocalImportRows(months);

                let importResult = { confirmed:0, queued:0, failed:0, batches:0, months };
                if (importRows.length) {
                    setCloudSyncStatus(
                        `重新核對本機匯入考勤｜${importRows.length} 筆`,
                        'loading',
                        'write'
                    );
                    importResult = await syncImportedAttendanceRecordsToCloud(importRows, {
                        fileName:'手動同步雲端'
                    });
                }

                // ③ 寫入完成後，立即拉 Delta，再強制讀回目前月份核對。
                setCloudSyncStatus('寫入完成，正在讀回雲端確認', 'loading', 'read');

                try {
                    if (typeof window.p79V5PollDelta === 'function') {
                        await window.p79V5PollDelta(true);
                    }
                } catch (e) {
                    console.warn('手動同步 Delta 確認失敗：', e);
                }

                try {
                    if (typeof window.p79ReconcileCurrentAttendanceMonth === 'function') {
                        await window.p79ReconcileCurrentAttendanceMonth({ force:true });
                    } else if (typeof manualCloudRefresh === 'function') {
                        await manualCloudRefresh();
                    }
                } catch (e) {
                    console.warn('手動同步月份讀回確認失敗：', e);
                }

                try {
                    renderAdminRecordsTable();
                } catch (e) {
                    try { p79RenderOnlyVisibleAttendanceView(); } catch (_) {}
                }

                const finalPending = p79AttendanceManualSyncPendingCount();
                updateAttendanceCloudSyncButton();

                if (finalPending > 0 || importResult.queued > 0 || importResult.failed > 0) {
                    setCloudSyncStatus(
                        `同步尚未全部完成｜待同步 ${finalPending}｜匯入待補傳 ${importResult.queued}｜失敗 ${importResult.failed}`,
                        'loading',
                        'write'
                    );
                    showToast(
                        `雲端同步尚未全部完成：待同步 ${finalPending} 筆｜匯入待補傳 ${importResult.queued} 筆｜失敗 ${importResult.failed} 筆`,
                        'warning'
                    );
                    return false;
                }

                const now = new Date().toLocaleTimeString('zh-TW', { hour12:false });
                setCloudSyncStatus(`手動同步完成｜${now}`, 'success', 'write');
                showToast(
                    `雲端同步完成：待同步已清空${importRows.length ? `｜重新核對匯入 ${importRows.length} 筆` : ''}`,
                    'success'
                );
                return true;
            } catch (error) {
                console.error('手動同步雲端失敗：', error);
                setCloudSyncStatus(
                    `手動同步失敗｜${String(error?.message || error || '未知錯誤')}`,
                    'error',
                    'error'
                );
                showToast('手動同步雲端失敗：' + String(error?.message || error || '未知錯誤'), 'warning');
                return false;
            } finally {
                p79ManualAttendanceCloudSyncBusy = false;
                if (button) {
                    button.disabled = false;
                    button.innerHTML = originalHtml;
                }
                updateAttendanceCloudSyncButton();
            }
        }

        window.syncAttendanceCloudNow = syncAttendanceCloudNow;
        window.updateAttendanceCloudSyncButton = updateAttendanceCloudSyncButton;

        const P79_ATTENDANCE_IMPORT_BATCH_SIZE = 60;

        async function syncImportedAttendanceRecordsToCloud(importedRecords, options = {}) {
            const list = Array.isArray(importedRecords) ? importedRecords.filter(Boolean) : [];
            if (!list.length) return { confirmed:0, queued:0, failed:0, batches:0, months:[] };

            const byMonth = new Map();
            list.forEach(record => {
                const month = attendanceRecordMonthKey(record) || 'UNKNOWN';
                if (!byMonth.has(month)) byMonth.set(month, []);
                byMonth.get(month).push(record);
            });

            const batches = [];
            [...byMonth.entries()]
                .sort((a,b)=>String(a[0]).localeCompare(String(b[0])))
                .forEach(([month, rows]) => {
                    for (let i=0; i<rows.length; i+=P79_ATTENDANCE_IMPORT_BATCH_SIZE) {
                        batches.push({ month, records:rows.slice(i, i+P79_ATTENDANCE_IMPORT_BATCH_SIZE) });
                    }
                });

            let confirmed = 0;
            let queued = 0;
            let failed = 0;

            for (let index=0; index<batches.length; index++) {
                const batch = batches[index];
                const batchNo = index + 1;
                try {
                    if (typeof setCloudSyncStatus === 'function') {
                        setCloudSyncStatus(
                            `匯入考勤 ${batchNo}/${batches.length}｜${batch.month}｜${batch.records.length} 筆`,
                            'loading',
                            'write'
                        );
                    }

                    const payload = {
                        action:'syncRecords',
                        records:batch.records,
                        importBatch:true,
                        importBatchNo:batchNo,
                        importBatchTotal:batches.length,
                        importFile:String(options.fileName || '')
                    };

                    let result;
                    if (typeof window.p79V5SubmitAttendanceWrite === 'function') {
                        result = await window.p79V5SubmitAttendanceWrite(payload, '', null, null);
                    } else {
                        result = await postToCloud(payload);
                    }

                    if (result?.ok && result?.queued !== true) confirmed += batch.records.length;
                    else if (result?.queued === true) queued += batch.records.length;
                    else failed += batch.records.length;
                } catch (error) {
                    console.warn(`考勤匯入第 ${batchNo}/${batches.length} 批寫入失敗`, error);
                    failed += batch.records.length;
                }

                await new Promise(resolve => setTimeout(resolve, 30));
            }

            if (typeof setCloudSyncStatus === 'function') {
                if (failed > 0 || queued > 0) {
                    setCloudSyncStatus(
                        `匯入考勤：已確認 ${confirmed}｜待補傳 ${queued}｜失敗 ${failed}`,
                        'loading',
                        'write'
                    );
                } else {
                    setCloudSyncStatus(
                        `匯入考勤已全部寫入｜${confirmed} 筆`,
                        'success',
                        'write'
                    );
                }
            }

            return {
                confirmed,
                queued,
                failed,
                batches:batches.length,
                months:[...byMonth.keys()].sort()
            };
        }

        window.syncImportedAttendanceRecordsToCloud = syncImportedAttendanceRecordsToCloud;

        let p79FinalizeExcelAttendanceBusy = false;
        async function p79FinalizeConfirmedExcelAttendance() {
            if (p79FinalizeExcelAttendanceBusy) return false;
            const audit = getStoredAttendanceImportAudit();
            if (!audit.length) {
                showToast('目前沒有匯入比對明細', 'warning');
                return false;
            }

            const pending = audit.filter(row => row?.needsAttention === true);
            if (pending.length) {
                showToast(`尚有 ${pending.length} 班待處理，必須全部核對完成後才能清理 Excel 匯入考勤`, 'warning');
                return false;
            }

            const officialIds = new Set();
            audit.forEach(row => {
                if (row?.systemInId) officialIds.add(String(row.systemInId));
                if (row?.systemOutId) officialIds.add(String(row.systemOutId));
            });

            const excelRows = (Array.isArray(records) ? records : []).filter(record =>
                record &&
                officialIds.has(String(record?.id ?? '')) &&
                String(record?.source || '').toLowerCase() === 'excel-import'
            );

            if (!excelRows.length) {
                showToast('目前已經只保留正式系統考勤，沒有 Excel 匯入考勤需要清理', 'success');
                return true;
            }

            let duplicateCount = 0;
            let promoteCount = 0;
            excelRows.forEach(record => {
                const type = getAttendanceRecordType(record);
                const identity = p79ImportShiftIdentity(record);
                const alternate = (Array.isArray(records) ? records : []).find(other => {
                    if (!other || other === record || isLocallyDeletedAttendanceRecord(other)) return false;
                    if (String(other?.source || '').toLowerCase() === 'excel-import') return false;
                    if (getAttendanceRecordType(other) !== type) return false;
                    if (p79ImportShiftIdentity(other) !== identity) return false;
                    return p79ImportSideMatch(record, other).matched;
                });
                if (alternate) duplicateCount++;
                else promoteCount++;
            });

            const confirmed = confirm(
                `核對已完成，確定只保留正式系統考勤嗎？\n\n` +
                `將刪除 Excel 重複副本：${duplicateCount} 筆\n` +
                `Excel 唯一補缺將轉正式考勤：${promoteCount} 筆\n\n` +
                `正式系統打卡、人工補卡都不會刪除。`
            );
            if (!confirmed) return false;

            p79FinalizeExcelAttendanceBusy = true;
            const deletedIds = [];
            const promotedRows = [];
            const cloudJobs = [];

            try {
                excelRows.forEach(record => {
                    const type = getAttendanceRecordType(record);
                    const identity = p79ImportShiftIdentity(record);
                    const alternate = (Array.isArray(records) ? records : []).find(other => {
                        if (!other || other === record || isLocallyDeletedAttendanceRecord(other)) return false;
                        if (String(other?.source || '').toLowerCase() === 'excel-import') return false;
                        if (getAttendanceRecordType(other) !== type) return false;
                        if (p79ImportShiftIdentity(other) !== identity) return false;
                        return p79ImportSideMatch(record, other).matched;
                    });

                    if (alternate) {
                        deletedIds.push(record.id);
                        cloudJobs.push(Promise.resolve(postToCloud({
                            action:'deleteRecord',
                            id:record.id
                        }, '', null, () => {})));
                    } else {
                        record.source = 'system-confirmed';
                        record.importConfirmedAt = new Date().toISOString();
                        record.importConfirmedFrom = String(record.importFile || '');
                        promotedRows.push(record);
                        rememberRecentAttendanceMutation(record, 'updateRecord');
                        cloudJobs.push(Promise.resolve(postToCloud({
                            action:'updateRecord',
                            record,
                            originalTimeStr:record.timeStr,
                            originalPunchType:record.status
                        }, '', () => markRecentAttendanceMutationCloudConfirmed(record.id), () => {})));
                    }
                });

                if (deletedIds.length) {
                    const deletedSet = new Set(deletedIds.map(String));
                    records = (Array.isArray(records) ? records : []).filter(
                        record => !deletedSet.has(String(record?.id ?? ''))
                    );
                    removeAttendanceRecordsFromArchive(deletedIds);
                    deletedIds.forEach(id => forgetRecentAttendanceMutation(id));
                }

                if (promotedRows.length) archiveAttendanceRecords(promotedRows);

                saveRecords();
                saveAttendanceSafetyBackup(records);
                try { renderAdminRecordsTable(); } catch (e) {
                    try { p79RenderOnlyVisibleAttendanceView(); } catch (_) {}
                }

                await Promise.allSettled(cloudJobs);
                rebuildAttendanceImportAuditFromCurrentSystem({ silent:true, finalize:false });
                showToast(
                    `核對完成：已刪除 Excel 重複副本 ${deletedIds.length} 筆｜轉正式考勤 ${promotedRows.length} 筆`,
                    'success'
                );
                return true;
            } finally {
                p79FinalizeExcelAttendanceBusy = false;
            }
        }
        window.p79FinalizeConfirmedExcelAttendance = p79FinalizeConfirmedExcelAttendance;

        function p79NormalizeStoredAttendanceImportAudit(rows) {
            return (Array.isArray(rows) ? rows : []).map(row => {
                const copy = {...row};
                const classified = p79ClassifyImportAuditRow(copy);

                copy.action = classified.action;
                copy.auditSeverity = classified.severity;
                copy.needsAttention = classified.needsAttention;
                copy.sourceIssue = classified.sourceIssue;
                copy.isComplete = classified.isComplete;
                copy.excelComplete = classified.excelComplete;
                copy.systemComplete = classified.systemComplete;
                copy.pairingIssue = classified.pairingIssue;
                copy.inDiffMin = classified.inDiff;
                copy.outDiffMin = classified.outDiff;
                return copy;
            });
        }

        function getStoredAttendanceImportAudit() {
            if (Array.isArray(window.p79LastAttendanceImportAudit)) {
                window.p79LastAttendanceImportAudit =
                    p79NormalizeStoredAttendanceImportAudit(window.p79LastAttendanceImportAudit);
                return window.p79LastAttendanceImportAudit;
            }
            try {
                const raw = localStorage.getItem('port79_last_attendance_import_audit');
                const parsed = raw ? JSON.parse(raw) : [];
                const normalized = p79NormalizeStoredAttendanceImportAudit(parsed);
                if (normalized.length) {
                    window.p79LastAttendanceImportAudit = normalized;
                    try {
                        localStorage.setItem(
                            'port79_last_attendance_import_audit',
                            JSON.stringify(normalized)
                        );
                    } catch (ignore) {}
                }
                return normalized;
            } catch (e) {
                return [];
            }
        }

        function updateAttendanceImportAuditButton() {
            const button = document.getElementById('btnAttendanceImportAudit');
            if (!button) return;

            const audit = getStoredAttendanceImportAudit();
            const pending = audit.filter(row => row?.needsAttention === true).length;
            const sourceIssues = audit.filter(row => row?.sourceIssue === true && row?.needsAttention !== true).length;
            const complete = audit.filter(row => row?.isComplete === true && row?.needsAttention !== true).length;
            const total = audit.length;

            // V5.10.38：比對入口固定顯示，不能因 localStorage/audit 暫時沒有資料就整顆消失。
            button.classList.remove('hidden');
            if (!total) {
                button.textContent = '🔎 Excel ↔ 系統比對';
                button.title = '先匯入考勤 Excel，即可逐班比對 Excel 與目前系統上下班';
                button.classList.remove('bg-amber-600','hover:bg-amber-700','bg-emerald-600','hover:bg-emerald-700');
                button.classList.add('bg-violet-600','hover:bg-violet-700');
                return;
            }

            button.classList.remove(
                'bg-violet-600','hover:bg-violet-700',
                'bg-amber-600','hover:bg-amber-700',
                'bg-emerald-600','hover:bg-emerald-700'
            );

            if (pending > 0) {
                button.textContent = `🔎 匯入比對｜待處理 ${pending} / ${total}`;
                button.classList.add('bg-violet-600','hover:bg-violet-700');
                button.title = `共有 ${total} 班，系統尚有 ${pending} 班需要處理`;
            } else if (sourceIssues > 0) {
                button.textContent = `⚠️ 匯入比對｜Excel來源缺資料 ${sourceIssues} / ${total}`;
                button.classList.add('bg-amber-600','hover:bg-amber-700');
                button.title = `系統目前無待補，但 Excel 有 ${sourceIssues} 班來源不完整，不能算完整比對`;
            } else {
                button.textContent = `✅ 匯入比對｜完整 ${complete} / ${total}`;
                button.classList.add('bg-emerald-600','hover:bg-emerald-700');
                button.title = `Excel 與系統四欄皆完整，且沒有待處理異常`;
            }
        }

        function renderAttendanceImportAudit(auditRows = getStoredAttendanceImportAudit()) {
            const body = document.getElementById('attendanceImportAuditBody');
            const summary = document.getElementById('attendanceImportAuditSummary');
            if (!body || !summary) return;

            const rows = Array.isArray(auditRows) ? auditRows : [];
            const fillIn = rows.filter(r => r.addIn).length;
            const fillOut = rows.filter(r => r.addOut).length;
            const pending = rows.filter(r => r.needsAttention === true).length;
            const sourceIssues = rows.filter(r => r.sourceIssue === true).length;
            const timeErrors = rows.filter(r => ['warning','error'].includes(String(r.auditSeverity || ''))).length;
            const pairingIssues = rows.filter(r => r.pairingIssue === true).length;
            const complete = rows.filter(r => r.isComplete === true && r.needsAttention !== true).length;
            const crossDay = rows.filter(r => r.crossDay).length;

            summary.textContent =
                `總比對 ${rows.length} 班｜系統待處理 ${pending}｜真正完整 ${complete}｜Excel來源缺資料 ${sourceIssues}｜缺卡可補 ${fillIn + fillOut}｜時間異常 ${timeErrors}｜配對異常 ${pairingIssues}｜跨日 ${crossDay}`;

            body.innerHTML = rows.map((row, rowIndex) => {
                const auditRowKey = encodeURIComponent(p79AttendanceAuditRowKey(row));
                const severity = String(row.auditSeverity || (row.addIn || row.addOut ? 'missing' : 'ok'));
                const actionClass =
                    severity === 'error'
                        ? 'bg-rose-100 text-rose-800 dark:bg-rose-950/40 dark:text-rose-300'
                        : (severity === 'warning'
                            ? 'bg-orange-100 text-orange-800 dark:bg-orange-950/40 dark:text-orange-300'
                            : (severity === 'source'
                                ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-950/40 dark:text-yellow-300'
                                : (severity === 'missing'
                                    ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300'
                                    : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-300')));

                return `<tr class="border-b border-slate-100 dark:border-slate-800">
                    <td class="px-2 py-2 text-center">${Number(row.index || 0)}</td>
                    <td class="px-2 py-2 font-bold">${escapeHtml(row.attNo || '')}</td>
                    <td class="px-2 py-2">${escapeHtml(row.empId || '')}</td>
                    <td class="px-2 py-2 font-bold">${escapeHtml(row.name || '')}</td>
                    <td class="px-2 py-2 bg-sky-50/80 dark:bg-sky-950/20 font-semibold text-sky-900 dark:text-sky-100">${escapeHtml(row.excelIn || '--')}</td>
                    <td class="px-2 py-2 bg-sky-50/80 dark:bg-sky-950/20 font-semibold text-sky-900 dark:text-sky-100">${escapeHtml(row.excelOut || '--')}</td>
                    <td class="px-2 py-2 bg-violet-50/80 dark:bg-violet-950/20 font-semibold text-violet-900 dark:text-violet-100">${escapeHtml(row.systemIn || '--')}</td>
                    <td class="px-2 py-2 bg-violet-50/80 dark:bg-violet-950/20 font-semibold text-violet-900 dark:text-violet-100">${escapeHtml(row.systemOut || '--')}</td>
                    <td class="px-2 py-2">${escapeHtml(row.systemStatus || '')}</td>
                    <td class="px-2 py-2 text-center">${row.crossDay ? '🌙 是' : '否'}</td>
                    <td class="px-2 py-2"><span class="inline-flex px-1.5 py-1 rounded-lg font-black ${actionClass}">${escapeHtml(row.action || '')}</span></td>
                    <td class="px-2 py-2 sticky right-0 bg-white dark:bg-slate-900">
                        <div class="p79-audit-actions">
                            ${row.systemIn
                                ? `<button type="button" onclick="openAttendanceImportAuditAction('${auditRowKey}','editIn')" class="px-2 py-1 rounded-lg bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 font-bold hover:ring-2 hover:ring-sky-300">✏️ 修改上班</button>`
                                : `<button type="button" onclick="openAttendanceImportAuditAction('${auditRowKey}','addIn')" class="px-2 py-1 rounded-lg bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300 font-bold hover:ring-2 hover:ring-amber-300">${row.excelIn ? '＋ 補上班' : '＋ 人工補上班'}</button>`}
                            ${row.systemOut
                                ? `<button type="button" onclick="openAttendanceImportAuditAction('${auditRowKey}','editOut')" class="px-2 py-1 rounded-lg bg-violet-100 text-violet-700 dark:bg-violet-950 dark:text-violet-300 font-bold hover:ring-2 hover:ring-violet-300">✏️ 修改下班</button>`
                                : `<button type="button" onclick="openAttendanceImportAuditAction('${auditRowKey}','addOut')" class="px-2 py-1 rounded-lg bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300 font-bold hover:ring-2 hover:ring-orange-300">${row.excelOut ? '＋ 補下班' : '＋ 人工補下班'}</button>`}
                        </div>
                    </td>
                </tr>`;
            }).join('');

            updateAttendanceImportAuditButton();
        }

        function p79ReturnToAttendanceAuditAfterMutation() {
            if (!p79AttendanceAuditReturnKey) return;
            const expectedKey = p79AttendanceAuditReturnKey;
            p79AttendanceAuditReturnKey = '';

            setTimeout(() => {
                try {
                    rebuildAttendanceImportAuditFromCurrentSystem({silent:true});
                    showAttendanceImportAuditModal();

                    // 若原列仍存在，捲回該人附近；列已處理消失/重新配對也不影響。
                    const row = p79FindAttendanceAuditRow(expectedKey);
                    if (row) {
                        showToast(`已更新「${row.name || row.attNo || ''}」並返回比對明細`, 'success');
                    }
                } catch (e) {
                    console.warn('返回匯入比對明細失敗：', e);
                }
            }, 180);
        }

        function p79AuditRowDate(timeStr, fallback = '') {
            const date = getAttendanceDateKey(timeStr || fallback || '');
            return String(date || '').trim();
        }

        function p79AuditRowIdentity(row) {
            return String(row?.empId || row?.attNo || row?.name || '').trim();
        }

        function p79NormalizeAuditName(value) {
            return stripAttendanceNameTrailingMeta(String(value || ''))
                .replace(/\s+/g,'')
                .toUpperCase();
        }

        function p79AttendanceAuditRowKey(row) {
            return [
                normalizeAttendanceStatsAttNo(row?.attNo),
                String(row?.empId || '').trim().toUpperCase(),
                p79NormalizeAuditName(row?.name),
                normalizeImportedAttendanceTime(row?.excelIn),
                normalizeImportedAttendanceTime(row?.excelOut)
            ].join('|');
        }

        function p79AuditRecordIdentityMatches(row, record) {
            if (!row || !record) return false;

            const rowAtt = normalizeAttendanceStatsAttNo(row?.attNo);
            const recAtt = normalizeAttendanceStatsAttNo(record?.attNo);
            if (rowAtt && recAtt) return rowAtt === recAtt;

            const rowEmp = String(row?.empId || '').trim().toUpperCase();
            const recEmp = String(record?.empId || '').trim().toUpperCase();
            if (rowEmp && recEmp && rowEmp === recEmp) return true;

            const rowName = p79NormalizeAuditName(row?.name);
            const recName = p79NormalizeAuditName(record?.name);
            if (rowName && recName && rowName === recName) return true;

            return false;
        }

        function p79FindAttendanceAuditRow(rowKey) {
            const key = String(rowKey || '');
            return getStoredAttendanceImportAudit().find(row =>
                p79AttendanceAuditRowKey(row) === key
            ) || null;
        }

        function p79ResolveAuditSystemRecord(row, type) {
            if (!row) return null;

            const directId = String(type === 'IN' ? row.systemInId || '' : row.systemOutId || '');
            if (directId) {
                const byId = (Array.isArray(records) ? records : []).find(record =>
                    String(record?.id ?? '') === directId &&
                    getAttendanceRecordType(record) === type &&
                    p79AuditRecordIdentityMatches(row, record)
                );
                if (byId) return byId;
            }

            const targetTime = String(type === 'IN' ? row.systemIn || '' : row.systemOut || '');
            const wantedTs = getAttendanceTimestamp({timeStr:targetTime});
            let best = null;
            let bestDiff = Infinity;

            (Array.isArray(records) ? records : []).forEach(record => {
                if (!record || isLocallyDeletedAttendanceRecord(record)) return;
                if (getAttendanceRecordType(record) !== type) return;
                if (!p79AuditRecordIdentityMatches(row, record)) return;

                const ts = getAttendanceTimestamp(record);
                if (!Number.isFinite(ts)) return;

                const diff = Number.isFinite(wantedTs) ? Math.abs(ts - wantedTs) : 0;
                if (diff < bestDiff) {
                    bestDiff = diff;
                    best = record;
                }
            });

            // 有指定系統時間時，只允許 15 分鐘內同一人的紀錄；沒有時間則只靠嚴格身份。
            if (!best) return null;
            if (targetTime && bestDiff > 15 * 60 * 1000) return null;
            return best;
        }

        let p79AttendanceAuditReturnKey = '';

        function openAttendanceImportAuditAction(encodedRowKey, action) {
            const rowKey = decodeURIComponent(String(encodedRowKey || ''));
            const row = p79FindAttendanceAuditRow(rowKey);
            if (!row) {
                showToast('找不到這筆比對資料，請重新比對', 'warning');
                return;
            }

            if (action === 'editIn') {
                const record = p79ResolveAuditSystemRecord(row, 'IN');
                if (!record?.id) {
                    showToast('找不到對應的系統上班原始紀錄，請先按重新比對', 'warning');
                    return;
                }
                closeAttendanceImportAuditModal();
                setTimeout(() => {
                    p79AttendanceAuditReturnKey = rowKey;
                    openEditRecordModal(String(record.id), 'IN', String(record.timeStr || row.systemIn || ''), row);
                }, 0);
                return;
            }

            if (action === 'editOut') {
                const record = p79ResolveAuditSystemRecord(row, 'OUT');
                if (!record?.id) {
                    showToast('找不到對應的系統下班原始紀錄，請先按重新比對', 'warning');
                    return;
                }
                closeAttendanceImportAuditModal();
                setTimeout(() => {
                    p79AttendanceAuditReturnKey = rowKey;
                    openEditRecordModal(String(record.id), 'OUT', String(record.timeStr || row.systemOut || ''), row);
                }, 0);
                return;
            }

            const identity = p79AuditRowIdentity(row);
            const attNo = String(row.attNo || '');
            const name = String(row.name || '');

            if (action === 'addIn') {
                const date = p79AuditRowDate(row.excelIn || row.systemOut || row.excelOut || row.systemIn);
                if (!date) {
                    showToast('找不到可用日期，請直接到考勤表手動補上班', 'warning');
                    return;
                }
                const targetId = String(row.systemOutId || '');
                p79AttendanceAuditReturnKey = rowKey;
                closeAttendanceImportAuditModal();
                setTimeout(() => {
                    openRowManualAdd(
                        encodeURIComponent(identity),
                        encodeURIComponent(date),
                        '上班簽到',
                        encodeURIComponent(targetId),
                        encodeURIComponent(attNo),
                        encodeURIComponent(name)
                    );
                    // 預先帶入 Excel 的時間，使用者仍可確認/修改後再儲存。
                    setTimeout(() => {
                        const m = String(row.excelIn || '').match(/(\d{1,2}):(\d{2})/);
                        if (m) {
                            set24HourTime('addModal', `${String(m[1]).padStart(2,'0')}:${m[2]}`);
                        } else {
                            showToast('Excel 也沒有上班時間，請人工輸入正確上班時間', 'warning');
                        }
                    }, 30);
                }, 0);
                return;
            }

            if (action === 'addOut') {
                const date = p79AuditRowDate(row.excelOut || row.systemIn || row.excelIn || row.systemOut);
                if (!date) {
                    showToast('找不到可用日期，請直接到考勤表手動補下班', 'warning');
                    return;
                }
                const targetId = String(row.systemInId || '');
                p79AttendanceAuditReturnKey = rowKey;
                closeAttendanceImportAuditModal();
                setTimeout(() => {
                    openRowManualAdd(
                        encodeURIComponent(identity),
                        encodeURIComponent(date),
                        '下班簽退',
                        encodeURIComponent(targetId),
                        encodeURIComponent(attNo),
                        encodeURIComponent(name)
                    );
                    setTimeout(() => {
                        const m = String(row.excelOut || '').match(/(\d{1,2}):(\d{2})/);
                        if (m) {
                            set24HourTime('addModal', `${String(m[1]).padStart(2,'0')}:${m[2]}`);
                        } else {
                            showToast('Excel 也沒有下班時間，請人工輸入正確下班時間', 'warning');
                        }
                    }, 30);
                }, 0);
                return;
            }
        }

        function rebuildAttendanceImportAuditFromCurrentSystem(options = {}) {
            const oldAudit = getStoredAttendanceImportAudit();
            if (!oldAudit.length) {
                showToast('目前沒有可以重新比對的匯入資料', 'warning');
                return;
            }

            const sourceRecords = [];
            oldAudit.forEach((row, index) => {
                const base = {
                    attNo: row.attNo || '',
                    empId: row.empId || '',
                    name: row.name || '',
                    source: 'audit-recheck'
                };
                if (row.excelIn) {
                    sourceRecords.push({
                        ...base,
                        id:`AUDIT-IN-${index}`,
                        timeStr:row.excelIn,
                        status:'上班簽到'
                    });
                }
                if (row.excelOut) {
                    sourceRecords.push({
                        ...base,
                        id:`AUDIT-OUT-${index}`,
                        timeStr:row.excelOut,
                        status:'下班簽退'
                    });
                }
            });

            const reconcile = p79ReconcileImportByShift(sourceRecords);
            window.p79LastAttendanceImportAudit = reconcile.audit;
            try {
                localStorage.setItem(
                    'port79_last_attendance_import_audit',
                    JSON.stringify(reconcile.audit)
                );
            } catch (e) {}

            renderAttendanceImportAudit(reconcile.audit);
            updateAttendanceImportAuditButton();

            const pending = reconcile.audit.filter(r=>r.needsAttention === true).length;
            if (!options?.silent) {
                showToast(
                    `已重新比對：總共 ${reconcile.audit.length} 班｜待處理 ${pending}｜已完成 ${reconcile.audit.length - pending}`,
                    'success'
                );
            }
            return reconcile;
        }

        window.openAttendanceImportAuditAction = openAttendanceImportAuditAction;
        window.rebuildAttendanceImportAuditFromCurrentSystem = rebuildAttendanceImportAuditFromCurrentSystem;

        function showAttendanceImportAuditModal() {
            const audit = getStoredAttendanceImportAudit();
            if (!audit.length) {
                showToast('目前還沒有匯入比對明細；請先匯入一份 Excel', 'warning');
                return;
            }
            renderAttendanceImportAudit(audit);
            document.getElementById('attendanceImportAuditModal')?.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }

        function closeAttendanceImportAuditModal() {
            document.getElementById('attendanceImportAuditModal')?.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        document.addEventListener('keydown', event => {
            if (event.key !== 'Escape') return;
            const modal = document.getElementById('attendanceImportAuditModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeAttendanceImportAuditModal();
            }
        });

        function exportAttendanceImportAuditExcel() {
            const audit = getStoredAttendanceImportAudit();
            if (!audit.length) {
                showToast('目前沒有匯入比對明細', 'warning');
                return;
            }
            if (typeof XLSX === 'undefined' || !XLSX?.utils) {
                showToast('Excel 元件尚未載入，請重新整理後再試', 'warning');
                return;
            }

            const fillIn = audit.filter(r => r.addIn).length;
            const fillOut = audit.filter(r => r.addOut).length;
            const completeCount = audit.filter(r => r.isComplete === true && r.needsAttention !== true).length;
            const sourceIssueCount = audit.filter(r => r.sourceIssue === true).length;
            const pendingCount = audit.filter(r => r.needsAttention === true).length;
            const crossDay = audit.filter(r => r.crossDay).length;
            const needRows = audit.filter(r => r.addIn || r.addOut);

            const summaryRows = [
                ['PORT79 考勤匯入逐班比對報表', ''],
                ['匯出時間', new Date().toLocaleString('zh-TW', {hour12:false})],
                ['逐班比對總數', audit.length],
                ['需要補上班', fillIn],
                ['需要補下班', fillOut],
                ['真正完整班次', completeCount],
                ['系統待處理', pendingCount],
                ['Excel來源缺資料', sourceIssueCount],
                ['跨日班次', crossDay],
                ['需要補卡班次', needRows.length],
                ['', ''],
                ['比對規則', 'Excel 先組成 IN→OUT 班次，再與系統班次逐班比對；已有側保留，只補空白側。']
            ];

            const detailRows = audit.map(row => ({
                '序號': row.index || '',
                '考勤號': row.attNo || '',
                '工號': row.empId || '',
                '姓名': row.name || '',
                'Excel上班': row.excelIn || '',
                'Excel下班': row.excelOut || '',
                '系統上班': row.systemIn || '',
                '系統下班': row.systemOut || '',
                '系統上班ID': row.systemInId || '',
                '系統下班ID': row.systemOutId || '',
                '系統狀態': row.systemStatus || '',
                '跨日': row.crossDay ? '是' : '否',
                '上班差異(分)': row.inDiffMin ?? '',
                '下班差異(分)': row.outDiffMin ?? '',
                '補上班': row.addIn ? '是' : '否',
                '補下班': row.addOut ? '是' : '否',
                'Excel完整': row.excelComplete ? '是' : '否',
                '系統完整': row.systemComplete ? '是' : '否',
                '真正完整班次': row.isComplete && !row.needsAttention ? '是' : '否',
                'Excel來源缺資料': row.sourceIssue ? '是' : '否',
                '待處理': row.needsAttention ? '是' : '否',
                '異常等級': row.auditSeverity || '',
                '比對結果/動作': row.action || ''
            }));

            const needDetailRows = needRows.map(row => ({
                '序號': row.index || '',
                '考勤號': row.attNo || '',
                '工號': row.empId || '',
                '姓名': row.name || '',
                'Excel上班': row.excelIn || '',
                'Excel下班': row.excelOut || '',
                '系統上班': row.systemIn || '',
                '系統下班': row.systemOut || '',
                '要補上班': row.addIn ? '是' : '否',
                '要補下班': row.addOut ? '是' : '否',
                '跨日': row.crossDay ? '是' : '否',
                '比對結果/動作': row.action || ''
            }));

            const wb = XLSX.utils.book_new();
            const wsSummary = XLSX.utils.aoa_to_sheet(summaryRows);
            const wsDetail = XLSX.utils.json_to_sheet(detailRows);
            const wsNeed = XLSX.utils.json_to_sheet(needDetailRows);

            wsSummary['!cols'] = [{wch:22},{wch:70}];
            wsDetail['!cols'] = [
                {wch:6},{wch:10},{wch:14},{wch:12},
                {wch:20},{wch:20},{wch:20},{wch:20},
                {wch:18},{wch:8},{wch:12},{wch:12},
                {wch:10},{wch:10},{wch:28}
            ];
            wsNeed['!cols'] = [
                {wch:6},{wch:10},{wch:14},{wch:12},
                {wch:20},{wch:20},{wch:20},{wch:20},
                {wch:10},{wch:10},{wch:8},{wch:28}
            ];

            // Auto filter on table sheets.
            if (detailRows.length) wsDetail['!autofilter'] = {ref: wsDetail['!ref']};
            if (needDetailRows.length) wsNeed['!autofilter'] = {ref: wsNeed['!ref']};

            XLSX.utils.book_append_sheet(wb, wsSummary, '總覽');
            XLSX.utils.book_append_sheet(wb, wsDetail, '逐班比對');
            XLSX.utils.book_append_sheet(wb, wsNeed, '需要補卡');

            const now = new Date();
            const stamp = [
                now.getFullYear(),
                String(now.getMonth()+1).padStart(2,'0'),
                String(now.getDate()).padStart(2,'0'),
                '_',
                String(now.getHours()).padStart(2,'0'),
                String(now.getMinutes()).padStart(2,'0')
            ].join('');
            XLSX.writeFile(wb, `PORT79_考勤匯入逐班比對_${stamp}.xlsx`);
            showToast(`Excel 比對報表已產生：逐班 ${audit.length}｜需要補卡 ${needRows.length}`, 'success');
        }

        function exportAttendanceImportAuditCsv() {
            const audit = getStoredAttendanceImportAudit();
            if (!audit.length) return;

            const headers = [
                '序號','考勤號','工號','姓名',
                'Excel上班','Excel下班','系統上班','系統下班',
                '系統狀態','跨日','比對結果'
            ];
            const rows = audit.map(row => [
                row.index || '',
                row.attNo || '',
                row.empId || '',
                row.name || '',
                row.excelIn || '',
                row.excelOut || '',
                row.systemIn || '',
                row.systemOut || '',
                row.systemStatus || '',
                row.crossDay ? '是' : '否',
                row.action || ''
            ]);

            const csv = [headers, ...rows]
                .map(line => line.map(value => `"${String(value ?? '').replace(/"/g,'""')}"`).join(','))
                .join('\r\n');

            const blob = new Blob(['\uFEFF' + csv], {type:'text/csv;charset=utf-8;'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `考勤匯入逐班比對_${new Date().toISOString().slice(0,10)}.csv`;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }

        window.showAttendanceImportAuditModal = showAttendanceImportAuditModal;
        window.closeAttendanceImportAuditModal = closeAttendanceImportAuditModal;
        window.exportAttendanceImportAuditExcel = exportAttendanceImportAuditExcel;
        window.exportAttendanceImportAuditCsv = exportAttendanceImportAuditCsv;
        window.updateAttendanceImportAuditButton = updateAttendanceImportAuditButton;

        async function importAttendanceExcel(event) {
            const input = event.target;
            const file = input.files?.[0];
            if (!file) return;
            if (!requireAdminAction('attendanceImport', '匯入考勤紀錄')) { input.value = ''; return; }
            if (!ensureExcelLibrary()) { input.value = ''; return; }

            try {
                const workbook = XLSX.read(await file.arrayBuffer(), { type: 'array', codepage: 950, cellDates: true });
                const sheet = workbook.Sheets[workbook.SheetNames[0]];
                const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
                const decodedRows = rows.map(row => row.map(decodeLegacyAttendanceExcelText));
                const headerRowIndex = decodedRows.slice(0, 10).findIndex(row => {
                    const headers = row.map(normalizeAttendanceImportHeader);
                    return headers.some(value => ['出勤時間', '考勤時間', '完整考勤時間'].includes(value))
                        && headers.some(value => ['出勤狀態', '考勤狀態', '狀態', '打卡項目'].includes(value));
                });
                if (headerRowIndex < 0) throw new Error('找不到「出勤時間」與「出勤狀態」欄位');

                const headers = decodedRows[headerRowIndex].map(normalizeAttendanceImportHeader);
                const findColumn = aliases => headers.findIndex(header => aliases.includes(header));
                const indexes = {
                    attNo: findColumn(['考勤號碼', '考勤號', '員工考勤號']),
                    empId: findColumn(['自定義編號', '工號', '完整工號', '員工編號']),
                    name: findColumn(['姓名', '員工姓名', '工號姓名']),
                    dept: findColumn(['部門', '所屬部門']),
                    time: findColumn(['出勤時間', '考勤時間', '完整考勤時間', '打卡時間']),
                    status: findColumn(['出勤狀態', '考勤狀態', '狀態', '打卡項目']),
                    location: findColumn(['地點', '定位地點', '備註地點']),
                    note: findColumn(['備註', '備註說明'])
                };
                if (indexes.time < 0 || indexes.status < 0 || (indexes.empId < 0 && indexes.attNo < 0 && indexes.name < 0)) {
                    throw new Error('欄位不完整，至少需要員工識別、出勤時間與出勤狀態');
                }

                let candidates = [];
                const parsedImportRecords = [];
                let skippedDuplicate = 0;
                let skippedProtected = 0;
                let skippedInvalid = 0;
                let unmatched = 0;
                const baseId = Date.now() * 1000;

                decodedRows.slice(headerRowIndex + 1).forEach((row, rowOffset) => {
                    const valueAt = index => index >= 0 ? decodeLegacyAttendanceExcelText(row[index]) : '';
                    const attNoRaw = String(valueAt(indexes.attNo) || '').trim();
                    const empIdRaw = String(valueAt(indexes.empId) || '').trim().toUpperCase();
                    const nameRaw = normalizeImportedAttendanceName(valueAt(indexes.name));
                    const timeStr = normalizeImportedAttendanceTime(valueAt(indexes.time));
                    const status = normalizeImportedAttendanceStatus(valueAt(indexes.status));
                    if ((!attNoRaw && !empIdRaw && !nameRaw) || !timeStr || !status) {
                        if (row.some(value => String(value ?? '').trim())) skippedInvalid++;
                        return;
                    }

                    const matchedEmployee = findEmployeeForAttendanceIdentity({ attNo: attNoRaw, empId: empIdRaw, name: nameRaw }, employees);
                    if (!matchedEmployee) unmatched++;
                    const record = {
                        id: baseId + rowOffset,
                        attNo: normalizeAttendanceNumber(matchedEmployee?.attNo ?? attNoRaw, matchedEmployee?.empId || empIdRaw),
                        empId: matchedEmployee?.empId || empIdRaw,
                        name: normalizeImportedAttendanceName(matchedEmployee?.name || nameRaw),
                        dept: matchedEmployee?.dept || String(valueAt(indexes.dept) || '一般').trim() || '一般',
                        timeStr,
                        status,
                        location: String(valueAt(indexes.location) || '').trim() || `Excel匯入：${file.name}`,
                        note: String(valueAt(indexes.note) || '').trim(),
                        source: 'excel-import',
                        importFile: file.name
                    };
                    const exactKey = p79ImportExactEventKey(record);
                    const sourceKey = getAttendanceImportEventKey(record);
                    if (!exactKey) {
                        skippedInvalid++;
                        return;
                    }

                    record.sourceEventKey = sourceKey || exactKey;
                    parsedImportRecords.push(record);
                });

                if (!parsedImportRecords.length) {
                    showToast(`Excel 沒有可比對的有效考勤；格式無效 ${skippedInvalid} 筆`, 'warning');
                    return;
                }

                const reconcile = p79ReconcileImportByShift(parsedImportRecords);
                candidates = reconcile.selected;
                skippedDuplicate = reconcile.sourceDuplicateCount;

                // 同一原始事件若已人工修改，系統班次本身已被視為「有該側」，
                // 不再額外新增；保護數量改由 audit 顯示，不做日期猜測。
                skippedProtected = reconcile.audit.filter(row =>
                    !row.addIn && !row.addOut &&
                    /原始資料已有|已有完整班次/.test(row.action)
                ).length;

                const skippedExistingSide = reconcile.audit.reduce((n,row) => {
                    let count = 0;
                    if (row.excelIn && row.systemIn) count++;
                    if (row.excelOut && row.systemOut) count++;
                    return n + count;
                }, 0);

                const skippedSameSideExtra = reconcile.sourceDuplicateCount;

                window.p79LastAttendanceImportAudit = reconcile.audit;
                try {
                    localStorage.setItem(
                        'port79_last_attendance_import_audit',
                        JSON.stringify(reconcile.audit)
                    );
                } catch (e) {}

                renderAttendanceImportAudit(reconcile.audit);

                if (!candidates.length) {
                    showAttendanceImportAuditModal();
                    showToast('逐筆比對完成：系統目前沒有需要補的空白上下班', 'success');
                    return;
                }

                const importSideSummary = p79ImportMissingSideSummary(candidates);
                const confirmed = confirm(`準備從「${file.name}」匯入考勤資料：

已逐班次比對 ${reconcile.audit.length} 班
系統空白、需要補的原始打卡 ${candidates.length} 筆
其中補上班簽到 ${importSideSummary.inCount} 筆
其中補下班簽退 ${importSideSummary.outCount} 筆

系統已有的一側 ${skippedExistingSide} 筆，不重複補
Excel 完全重複 ${skippedDuplicate} 筆
格式無效 ${skippedInvalid} 筆
未配對員工主檔 ${unmatched} 筆

比對規則：
• 不是只看日期，而是先把 Excel 上班→下班組成班次
• 跨日班次（例如 10/03 23:34 → 10/04 07:53）視為同一班
• 系統已有下班，只補 Excel 對應的上班
• 系統已有上班，只補 Excel 對應的下班
• 系統兩側都有，不補
• 系統既有時間若與 Excel 差幾分鐘，保留系統/人工時間，不再新增另一筆
• 每一班的 Excel/系統比對結果可按「🔎 匯入比對明細」查看

確定先補到畫面，再寫入雲端嗎？`);
                if (!confirmed) return;

                if (!await backupAttendanceRecordsBeforeImport(file.name)) {
                    throw new Error('無法備份目前的考勤紀錄，為避免資料遺失已取消匯入');
                }

                // V5.10.23：匯入後不再呼叫 deduplicateAttendanceRecords()。
                // candidates 前面已經排除「完全相同事件」；不同時間的原始刷卡必須全部保留。
                records = [...candidates, ...records];
                try { saveRecords(); } catch (e) {}
                archiveAttendanceRecords(candidates);

                try { initDropdowns(); } catch (e) {}
                try { renderAdminRecordsTable(); } catch (e) {
                    try { p79RenderOnlyVisibleAttendanceView(); } catch (_) {}
                }
                if (currentEmp && !isAdminLoggedIn) {
                    try { renderEmpHistoryTable(); } catch (e) {}
                }

                // 確保先完成畫面更新，再開始任何雲端寫入。
                await new Promise(resolve => {
                    if (typeof requestAnimationFrame === 'function') {
                        requestAnimationFrame(() => requestAnimationFrame(resolve));
                    } else {
                        setTimeout(resolve, 40);
                    }
                });

                const monthCounts = candidates.reduce((map, record) => {
                    const month = attendanceRecordMonthKey(record) || '未知月份';
                    map[month] = (map[month] || 0) + 1;
                    return map;
                }, {});
                const monthText = Object.entries(monthCounts)
                    .sort((a,b)=>String(a[0]).localeCompare(String(b[0])))
                    .map(([month,count]) => `${month}：${count} 筆`)
                    .join('、');

                showToast(
                    `只補空白欄位：上班 ${importSideSummary.inCount} 筆｜下班 ${importSideSummary.outCount} 筆｜共 ${candidates.length} 筆；已有上下班不重複補，現在開始寫入雲端`,
                    'success'
                );

                const cloudResult = await syncImportedAttendanceRecordsToCloud(candidates, {
                    fileName:file.name,
                    monthText
                });

                if (cloudResult.failed > 0 || cloudResult.queued > 0) {
                    showToast(
                        `匯入完成：本機 ${candidates.length} 筆｜雲端已確認 ${cloudResult.confirmed} 筆｜待補傳 ${cloudResult.queued} 筆｜失敗 ${cloudResult.failed} 筆`,
                        'warning'
                    );
                } else {
                    showToast(
                        `匯入完成：逐班比對 ${reconcile.audit.length} 班｜補上班 ${importSideSummary.inCount}｜補下班 ${importSideSummary.outCount}｜雲端已確認 ${cloudResult.confirmed}`,
                        'success'
                    );
                }

                updateAttendanceImportAuditButton();

                try {
                    localStorage.setItem('port79_last_attendance_import_summary', JSON.stringify({
                        fileName:file.name,
                        importedAt:new Date().toISOString(),
                        local:candidates.length,
                        cloudConfirmed:cloudResult.confirmed,
                        queued:cloudResult.queued,
                        failed:cloudResult.failed,
                        skippedProtected,
                        skippedDuplicate,
                        skippedInvalid,
                        unmatched,
                        monthCounts,
                        importedIn:importSideSummary.inCount,
                        importedOut:importSideSummary.outCount,
                        skippedExistingSide,
                        skippedSameSideExtra,
                        comparedShifts:reconcile.audit.length,
                        crossDayShifts:reconcile.audit.filter(row=>row.crossDay).length
                    }));
                } catch (e) {}
            } catch (error) {
                console.error('考勤 Excel 匯入失敗：', error);
                showToast('考勤 Excel 匯入失敗：' + (error?.message || error), 'warning');
            } finally {
                input.value = '';
            }
        }

        let exportFieldConfig = {
            attNo: true,
            empId: true,
            name: true,
            dept: true,
            jobTitle: true,
            time: true,
            status: true,
            location: true,
            note: true
        };

        function openExportRecordsModal() {
            if (!requireAdminAction('attendanceExport', '匯出考勤')) return;
            const companyFilter = document.getElementById('exportCompanyFilter');
            if (companyFilter) companyFilter.value = 'ALL';
            document.getElementById('exportRecordsModal').classList.remove('hidden');
            updateExportFieldCount();
        }

        function closeExportRecordsModal() {
            document.getElementById('exportRecordsModal').classList.add('hidden');
        }

        function selectAllExportFields(selectAll) {
            document.querySelectorAll('.export-field-checkbox').forEach(cb => {
                cb.checked = selectAll;
            });
            updateExportFieldCount();
        }

        function resetExportFields() {
            document.querySelectorAll('.export-field-checkbox').forEach(cb => {
                cb.checked = true;
            });
            updateExportFieldCount();
        }

        function updateExportFieldCount() {
            const checkedCount = document.querySelectorAll('.export-field-checkbox:checked').length;
            document.getElementById('exportFieldCount').textContent = `已選 ${checkedCount} 個欄位`;
        }

        function exportSelectedRecordsExcel() {
            if (!requireAdminAction('attendanceExport', '匯出考勤')) return;
            const checkboxes = document.querySelectorAll('.export-field-checkbox');
            let selectedFields = [];
            checkboxes.forEach(cb => {
                if (cb.checked) {
                    selectedFields.push({ key: cb.value, label: cb.getAttribute('data-label') });
                }
            });

            if (selectedFields.length === 0) {
                showToast("請至少選擇一個匯出欄位！", "warning");
                return;
            }

            const companyFilter = document.getElementById('exportCompanyFilter')?.value || 'ALL';
            const visibleRecords = records
                .filter(canCurrentAdminViewDataRow)
                .filter(record => {
                    if (companyFilter === 'ALL') return true;
                    const matchedEmployee = employees.find(emp =>
                        String(emp.empId || '').trim().toUpperCase() === String(record.empId || '').trim().toUpperCase() ||
                        normalizeAttendanceStatsAttNo(emp.attNo) === normalizeAttendanceStatsAttNo(record.attNo)
                    );
                    const recordEmpId = String(record.empId || matchedEmployee?.empId || '').trim().toUpperCase();
                    const company = recordEmpId.match(/^([A-Z]+)/)?.[1] || '';
                    return company === companyFilter;
                });
            if (visibleRecords.length === 0) {
                showToast(companyFilter === 'ALL' ? "目前無考勤紀錄可供匯出" : `目前沒有 ${companyFilter} 工號的考勤紀錄`, "warning");
                return;
            }
            if (!ensureExcelLibrary()) return;
            const sheetRows = [selectedFields.map(f => f.label)];
            visibleRecords.forEach(r => {
                const currentEmployee = findEmployeeForAttendanceIdentity(r, getAttendanceIdentityEmployeePool());
                const rowData = selectedFields.map(f => {
                    let val = "";
                    if (f.key === 'attNo') val = currentEmployee?.attNo ?? r.attNo ?? '';
                    if (f.key === 'empId') val = currentEmployee?.empId || r.empId || '';
                    if (f.key === 'name') val = currentEmployee?.name || r.name || '';
                    if (f.key === 'dept') val = currentEmployee?.dept || r.dept || '';
                    if (f.key === 'jobTitle') val = currentEmployee?.jobTitle || currentEmployee?.deptDetail || '';
                    if (f.key === 'time') val = formatDateTime(r.timeStr) || '';
                    if (f.key === 'status') val = r.status || '';
                    if (f.key === 'location') val = formatAttendanceLocationDisplay(r.location) || '';
                    if (f.key === 'note') val = r.note || '';
                    return val;
                });
                sheetRows.push(rowData);
            });
            const worksheet = XLSX.utils.aoa_to_sheet(sheetRows);
            worksheet['!cols'] = selectedFields.map(field => ({ wch: ({ attNo: 10, empId: 15, name: 14, dept: 16, jobTitle: 14, time: 22, status: 14, location: 28, note: 28 })[field.key] || 16 }));
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, '考勤紀錄');
            const companySuffix = companyFilter === 'ALL' ? 'AP_AN' : companyFilter;
            XLSX.writeFile(workbook, `${sysConfig.companyName || defaultConfig.companyName}_考勤紀錄_${companySuffix}_${new Date().toISOString().slice(0,10)}.xlsx`);
            closeExportRecordsModal();
            showToast("考勤紀錄 Excel 匯出成功！", "success");
        }

        // 首頁預設日期若已經是同一天，載入後立即顯示 1 天，而不是舊制的 8 小時。
        window.addEventListener('load', function() {
            setTimeout(function() {
                try { updateHomeLeaveDays(); } catch (e) {}
            }, 0);
        });
</script>

<script id="port79-unified-sticky-attendance">
(()=>{const h=document.querySelector('body>header');if(!h)return;const sync=()=>document.documentElement.style.setProperty('--attendance-header-h',Math.ceil(h.getBoundingClientRect().height)+'px');sync();window.addEventListener('resize',sync,{passive:true});if(window.ResizeObserver)new ResizeObserver(sync).observe(h);})();
</script>

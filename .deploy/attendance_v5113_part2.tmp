<script id="p79-performance-diagnostics-v20261004">
(function(){
  window.p79PerformanceSnapshot=function(){
    const mem=performance?.memory;
    const out={
      page:location.pathname,
      visibility:document.visibilityState,
      domNodes:document.getElementsByTagName('*').length,
      heapUsedMB:mem?Math.round(mem.usedJSHeapSize/1048576):null,
      heapTotalMB:mem?Math.round(mem.totalJSHeapSize/1048576):null
    };
    console.table(out);
    return out;
  };
})();
</script>


<script id="p79-attendance-direct-admin-boot">
(function(){
'use strict';

function p79HasAdminSessionForDirectOpen(){
  try{
    let u=null,a=null;
    try{u=JSON.parse(sessionStorage.getItem('port79_user_session')||'null')}catch(e){}
    try{a=JSON.parse(sessionStorage.getItem('admin_session')||'null')}catch(e){}

    const entryMode=String(
      sessionStorage.getItem('port79_entry_mode') ||
      u?.entryMode ||
      (u?.punchOnly?'punch':'')
    ).toLowerCase();

    if(entryMode==='punch'||u?.punchOnly===true) return false;

    const role=[
      String(sessionStorage.getItem('aqc_admin_role')||'').toLowerCase(),
      String(a?.adminRole||a?.role||'').toLowerCase(),
      String(u?.adminRole||u?.role||'').toLowerCase()
    ].find(r=>r==='admin'||r==='superadmin')||'';

    const token=String(
      sessionStorage.getItem('port79_admin_token')||
      sessionStorage.getItem('port79_gc_superadmin_token')||
      sessionStorage.getItem('port79_gc_token')||
      sessionStorage.getItem('port79_user_token')||
      ''
    ).trim();

    return !!role && !!token;
  }catch(e){}
  return false;
}

function p79OpenAttendanceAdminDirect(){
  if(!p79HasAdminSessionForDirectOpen()){
    document.documentElement.classList.remove('p79-attendance-admin-prepaint');
    document.body.style.visibility='';
    return;
  }

  try{
    if(typeof window.restoreAdminSession==='function') window.restoreAdminSession();
    try{sessionStorage.setItem('aqc_admin_active_tab','records')}catch(e){}

    if(typeof window.switchView==='function'){
      window.switchView('admin');
    }

    if(typeof window.switchAdminTab==='function'){
      window.switchAdminTab('records');
    }
  }catch(e){
    console.warn('考勤後台直接開啟失敗，交由原本 onload 流程接手：',e);
  }finally{
    document.documentElement.classList.remove('p79-attendance-admin-prepaint');
    document.body.style.visibility='';
  }
}

if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded',()=>setTimeout(p79OpenAttendanceAdminDirect,0),{once:true});
}else{
  setTimeout(p79OpenAttendanceAdminDirect,0);
}
})();
</script>


<script id="p79-cache-center-hard-fallback-20261004-1320-cache-center-final">
(function(){
function add(){
 const menus=['#p79SystemMenu','#p79HrSystemMenu','#p79UnifiedMenu','#attendanceDrawer'];
 menus.forEach(sel=>{const m=document.querySelector(sel);if(!m||m.querySelector('[data-p79-cache-hard="1"]'))return;const b=document.createElement('button');b.type='button';b.dataset.p79CacheHard='1';b.textContent='☁️ 資料快取中心';b.onclick=()=>window.Port79DataCache?.openCenter?.();const th=[...m.querySelectorAll('button')].find(x=>/全系統顯示模式|深淺色|亮色|暗色/.test(x.textContent||''));if(th)m.insertBefore(b,th);else m.appendChild(b);});
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{add();setTimeout(add,500);setTimeout(add,1800)},{once:true});else{add();setTimeout(add,500);setTimeout(add,1800)}
})();
</script>

<script id="p79-attendance-full-cache-bridge-v20261004">
(function(){
'use strict';
window.p79ApplyAttendanceFullCache=async function(snapshot,options={}){
 try{
  if(!snapshot||!Array.isArray(snapshot.records))throw new Error('完整考勤快取格式不正確');
  const cloudRows=snapshot.records.map(r=>typeof normalizeAttendanceRecordIdentifiers==='function'?normalizeAttendanceRecordIdentifiers(r):r);
  if(typeof mergeAttendanceRecordCollections==='function') records=mergeAttendanceRecordCollections(cloudRows,Array.isArray(records)?records:[]);
  else if(typeof deduplicateAttendanceRecordArray==='function') records=deduplicateAttendanceRecordArray([...(Array.isArray(records)?records:[]),...cloudRows]);
  else records=cloudRows;

  if(Array.isArray(snapshot.employees)&&snapshot.employees.length){
   const cloudEmployees=snapshot.employees.map(e=>typeof normalizeEmployeeIdentifiers==='function'?normalizeEmployeeIdentifiers(e):e);
   employees=typeof mergeCloudEmployees==='function'?mergeCloudEmployees(cloudEmployees):cloudEmployees;
   try{ensureBuiltinAdminAccount()}catch(e){}
   try{migrateLegacyDepartments()}catch(e){}
   try{syncDepartmentsFromEmployees()}catch(e){}
   try{syncJobTitlesFromEmployees()}catch(e){}
   try{syncAdminIdsFromEmployeeRoles()}catch(e){}
  }

  try{localStorage.setItem('sp_records_v5',JSON.stringify(records))}catch(e){}
  try{localStorage.setItem('sp_employees_v5',JSON.stringify(employees))}catch(e){}
  try{if(typeof saveAttendanceSafetyBackup==='function')saveAttendanceSafetyBackup(records)}catch(e){}

  if(Array.isArray(snapshot.months)&&typeof updateAttendanceMonthOptionsFromCloud==='function'){
   updateAttendanceMonthOptionsFromCloud(snapshot.months);
  }
  const monthSelect=document.getElementById('filterMonthSelect');
  const now=new Date();
  const currentMonth=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
  if(monthSelect){
   // 完整快取可以保存全部月份，但進入考勤時永遠先停在目前月份。
   // 只有使用者親自操作月份選單選 ALL 時，才顯示全部月份。
   if(options.forceCurrentMonth===true || options.showAll===false){
    if(![...monthSelect.options].some(o=>o.value===currentMonth)){
      const opt=document.createElement('option');opt.value=currentMonth;opt.textContent=currentMonth;monthSelect.appendChild(opt);
    }
    monthSelect.value=currentMonth;
    monthSelect.dataset.p79MonthInitialized='1';
    try{renderAttendanceMonthTabs([...monthSelect.options].map(o=>o.value),currentMonth)}catch(e){}
   }else if(options.showAll===true){
    // 保留相容，但不再由啟動/快取下載流程主動使用。
    monthSelect.value='ALL';
    try{renderAttendanceMonthTabs([...monthSelect.options].map(o=>o.value),'ALL')}catch(e){}
   }
  }
  const from=document.getElementById('recordDateFilter'),to=document.getElementById('recordDateEndFilter');
  if(options.forceCurrentMonth===true || options.showAll===false){
    if(from)from.value='';if(to)to.value='';try{updateRecordDateRangeSummary()}catch(e){}
  }else if(options.showAll===true){
    if(from)from.value='';if(to)to.value='';try{updateRecordDateRangeSummary()}catch(e){}
  }
  try{recordsCurrentPage=1}catch(e){}
  try{initDropdowns()}catch(e){}
  try{if(typeof p79RenderOnlyVisibleAttendanceView==='function')p79RenderOnlyVisibleAttendanceView();else renderAdminRecordsTable()}catch(e){try{renderAdminRecordsTable()}catch(_) {}}
  try{if(typeof renderAdminLiveTable==='function'&&!document.getElementById('adminContentLive')?.classList.contains('hidden'))renderAdminLiveTable()}catch(e){}
  try{if(typeof renderAttendanceStatsTable==='function'&&!document.getElementById('adminContentStats')?.classList.contains('hidden'))renderAttendanceStatsTable(true)}catch(e){}
  try{if(typeof renderOvertimeStats==='function'&&!document.getElementById('adminContentOvertime')?.classList.contains('hidden'))renderOvertimeStats()}catch(e){}
  if(!options.silent){try{showToast(`完整考勤已載入：${records.length} 筆｜員工主檔 ${employees.length} 人`,'success')}catch(e){}}
  return {ok:true,recordCount:records.length,employeeCount:employees.length};
 }catch(err){console.error('完整考勤快取套用失敗',err);try{showToast('完整考勤快取套用失敗：'+(err?.message||err),'warning')}catch(e){};return {ok:false,error:String(err?.message||err)}}
};
})();
</script>


<script id="p79-stale-snapshot-diagnostic-v20261004">
window.p79AttendanceLiveMergeInfo = function(){
  try{
    const list = Array.isArray(records) ? records : [];
    const month = typeof getRequestedAttendanceCloudMonth==='function' ? getRequestedAttendanceCloudMonth() : '';
    const monthRows = list.filter(r => {
      try{return attendanceRecordMonthKey(r)===month}catch(e){return false}
    });
    return {
      month,
      totalRecords:list.length,
      currentMonthRecords:monthRows.length,
      deltaSeq:typeof attendanceDeltaLastSeq!=='undefined'?attendanceDeltaLastSeq:null,
      lastCloudRevision:typeof lastAttendanceCloudRevision!=='undefined'?lastAttendanceCloudRevision:null
    };
  }catch(e){return {error:String(e?.message||e)}}
};
</script>


<script id="p79-attendance-lossless-diagnostic-v20261004">
window.p79AttendanceRecordCounts = function(){
  try{
    const raw = Array.isArray(records) ? records : [];
    const visibleRaw = raw.filter(typeof canCurrentAdminViewDataRow==='function' ? canCurrentAdminViewDataRow : ()=>true);
    const paired = typeof buildDailyAttendanceRows==='function' ? buildDailyAttendanceRows(visibleRaw) : [];
    const month = typeof getRequestedAttendanceCloudMonth==='function' ? getRequestedAttendanceCloudMonth() : '';
    const monthRaw = visibleRaw.filter(r=>{
      try{return attendanceRecordMonthKey(r)===month}catch(e){return false}
    });
    return {
      selectedMonth: month,
      allRawRecords: raw.length,
      visibleRawRecords: visibleRaw.length,
      selectedMonthRawRecords: monthRaw.length,
      pairedDisplayRows: paired.length
    };
  }catch(e){
    return {error:String(e?.message||e)};
  }
};
</script>


<script id="p79-attendance-data-engine-v2-20261004">
/*
 * PORT79 Attendance Data Engine V3 RAW-LOSSLESS
 * 保留既有 UI / 七大系統 / 打卡 / 人工修改 / 權限。
 * 只統一讀取層：所有「月份/Core/歷史補漏」都進同一個同步函式，禁止多條管線各自重寫 records。
 */
(function(){
  'use strict';

  const V2 = {
    version:'2026.10.06-V5.11-STABLE-CORE',
    busy:new Map(),
    lastSyncAt:new Map(),
    lastSourceCounts:{},
    reconcileTimer:null,
    startupDone:false,
    minBackgroundGapMs:15000,
    reconcileMs:30000
  };

  function monthNow(){
    const d=new Date();
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
  }
  function validMonth(v){return /^\d{4}-\d{2}$/.test(String(v||''));}
  function selectedMonth(){
    const v=String(document.getElementById('filterMonthSelect')?.value||'').trim();
    return validMonth(v)?v:monthNow();
  }
  function authToken(){
    try{
      return String(
        sessionStorage.getItem('port79_admin_token')||
        sessionStorage.getItem('port79_gc_superadmin_token')||
        sessionStorage.getItem('port79_user_token')||''
      ).trim();
    }catch(e){return '';}
  }
  function apiUrl(action, params={}){
    const base=getActiveGasUrl();
    if(!isValidGasWebAppUrl(base)) throw new Error('GAS URL 無效');
    const u=new URL(base);
    u.searchParams.set('action',action);
    Object.entries(params).forEach(([k,v])=>{
      if(v!==undefined&&v!==null&&String(v)!=='')u.searchParams.set(k,String(v));
    });
    const token=authToken();
    if(token)u.searchParams.set('token',token);
    u.searchParams.set('t',String(Date.now()));
    return u.toString();
  }
  async function readApi(action,params,label,timeout=12000){
    const d=await fetchGasJsonWithRetry(apiUrl(action,params),label,1,timeout);
    if(!d?.ok)throw new Error(d?.error||`${label}失敗`);
    return d;
  }
  function normRows(rows){
    return (Array.isArray(rows)?rows:[])
      .filter(Boolean)
      .map(r=>normalizeAttendanceRecordIdentifiers({...r}))
      .filter(r=>!isLocallyDeletedAttendanceRecord(r));
  }
  function stableAliasKeys(r){
    const out=[];
    if(!r||typeof r!=='object')return out;
    const id=String(r.id??'').trim();
    const ty=getAttendanceRecordType(r);
    if(id)out.push('ID:'+id+'|TYPE:'+ty);
    const ev=String(getAttendanceImportEventKey(r)||'').trim();
    if(ev)out.push('EV:'+stripManualPairSuffixFromEventKey(ev)+'|TYPE:'+ty);
    const src=String(r.sourceEventKey||'').trim();
    if(src)out.push('SRC:'+stripManualPairSuffixFromEventKey(src)+'|TYPE:'+ty);
    const emp=String(r.attNo||r.empId||r.name||'').replace(/\s+/g,'').toUpperCase();
    const tm=normalizeImportedAttendanceTime(r.timeStr);
    if(emp&&tm&&ty!=='OTHER')out.push(`RAW:${emp}|${tm}|${ty}`);
    return [...new Set(out.filter(Boolean))];
  }
  function chooseBetter(current,candidate){
    if(!current)return candidate;
    if(!candidate)return current;
    const cm=isManuallyEditedAttendanceRecord(current), nm=isManuallyEditedAttendanceRecord(candidate);
    if(cm!==nm)return nm?candidate:current;
    if(cm&&nm){
      const ca=Date.parse(current.manuallyEditedAt||'')||0;
      const na=Date.parse(candidate.manuallyEditedAt||'')||0;
      if(na!==ca)return na>ca?candidate:current;
    }
    // 同 ID 時偏向欄位較完整的一筆；避免空白快照蓋掉完整 Delta。
    const score=r=>[
      'empId','attNo','name','dept','timeStr','status','location','note','unit','jobTitle',
      'sourceEventKey','manualPairGroupKey',
      'manualPairClockInId','manualPairClockOutId',
      'manualPairClockInKey','manualPairClockOutKey',
      'manualPairClockInTimeStr','manualPairClockOutTimeStr',
      'v5PairTargetId','v5PairLinkedAt'
    ].reduce((n,k)=>n+(String(r?.[k]??'').trim()?1:0),0);
    return score(candidate)>score(current)?candidate:current;
  }
  function losslessMerge(groups){
    const result=[];
    const aliasToIndex=new Map();
    for(const group of groups){
      for(const raw of normRows(group)){
        const keys=stableAliasKeys(raw);
        let idx=-1;
        for(const k of keys){if(aliasToIndex.has(k)){idx=aliasToIndex.get(k);break;}}
        if(idx<0){
          idx=result.length;result.push(raw);
        }else{
          result[idx]=chooseBetter(result[idx],raw);
        }
        stableAliasKeys(result[idx]).forEach(k=>aliasToIndex.set(k,idx));
        keys.forEach(k=>aliasToIndex.set(k,idx));
      }
    }
    return result.filter(r=>!isLocallyDeletedAttendanceRecord(r));
  }

  let p79V2PersistTimer=null;
  let p79V2RenderQueued=false;

  function p79V2SchedulePersist(){
    if(p79V2PersistTimer)clearTimeout(p79V2PersistTimer);
    p79V2PersistTimer=setTimeout(()=>{
      p79V2PersistTimer=null;
      const run=()=>{
        try{
          // V5.10.15：整份 records 只 JSON.stringify 一次。
          // 主快取與安全備份共用同一字串，避免修改一筆考勤卻連續序列化 2～3 次全量資料。
          const serialized=JSON.stringify(Array.isArray(records)?records:[]);
          localStorage.setItem('sp_records_v5',serialized);
          if(serialized!=='[]') localStorage.setItem(ATTENDANCE_SAFETY_BACKUP_KEY,serialized);
        }catch(e){
          console.warn('考勤背景持久化失敗：',e);
        }
        // ATTENDANCE_IMPORT_ARCHIVE_KEY 不再於每次月份同步重建。
        // 匯入/人工異動仍由既有 archiveAttendanceRecords() 個別保護。
      };
      if(typeof requestIdleCallback==='function')requestIdleCallback(run,{timeout:1500});
      else setTimeout(run,0);
    },180);
  }

  function p79V2ScheduleRender(){
    if(p79V2RenderQueued)return;
    p79V2RenderQueued=true;
    const run=()=>{
      p79V2RenderQueued=false;
      try{initDropdowns();}catch(e){}
      try{p79RenderOnlyVisibleAttendanceView();}catch(e){try{renderAdminRecordsTable();}catch(_) {}}
    };
    if(typeof requestAnimationFrame==='function')requestAnimationFrame(run);
    else setTimeout(run,0);
  }

  // 提供單筆修改／補卡／刪除使用；避免各功能各自做一次全量 localStorage 序列化。
  window.p79ScheduleAttendancePersist=p79V2SchedulePersist;

  function applyMonth(month, remoteRows, sourceCounts, availableMonths){
    // V5.10.20：只要雲端整月讀回相同 ID 且內容已符合本機待同步內容，
    // 代表其實已經寫入成功；自動清掉舊待同步，不讓徽章永遠卡住。
    try{
      if(typeof window.p79V5ConfirmCloudRecord==='function'){
        normRows(remoteRows).forEach(r=>window.p79V5ConfirmCloudRecord(r));
      }
    }catch(e){}

    const current=Array.isArray(records)?records.map(normalizeAttendanceRecordIdentifiers):[];
    const same=current.filter(r=>attendanceRecordMonthKey(r)===month);
    const other=current.filter(r=>attendanceRecordMonthKey(r)!==month);

    // remote 在前、現有本機在後：同事件通常用 remote；但人工修改會由 chooseBetter 保留本機人工版。
    // remote 沒有的 Delta / 本機新事件也會由 same 補回，絕不因快照缺漏而消失。
    const mergedMonth=losslessMerge([remoteRows,same]);
    records=losslessMerge([mergedMonth,other]);

    // V5.10.10：四來源聯集完成後立刻補姓名/部門/職務，
    // 姓名篩選與補卡下拉不再等待下一次 render 才出現。
    try{repairAttendanceNamesInMemory();}catch(e){}

    p79V2SchedulePersist();
    if(Array.isArray(availableMonths)){
      try{updateAttendanceMonthOptionsFromCloud(availableMonths);}catch(e){}
    }
    V2.lastSourceCounts={month,...sourceCounts,totalMonth:mergedMonth.length,totalAll:records.length};
    p79V2ScheduleRender();
    return mergedMonth.length;
  }

  async function fetchCurrentMonthSources(month){
    // V5.10.14：正常狀況先讀「原始全量 + 主表直讀」兩條。
    // getAttendanceMonthRaw 已經是物理全量來源；若 raw 失敗/為 0/比主表還少，
    // 才補讀 month/core，避免每次背景同步都同時跑四條大型 API。
    const primary={
      raw:readApi('getAttendanceMonthRaw',{month},`原始全量考勤 ${month}`,16000),
      direct:readApi('getAttendanceMainDirect',{month},`主考勤直接讀取 ${month}`,14000)
    };
    const pkeys=Object.keys(primary);
    const settled=await Promise.allSettled(pkeys.map(k=>primary[k]));
    const data={};
    settled.forEach((r,i)=>{
      if(r.status==='fulfilled')data[pkeys[i]]=r.value;
      else console.debug(`[PORT79 V5.10.14] ${pkeys[i]}失敗`,r.reason);
    });

    let rawRows=normRows(data.raw?.records).filter(r=>attendanceRecordMonthKey(r)===month);
    let directRows=normRows(data.direct?.records).filter(r=>attendanceRecordMonthKey(r)===month);
    let monthRows=[];
    let coreRows=[];
    let fallbackUsed=false;

    const needFallback =
      rawRows.length===0 ||
      (directRows.length>0 && rawRows.length<directRows.length);

    if(needFallback){
      fallbackUsed=true;
      const fallback={
        month:readApi('getAttendanceMonthData',{month},`月份相容資料 ${month}`,14000),
        core:readApi('getAttendanceCoreData',{month,includeEmployees:'0'},`月份核心資料 ${month}`,14000)
      };
      const fkeys=Object.keys(fallback);
      const fsettled=await Promise.allSettled(fkeys.map(k=>fallback[k]));
      fsettled.forEach((r,i)=>{
        if(r.status==='fulfilled')data[fkeys[i]]=r.value;
        else console.debug(`[PORT79 V5.10.14] ${fkeys[i]}備援失敗`,r.reason);
      });
      monthRows=normRows(data.month?.records).filter(r=>attendanceRecordMonthKey(r)===month);
      coreRows=normRows(data.core?.records).filter(r=>attendanceRecordMonthKey(r)===month);
    }

    const rows=losslessMerge([rawRows,directRows,monthRows,coreRows]);
    return {
      rows,
      counts:{
        raw:rawRows.length,
        direct:directRows.length,
        monthApi:monthRows.length,
        coreApi:coreRows.length,
        fallbackUsed:fallbackUsed?1:0,
        rawMissingNames:Number(data.raw?.missingNameCount||0)
      },
      availableMonths:data.raw?.availableMonths||data.month?.availableMonths||data.core?.availableMonths||[],
      revision:String(data.raw?.revision||data.month?.revision||data.core?.revision||data.direct?.revision||'').trim(),
      rawSourceCounts:data.raw?.sourceCounts||{}
    };
  }

  async function fetchBoundaryMonth(month){
    try{
      const d=await readApi('getAttendanceMonthRaw',{month},`跨月原始邊界 ${month}`,12000);
      return normRows(d.records).filter(r=>attendanceRecordMonthKey(r)===month);
    }catch(rawError){
      try{
        const d=await readApi('getAttendanceMonthData',{month},`跨月相容邊界 ${month}`,12000);
        return normRows(d.records).filter(r=>attendanceRecordMonthKey(r)===month);
      }catch(e){console.debug('[PORT79 V2] 邊界月份讀取失敗',month,e);return [];}
    }
  }

  async function syncMonth(month, options={}){
    month=validMonth(month)?month:selectedMonth();
    if(typeof navigator!=='undefined'&&navigator.onLine===false)return false;
    if(V2.busy.has(month))return V2.busy.get(month);
    const task=(async()=>{
      const before=Array.isArray(records)?records.length:0;
      try{
        if(options.status!==false)try{setCloudSyncStatus(`${month} 從雲端讀取考勤資料`,'loading','read');}catch(e){}
        const src=await fetchCurrentMonthSources(month);
        if(src.revision)lastAttendanceCloudRevision=src.revision;
        const totalRemote=src.rows.length;
        if(totalRemote){
          applyMonth(month,src.rows,src.counts,src.availableMonths);
        }else{
          // 四條來源全部 0 才保留本機，絕不清空。
          console.warn(`[PORT79 V2] ${month} 四通道皆 0 筆，保留本機`);
        }

        // 跨月只補前後月份，不改目前月份選擇。
        if(options.boundary!==false){
          const prev=shiftAttendanceMonthKey(month,-1), next=shiftAttendanceMonthKey(month,1);
          const boundary=await Promise.all([fetchBoundaryMonth(prev),fetchBoundaryMonth(next)]);
          if(boundary[0].length)applyMonth(prev,boundary[0],{boundary:boundary[0].length},null);
          if(boundary[1].length)applyMonth(next,boundary[1],{boundary:boundary[1].length},null);
          // applyMonth 會 render，最後再依使用者目前選擇 render 一次即可。
          try{p79RenderOnlyVisibleAttendanceView();}catch(e){}
        }
        V2.lastSyncAt.set(month,Date.now());
        const after=Array.isArray(records)?records.length:0;
        try{
          const sc=src.counts||{};
          const rawMissing=Number(sc.rawMissingNames||0);
          const suffix=rawMissing?`｜原始空白姓名 ${rawMissing} 筆已嘗試補全`:'';
          setCloudSyncStatus(`${month} 讀取完成｜本月 ${V2.lastSourceCounts.totalMonth||0} 筆${suffix}`,'success','read');
        }catch(e){}
        if(options.showMessage)try{showToast(`${month} 考勤已重新對齊雲端`,'success');}catch(e){}
        console.info('[PORT79 Attendance V2]',{month,before,after,...src.counts,remoteMerged:totalRemote});
        return true;
      }catch(e){
        console.warn('[PORT79 Attendance V2] 同步失敗，保留目前資料',e);
        try{setCloudSyncStatus(`🟠 ${month} 同步暫時失敗｜已保留本機資料`,'loading');}catch(_){}
        if(options.showMessage)try{showToast(`考勤同步暫時失敗：${e?.message||e}`,'warning');}catch(_){}
        return false;
      }finally{V2.busy.delete(month);}
    })();
    V2.busy.set(month,task);
    return task;
  }

  async function startup(showMessage=false){
    const month=monthNow();
    const sel=document.getElementById('filterMonthSelect');
    if(sel && sel.value==='ALL')sel.value=month;

    // V5.10.36：LOCAL-FIRST。
    // 進考勤頁時先把瀏覽器已有考勤立即畫出來，絕不等待任何 GAS 請求。
    try{
      if((!Array.isArray(records)||!records.length) && typeof restoreAttendanceRecordsFromLocalCaches==='function'){
        restoreAttendanceRecordsFromLocalCaches();
      }
    }catch(e){}
    try{repairAttendanceNamesInMemory?.();}catch(e){}
    try{initDropdowns?.();}catch(e){}
    try{p79RenderOnlyVisibleAttendanceView?.();}catch(e){
      try{renderAdminRecordsTable?.();}catch(_){}
    }
    try{
      const localMonthCount=(Array.isArray(records)?records:[])
        .filter(r=>attendanceRecordMonthKey(r)===selectedMonth()).length;
      setCloudSyncStatus(
        localMonthCount
          ? `⚡ 已顯示本機考勤 ${localMonthCount} 筆｜背景更新雲端`
          : '⚡ 考勤畫面已開啟｜背景讀取雲端',
        'loading',
        'read'
      );
    }catch(e){}

    // 員工主檔與當月考勤都改成背景工作。
    // syncMonth 本身仍維持單月 + 前後月邊界 + lossless merge，不改 GAS、不抓全部 getData。
    const runBackground=async()=>{
      const master=typeof preloadAttendanceEmployeeMaster==='function'
        ? Promise.resolve(preloadAttendanceEmployeeMaster(false,true)).catch(()=>false)
        : Promise.resolve(false);
      const sync=Promise.resolve(syncMonth(selectedMonth(),{showMessage,boundary:true})).catch(()=>false);
      const results=await Promise.allSettled([master,sync]);
      V2.startupDone=true;
      const syncResult=results[1]?.status==='fulfilled' ? results[1].value : false;
      return syncResult===true;
    };

    // 手動重新整理：使用者明確要求刷新，維持等待雲端完成後才回報。
    if(showMessage){
      return await runBackground();
    }

    // 自動進頁：排到下一個 event loop 後背景執行，首屏立即可操作。
    setTimeout(()=>{ runBackground().catch(()=>false); },0);
    V2.startupDone=true;
    return true;
  }

  async function reconcile(options={}){
    const m=selectedMonth();
    const last=V2.lastSyncAt.get(m)||0;
    if(!options.force&&Date.now()-last<V2.minBackgroundGapMs)return true;
    return syncMonth(m,{showMessage:false,boundary:false,status:false});
  }

  // ----- 把舊的多條同步入口統一導向同一引擎 -----
  try{loadAttendanceMonthFromCloud=async (month,showMessage=false)=>syncMonth(month,{showMessage,boundary:true});}catch(e){}
  try{loadAttendanceCoreSyncData=async (showMessage=false)=>syncMonth(selectedMonth(),{showMessage,boundary:true});}catch(e){}
  try{p79StartupAttendanceCurrentMonthSync=startup;}catch(e){}
  try{p79ReconcileCurrentAttendanceMonth=reconcile;}catch(e){}
  try{loadAttendanceBoundaryMonthsFromCloud=async (month)=>{
    const m=validMonth(month)?month:selectedMonth();
    const prev=shiftAttendanceMonthKey(m,-1),next=shiftAttendanceMonthKey(m,1);
    const [a,b]=await Promise.all([fetchBoundaryMonth(prev),fetchBoundaryMonth(next)]);
    if(a.length)applyMonth(prev,a,{boundary:a.length},null);
    if(b.length)applyMonth(next,b,{boundary:b.length},null);
    return true;
  };}catch(e){}

  // revision/focus 只要求 Delta 即時追，再視需要做一次單一權威同步。
  try{checkAttendanceCloudRevision=async function(){
    try{await pollAttendanceDelta(true);}catch(e){}
    return reconcile({force:false});
  };}catch(e){}
  try{handleAttendanceRevisionFromCloudStatus=async function(revision){
    const r=String(revision||'').trim();
    if(r&&r!==String(lastAttendanceCloudRevision||'')){
      try{await pollAttendanceDelta(true);}catch(e){}
      return reconcile({force:true});
    }
    return true;
  }; window.p79HandleAttendanceCloudRevision=handleAttendanceRevisionFromCloudStatus;}catch(e){}

  // 原本 30 秒補漏改成 60 秒單一管線；不再啟動另一套資料邏輯。
  try{p79StartCurrentMonthAttendanceReconcile=function(){
    try{clearInterval(p79CurrentMonthReconcileTimer);}catch(e){}
    try{if(V2.reconcileTimer)clearInterval(V2.reconcileTimer);}catch(e){}
    setTimeout(()=>reconcile({force:true}),2200);
    V2.reconcileTimer=setInterval(()=>{
      if(document.visibilityState==='visible')reconcile({force:false});
    },V2.reconcileMs);
  };}catch(e){}

  // 手動拉取也用同一管線。
  try{manualCloudRefresh=async function(){
    setCloudSyncStatus('從雲端讀取考勤資料','loading','read');
    const ok=await syncMonth(selectedMonth(),{showMessage:true,boundary:true});
    if(ok)try{p79RenderOnlyVisibleAttendanceView();}catch(e){}
    try{flushCloudOutbox(true);}catch(e){}
    return ok;
  };}catch(e){}

  // 提供明確診斷，不需要再猜資料在哪裡消失。
  window.p79AttendanceEngineV2=V2;
  window.p79AttendanceForceRepair=()=>syncMonth(selectedMonth(),{showMessage:true,boundary:true,status:true});
  window.p79AttendanceNameAudit=function(){
    const month=selectedMonth();
    try{repairAttendanceNamesInMemory();}catch(e){}
    const monthRows=(Array.isArray(records)?records:[]).filter(r=>month==='ALL'||attendanceRecordMonthKey(r)===month);
    const missing=monthRows.filter(r=>!normalizeAttendanceIdentityName(r?.name));
    const names=[...new Set(monthRows.map(r=>String(r?.name||'').trim()).filter(Boolean))];
    const result={month,records:monthRows.length,named:monthRows.length-missing.length,missing:missing.length,uniqueNames:names.length,samples:missing.slice(0,30).map(r=>({attNo:r?.attNo,empId:r?.empId,timeStr:r?.timeStr,status:r?.status}))};
    console.table(result.samples);
    console.info('[PORT79 V5.10.10 姓名檢視]',result);
    return result;
  };
  window.p79AttendancePerformanceStatus=function(){
    const info={
      version:'V5.11',
      deltaActiveMs:1800,
      deltaIdleMs:4000,
      fullReconcileMs:30000,
      minBackgroundGapMs:15000,
      mutationPersist:'idle/debounced',
      mutationRender:'single-RAF/no-cloud-success-rerender',
      records:Array.isArray(records)?records.length:0,
      employees:Array.isArray(employees)?employees.length:0,
      visibility:document.visibilityState
    };
    console.table(info);
    return info;
  };

  window.p79AttendanceEngineStatus=function(){
    const m=selectedMonth();
    const all=Array.isArray(records)?records:[];
    const raw=all.filter(r=>attendanceRecordMonthKey(r)===m);
    let display=[];try{display=buildDailyAttendanceRows(raw.filter(canCurrentAdminViewDataRow));}catch(e){}
    const info={
      engine:V2.version,
      month:m,
      allRecords:all.length,
      monthRawRecords:raw.length,
      displayRows:Array.isArray(display)?display.length:null,
      deltaSeq:typeof attendanceDeltaLastSeq!=='undefined'?attendanceDeltaLastSeq:null,
      lastSync:new Date(V2.lastSyncAt.get(m)||0).toLocaleString(),
      sourceCounts:V2.lastSourceCounts
    };
    console.table(info);return info;
  };

  // 切回頁面：Delta 先追；若 45 秒以上沒做權威同步，再補一次。
  document.addEventListener('visibilitychange',()=>{
    if(document.visibilityState!=='visible')return;
    setTimeout(async()=>{try{await pollAttendanceDelta(true);}catch(e){};reconcile({force:false});},250);
  });
  window.addEventListener('online',()=>setTimeout(()=>reconcile({force:true}),300));

  console.info('[PORT79] Attendance Data Engine V2 ready');
})();
</script>


<script id="p79-attendance-v42-live-progress">
(function(){
'use strict';

function ensurePanel(){
  let host=document.getElementById('p79AttendanceLiveProgress');
  if(host)return host;
  host=document.createElement('div');
  host.id='p79AttendanceLiveProgress';
  host.className='mt-2 flex flex-wrap items-center gap-2 text-[10px] font-bold';
  host.innerHTML=`
    <span id="p79AttLocalState" class="rounded-full border border-sky-200 bg-sky-50 px-2 py-1 text-sky-700 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-300">⚡ 本機即時</span>
    <span id="p79AttPendingState" class="rounded-full border border-slate-200 bg-white px-2 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">📤 待同步 0 筆</span>
    <span id="p79AttCurrentState" class="rounded-full border border-slate-200 bg-white px-2 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">☁️ 雲端待命</span>
    <span id="p79AttLastDone" class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-1 text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300">✅ 尚無完成紀錄</span>`;
  const sync=document.getElementById('cloudSyncStatus');
  if(sync?.parentElement) sync.parentElement.appendChild(host);
  else document.body.prepend(host);
  return host;
}

let lastPending=-1;
let lastBusy=-1;
let lastDoneText='';

function update(){
  ensurePanel();
  let queue=[];
  try{ queue=typeof readCloudOutbox==='function'?readCloudOutbox():[]; }catch(e){}
  const pending=Array.isArray(queue)?queue.length:0;
  const busy=Number(typeof cloudDirectWriteBusy!=='undefined'?cloudDirectWriteBusy:0)||0;
  const pendingEl=document.getElementById('p79AttPendingState');
  const currentEl=document.getElementById('p79AttCurrentState');
  const doneEl=document.getElementById('p79AttLastDone');

  if(pendingEl){
    pendingEl.textContent=`📤 待同步 ${pending} 筆`;
    pendingEl.className=pending>0
      ? 'rounded-full border border-amber-200 bg-amber-50 px-2 py-1 text-amber-700 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300'
      : 'rounded-full border border-slate-200 bg-white px-2 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300';
  }

  if(currentEl){
    if(busy>0){
      let desc='正在寫入考勤';
      try{
        const first=queue[0]?.payload;
        if(first && typeof getCloudPayloadDescription==='function') desc=getCloudPayloadDescription(first);
      }catch(e){}
      currentEl.textContent=`⏳ ${desc}`;
      currentEl.className='rounded-full border border-indigo-200 bg-indigo-50 px-2 py-1 text-indigo-700 dark:border-indigo-900 dark:bg-indigo-950/40 dark:text-indigo-300';
    }else if(pending>0){
      currentEl.textContent='🟠 雲端忙碌／等待自動補傳';
      currentEl.className='rounded-full border border-amber-200 bg-amber-50 px-2 py-1 text-amber-700 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300';
    }else{
      currentEl.textContent='☁️ 雲端待命';
      currentEl.className='rounded-full border border-emerald-200 bg-emerald-50 px-2 py-1 text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300';
    }
  }

  if((lastBusy>0||lastPending>0) && busy===0 && pending===0){
    const now=new Date();
    lastDoneText=`✅ 上次完成 ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
  }
  if(doneEl && lastDoneText) doneEl.textContent=lastDoneText;

  lastPending=pending;
  lastBusy=busy;
}

document.addEventListener('DOMContentLoaded',()=>{
  ensurePanel();
  update();
  setInterval(()=>{ if(document.visibilityState==='visible') update(); },2000);
},{once:true});
window.addEventListener('pageshow',update);
window.p79UpdateAttendanceLiveProgress=update;
})();
</script>


<script id="p79-attendance-v5-clean-core">
(function(){
'use strict';

/*
  PORT79 Attendance V5 Clean Core
  核心原則：
  1. 畫面立即改（optimistic）
  2. 所有雲端寫入只走一條序列佇列
  3. Delta 只做增量，不做整月覆蓋
  4. 待同步本機修改永遠優先於雲端舊快照
  5. 狀態明確：待同步→同步中→已同步/失敗
*/

const OUTBOX_KEY='port79_attendance_v5_outbox';
const STATE_KEY='port79_attendance_v5_state';
const ACTIVE_MS=1800;
const IDLE_MS=4000;
const MAX_BACKOFF=15000;

const ATTENDANCE_WRITE_ACTIONS = new Set([
  'addRecord','updateRecord','editRecord','deleteRecord',
  'queueEmployeePunch','persistEmployeePunch',
  'syncRecords','repairAttendanceRecords'
]);
function isV5AttendanceWrite(payload){
  return ATTENDANCE_WRITE_ACTIONS.has(String(payload?.action||''));
}


let writing=false;
let deltaBusy=false;
let deltaTimer=null;
let deltaResetRepairBusy=false;
// V5.11：每次頁面生命週期從 0 開始追最新 Delta，避免舊 sessionStorage 游標高於雲端最新序號後永遠收不到事件。
let lastSeq=0;
try{sessionStorage.setItem('port79_attendance_v5_delta_seq','0')}catch(e){}
let lastDoneAt=0;
let currentOpText='準備同步';
let activeSyncRecordId='';
let syncBatchTotal=0;
let syncBatchDone=0;
let syncBatchStartedAt=0;
let lastStatusUiSignature='';
const rejectedPunchById=new Map();

function token(){
  return String(
    sessionStorage.getItem('port79_user_token') ||
    sessionStorage.getItem('port79_admin_token') ||
    sessionStorage.getItem('port79_gc_superadmin_token') ||
    ''
  ).trim();
}
function gasUrl(){
  try{return typeof getActiveGasUrl==='function'?getActiveGasUrl():String(sysConfig?.gasUrl||'')}catch(e){return ''}
}
function readQueue(){
  try{
    const a=JSON.parse(localStorage.getItem(OUTBOX_KEY)||'[]');
    return Array.isArray(a)?a:[];
  }catch(e){return []}
}
function saveQueue(q){
  try{localStorage.setItem(OUTBOX_KEY,JSON.stringify(q.slice(-500)))}catch(e){}
  updateUi();
}
function opKey(payload){
  const a=String(payload?.action||'');
  const id=String(payload?.record?.id ?? payload?.id ?? '');
  return `${a}:${id||JSON.stringify(payload||{})}`;
}
function desc(payload){
  try{
    if(typeof getCloudPayloadDescription==='function')return getCloudPayloadDescription(payload)
  }catch(e){}
  const a=String(payload?.action||'');
  const n=String(payload?.record?.name||'');
  if(a==='updateRecord'||a==='editRecord')return `修改考勤 ${n}`;
  if(a==='addRecord')return `新增考勤 ${n}`;
  if(a==='deleteRecord')return `刪除考勤`;
  return a||'考勤資料';
}
function enqueue(payload){
  const q=readQueue();
  const key=opKey(payload);
  const item={
    key,payload,
    createdAt:Date.now(),
    attempts:0,
    nextRetryAt:0,
    state:'pending'
  };
  const i=q.findIndex(x=>x.key===key);
  if(i>=0) q[i]=item; else q.push(item);
  saveQueue(q);
  return q.length;
}
function remove(key){
  const q=readQueue().filter(x=>x.key!==key);
  saveQueue(q);
}
function pendingForId(id){
  const s=String(id??'');
  return readQueue().some(x=>String(x?.payload?.record?.id ?? x?.payload?.id ?? '')===s);
}

function payloadRecordId(payload){
  return String(payload?.record?.id ?? payload?.id ?? '');
}

function queueInfoForId(id){
  const wanted=String(id??'');
  if(!wanted)return null;

  const q=readQueue();
  const idx=q.findIndex(x=>payloadRecordId(x?.payload)===wanted);
  if(idx>=0){
    const item=q[idx];
    return {
      index:idx+1,
      total:q.length,
      state:String(item?.state||'pending'),
      description:desc(item?.payload),
      lastError:String(item?.lastError||'')
    };
  }

  if(writing && activeSyncRecordId===wanted){
    const total=Math.max(1,syncBatchTotal||1);
    const index=Math.min(total,Math.max(1,syncBatchDone+1));
    return {
      index,
      total,
      state:'syncing',
      description:currentOpText,
      lastError:''
    };
  }
  return null;
}

function normalizeCompareValue(value){
  return String(value==null?'':value).replace('T',' ').trim();
}

function cloudRecordConfirmsItem(item, cloudRecord){
  const payload=item?.payload||{};
  const action=String(payload.action||'');
  if(action==='deleteRecord')return false;

  const local=payload.record||{};
  const localId=payloadRecordId(payload);
  const cloudId=String(cloudRecord?.id??'');
  if(!localId||localId!==cloudId)return false;

  // 新增/落盤只要同 ID 已由雲端讀回即可確認。
  if(action==='addRecord'||action==='persistEmployeePunch'||action==='queueEmployeePunch'){
    return true;
  }

  // 修改則至少要確認時間與狀態已是本機要求的值。
  if(action==='updateRecord'||action==='editRecord'){
    const fields=['timeStr','status'];
    for(const key of fields){
      const wanted=normalizeCompareValue(local?.[key]);
      if(wanted && normalizeCompareValue(cloudRecord?.[key])!==wanted)return false;
    }

    const localEditedAt=Date.parse(String(local?.manuallyEditedAt||''))||0;
    const cloudEditedAt=Date.parse(String(cloudRecord?.manuallyEditedAt||''))||0;
    if(localEditedAt && cloudEditedAt && cloudEditedAt<localEditedAt)return false;
    return true;
  }

  return false;
}

function confirmCloudRecord(cloudRecord){
  const id=String(cloudRecord?.id??'');
  if(!id)return false;

  const q=readQueue();
  let removed=0;
  const keep=[];
  q.forEach(item=>{
    if(payloadRecordId(item?.payload)!==id){
      keep.push(item);
      return;
    }
    if(cloudRecordConfirmsItem(item,cloudRecord)){
      removed++;
    }else{
      keep.push(item);
    }
  });

  if(!removed)return false;

  saveQueue(keep);
  try{markRecentAttendanceMutationCloudConfirmed?.(id)}catch(e){}
  lastDoneAt=Date.now();
  currentOpText='同步完成';
  updateUi();
  return true;
}

function confirmCloudDelete(id){
  const wanted=String(id??'');
  if(!wanted)return false;

  const q=readQueue();
  let removed=0;
  const keep=[];
  q.forEach(item=>{
    const same=payloadRecordId(item?.payload)===wanted;
    const isDelete=String(item?.payload?.action||'')==='deleteRecord';
    if(same&&isDelete)removed++;
    else keep.push(item);
  });

  if(!removed)return false;
  saveQueue(keep);
  lastDoneAt=Date.now();
  currentOpText='同步完成';
  updateUi();
  return true;
}

async function send(payload,timeout=25000){
  const url=gasUrl();
  if(!url) throw new Error('未設定 GAS URL');
  const body={...payload};
  const tk=token();
  if(tk&&!body.token)body.token=tk;

  const ctrl=new AbortController();
  const timer=setTimeout(()=>ctrl.abort(),timeout);
  try{
    const r=await fetch(url,{
      method:'POST',
      headers:{'Content-Type':'text/plain;charset=utf-8'},
      body:JSON.stringify(body),
      cache:'no-store',
      signal:ctrl.signal
    });
    const text=await r.text();
    let data=null;
    try{data=JSON.parse(text)}catch(e){throw new Error('GAS 回傳不是 JSON')}
    if(!data?.ok){
      const err=new Error(String(data?.error||'雲端寫入失敗'));
      err.retryable=data?.retryable!==false;
      err.serverData=data;
      err.duplicatePunch=data?.duplicatePunch===true;
      throw err;
    }
    return data;
  }finally{
    clearTimeout(timer);
  }
}

async function drain(force=false){
  if(writing)return false;
  if(navigator.onLine===false){updateUi();return false}
  let q=readQueue();
  if(!q.length){updateUi();return true}

  writing=true;
  syncBatchTotal=Math.max(1,q.length);
  syncBatchDone=0;
  syncBatchStartedAt=Date.now();
  try{
    while(true){
      q=readQueue();
      if(!q.length)break;
      const now=Date.now();
      const item=q.find(x=>force||Number(x.nextRetryAt||0)<=now);
      if(!item)break;

      currentOpText=desc(item.payload);
      activeSyncRecordId=payloadRecordId(item.payload);
      item.state='syncing';
      saveQueue(q.map(x=>x.key===item.key?item:x));
      updateUi();

      try{
        const data=await send(item.payload,30000);
        if(Number(data?.deltaSeq||0)>0){
          lastSeq=Math.max(lastSeq,Number(data.deltaSeq)||0);
          sessionStorage.setItem('port79_attendance_v5_delta_seq',String(lastSeq));
        }

        const rid=item?.payload?.record?.id ?? item?.payload?.id;
        if(rid!=null){
          try{markRecentAttendanceMutationCloudConfirmed?.(rid)}catch(e){}
        }

        remove(item.key);
        syncBatchDone++;
        lastDoneAt=Date.now();
        currentOpText='同步完成';
        activeSyncRecordId='';

        try{p79RenderOnlyVisibleAttendanceView?.()}catch(e){}

        if(typeof item.payload?._v5Success==='function'){
          try{item.payload._v5Success(data)}catch(e){}
        }
      }catch(err){
        q=readQueue();
        const cur=q.find(x=>x.key===item.key);
        if(!cur)continue;

        const nonRetryable = err?.retryable === false;
        const serverData = err?.serverData || {};
        const rid = cur?.payload?.record?.id ?? cur?.payload?.id;

        if(nonRetryable){
          // V5.10.17：雲端判定為重複刷卡時不可一直重試，
          // 並把剛才 optimistic 加入的本機那一筆回滾。
          remove(cur.key);
          if(rid!=null){
            const ridText=String(rid);
            rejectedPunchById.set(ridText, String(err?.message||'重複刷卡已阻擋'));
            records=(Array.isArray(records)?records:[]).filter(r=>String(r?.id??'')!==ridText);
            try{removeAttendanceRecordsFromArchive?.([ridText])}catch(e){}
            try{forgetRecentAttendanceMutation?.(ridText)}catch(e){}
            try{
              if(typeof window.p79ScheduleAttendancePersist==='function')window.p79ScheduleAttendancePersist();
              else saveRecords?.();
            }catch(e){}
          }
          try{updateHomeClockInButtonState?.()}catch(e){}
          try{renderEmpHistoryTable?.()}catch(e){}
          try{p79RenderOnlyVisibleAttendanceView?.()}catch(e){}
          try{showToast(String(err?.message||'重複刷卡已阻擋'),'warning')}catch(e){}
          syncBatchDone++;
          activeSyncRecordId='';
          currentOpText='重複刷卡已阻擋';
          updateUi();
          continue;
        }

        const attempts=Number(cur.attempts||0)+1;
        cur.attempts=attempts;
        cur.state='pending';
        cur.lastError=String(err?.message||err||'失敗');
        cur.nextRetryAt=Date.now()+Math.min(MAX_BACKOFF,1000*Math.pow(2,Math.min(attempts,4)));
        saveQueue(q.map(x=>x.key===cur.key?cur:x));
        activeSyncRecordId='';
        currentOpText='等待重試';
        updateUi();
        break;
      }
    }
  }finally{
    writing=false;
    activeSyncRecordId='';
    updateUi();
  }
  return !readQueue().length;
}

function mergeDeltaEvent(event){
  const kind=String(event?.kind||'').toLowerCase();
  if(kind==='reset') return false;
  if(kind==='delete'){
    const id=String(event?.id??'');
    if(!id)return false;
    confirmCloudDelete(id);
    if(pendingForId(id))return false;
    records=records.filter(r=>String(r?.id??'')!==id);
    try{forgetRecentAttendanceMutation?.(id)}catch(e){}
    return true;
  }
  const rec=event?.record;
  if(!rec)return false;
  const id=String(rec?.id??'');
  if(id){
    confirmCloudRecord(rec);
    if(pendingForId(id))return false;
  }

  const nr=typeof normalizeAttendanceRecordIdentifiers==='function'
    ? normalizeAttendanceRecordIdentifiers(rec)
    : rec;

  // V5.10.35：舊雲端資料可能讓上班與下班共用同一 id。
  // V5 Delta 只能覆蓋「同 id + 同 IN/OUT 類型」的紀錄，避免 OUT 被 IN 吃掉。
  const nrType=typeof getAttendanceRecordType==='function'?getAttendanceRecordType(nr):'';
  const idx=records.findIndex(r=>{
    if(String(r?.id??'')!==String(nr?.id??''))return false;
    if(typeof getAttendanceRecordType!=='function')return true;
    return getAttendanceRecordType(r)===nrType;
  });
  if(idx>=0)records[idx]={...records[idx],...nr};
  else records.unshift(nr);
  return true;
}

async function pollDelta(force=false){
  if(deltaBusy)return false;
  if(navigator.onLine===false)return false;
  if(document.hidden&&!force)return false;
  const url=gasUrl();
  if(!url)return false;

  deltaBusy=true;
  let changed=false;
  try{
    const tk=token();
    let u=url+(url.includes('?')?'&':'?')+
      'action=getAttendanceDelta&since='+encodeURIComponent(String(lastSeq||0))+
      '&limit=100&tail=30&t='+Date.now();
    if(tk)u+='&token='+encodeURIComponent(tk);

    const ctrl=new AbortController();
    const timer=setTimeout(()=>ctrl.abort(),6000);
    try{
      const r=await fetch(u,{cache:'no-store',signal:ctrl.signal});
      const data=await r.json();
      if(!data?.ok)throw new Error(data?.error||'Delta 失敗');

      // V5.11：Delta reset/cursor 回退必須立即做權威月份修復。
      const latestSeq=Math.max(0,Number(data.latestSeq??data.deltaSeq??0)||0);
      const resetRequired=data.resetRequired===true || (lastSeq>0 && latestSeq>0 && latestSeq<lastSeq);
      if(resetRequired){
        lastSeq=0;
        try{sessionStorage.setItem('port79_attendance_v5_delta_seq','0')}catch(e){}
        if(!deltaResetRepairBusy){
          deltaResetRepairBusy=true;
          setTimeout(async()=>{
            try{
              if(typeof window.p79AttendanceForceRepair==='function') await window.p79AttendanceForceRepair();
              else if(typeof loadAttendanceCoreSyncData==='function') await loadAttendanceCoreSyncData(false);
            }catch(e){
              console.warn('[PORT79 V5.11] Delta reset 權威修復失敗',e);
            }finally{
              deltaResetRepairBusy=false;
            }
          },0);
        }
      }

      const events=Array.isArray(data.events)?data.events:[];
      for(const ev of events) changed=mergeDeltaEvent(ev)||changed;

      const seq=Math.max(0,Number(data.deltaSeq??data.latestSeq??0)||0);
      if(seq>0){
        lastSeq=Math.max(lastSeq,seq);
        sessionStorage.setItem('port79_attendance_v5_delta_seq',String(lastSeq));
      }

      if(changed){
        try{saveRecords?.()}catch(e){}
        try{p79RenderOnlyVisibleAttendanceView?.()}catch(e){}
      }
    }finally{clearTimeout(timer)}
  }catch(e){
    // Delta 失敗只留待下一輪，不整月重抓，不洗畫面。
  }finally{
    deltaBusy=false;
  }
  return changed;
}
function scheduleDelta(ms){
  clearTimeout(deltaTimer);
  deltaTimer=setTimeout(async()=>{
    const changed=await pollDelta(false);
    scheduleDelta(changed?ACTIVE_MS:IDLE_MS);
  },ms);
}
function startDelta(){
  if(deltaTimer)return true;
  scheduleDelta(500);
  return true;
}

function ensurePanel(){
  let el=document.getElementById('p79AttendanceV5Status');
  if(el)return el;
  el=document.createElement('div');
  el.id='p79AttendanceV5Status';
  el.className='mt-2 flex flex-wrap items-center gap-2 text-[10px] font-black';
  const sync=document.getElementById('cloudSyncStatus');
  if(sync?.parentElement)sync.parentElement.appendChild(el);
  else document.body.prepend(el);
  return el;
}
function p79LatestCloudActivityAt(){
  let readAt=0;
  try{
    readAt=Number(typeof lastCloudLoadSuccessAt!=='undefined'?lastCloudLoadSuccessAt:0)||0;
  }catch(e){}
  return Math.max(Number(lastDoneAt||0),readAt);
}

function updateUi(){
  const el=ensurePanel();
  const q=readQueue();
  const pending=q.length;
  const latestAt=p79LatestCloudActivityAt();
  const latestText=latestAt
    ? new Date(latestAt).toLocaleTimeString('zh-TW',{hour12:false})
    : '--';

  const total=Math.max(
    1,
    Number(syncBatchTotal||0),
    Number(syncBatchDone||0)+pending+(writing?1:0)
  );
  const currentIndex=Math.min(total,Math.max(1,Number(syncBatchDone||0)+1));
  const nextDescription=pending?desc(q[0]?.payload):'';

  const mainState = writing
    ? `✍️ 寫入中 ${currentIndex}/${total}｜${currentOpText}`
    : (pending
        ? `🟠 等待寫入 ${pending} 筆｜下一筆：${nextDescription}`
        : (latestAt
            ? `✅ 已同步｜${latestText}`
            : '● 待命｜尚未完成首次雲端作業'));

  const html=`
    <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-1 text-emerald-700">⚡ V5 即時核心</span>
    <span class="rounded-full border ${pending?'border-amber-200 bg-amber-50 text-amber-700':'border-emerald-200 bg-emerald-50 text-emerald-700'} px-2 py-1">${pending?`📤 同步佇列 ${pending} 筆`:'📤 同步佇列已清空'}</span>
    <span class="rounded-full border ${writing?'border-indigo-200 bg-indigo-50 text-indigo-700':(pending?'border-amber-200 bg-amber-50 text-amber-700':'border-emerald-200 bg-emerald-50 text-emerald-700')} px-2 py-1">${mainState}</span>
    <span class="rounded-full border border-sky-200 bg-sky-50 px-2 py-1 text-sky-700">📡 即時同步 ${deltaBusy?'讀取中':`監聽正常｜Seq ${lastSeq}`}</span>`;

  const signature=[pending,writing,currentOpText,activeSyncRecordId,syncBatchTotal,syncBatchDone,deltaBusy,lastSeq,latestAt].join('|');
  if(signature!==lastStatusUiSignature){
    el.innerHTML=html;
    lastStatusUiSignature=signature;
  }

  // 頁首狀態也顯示真實進度，不再只寫「待命」。
  try{
    if(typeof setCloudSyncStatus==='function'){
      const opState = window.p79AttendanceOperationState || {};
      const readBusy = opState.busy === true && opState.mode === 'read';

      // 正在讀取時，不讓 V5 寫入狀態計時器把「讀取中」覆蓋掉。
      if(readBusy){
        // 由目前 GET 流程自己更新讀取狀態。
      }else if(writing){
        setCloudSyncStatus(`第 ${currentIndex}/${total} 筆｜${currentOpText}`,'loading','write');
      }else if(pending){
        setCloudSyncStatus(`等待寫入 ${pending} 筆｜下一筆：${nextDescription}`,'loading','write');
      }else if(latestAt){
        const prevMode=String(opState.mode||'');
        if(prevMode==='write'){
          setCloudSyncStatus(`雲端考勤已寫入｜${latestText}`,'success','write');
        }else{
          setCloudSyncStatus(`雲端考勤已更新｜${latestText}`,'success','read');
        }
      }else{
        setCloudSyncStatus('目前沒有讀取或寫入','idle','idle');
      }
    }
  }catch(e){}
}

// ---- replace legacy sync API with V5 ----
window.p79V5Enqueue=enqueue;
window.p79V5Drain=drain;
window.p79V5StartDelta=startDelta;
window.p79V5PollDelta=pollDelta;
window.p79V5PendingForId=pendingForId;
window.p79V5QueueInfoForId=queueInfoForId;
window.p79V5ConfirmCloudRecord=confirmCloudRecord;
window.p79V5ConfirmCloudDelete=confirmCloudDelete;
window.p79V5RefreshStatus=updateUi;
window.p79V5GetStatus=()=>({
  writing,
  pending:readQueue().length,
  currentOpText,
  activeSyncRecordId,
  syncBatchTotal,
  syncBatchDone,
  deltaBusy,
  lastSeq,
  lastDoneAt,
  cloudActivityAt:p79LatestCloudActivityAt()
});


async function submitAttendanceWrite(payload,successMsg,onSuccess,onError){
  const recordId = payload?.record?.id ?? payload?.id;

  // 非考勤寫入交還舊系統；V5 只接管考勤。
  if(!isV5AttendanceWrite(payload)){
    if(typeof window.p79LegacyPostToCloud==='function'){
      return window.p79LegacyPostToCloud(payload,successMsg,onSuccess,onError);
    }
    return {ok:false,error:'非考勤寫入未由 V5 處理'};
  }

  // 沒有其他 writer 時直接送 GAS。
  if(!writing && navigator.onLine !== false){
    writing=true;
    syncBatchTotal=Math.max(1,readQueue().length+1);
    syncBatchDone=0;
    syncBatchStartedAt=Date.now();
    activeSyncRecordId=recordId!=null?String(recordId):'';
    currentOpText=desc(payload);
    updateUi();

    try{
      const data=await send(payload,30000);
      if(Number(data?.deltaSeq||0)>0){
        lastSeq=Math.max(lastSeq,Number(data.deltaSeq)||0);
        sessionStorage.setItem('port79_attendance_v5_delta_seq',String(lastSeq));
      }

      if(recordId!=null){
        try{markRecentAttendanceMutationCloudConfirmed?.(recordId)}catch(e){}
      }

      syncBatchDone++;
      lastDoneAt=Date.now();
      currentOpText='同步完成';
      activeSyncRecordId='';

      try{p79RenderOnlyVisibleAttendanceView?.()}catch(e){}
      try{renderAdminRecordsTable?.()}catch(e){}
      try{renderAdminLiveTable?.()}catch(e){}

      if(successMsg)try{showToast(successMsg,'success')}catch(e){}
      if(typeof onSuccess==='function')try{onSuccess(data)}catch(e){}

      // 直送完成後再補傳之前失敗的考勤。
      setTimeout(()=>drain(false),0);
      return data;
    }catch(err){
      const reason=String(err?.message||err||'雲端寫入失敗');

      if(err?.retryable===false){
        const rid=recordId!=null?String(recordId):'';
        if(rid){
          rejectedPunchById.set(rid, reason);
          records=(Array.isArray(records)?records:[]).filter(r=>String(r?.id??'')!==rid);
          try{removeAttendanceRecordsFromArchive?.([rid])}catch(e){}
          try{forgetRecentAttendanceMutation?.(rid)}catch(e){}
          try{
            if(typeof window.p79ScheduleAttendancePersist==='function')window.p79ScheduleAttendancePersist();
            else saveRecords?.();
          }catch(e){}
        }
        try{updateHomeClockInButtonState?.()}catch(e){}
        try{renderEmpHistoryTable?.()}catch(e){}
        try{p79RenderOnlyVisibleAttendanceView?.()}catch(e){}
        currentOpText='重複刷卡已阻擋';
        updateUi();
        if(typeof onError==='function'){
          try{onError(reason)}catch(e){}
        }else{
          try{showToast(reason,'warning')}catch(e){}
        }
        return {ok:false,queued:false,duplicatePunch:err?.duplicatePunch===true,error:reason};
      }

      enqueue(payload);
      currentOpText='等待自動重試';
      updateUi();

      if(typeof onError==='function'){
        try{onError(reason)}catch(e){}
      }else{
        try{showToast('雲端暫時未完成，這筆考勤已保留並會自動重試','warning')}catch(e){}
      }
      return {ok:false,queued:true,error:reason};
    }finally{
      writing=false;
      activeSyncRecordId='';
      updateUi();
    }
  }

  // 已有另一筆考勤寫入中，才排入唯一 V5 outbox。
  enqueue(payload);
  currentOpText='等待前一筆完成';
  updateUi();
  return {ok:true,queued:true};
}

window.p79V5SubmitAttendanceWrite=submitAttendanceWrite;

window.postToCloud=async function(payload,successMsg,onSuccess,onError){
  return submitAttendanceWrite(payload,successMsg,onSuccess,onError);
};

window.flushCloudOutbox=function(force=false){return drain(force)};
window.startAttendanceRevisionWatch=function(){return startDelta()};
window.checkAttendanceCloudRevision=async function(){return false};
window.pollAttendanceDelta=pollDelta;
window.startAttendanceDeltaWatch=startDelta;

// 一般員工手機打卡也統一進 V5 單一寫入通道。
window.postRealtimePunchToCloud=function(record,successMsg,onPersistSuccess,onError){
  try{
    enqueue({action:'addRecord',record});
    updateUi();
    drain(true).then(()=>{
      const rid=String(record?.id??'');
      const rejected=rid?rejectedPunchById.get(rid):'';
      if(rejected){
        rejectedPunchById.delete(rid);
        try{onError?.(rejected)}catch(e){}
        return;
      }
      if(!pendingForId(record?.id)){
        try{onPersistSuccess?.({ok:true})}catch(e){}
        if(successMsg)try{showToast(successMsg,'success')}catch(e){}
      }else{
        try{onError?.('打卡已保留，等待雲端補傳')}catch(e){}
      }
    });
  }catch(e){
    try{onError?.(String(e?.message||e))}catch(ignore){}
  }
};

// legacy outbox no longer drives attendance writes.
try{
  localStorage.removeItem('port79_cloud_outbox_v1');
  localStorage.removeItem('port79_cloud_outbox');
}catch(e){}

document.addEventListener('DOMContentLoaded',()=>{
  updateUi();
  startDelta();
  drain(false);
  setInterval(()=>{if(document.visibilityState==='visible')updateUi();},3000);
},{once:true});
window.addEventListener('online',()=>{drain(true);pollDelta(true)});
document.addEventListener('visibilitychange',()=>{
  if(!document.hidden){drain(false);pollDelta(true)}
});
setInterval(()=>{if(!writing)drain(false)},5000);


// ----- V5.4 HARD BRIDGE -----
// 保留非考勤舊 API；任何考勤寫入若繞過 postToCloud，仍會被攔回 V5。
if(!window.p79LegacyPerformCloudRequest && typeof window.performCloudRequest==='function'){
  window.p79LegacyPerformCloudRequest=window.performCloudRequest;
}
if(!window.p79LegacyEnqueueCloudOperation && typeof window.enqueueCloudOperation==='function'){
  window.p79LegacyEnqueueCloudOperation=window.enqueueCloudOperation;
}
if(!window.p79LegacyFlushCloudOutbox && typeof window.flushCloudOutbox==='function'){
  window.p79LegacyFlushCloudOutbox=window.flushCloudOutbox;
}

window.performCloudRequest=async function(payload,timeoutMs=0){
  if(isV5AttendanceWrite(payload)){
    return submitAttendanceWrite(payload,'',null,null);
  }
  if(typeof window.p79LegacyPerformCloudRequest==='function'){
    return window.p79LegacyPerformCloudRequest(payload,timeoutMs);
  }
  return {ok:false,error:'無可用雲端 API'};
};

window.enqueueCloudOperation=function(payload,scheduleRetry=true){
  if(isV5AttendanceWrite(payload)){
    enqueue(payload);
    if(scheduleRetry) setTimeout(()=>drain(false),0);
    return true;
  }
  if(typeof window.p79LegacyEnqueueCloudOperation==='function'){
    return window.p79LegacyEnqueueCloudOperation(payload,scheduleRetry);
  }
  return false;
};

window.flushCloudOutbox=function(force=false){
  // 考勤只跑 V5 outbox。舊 outbox 不再負責考勤。
  return drain(force);
};

window.postRealtimePunchToCloud=function(record,successMsg,onPersistSuccess,onError){
  return submitAttendanceWrite(
    {action:'addRecord',record},
    successMsg,
    data=>{try{onPersistSuccess?.(data)}catch(e){}},
    onError
  );
};

})();
</script>



<script id="p79-v51021-attendance-status-clarity">
(function(){
'use strict';

let observer=null;
let currentItem=null;
let queued=false;

function refine(){
  queued=false;
  const item=document.querySelector('#p79SevenLiveRow .p79-seven-live-item[data-sys="attendance"]')
    || document.querySelector('.p79cloud-item[data-sys="attendance"]');
  if(!item)return;

  const span=item.querySelector('span');
  if(!span)return;

  const raw=String(span.textContent||'').trim();
  const cls=String(item.className||'');

  let next=raw;

  if(/\bwrite\b/.test(cls)){
    // Server activity class is authoritative: this is a POST/write.
    if(!/寫入中/.test(raw)){
      const elapsed=(raw.match(/(\d+(?:分\d+秒|秒))$/)||[])[1]||'';
      next=`✍️ 寫入中｜寫入考勤資料${elapsed?` ${elapsed}`:''}`;
    }
  }else if(/\bread\b/.test(cls)){
    // Server activity class is authoritative: this is a GET/read.
    if(!/讀取中/.test(raw)){
      const elapsed=(raw.match(/(\d+(?:分\d+秒|秒))$/)||[])[1]||'';
      next=`↙ 讀取中｜從雲端讀取考勤資料${elapsed?` ${elapsed}`:''}`;
    }
  }else if(/\berror\b/.test(cls)){
    next='! 錯誤｜考勤雲端作業失敗';
  }else if(/\bidle\b/.test(cls)){
    next='● 待命｜沒有讀取或寫入';
  }else if(/\bdone\b/.test(cls)){
    // Existing monitor already knows whether the last completed job was read or write.
    if(/寫入完成/.test(raw)) next=raw.replace(/^.*?寫入完成/u,'✅ 寫入完成');
    else if(/讀取完成/.test(raw)) next=raw.replace(/^.*?讀取完成/u,'✅ 讀取完成');
    else next=`✅ 已完成｜${raw.replace(/^[✓!]\s*/u,'')}`;
  }

  if(next!==raw)span.textContent=next;
  item.title = span.textContent;
}

function schedule(){
  if(queued)return;
  queued=true;
  requestAnimationFrame(refine);
}

function attach(){
  const item=document.querySelector('#p79SevenLiveRow .p79-seven-live-item[data-sys="attendance"]')
    || document.querySelector('.p79cloud-item[data-sys="attendance"]');

  if(!item){
    setTimeout(attach,500);
    return;
  }

  if(currentItem===item)return;
  currentItem=item;
  try{observer?.disconnect()}catch(e){}
  observer=new MutationObserver(schedule);
  observer.observe(item,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:['class']});
  refine();
}

document.addEventListener('DOMContentLoaded',()=>setTimeout(attach,800),{once:true});
window.addEventListener('pageshow',()=>setTimeout(attach,200));
})();
</script>


<script id="p79-v51022-refresh-blank-screen-guard">
(function(){
'use strict';

let repairCount=0;
let lastRepairAt=0;

function safeJson(key){
  try{return JSON.parse(sessionStorage.getItem(key)||'null')}catch(e){return null}
}

function desiredMode(){
  const u=safeJson('port79_user_session');
  const a=safeJson('admin_session');

  const entryMode=String(
    sessionStorage.getItem('port79_entry_mode') ||
    u?.entryMode ||
    (u?.punchOnly?'punch':'')
  ).toLowerCase();

  if(entryMode==='punch' || u?.punchOnly===true) return 'employee';

  const role=[
    String(sessionStorage.getItem('aqc_admin_role')||'').toLowerCase(),
    String(a?.adminRole||a?.role||'').toLowerCase(),
    String(u?.adminRole||u?.role||u?.actualAdminRole||'').toLowerCase()
  ].find(r=>r==='admin'||r==='superadmin')||'';

  const token=String(
    sessionStorage.getItem('port79_admin_token') ||
    sessionStorage.getItem('port79_gc_superadmin_token') ||
    sessionStorage.getItem('port79_gc_token') ||
    sessionStorage.getItem('port79_user_token') ||
    ''
  ).trim();

  return role && token ? 'admin' : 'employee';
}

function effectivelyHidden(el){
  if(!el)return true;
  if(el.classList.contains('hidden'))return true;
  const cs=getComputedStyle(el);
  if(cs.display==='none' || cs.visibility==='hidden' || Number(cs.opacity)===0)return true;
  return false;
}

function removeInlineHide(el){
  if(!el)return;
  el.classList.remove('hidden');
  ['display','visibility','opacity','height','max-height'].forEach(p=>{
    try{el.style.removeProperty(p)}catch(e){}
  });
}

function ensureAdminRecordsVisible(){
  const ids=[
    'viewAdmin','adminContentRecords','filterMonthSelect',
    'recordFilterResultCount','recordsPagination','adminRecordsTableBody'
  ];
  ids.forEach(id=>{
    const el=document.getElementById(id);
    if(el?.style?.getPropertyValue('display')) el.style.removeProperty('display');
  });

  const admin=document.getElementById('viewAdmin');
  removeInlineHide(admin);

  const content=document.getElementById('adminContentRecords');
  if(content){
    content.classList.remove('hidden');
    if(content.style?.getPropertyValue('display')) content.style.removeProperty('display');
  }

  try{sessionStorage.setItem('aqc_admin_active_tab','records')}catch(e){}
  try{if(typeof window.switchAdminTab==='function')window.switchAdminTab('records')}catch(e){}
  try{if(typeof window.renderAdminRecordsTable==='function')window.renderAdminRecordsTable()}catch(e){}
}

function ensureEmployeeVisible(){
  const employee=document.getElementById('viewEmployee');
  removeInlineHide(employee);

  const shell=employee?.querySelector('.employee-desktop-shell');
  if(shell){
    shell.classList.remove('hidden');
    if(shell.style?.getPropertyValue('display'))shell.style.removeProperty('display');
  }
}

function repairIfBlank(reason='watchdog'){
  const employee=document.getElementById('viewEmployee');
  const admin=document.getElementById('viewAdmin');
  if(!employee || !admin)return false;

  const employeeHidden=effectivelyHidden(employee);
  const adminHidden=effectivelyHidden(admin);

  // 正常已有其中一個主畫面時完全不碰，避免干涉使用者操作。
  if(!employeeHidden || !adminHidden)return false;

  const mode=desiredMode();

  // 先清掉互相衝突的 mode class。
  document.body.classList.remove('port79-admin-mode','port79-employee-only');

  if(mode==='admin'){
    document.body.classList.add('port79-admin-mode');
    employee.classList.add('hidden');

    try{
      if(typeof window.restoreAdminSession==='function')window.restoreAdminSession();
      if(typeof window.clearEmployeeOnlyInlineHidesForAdmin==='function')window.clearEmployeeOnlyInlineHidesForAdmin();
    }catch(e){}

    ensureAdminRecordsVisible();
  }else{
    document.body.classList.add('port79-employee-only');
    admin.classList.add('hidden');
    ensureEmployeeVisible();

    try{
      if(typeof window.enforcePort79EmployeeSimpleMode==='function')window.enforcePort79EmployeeSimpleMode();
    }catch(e){}
  }

  repairCount++;
  lastRepairAt=Date.now();
  console.warn(`[PORT79 V5.10.22] 偵測到主畫面全隱藏，已自動恢復 ${mode} 畫面`,{reason,repairCount});
  return true;
}

window.p79EnsureAttendanceViewVisible=repairIfBlank;
window.p79AttendanceBlankGuardStatus=()=>({
  mode:desiredMode(),
  repairCount,
  lastRepairAt,
  bodyClass:document.body?.className||'',
  employeeHidden:effectivelyHidden(document.getElementById('viewEmployee')),
  adminHidden:effectivelyHidden(document.getElementById('viewAdmin'))
});

function scheduleChecks(){
  [0,120,400,900,1800,3500].forEach(ms=>{
    setTimeout(()=>repairIfBlank(`startup-${ms}`),ms);
  });
}

if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded',scheduleChecks,{once:true});
}else{
  scheduleChecks();
}

window.addEventListener('pageshow',()=>setTimeout(()=>repairIfBlank('pageshow'),50));
window.addEventListener('error',()=>setTimeout(()=>repairIfBlank('runtime-error'),0));
window.addEventListener('unhandledrejection',()=>setTimeout(()=>repairIfBlank('promise-error'),0));
})();
</script>


<script id="p79-v51023-import-count-diagnostic">
(function(){
'use strict';
window.p79LastAttendanceImportSummary=function(){

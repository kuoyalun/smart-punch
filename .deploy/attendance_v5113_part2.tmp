<script id="p79-v51029-preserve-admin-return-mode">
(function(){
'use strict';

const OTHER_SYSTEM_PATHS=[
  '/work-hours/',
  '/leave/',
  '/schedule/',
  '/aqc-efficiency/',
  '/hr/',
  '/history-data/'
];

function safeJson(key){
  try{return JSON.parse(sessionStorage.getItem(key)||'null')}catch(e){return null}
}

function isAdminAttendanceContext(){
  const a=safeJson('admin_session');
  const u=safeJson('port79_user_session');
  const role=String(
    sessionStorage.getItem('aqc_admin_role') ||
    a?.adminRole || a?.role ||
    u?.adminRole || u?.role || u?.actualAdminRole ||
    ''
  ).toLowerCase();

  return (
    (role==='admin'||role==='superadmin') &&
    sessionStorage.getItem('port79_entry_mode')!=='punch'
  );
}

document.addEventListener('click',event=>{
  const a=event.target?.closest?.('a[href]');
  if(!a || !isAdminAttendanceContext())return;

  let path='';
  try{
    path=new URL(a.href,location.href).pathname||'';
  }catch(e){return}

  if(!OTHER_SYSTEM_PATHS.some(p=>path.includes(p)))return;

  try{
    sessionStorage.setItem('port79_attendance_return_mode','manage');
    sessionStorage.setItem('port79_entry_mode','manage');

    const u=safeJson('port79_user_session');
    if(u){
      u.entryMode='manage';
      u.punchOnly=false;
      sessionStorage.setItem('port79_user_session',JSON.stringify(u));
    }
  }catch(e){}
},true);
})();
</script>


<script id="p79-v51026-import-blank-side-audit">
(function(){
'use strict';
window.p79AuditImportBlankSides=function(attNoOrName,dateText){
  const wanted=String(attNoOrName||'').trim().replace(/\s+/g,'').toUpperCase();
  const date=String(dateText||'').trim().replaceAll('-','/');
  const rows=(Array.isArray(records)?records:[]).filter(r=>{
    const att=String(r?.attNo||'').trim().replace(/^0+/,'').toUpperCase();
    const name=String(r?.name||'').trim().replace(/\s+/g,'').toUpperCase();
    const emp=String(r?.empId||'').trim().toUpperCase();
    const d=String(r?.timeStr||'').slice(0,10).replaceAll('-','/');
    return (!wanted || att===wanted || name===wanted || emp===wanted) && (!date || d===date);
  });
  const hasIn=rows.some(r=>getAttendanceRecordType(r)==='IN');
  const hasOut=rows.some(r=>getAttendanceRecordType(r)==='OUT');
  const result={hasIn,hasOut,shouldFillIn:!hasIn,shouldFillOut:!hasOut,rows:rows.length};
  console.table([result]);
  return result;
};
})();
</script>



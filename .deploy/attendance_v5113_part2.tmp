<div id="port79CalendarModeBox" role="group" aria-label="年份顯示方式">
  <span>年份</span>
  <select id="port79CalendarModeSelect" title="切換西元年／民國年">
    <option value="gregorian">西元</option>
    <option value="roc">民國</option>
  </select>
</div>
<script id="port79-calendar-mode-script">
(function(){
  const KEY='port79_year_mode';
  const mode=localStorage.getItem(KEY)==='roc'?'roc':'gregorian';
  const sel=document.getElementById('port79CalendarModeSelect');
  if(sel){
    sel.value=mode;
    sel.addEventListener('change',()=>{
      localStorage.setItem(KEY,sel.value==='roc'?'roc':'gregorian');
      location.reload();
    });
  }
  if(mode!=='roc')return;
  const skip=new Set(['SCRIPT','STYLE','NOSCRIPT','TEXTAREA','INPUT']);
  const cv=(s)=>{
    s=String(s||'');
    s=s.replace(/民國\s*(\d{1,3})\s*年\s*(\d{1,2})\s*月\s*(\d{1,2})\s*日/g,(m,y,mo,d)=>`${Number(y)}/${String(mo).padStart(2,'0')}/${String(d).padStart(2,'0')}`);
    s=s.replace(/民國\s*(\d{1,3})(?:[\/-])(\d{1,2})(?:[\/-])(\d{1,2})\b/g,(m,y,mo,d)=>`${Number(y)}/${String(mo).padStart(2,'0')}/${String(d).padStart(2,'0')}`);
    s=s.replace(/民國\s*(\d{1,3})\s*年\s*(\d{1,2})\s*月/g,(m,y,mo)=>`${Number(y)}/${String(mo).padStart(2,'0')}`);
    s=s.replace(/民國\s*(\d{1,3})(?:[\/-])(\d{1,2})(?![\/-]\d)/g,(m,y,mo)=>`${Number(y)}/${String(mo).padStart(2,'0')}`);
    s=s.replace(/民國\s*(\d{1,3})\s*年/g,(m,y)=>`${Number(y)}年`);
    s=s.replace(/\b((?:19|20)\d{2})\s*年\s*(\d{1,2})\s*月\s*(\d{1,2})\s*日/g,(m,y,mo,d)=>`${Number(y)-1911}/${String(mo).padStart(2,'0')}/${String(d).padStart(2,'0')}`);
    s=s.replace(/\b((?:19|20)\d{2})(?:[\/-])(\d{1,2})(?:[\/-])(\d{1,2})\b/g,(m,y,mo,d)=>`${Number(y)-1911}/${String(mo).padStart(2,'0')}/${String(d).padStart(2,'0')}`);
    s=s.replace(/\b((?:19|20)\d{2})\s*年\s*(\d{1,2})\s*月/g,(m,y,mo)=>`${Number(y)-1911}/${String(mo).padStart(2,'0')}`);
    s=s.replace(/\b((?:19|20)\d{2})(?:[\/-])(\d{1,2})(?![\/-]\d)/g,(m,y,mo)=>`${Number(y)-1911}/${String(mo).padStart(2,'0')}`);
    s=s.replace(/\b((?:19|20)\d{2})\s*年/g,(m,y)=>`${Number(y)-1911}年`);
    return s;
  };
  let busy=false;
  function scan(root){
    if(!root||busy)return;
    busy=true;
    try{
      const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
      const nodes=[]; let n;
      while(n=walker.nextNode())nodes.push(n);
      nodes.forEach(node=>{
        const p=node.parentElement;
        if(!p||skip.has(p.tagName)||p.closest('#port79CalendarModeBox'))return;
        const old=node.nodeValue||'';
        const next=cv(old);
        if(next!==old)node.nodeValue=next;
      });
    }finally{busy=false}
  }
  scan(document.body);
  let p79CalendarObserverQueued=false;
  const p79CalendarObserverRoots=new Set();
  function flushCalendarObserver(){
    p79CalendarObserverQueued=false;
    const roots=[...p79CalendarObserverRoots];
    p79CalendarObserverRoots.clear();
    roots.forEach(n=>{
      if(!n)return;
      const root=n.nodeType===1?n:n.parentElement;
      if(root)scan(root);
    });
  }
  const mo=new MutationObserver(ms=>{
    if(busy)return;
    ms.forEach(m=>(m.addedNodes||[]).forEach(n=>{
      if(n && (n.nodeType===1||n.nodeType===3)) p79CalendarObserverRoots.add(n);
    }));
    if(p79CalendarObserverRoots.size && !p79CalendarObserverQueued){
      p79CalendarObserverQueued=true;
      requestAnimationFrame(flushCalendarObserver);
    }
  });
  mo.observe(document.body,{childList:true,subtree:true});
})();
</script>


<script id="p79-unified-ui-script-v20260930-82">
(function(){
  const SYS = document.body?.dataset?.p79System || '';
  const meta={
    attendance:{name:'考勤系統',icon:'🕒',desc:'員工打卡・考勤紀錄・即時動態'},
    leave:{name:'請假系統',icon:'📝',desc:'請假申請・審核・特休資訊'},
    schedule:{name:'排班系統',icon:'📅',desc:'人員班表・組別・今日出勤'},
    efficiency:{name:'效率系統',icon:'🚢',desc:'船舶作業・效率統計・月報比對'},
    hr:{name:'人資系統',icon:'👥',desc:'員工主檔・部門職稱・權限設定'}
  };
  const info=meta[SYS]||{name:'79號碼頭系統',icon:'⚓',desc:'雲端智慧管理平台'};
  const nav=[['attendance','🕒','考勤','../attendance/'],['workhours','📊','工時統計','../work-hours/'],['leave','📝','請假','../leave/'],['schedule','📅','排班','../schedule/'],['efficiency','🚢','效率','../aqc-efficiency/'],['hr','👥','人資','../hr/'],['history','🗄️','歷史資料','../history-data/']];
  const esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));
  function mount(){
    if(document.getElementById('p79UnifiedShell'))return;
    // 超級管理員進入考勤後台時預設為編輯模式，避免跨頁沿用「查看模式」
    // 造成編輯/刪除按鈕被統一介面再次鎖住。
    try{
      const superAdmin = SYS==='attendance' &&
        sessionStorage.getItem('aqc_admin_logged_in')==='1' &&
        String(sessionStorage.getItem('aqc_admin_role')||'').toLowerCase()==='superadmin';
      if(superAdmin)localStorage.setItem('port79_unified_edit_mode_v1','edit');
    }catch(e){}
    const shell=document.createElement('div');shell.id='p79UnifiedShell';
    shell.innerHTML=`<div class="p79u-top">
      <div class="p79u-brand"><div class="p79u-logo">${info.icon}</div><div><div class="p79u-title">${esc(info.name)}</div><div class="p79u-sub">79號碼頭雲端智慧系統｜統一介面 v2026.09.30.9.1</div></div></div>
      <nav class="p79u-nav">${nav.map(([k,i,n,u])=>`<a class="${k===SYS?'active':''}" href="${u}"><span>${i}</span>${n}</a>`).join('')}</nav>
      <div class="p79u-actions">
        <button class="p79u-btn primary" type="button" onclick="window.p79UnifiedRefresh()">⟳ 重新整理</button>
        
        <button class="p79u-btn" type="button" onclick="window.p79UnifiedTheme()">◐ 深淺色</button>
        <button class="p79u-btn home" type="button" onclick="location.href='../'">⌂ 返回首頁</button>
      </div></div>
      <div id="p79UnifiedContext"><div class="p79u-context-inner"><div class="p79u-context-status"><b>${esc(info.desc)}</b></div><div class="p79u-context-hint">日期範圍、搜尋、下拉條件與清除篩選皆採相同操作規格</div></div></div>`;
    document.body.insertBefore(shell,document.body.firstChild);
    applyMode(readMode());
    markMutationControls();
    observeMutations();
  }
  function readMode(){return 'edit'}
  function canMark(el){if(!el||el.id==='p79UnifiedEditModeBtn')return false; if(el.closest('#p79UnifiedShell'))return false; return true}
  function markMutationControls(){
    let els=[];
    try{
      if(SYS==='schedule') els=[...document.querySelectorAll('[data-schedule-edit="1"]')];
      else if(SYS==='hr') els=[...document.querySelectorAll('#addBtn,button[onclick*="openEditor"],button[onclick*="deleteEmployee"],button[onclick*="saveEmployee"],button[onclick*="clearSessionLogs"]')];
      else if(SYS==='leave') els=[...document.querySelectorAll('#adminMode button[onclick*="approve"],#adminMode button[onclick*="reject"],#adminMode button[onclick*="delete"],#adminMode button[onclick*="updateLeave"]')];
      else if(SYS==='efficiency') els=[...document.querySelectorAll('#efficiencySaveBtn,button[onclick*="saveGroup"],button[onclick*="deleteGroup"],button[onclick*="saveRecord"],button[onclick*="deleteRecord"],button[onclick*="addMonthlyEditorRow"],button[onclick*="applyMonthlyEditorRows"]')];
      else if(SYS==='attendance') els=[...document.querySelectorAll('#viewAdmin button[onclick*="save"],#viewAdmin button[onclick*="delete"],#viewAdmin button[onclick*="edit"],#viewAdmin button[onclick*="add"],#viewAdmin button[onclick*="update"]')];
    }catch(e){}
    els.filter(canMark).forEach(el=>el.dataset.p79Mutation='1');
    applyMode(readMode());
  }
  function applyMode(mode){
    const view=mode==='view';document.body.classList.toggle('p79-view-mode',view);
    const btn=document.getElementById('p79UnifiedEditModeBtn'),txt=document.getElementById('p79UnifiedEditModeText'),st=document.getElementById('p79UnifiedModeStatus');
    if(btn){btn.classList.toggle('edit',!view);btn.classList.toggle('view',view)}
    const wantedTxt=view?'查看模式':'編輯模式';
    const wantedStatus=view?'｜目前為查看模式':'｜編輯模式已同步';
    if(txt&&txt.textContent!==wantedTxt)txt.textContent=wantedTxt;
    if(st&&st.textContent!==wantedStatus)st.textContent=wantedStatus;
    document.querySelectorAll('[data-p79-mutation="1"]').forEach(el=>{
      if(view){if(!el.disabled){el.dataset.p79ModeDisabled='1';el.disabled=true}}
      else if(el.dataset.p79ModeDisabled==='1'){el.disabled=false;delete el.dataset.p79ModeDisabled}
    });
  }
  window.p79ToggleUnifiedEditMode=function(){const next=readMode()==='edit'?'view':'edit';try{localStorage.setItem('port79_unified_edit_mode_v1',next)}catch(e){}applyMode(next)};
  window.addEventListener('storage',e=>{if(e.key==='port79_unified_edit_mode_v1')applyMode(readMode())});
  window.p79UnifiedRefresh=async function(){
    const b=document.querySelector('#p79UnifiedShell .p79u-btn.primary');const old=b?.textContent;if(b){b.disabled=true;b.textContent='⟳ 整理中…'}
    try{
      if(SYS==='attendance'){if(typeof refreshAdminDashboard==='function'&&typeof isAdminLoggedIn!=='undefined'&&isAdminLoggedIn) await refreshAdminDashboard(); else if(typeof manualCloudRefresh==='function') await manualCloudRefresh(); else location.reload();}
      else if(SYS==='leave'&&typeof loadCloud==='function') await loadCloud(true);
      else if(SYS==='schedule'&&typeof manualRefreshSchedule==='function') await manualRefreshSchedule();
      else if(SYS==='efficiency'){if(typeof manualCloudSync==='function') await manualCloudSync(); else if(typeof syncFromCloud==='function') await syncFromCloud(true);}
      else if(SYS==='hr'&&typeof loadEmployees==='function') await loadEmployees(true);
      else location.reload();
    }catch(e){console.error('統一重新整理失敗',e)}finally{if(b){b.disabled=false;b.textContent=old||'⟳ 重新整理'} markMutationControls();}
  };
  window.p79UnifiedTheme=function(){
    try{
      if(SYS==='attendance'&&typeof toggleDarkMode==='function')return toggleDarkMode();
      if(SYS==='leave'&&document.getElementById('themeBtn'))return document.getElementById('themeBtn').click();
      if(SYS==='schedule'&&typeof toggleScheduleTheme==='function')return toggleScheduleTheme();
      if(SYS==='efficiency'&&typeof toggleEfficiencyTheme==='function')return toggleEfficiencyTheme();
      if(SYS==='hr'&&document.getElementById('themeBtn'))return document.getElementById('themeBtn').click();
    }catch(e){} document.documentElement.classList.toggle('dark');
  };
  function observeMutations(){
    try{
      let pending=false;
      const mo=new MutationObserver(ms=>{
        // 只在真的新增「元素」時重新掃描；純文字更新不處理，避免 applyMode → textContent → Observer 無限循環。
        const hasElementAddition=ms.some(m=>Array.from(m.addedNodes||[]).some(n=>n&&n.nodeType===1&&!n.closest?.('#p79UnifiedShell')));
        if(!hasElementAddition||pending)return;
        pending=true;
        const run=()=>{pending=false;markMutationControls();};
        if(typeof requestAnimationFrame==='function')requestAnimationFrame(run);else setTimeout(run,0);
      });
      mo.observe(document.body,{subtree:true,childList:true});
    }catch(e){}
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mount);else mount();
})();
</script>

<script id="port79-localdb-offline-first-v20260930-85">
(function(){
  'use strict';
  const DB_NAME='port79_attendance_local_v1';
  const DB_VERSION=1;
  const PROFILE_STORE='profiles';
  const SNAPSHOT_STORE='snapshots';

  function p79DbOpen(){
    return new Promise((resolve,reject)=>{
      if(!('indexedDB' in window)){reject(new Error('IndexedDB unavailable'));return;}
      const req=indexedDB.open(DB_NAME,DB_VERSION);
      req.onupgradeneeded=()=>{
        const db=req.result;
        if(!db.objectStoreNames.contains(PROFILE_STORE)) db.createObjectStore(PROFILE_STORE,{keyPath:'empId'});
        if(!db.objectStoreNames.contains(SNAPSHOT_STORE)) db.createObjectStore(SNAPSHOT_STORE,{keyPath:'key'});
      };
      req.onsuccess=()=>resolve(req.result);
      req.onerror=()=>reject(req.error||new Error('IndexedDB open failed'));
    });
  }

  async function p79DbPut(storeName,value){
    const db=await p79DbOpen();
    return new Promise((resolve,reject)=>{
      const tx=db.transaction(storeName,'readwrite');
      tx.objectStore(storeName).put(value);
      tx.oncomplete=()=>{try{db.close()}catch(e){} resolve(true)};
      tx.onerror=()=>{try{db.close()}catch(e){} reject(tx.error||new Error('IndexedDB write failed'))};
      tx.onabort=()=>{try{db.close()}catch(e){} reject(tx.error||new Error('IndexedDB write aborted'))};
    });
  }

  async function p79DbGet(storeName,key){
    const db=await p79DbOpen();
    return new Promise((resolve,reject)=>{
      const tx=db.transaction(storeName,'readonly');
      const req=tx.objectStore(storeName).get(key);
      req.onsuccess=()=>resolve(req.result||null);
      req.onerror=()=>reject(req.error||new Error('IndexedDB read failed'));
      tx.oncomplete=()=>{try{db.close()}catch(e){}};
    });
  }

  async function p79DbDelete(storeName,key){
    const db=await p79DbOpen();
    return new Promise((resolve,reject)=>{
      const tx=db.transaction(storeName,'readwrite');
      tx.objectStore(storeName).delete(key);
      tx.oncomplete=()=>{try{db.close()}catch(e){} resolve(true)};
      tx.onerror=()=>{try{db.close()}catch(e){} reject(tx.error||new Error('IndexedDB delete failed'))};
      tx.onabort=()=>{try{db.close()}catch(e){} reject(tx.error||new Error('IndexedDB delete aborted'))};
    });
  }

  function p79SessionEmpId(){
    try{
      const s=JSON.parse(sessionStorage.getItem('port79_user_session')||'null');
      return String(s?.empId||sessionStorage.getItem('port79_home_emp_id')||'').trim().toUpperCase();
    }catch(e){return String(sessionStorage.getItem('port79_home_emp_id')||'').trim().toUpperCase();}
  }

  function p79SafeProfile(emp){
    if(!emp)return null;
    const empId=String(emp.empId||'').trim().toUpperCase();
    if(!empId)return null;
    return {
      empId,
      attNo:String(emp.attNo||''),
      name:String(emp.name||''),
      dept:String(emp.dept||''),
      jobTitle:String(emp.jobTitle||emp.deptDetail||''),
      deptDetail:String(emp.jobTitle||emp.deptDetail||''),
      adminRole:'employee',
      employmentStatus:String(emp.employmentStatus||'active'),
      deviceId:String(emp.deviceId||''),
      localDbProfile:true,
      savedAt:Date.now()
    };
  }

  async function p79SaveLocalDbSnapshot(){
    try{
      const empId=String(currentEmp?.empId||p79SessionEmpId()).trim().toUpperCase();
      if(!empId)return false;
      let emp=currentEmp;
      if(!emp && Array.isArray(employees)) emp=employees.find(e=>String(e?.empId||'').trim().toUpperCase()===empId)||null;
      const profile=p79SafeProfile(emp);
      if(profile) await p79DbPut(PROFILE_STORE,profile);
      if(typeof isAdminLoggedIn!=='undefined' && isAdminLoggedIn){
        // 管理員畫面顯示的是全公司資料，不能只把「管理員本人」考勤存成離線快照。
        // 舊版這樣做會在手機下次啟動時把本人舊紀錄重新混回最新雲端清單。
        await p79DbDelete(SNAPSHOT_STORE,'records:'+empId);
      }else if(Array.isArray(records)){
        const mine=records.filter(r=>String(r?.empId||'').trim().toUpperCase()===empId).slice(0,500);
        await p79DbPut(SNAPSHOT_STORE,{key:'records:'+empId,empId,records:mine,savedAt:Date.now()});
      }
      await p79DbPut(SNAPSHOT_STORE,{key:'meta:'+empId,empId,lastSavedAt:Date.now(),version:'2026.09.30.8.5'});
      return true;
    }catch(e){console.warn('本機資料庫保存失敗：',e);return false;}
  }

  async function p79LoadLocalDbSnapshot(){
    const empId=p79SessionEmpId();
    if(!empId)return null;
    try{
      const [profile,recordPack]=await Promise.all([
        p79DbGet(PROFILE_STORE,empId),
        p79DbGet(SNAPSHOT_STORE,'records:'+empId)
      ]);
      return {empId,profile,records:Array.isArray(recordPack?.records)?recordPack.records:[]};
    }catch(e){console.warn('本機資料庫讀取失敗：',e);return null;}
  }

  function p79ApplyLocalDbSnapshot(snapshot, options={}){
    if(!snapshot?.empId)return false;

    const allowRecords = options.allowRecords === true;
    const empId=String(snapshot.empId).toUpperCase();

    // 雲端已成功讀取時，手機 IndexedDB 絕對不能再反向蓋回雲端資料。
    // IndexedDB 僅供「離線 / 雲端讀取失敗」備援。
    const cloudAlreadyFresh = typeof lastCloudLoadSuccessAt !== 'undefined' && Number(lastCloudLoadSuccessAt||0) > 0;
    const online = typeof navigator === 'undefined' ? true : navigator.onLine !== false;
    const canApplyRecords = allowRecords && (!online || !cloudAlreadyFresh);

    if(snapshot.profile && Array.isArray(employees)){
      const i=employees.findIndex(e=>String(e?.empId||'').trim().toUpperCase()===empId);
      // 只有本機缺少 profile 時才補，不覆蓋已從雲端取得的欄位。
      if(i<0) employees.unshift({...snapshot.profile,localDbProfile:true});
      else if(!online || !cloudAlreadyFresh) employees[i]={...snapshot.profile,...employees[i],localDbProfile:true};
    }

    if(canApplyRecords && Array.isArray(snapshot.records)&&snapshot.records.length&&Array.isArray(records)){
      const seen=new Set(records.map(r=>String(r?.id??'')));
      snapshot.records.forEach(r=>{
        const id=String(r?.id??'');
        if(id&&!seen.has(id)){records.push(r);seen.add(id)}
      });
      try{records.sort((a,b)=>getAttendanceTimestamp(b)-getAttendanceTimestamp(a));}catch(e){}
    }

    const input=document.getElementById('inputEmpId');
    if(input && !String(input.value||'').trim()) input.value=empId;
    try{applyUnifiedEmployeeLoginFromHome();}catch(e){}
    if(!currentEmp && snapshot.profile){
      currentEmp={...snapshot.profile,localDbProfile:true,sessionFallback:true};
    }else if(currentEmp && String(currentEmp.empId||'').trim().toUpperCase()===empId && (!online || !cloudAlreadyFresh)){
      currentEmp={...snapshot.profile,...currentEmp,localDbProfile:true};
    }
    try{
      if(currentEmp){
        savePersistentEmployeeSession(currentEmp);
        const dep=document.getElementById('empDeptDisplay');
        if(dep && !String(currentEmp.dept||'').trim() && canApplyRecords) dep.textContent='部門：本機離線資料已載入｜等待雲端恢復';
      }
      updateHomeClockInButtonState();
      if(canApplyRecords) renderEmpHistoryTable();
    }catch(e){}
    return !!currentEmp;
  }

  // 雲端成功後，只把「目前登入員工」需要的資料落地到手機 IndexedDB。
  try{
    const oldLoadCloudData=loadCloudData;
    loadCloudData=function(...args){
      const p=oldLoadCloudData.apply(this,args);
      return Promise.resolve(p).then(async ok=>{
        if(ok){
          try{applyUnifiedEmployeeLoginFromHome();}catch(e){}
          await p79SaveLocalDbSnapshot();
        }
        return ok;
      });
    };
  }catch(e){console.warn('無法掛接雲端同步保存：',e)}

  // 每次本機考勤資料變更，同步保存一份 IndexedDB 快照。
  try{
    const oldSaveRecords=saveRecords;
    saveRecords=function(...args){
      const out=oldSaveRecords.apply(this,args);
      setTimeout(()=>p79SaveLocalDbSnapshot(),0);
      return out;
    };
  }catch(e){console.warn('無法掛接本機考勤保存：',e)}

  // 已在這台手機完成首次驗證、且 IndexedDB 有本人資料時，不因 GAS 暫時失聯再次卡綁定。
  try{
    const oldVerifyAndBind=verifyAndBindCurrentDevice;
    verifyAndBindCurrentDevice=async function(){
      try{
        if((currentEmp?.localDbProfile || currentEmp?.masterTemporarilyUnavailable) && isFirstPunchVerified(currentEmp)){
          const saved=String(currentEmp.deviceId||'').trim();
          const nowId=getDeviceId();
          if(!saved || isSamePhysicalDeviceId(saved,nowId)){
            savePersistentEmployeeSession(currentEmp);
            return true;
          }
        }
      }catch(e){}
      return await oldVerifyAndBind.apply(this,arguments);
    };
  }catch(e){console.warn('無法掛接本機裝置驗證：',e)}

  // 頁面啟動規則：
  // 1. 真正離線：先用 IndexedDB 備援。
  // 2. 有網路：雲端是唯一主資料；等雲端完成後只「覆寫保存」IndexedDB，不可再把舊快取合併回畫面。
  const oldOnload=window.onload;
  window.onload=async function(ev){
    // PORT79 2026-10-04 IDB-FIRST：
    // 已下載過「資料快取中心」後，開頁先用完整 IndexedDB 快取立即顯示，
    // 雲端同步只在背景更新，不再阻塞畫面。
    let fullCacheRow=null;
    try{
      fullCacheRow=await window.Port79DataCache?.getSystemSnapshot?.('attendance');
      if(fullCacheRow?.data?.fullDatabase && Array.isArray(fullCacheRow.data.records)){
        await window.p79ApplyAttendanceFullCache?.(fullCacheRow.data,{showAll:false,forceCurrentMonth:true,fromIndexedDb:true,silent:true});
        try{setCloudSyncStatus(`⚡ 已載入本機完整快取｜考勤 ${fullCacheRow.data.records.length} 筆`,'success')}catch(e){}
      }
    }catch(e){console.warn('本機完整快取啟動失敗',e)}

    // 保留原本 IndexedDB/離線快照，僅作舊版相容備援。
    let snapshot=null;
    try{snapshot=await p79LoadLocalDbSnapshot()}catch(e){}
    const online = typeof navigator==='undefined' ? true : navigator.onLine!==false;
    if(!fullCacheRow && !online && snapshot){
      try{p79ApplyLocalDbSnapshot(snapshot,{allowRecords:true})}catch(e){}
    }

    if(typeof oldOnload==='function') await oldOnload.call(this,ev);

    // 舊頁面初始化可能重建月份選單；最後再保證一次預設為目前月份。
    try{
      const monthSelect=document.getElementById('filterMonthSelect');
      if(monthSelect){
        const now=new Date();
        const currentMonth=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
        if([...monthSelect.options].some(o=>o.value===currentMonth)) monthSelect.value=currentMonth;
        monthSelect.dataset.p79MonthInitialized='1';
        try{renderAttendanceMonthTabs([...monthSelect.options].map(o=>o.value),currentMonth)}catch(e){}
        recordsCurrentPage=1;
        try{renderAdminRecordsTable()}catch(e){}
      }
    }catch(e){}

    // oldOnload 已會自己啟動背景雲端同步。
    // 這裡不再額外 await p79StartupAttendanceCurrentMonthSync()，
    // 避免開頁重複抓月份、造成「明明有快取還是等很久」。
    if(!online && !fullCacheRow && snapshot){
      try{p79ApplyLocalDbSnapshot(snapshot,{allowRecords:true})}catch(e){}
    }
  };

  window.addEventListener('online',()=>{
    setTimeout(()=>{
      try{
        if(typeof p79IsMobileOrTabletForAttendanceSync==='function' && p79IsMobileOrTabletForAttendanceSync()){
          Promise.resolve(typeof pollAttendanceDelta==='function' ? pollAttendanceDelta(true) : false)
            .finally(()=>flushCloudOutbox(false));
        }else{
          loadAttendanceCoreSyncData(false)
            .then(ok=>ok||loadAttendanceMonthFromCloud(getRequestedAttendanceCloudMonth(),false))
            .then(()=>flushCloudOutbox(true));
        }
      }catch(e){}
    },600);
  });

  // 手機從背景切回前景時，若距離上次完整雲端讀取已超過 12 秒，直接強制對齊一次。
  // revision 狀態列仍會做快速偵測；這裡只處理 iOS 長時間凍結計時器的情況。
  document.addEventListener('visibilitychange',()=>{
    if(document.visibilityState!=='visible')return;
    if(typeof navigator!=='undefined'&&navigator.onLine===false)return;

    // 手機/平板從背景回來只補 attendance delta，不再立刻重抓整個月份。
    if(typeof p79IsMobileOrTabletForAttendanceSync==='function' && p79IsMobileOrTabletForAttendanceSync()){
      setTimeout(()=>{try{if(typeof pollAttendanceDelta==='function')pollAttendanceDelta(true)}catch(e){}},250);
      return;
    }

    // 電腦/筆電維持原本行為，不更動。
    const age=Date.now()-Number(typeof lastCloudLoadSuccessAt!=='undefined'?lastCloudLoadSuccessAt:0);
    if(age<12000)return;
    setTimeout(()=>{try{loadAttendanceCoreSyncData(false).then(ok=>ok||loadAttendanceMonthFromCloud(getRequestedAttendanceCloudMonth(),false))}catch(e){}},250);
  });


  // 方便測試：控制台可輸入 p79AttendanceLocalDbInfo() 查看本機是否已有本人資料。
  window.p79AttendanceLocalDbInfo=async function(){
    const s=await p79LoadLocalDbSnapshot();
    return {empId:s?.empId||'',hasProfile:!!s?.profile,recordCount:s?.records?.length||0};
  };
})();
</script>


<!-- PORT79 v2026.09.30.8.8 NAME-ONLY DISPLAY: 姓名後方單位代碼不顯示；不改原始人資資料 -->
<script id="port79-name-only-display-v20260930-88">
(function(){
  'use strict';
  const UNIT_TOKEN = '(?:AQC|ARMG|F\\s*\\/\\s*L|FL|GC|QC|RTG|RMG|領班|指揮手)';
  const NAME_UNIT_RE = new RegExp('([\\u3400-\\u9FFF]{2,5})\\s*[（(]\\s*'+UNIT_TOKEN+'\\s*[）)]','g');
  function nameOnlyText(value){
    return String(value == null ? '' : value).replace(NAME_UNIT_RE,'$1');
  }
  window.port79NameOnly = nameOnlyText;

  function cleanTextNode(node){
    if(!node || node.nodeType!==3) return;
    const old=node.nodeValue||'';
    const next=nameOnlyText(old);
    if(next!==old) node.nodeValue=next;
  }
  function cleanNode(root){
    if(!root) return;
    if(root.nodeType===3){ cleanTextNode(root); return; }
    if(root.nodeType!==1 && root.nodeType!==9 && root.nodeType!==11) return;
    const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
    let n; while((n=walker.nextNode())) cleanTextNode(n);
    if(root.nodeType===1){
      ['title','aria-label','placeholder'].forEach(attr=>{
        if(root.hasAttribute && root.hasAttribute(attr)){
          const old=root.getAttribute(attr)||'', next=nameOnlyText(old);
          if(next!==old) root.setAttribute(attr,next);
        }
      });
    }
  }

  let queued=false, pending=new Set();
  function flush(){
    queued=false;
    const list=[...pending];
    pending.clear();
    list.forEach(cleanNode);
  }
  function queue(node){
    if(node) pending.add(node);
    if(!queued){ queued=true; requestAnimationFrame(flush); }
  }
  function start(){
    cleanNode(document.body);
    const obs=new MutationObserver(muts=>{
      muts.forEach(m=>{
        if(m.addedNodes) m.addedNodes.forEach(queue);
      });
    });
    // V5.10.14：姓名已在資料匯入層清理，DOM 只監看新增節點。
    // 不再監看 characterData，避免表格文字更新時全頁反覆掃描。
    obs.observe(document.body,{subtree:true,childList:true});
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();
})();
</script>






<script id="attendanceDrawerScript">
(function(){
  function els(){return {drawer:document.getElementById('attendanceDrawer'),backdrop:document.getElementById('attendanceDrawerBackdrop'),toggle:document.getElementById('attendanceDrawerToggle')}}
  window.openAttendanceDrawer=function(){const e=els();if(!e.drawer)return;e.drawer.classList.add('open');e.backdrop?.classList.add('open');document.body.classList.add('attendance-drawer-open');e.drawer.setAttribute('aria-hidden','false');e.toggle?.setAttribute('aria-expanded','true')};
  window.closeAttendanceDrawer=function(){const e=els();if(!e.drawer)return;e.drawer.classList.remove('open');e.backdrop?.classList.remove('open');document.body.classList.remove('attendance-drawer-open');e.drawer.setAttribute('aria-hidden','true');e.toggle?.setAttribute('aria-expanded','false')};
  window.toggleAttendanceDrawer=function(){const e=els();if(!e.drawer)return;e.drawer.classList.contains('open')?window.closeAttendanceDrawer():window.openAttendanceDrawer()};
  document.addEventListener('keydown',function(ev){if(ev.key==='Escape')window.closeAttendanceDrawer()});
  document.addEventListener('click',function(ev){const btn=ev.target.closest('#attendanceDrawer button');if(!btn||btn.classList.contains('attendance-drawer-close'))return;setTimeout(window.closeAttendanceDrawer,80)});
})();
</script>

<script id="p79-unified-shell-v103-script">
(function(){
'use strict';
const current='attendance';
const meta={attendance:['🕒','考勤系統','員工打卡・考勤紀錄・即時動態'],leave:['📝','請假系統','請假申請・審核・特休資訊'],schedule:['📅','排班系統','人員班表・組別・今日出勤'],efficiency:['🚢','效率系統','船舶作業・效率統計・月報比對'],hr:['👥','人資系統','員工主檔・部門職稱・權限設定']};
const nav=[['attendance','🕒','考勤','../attendance/'],['workhours','📊','工時統計','../work-hours/'],['leave','📝','請假','../leave/'],['schedule','📅','排班','../schedule/'],['efficiency','🚢','效率','../aqc-efficiency/'],['hr','👥','人資','../hr/'],['history','🗄️','歷史資料','../history-data/']];
function esc(x){return String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function getSession(){try{return JSON.parse(sessionStorage.getItem('port79_user_session')||sessionStorage.getItem('admin_session')||'null')}catch(e){return null}}
function roleText(){const s=getSession();const r=String(s?.adminRole||s?.role||sessionStorage.getItem('aqc_admin_role')||'').toLowerCase();return r==='superadmin'?'超級管理員':r==='admin'?'管理員':'一般員工'}
function mount(){document.getElementById('p79UnifiedShell')?.remove();document.getElementById('p79UnifiedShellV102')?.remove();document.getElementById('p79UnifiedShellV103')?.remove();const m=meta[current];const el=document.createElement('div');el.id='p79UnifiedShellV103';el.innerHTML=`<div class="p79v103-row"><div class="p79v103-brand"><div class="p79v103-logo">${m[0]}</div><div><div class="p79v103-title">${m[1]}</div><div class="p79v103-sub">79號碼頭雲端智慧系統｜效率同款介面 v10.14.5</div></div></div><nav class="p79v103-nav">${nav.map(n=>`<a class="${n[0]===current?'active':''}" href="${n[3]}">${n[1]} ${n[2]}</a>`).join('')}</nav><div class="p79v103-actions"><div class="p79v103-menu-wrap"><button class="p79v103-btn menu" type="button" onclick="window.p79ToggleSystemMenu(event)">☰ 功能選單</button><div id="p79SystemMenu" class="p79v103-menu"><button type="button" onclick="window.p79SystemMenuAction(\'records\')">📋 考勤管理</button><button type="button" onclick="window.p79SystemMenuAction(\'live\')">📡 即時動態</button><button type="button" onclick="window.p79SystemMenuAction(\'settings\')">⚙️ 系統設定</button><button type="button" onclick="window.p79SystemMenuAction(\'clearDeleted\')">🗑️ 清空已刪除考勤</button><div class="p79v103-menu-sep"></div><button type="button" onclick="window.p79SystemMenuAction(\'cloudread\')">☁️ 讀取雲端</button><button type="button" onclick="window.p79SystemMenuAction(\'cloudwrite\')">☁️ 全部同步</button><button type="button" onclick="window.p79SystemMenuAction(\'employee\')">👤 我的打卡</button><button type="button" onclick="window.p79SystemMenuAction(\'theme\')">◐ 深淺色</button><button type="button" onclick="window.p79SystemMenuAction(\'home\')">⌂ 返回首頁</button><button type="button" class="danger" onclick="window.p79SystemMenuAction(\'logout\')">↪ 登出後台</button></div></div></div></div><div class="p79v103-status"><span class="p79v103-dot"></span><span>${esc(roleText())}｜${esc(m[2])}</span></div>`;document.body.insertBefore(el,document.body.firstChild)}
window.p79ToggleSystemMenu=(event)=>{if(event)event.stopPropagation();document.getElementById('p79SystemMenu')?.classList.toggle('open')};
window.p79CloseSystemMenu=()=>document.getElementById('p79SystemMenu')?.classList.remove('open');
window.p79EffStyleRefresh=async()=>{try{if(typeof window.p79UnifiedRefresh==='function')return await window.p79UnifiedRefresh()}catch(e){}location.reload()};
window.p79EffStyleEdit=()=>{try{if(typeof window.p79ToggleUnifiedEditMode==='function')return window.p79ToggleUnifiedEditMode()}catch(e){}};
window.p79EffStyleTheme=()=>{try{if(current==='attendance'&&typeof window.toggleDarkMode==='function')return window.toggleDarkMode();if(current==='schedule'&&typeof window.toggleScheduleTheme==='function')return window.toggleScheduleTheme();if(typeof window.p79UnifiedTheme==='function')return window.p79UnifiedTheme();if(document.getElementById('themeBtn'))return document.getElementById('themeBtn').click()}catch(e){}document.documentElement.classList.toggle('dark')};
window.p79SystemMenuAction=async(action)=>{window.p79CloseSystemMenu();try{
  if(action==='records'&&typeof window.switchAdminTab==='function'){window.switchView?.('admin');return window.switchAdminTab('records');}
  if(action==='live'&&typeof window.switchAdminTab==='function'){window.switchView?.('admin');return window.switchAdminTab('live');}
  if(action==='settings'&&typeof window.switchAdminTab==='function'){window.switchView?.('admin');return window.switchAdminTab('settings');}
  if(action==='clearDeleted'&&typeof window.clearDeletedAttendanceGoogleSheet==='function')return await window.clearDeletedAttendanceGoogleSheet();
  if(action==='cloudread'&&typeof window.manualCloudRefresh==='function')return await window.manualCloudRefresh();
  if(action==='cloudwrite'&&typeof window.syncAllDataToCloud==='function')return await window.syncAllDataToCloud();
  if(action==='employee'&&typeof window.switchView==='function')return window.switchView('employee');
  if(action==='logout'&&typeof window.logoutAdmin==='function')return window.logoutAdmin();
  if(action==='theme')return window.p79EffStyleTheme();
  if(action==='home'){location.href='../';return;}
}catch(e){console.error(current+' 功能選單執行失敗',e);alert('功能執行失敗：'+(e?.message||e))}};
document.addEventListener('click',e=>{if(!e.target?.closest?.('.p79v103-menu-wrap'))window.p79CloseSystemMenu()});document.addEventListener('keydown',e=>{if(e.key==='Escape')window.p79CloseSystemMenu()});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(mount,0));else setTimeout(mount,0);
})();
</script>








<script id="p79-year-mode-in-function-menu-v20261002">
(function(){
  const KEY='port79_year_mode';
  function current(){return localStorage.getItem(KEY)==='roc'?'roc':'gregorian'}
  function label(){return current()==='roc'?'民國':'西元'}
  window.p79ToggleYearModeFromMenu=function(event){
    if(event){event.preventDefault();event.stopPropagation();}
    localStorage.setItem(KEY,current()==='roc'?'gregorian':'roc');
    location.reload();
  };
  function mount(){
    const box=document.getElementById('port79CalendarModeBox');if(box)box.style.display='none';
    const menu=document.getElementById('p79SystemMenu');
    if(!menu||menu.querySelector('[data-p79-year-menu="1"]'))return false;
    const btn=document.createElement('button');
    btn.type='button';btn.dataset.p79YearMenu='1';
    btn.innerHTML='📆 年份顯示：<b>'+label()+'</b>（點擊切換）';
    btn.addEventListener('click',window.p79ToggleYearModeFromMenu);
    const seps=[...menu.querySelectorAll('.p79v103-menu-sep')];
    const target=seps.length?seps[seps.length-1]:null;
    if(target)menu.insertBefore(btn,target);else menu.appendChild(btn);
    return true;
  }
  if(!mount()){
    const mo=new MutationObserver(()=>{if(mount())mo.disconnect()});
    mo.observe(document.documentElement,{childList:true,subtree:true});
    setTimeout(()=>{mount();try{mo.disconnect()}catch(e){}},4000);
  }
})();
</script>


<script id="port79-attendance-nonempty-guard-v20261003">
(function(){
  let lastGoodMonthRecords = [];
  function currentMonth(){
    try{
      const v=String(document.getElementById('filterMonthSelect')?.value||'').trim();
      return /^\d{4}-\d{2}$/.test(v)?v:'';
    }catch(e){return '';}
  }
  function snapshot(){
    try{
      const m=currentMonth();
      if(!m || !Array.isArray(records)) return;
      const rows=records.filter(r=>attendanceRecordMonthKey(r)===m && !isLocallyDeletedAttendanceRecord(r));
      if(rows.length) lastGoodMonthRecords=rows.map(r=>({...r}));
    }catch(e){}
  }
  function restoreIfBlank(){
    try{
      const m=currentMonth();
      if(!m || !lastGoodMonthRecords.length || !Array.isArray(records)) return;
      const now=records.filter(r=>attendanceRecordMonthKey(r)===m);
      if(now.length===0){
        const other=records.filter(r=>attendanceRecordMonthKey(r)!==m);
        records=deduplicateAttendanceRecordArray(
          [...lastGoodMonthRecords,...other].filter(r=>!isLocallyDeletedAttendanceRecord(r))
        );
        try{localStorage.setItem('sp_records_v5',JSON.stringify(records));}catch(e){}
        if(typeof renderAdminRecordsTable==='function') renderAdminRecordsTable();
        console.warn(`[PORT79] 偵測到 ${m} 畫面被空回應清空，已自動恢復 ${lastGoodMonthRecords.length} 筆`);
      }
    }catch(e){}
  }
  document.addEventListener('DOMContentLoaded',()=>setTimeout(()=>{
    snapshot();
    setInterval(()=>{
      if(document.visibilityState!=='visible') return;
      snapshot();
      restoreIfBlank();
    },60000);
  },1200),{once:true});
})();
</script>


